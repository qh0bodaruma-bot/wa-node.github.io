---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "AI Consultation Navigator (Temporarily Unavailable) | Wa-Node";
const description = "The AI input and response functions are temporarily unavailable while Wa-Node improves its privacy notice and consent process.";
---

<BaseLayout noindex={true} title={title} description={description} lang="en">
  <main id="main" class="notice-page">
    <section class="section">
      <div class="notice-card">
        <p class="eyebrow">AI & ICT Solutions</p>
        <h1>AI Consultation Navigator</h1>
        <h2>Input and response functions are temporarily unavailable</h2>
        <p>We are updating our privacy notice and consent process. No information entered on this page is transmitted to an external AI service.</p>
        <p>For web, AI, or workflow consultation, please use our contact page after reviewing the Japanese legal notices.</p>
        <a class="btn primary" href="/en/contact/?source=ai_chat_demo">Go to contact page</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .notice-page { background: #fdfcf9; min-height: 70vh; }
  .notice-card { max-width: 760px; margin: 50px auto; padding: 40px; background: #fff; border: 1px solid var(--line); border-radius: 24px; text-align: center; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.8rem); margin: 12px 0; }
  h2 { color: var(--accent); font-size: 1.4rem; margin-bottom: 24px; }
  p { line-height: 1.8; }
</style>
