---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactFormContent from '../components/ContactFormContent.astro';
import {
  createBreadcrumbSchema,
  createWebPageSchema,
  organizationSchema,
} from '../data/structuredData';

const title = "無料相談｜LINE連携構築のご相談（初回30分）｜和-Node";
const description = "LINE公式アカウントとSalesforce・kintone・HubSpot・Googleスプレッドシートの連携構築のご相談はこちら。アプリ開発・Web制作のご相談も受け付けます。初回30分は無料。希望日時は後で調整でき、通常2営業日以内に返信します。";
const structuredData = [
  organizationSchema,
  createWebPageSchema({ name: title, description, path: "/contact/", type: "ContactPage" }),
  createBreadcrumbSchema([
    { name: "ホーム", path: "/" },
    { name: "お問い合わせ・無料相談", path: "/contact/" },
  ]),
];
---
<BaseLayout lang="ja" title={title} description={description} structuredData={structuredData}>
  <ContactFormContent lang="ja" />
</BaseLayout>
