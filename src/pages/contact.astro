---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactFormContent from '../components/ContactFormContent.astro';
import {
  createBreadcrumbSchema,
  createWebPageSchema,
  organizationSchema,
} from '../data/structuredData';

const title = "無料相談フォーム｜LINE連携構築（Salesforce・kintone・HubSpot等）｜和-Node";
const description = "LINE連携構築（Salesforce・kintone・HubSpot・Googleスプレッドシート等）に関するご相談・費用のお問い合わせはこちら。初回30分の無料相談を受け付けています。返信は営業日2日以内。";
const structuredData = [
  organizationSchema,
  createWebPageSchema({ name: title, description, path: "/contact/", type: "ContactPage" }),
  createBreadcrumbSchema([
    { name: "ホーム", path: "/" },
    { name: "お問い合わせ・無料相談", path: "/contact/" },
  ]),
];
---
<BaseLayout lang="ja" title={title} description={description} structuredData={structuredData}>
  <ContactFormContent lang="ja" />
</BaseLayout>
