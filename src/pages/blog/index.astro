---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogs } from '../../library/microcms';
import { presentBlog } from '../../library/blogPresentation';
import { blogTopics, blogStartPoints } from '../../data/blogReadingGuides';
import '../../styles/fonts/shippori-mincho-site.css';

// microCMSから記事一覧を取得（公開日の降順）
const response = await getBlogs({ 
  orders: '-publishedAt' 
});
const posts = response.contents.map(presentBlog);
const topics = blogTopics.filter(topic => posts.some(post => post.topic === topic.id));
const startPoints = blogStartPoints.filter(point => posts.some(post => post.id === point.id));
---

<BaseLayout title="コラム｜LINE連携を考えるための読みもの｜和-Node" description="LINE連携を検討する方に向けて、業務の整理、受付の記録、権限と引き継ぎの確認点をまとめています。目的に合う記事からお読みいただけます。">
  <main id="main" class="blog-index" data-reveal="off">
    <header class="blog-header">
      <div class="container">

        <h1>コラム<br/><span class="accent-text"><span>LINE連携を</span><span>考えるために。</span></span></h1>
        <p class="lead">LINE連携の準備から運用まで。記事の冒頭で、発注・導入前の確認点を読めます。</p>
      </div>
    </header>

    <div class="container">
      {startPoints.length > 0 && <section class="reading-start" aria-labelledby="reading-start-title">
        <h2 id="reading-start-title">気になることから読む</h2>
        <div class="start-grid">
          {startPoints.map(point => <a href={`/blog/${point.id}/`}>
            <strong>{point.label}</strong>
            <span>{point.text}</span>
          </a>)}
        </div>
      </section>}
      <nav class="topic-nav" aria-label="コラムのテーマ">
        {topics.map(topic => <a href={`#topic-${topic.id}`}>{topic.label}</a>)}
      </nav>
      {topics.map(topic => <section class="topic-section" id={`topic-${topic.id}`} aria-labelledby={`heading-${topic.id}`}>
        <h2 id={`heading-${topic.id}`}>{topic.label}</h2>
        <p class="topic-description">{topic.description} {topic.id === 'web' && <a href="/pricing/">料金と対応範囲を見る</a>}</p>
      <div class="post-grid">
        {posts.filter(post => post.topic === topic.id).map((post) => (
          <article class="post-card" data-motion-enter="block" data-motion-group="posts">
            <a href={`/blog/${post.id}/`}>
              {post.eyecatch && <div class="post-image">
                  <img src={post.eyecatch.url} alt="" width={post.eyecatch.width} height={post.eyecatch.height} loading="lazy" decoding="async"
                  />
              </div>}
              <div class="post-content">
                <div class="post-meta">
                  <time datetime={post.publishedAt}>
                    {new Date(post.publishedAt).toLocaleDateString('ja-JP', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                      timeZone: 'Asia/Tokyo',
                    })}
                  </time>
                </div>
                <h3>{post.title}</h3>
                <p>{post.description}</p>
                <span class="read-more">記事を読む <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>
        ))}
      </div>
      </section>)}
    </div>
  </main>
</BaseLayout>

<style>
  .blog-index { padding-bottom: 120px; }
  .blog-header { padding: 80px 0 48px; text-align: left; }
  .eyebrow { font-size: 0.85rem; font-weight: 900; color: var(--accent2); letter-spacing: 0.3em; text-transform: uppercase; margin-bottom: 16px; display: block; }
  .blog-header h1, .reading-start h2, .topic-section > h2 { font-family: 'Shippori Mincho', 'Yu Mincho', serif; font-weight: 700; }
  .blog-header h1 { font-size: clamp(2.35rem, 4.3vw, 3.8rem); line-height: 1.3; margin-bottom: 24px; text-wrap: balance; }
  .accent-text { color: var(--trust, #0f4c5c); }
  .accent-text > span { display: inline-block; }
  .lead { font-size: 1.15rem; color: var(--muted); max-width: 700px; margin: 0; line-height: 1.8; }
  .reading-start { padding: 28px; background: #fff; border: 1px solid var(--line); border-radius: 16px; }
  .reading-start h2 { font-size: 1.3rem; line-height: 1.6; margin: 0 0 20px; }
  .start-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .start-grid a { display: grid; align-content: start; gap: 10px; padding: 20px; color: var(--trust, #0f4c5c); background: #f2f7f6; border: 1px solid #8fa09b; border-radius: 8px; text-decoration: none; line-height: 1.7; }
  .start-grid a:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .start-grid span { color: var(--text); font-size: 1rem; }
  .topic-nav { display: flex; flex-wrap: wrap; gap: 10px 20px; margin: 28px 0 48px; }
  .topic-nav a, .topic-description a { color: var(--trust, #0f4c5c); text-underline-offset: 4px; }
  .topic-description a { text-decoration: underline; }
  .topic-nav a { display: inline-flex; align-items: center; min-height: 44px; }
  .topic-section { scroll-margin-top: 100px; margin-bottom: 64px; }
  .topic-section > h2 { margin: 0 0 12px; font-size: clamp(1.4rem, 3vw, 1.8rem); line-height: 1.5; }
  .topic-description { margin: 0; color: var(--muted); line-height: 1.8; max-width: 760px; }
  .blog-index a:focus-visible { outline: 3px solid var(--trust, #0f4c5c); outline-offset: 4px; }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin-top: 24px;
  }

  .post-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    transition: 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: none;
  }
  .post-card a { text-decoration: none; color: inherit; display: block; height: 100%; }
  
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(70, 52, 32, 0.08);
    border-color: var(--accent2);
  }

  .post-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #f8f1e9;
    overflow: hidden;
  }
  .post-image img { width: 100%; height: 100%; object-fit: cover; transition: 0.6s; }
  .post-card:hover .post-image img { transform: scale(1.05); }

  .post-content { padding: 32px; }

  /* 各テーマの1件目：画像と本文を横に並べて全幅で見せる（記事が1件だけのテーマは通常の大きさ） */
  .post-card:first-child:not(:only-child) { grid-column: 1 / -1; }
  .post-card:first-child:not(:only-child) > a { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: stretch; }
  /* 画像に文字が入っているため、切り取らず 16:9 のまま見せる */
  .post-card:first-child:not(:only-child) .post-image { align-self: start; }
  .post-card:first-child:not(:only-child) .post-content { align-self: center; padding: 40px; }
  .post-card:first-child:not(:only-child) .post-content h3 { font-size: 1.5rem; }
  
  .post-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; font-size: 0.85rem; color: var(--muted); }
  .tags { display: flex; gap: 8px; }
  .tags span { color: var(--accent); font-weight: 700; }

  .post-content h3 { font-size: 1.3rem; font-weight: 800; margin-bottom: 12px; line-height: 1.6; color: var(--text); }
  .post-content p { font-size: 1rem; color: #465952; font-weight: 500; line-height: 1.85; margin-bottom: 24px; }
  
  .read-more { font-weight: 800; color: var(--accent); font-size: 0.9rem; border-bottom: 2px solid var(--soft); padding-bottom: 2px; }

  @media (max-width: 768px) {
    .blog-header { padding: 48px 0 32px; }
    .lead { font-size: 1rem; }
    .post-grid { grid-template-columns: 1fr; gap: 30px; }
    .post-card:first-child:not(:only-child) > a { display: block; }
    .post-card:first-child:not(:only-child) .post-content { padding: 24px; }
    .post-card:first-child:not(:only-child) .post-content h3 { font-size: 1.3rem; }
    .start-grid { grid-template-columns: 1fr; }
    .reading-start { padding: 20px; }
    .start-grid a { padding: 16px; }
    .post-content { padding: 24px; }
  }
</style>
