---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Navigateur de consultation IA (indisponible temporairement) | Wa-Node";
const description = "Les fonctions de saisie et de réponse IA sont temporairement indisponibles pendant la mise à jour de l'information et du consentement relatifs aux données personnelles.";
---

<BaseLayout noindex={true} title={title} description={description} lang="fr">
  <main id="main" class="notice-page">
    <section class="section">
      <div class="notice-card">
        <p class="eyebrow">Solutions IA & TIC</p>
        <h1>Navigateur de consultation IA</h1>
        <h2>Les fonctions de saisie et de réponse sont temporairement indisponibles</h2>
        <p>Nous mettons à jour l'information et le processus de consentement relatifs aux données personnelles. Aucune information saisie sur cette page n'est transmise à un service d'IA externe.</p>
        <p>Pour une consultation web, IA ou organisationnelle, utilisez notre page de contact après avoir consulté les mentions juridiques en japonais.</p>
        <a class="btn primary" href="/fr/contact/?source=ai_chat_demo">Accéder à la page de contact</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .notice-page { background: #fdfcf9; min-height: 70vh; }
  .notice-card { max-width: 760px; margin: 50px auto; padding: 40px; background: #fff; border: 1px solid var(--line); border-radius: 24px; text-align: center; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.8rem); margin: 12px 0; }
  h2 { color: var(--accent); font-size: 1.4rem; margin-bottom: 24px; }
  p { line-height: 1.8; }
</style>
