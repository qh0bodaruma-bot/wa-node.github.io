    <section class="demo-after">
      <div class="demo-shell">
        <p class="section-kicker">WHAT TO BUILD</p>
        <h2>画面だけで終わらせず、<br />運用までつながる形を考えます。</h2>
        <div class="demo-after__grid">
          <article><MaterialIcon name="groups" /><h3>利用者の画面</h3><p>記録・予約・会員情報・費用管理など、使う人が迷わない順番を整えます。</p></article>
          <article><MaterialIcon name="dashboard" /><h3>運用する画面</h3><p>確認、対応、通知、データ出力など、担当者の作業も一緒に整理します。</p></article>
          <article><MaterialIcon name="sync_alt" /><h3>必要な連携</h3><p>LINE、既存サイト、予約・顧客システム、外部APIとのつなぎ方を検討します。</p></article>
        </div>
      </div>
    </section>
  </main>

  <script>
    const appChoices = document.querySelectorAll('[data-app-choice]');
    const appPanels = document.querySelectorAll('[data-app-panel]');
    const copyPanels = document.querySelectorAll('[data-copy-panel]');
    const demoStatus = document.querySelector('#demo-status');
    const storageKey = 'wa-node-mobile-app-demo-state-v2';
    const defaultState = {
      petRecords: [
        { date: '昨日 20:18', condition: '元気です', weight: '4.2' },
        { date: '8月8日（金）', condition: '元気です', weight: '4.1' },
        { date: '8月7日（木）', condition: '少し気になる', weight: '4.3' },
      ],
    };
    let demoState = { ...defaultState };

    try {
      const saved = JSON.parse(localStorage.getItem(storageKey));
      if (saved && Array.isArray(saved.petRecords)) demoState = { ...defaultState, ...saved };
    } catch {
      demoState = { ...defaultState };
    }

    function saveState() {
      localStorage.setItem(storageKey, JSON.stringify(demoState));
    }

    function showApp(app) {
      appChoices.forEach((button) => {
        const selected = button.dataset.appChoice === app;
        button.classList.toggle('is-active', selected);
        button.setAttribute('aria-selected', String(selected));
        button.tabIndex = selected ? 0 : -1;
      });
      appPanels.forEach((panel) => {
        const selected = panel.dataset.appPanel === app;
        panel.hidden = !selected;
        panel.classList.toggle('is-active', selected);
      });
      copyPanels.forEach((panel) => { panel.hidden = panel.dataset.copyPanel !== app; });
      demoStatus.textContent = app === 'pet' ? 'ペット健康手帳のデモを表示しています。' : 'Flowのデモを表示しています。';
    }

    /* ---------- ペット ---------- */
    function showPetView(view) {
      document.querySelectorAll('[data-pet-view]').forEach((panel) => {
        const selected = panel.dataset.petView === view;
        panel.hidden = !selected;
        panel.classList.toggle('is-active', selected);
      });
      document.querySelectorAll('[data-pet-nav]').forEach((button) => button.classList.toggle('is-current', button.dataset.petNav === view));
    }

    function renderPetRecords() {
      const list = document.querySelector('#pet-record-list');
      const count = document.querySelector('#pet-record-count');
      const current = demoState.petRecords[0];
      list.innerHTML = demoState.petRecords.map((record) =>
        `<article><span>${record.date}</span><strong>${record.condition}</strong><small>${record.weight ? '体重 ' + record.weight + ' kg' : '体調記録済み'}</small><i class="material-symbols-rounded">chevron_right</i></article>`
      ).join('');
      count.textContent = String(demoState.petRecords.length);
      document.querySelector('#pet-condition').textContent = current.condition;
      const weightEl = document.querySelector('#pet-weight');
      if (current.weight) weightEl.innerHTML = current.weight + '<small>kg</small>';
    }

    appChoices.forEach((button) => {
      button.addEventListener('click', () => showApp(button.dataset.appChoice));
      button.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
        event.preventDefault();
        const buttons = [...appChoices];
        const current = buttons.indexOf(button);
        const next = event.key === 'ArrowRight' ? (current + 1) % buttons.length : (current - 1 + buttons.length) % buttons.length;
        buttons[next].focus();
        showApp(buttons[next].dataset.appChoice);
      });
    });

    document.querySelectorAll('[data-pet-nav]').forEach((button) => button.addEventListener('click', () => showPetView(button.dataset.petNav)));
    document.querySelectorAll('[data-pet-to-home]').forEach((button) => button.addEventListener('click', () => showPetView('home')));

    const petModal = document.querySelector('#pet-record-modal');
    let selectedCondition = '元気です';
    function openPetRecordModal() { petModal.hidden = false; }
    document.querySelector('#pet-record-button').addEventListener('click', openPetRecordModal);
    document.querySelector('#pet-record-from-list').addEventListener('click', openPetRecordModal);
    document.querySelector('#pet-record-close').addEventListener('click', () => { petModal.hidden = true; });
    document.querySelectorAll('[data-condition]').forEach((button) => {
      button.addEventListener('click', () => {
        document.querySelectorAll('[data-condition]').forEach((item) => item.classList.remove('is-selected'));
        button.classList.add('is-selected');
        selectedCondition = button.dataset.condition;
      });
    });
    document.querySelector('#pet-record-save').addEventListener('click', () => {
      const weightVal = document.querySelector('#pet-weight-input').value.trim();
      demoState.petRecords.unshift({ date: 'たった今', condition: selectedCondition, weight: weightVal || null });
      demoState.petRecords = demoState.petRecords.slice(0, 6);
      saveState();
      renderPetRecords();
      petModal.hidden = true;
      document.querySelector('#pet-weight-input').value = '';
      demoStatus.textContent = `ルナの「${selectedCondition}」${weightVal ? '・体重' + weightVal + 'kg' : ''}を記録しました。記録画面でも確認できます。`;
    });

    document.querySelector('#schedule-complete').addEventListener('click', (event) => {
      event.currentTarget.textContent = '完了にしました';
      event.currentTarget.disabled = true;
      demoStatus.textContent = 'ワクチン相談を完了にするサンプル操作を反映しました。';
    });

    const petHospitalModal = document.querySelector('#pet-hospital-modal');
    document.querySelector('#pet-hospital-button').addEventListener('click', () => { petHospitalModal.hidden = false; demoStatus.textContent = '病院持参モードを開きました。画面をそのまま受付に見せられます。'; });
    document.querySelector('#pet-hospital-close').addEventListener('click', () => { petHospitalModal.hidden = true; });

    document.querySelector('#reset-pet-demo').addEventListener('click', () => {
      demoState.petRecords = defaultState.petRecords.map((r) => ({ ...r }));
      saveState();
      renderPetRecords();
      showPetView('home');
      demoStatus.textContent = 'ペット健康手帳のデモを初期状態に戻しました。';
    });

    /* ---------- Flow ---------- */
    function showFlowView(view) {
      document.querySelectorAll('[data-flow-view]').forEach((panel) => {
        const selected = panel.dataset.flowView === view;
        panel.hidden = !selected;
        panel.classList.toggle('is-active', selected);
      });
      document.querySelectorAll('[data-flow-nav]').forEach((button) => button.classList.toggle('is-current', button.dataset.flowNav === view));
    }

    document.querySelectorAll('[data-flow-nav]').forEach((button) => button.addEventListener('click', () => showFlowView(button.dataset.flowNav)));
    document.querySelectorAll('[data-flow-to-home]').forEach((button) => button.addEventListener('click', () => showFlowView('home')));

    // カテゴリフィルター
    document.querySelectorAll('[data-flow-cat]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-flow-cat]').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const cat = btn.dataset.flowCat;
        let count = 0;
        document.querySelectorAll('[data-flow-service-cat]').forEach((card) => {
          const show = cat === 'all' || card.dataset.flowServiceCat === cat;
          card.hidden = !show;
          if (show) count++;
        });
        const label = cat === 'all' ? 'すべてのサービス' : btn.textContent.trim();
        document.querySelector('#flow-list-title').textContent = `${label}（${count}件）`;
      });
    });

    // カレンダー
    const calEvents = {
      15: [{ emoji: '🎬', name: 'Netflix', cat: '動画', price: '¥990' }],
      17: [{ emoji: '🎵', name: 'Spotify', cat: '音楽', price: '¥980' }],
      26: [{ emoji: '💼', name: 'Adobe CC', cat: '作業', price: '¥2,728' }],
    };
    document.querySelectorAll('[data-flow-day]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-flow-day]').forEach((b) => b.classList.remove('flow-cal-selected'));
        btn.classList.add('flow-cal-selected');
        const day = parseInt(btn.dataset.flowDay);
        const events = calEvents[day] || [];
        const labelEl = document.querySelector('#flow-cal-label');
        const eventsEl = document.querySelector('#flow-cal-events');
        labelEl.textContent = `8月${day}日の請求`;
        if (events.length === 0) {
          eventsEl.innerHTML = '<p class="flow-cal-empty">この日に請求なし</p>';
        } else {
          eventsEl.innerHTML = events.map((e) =>
            `<div class="flow-cal-event-row"><span>${e.emoji}</span><div><strong>${e.name}</strong><small>${e.cat}</small></div><strong>${e.price}</strong></div>`
          ).join('');
        }
        demoStatus.textContent = `8月${day}日の請求を確認しています。`;
      });
    });

    // トライアルモーダル
    const flowTrialModal = document.querySelector('#flow-trial-modal');
    document.querySelector('#flow-trial-bell').addEventListener('click', () => { flowTrialModal.hidden = false; });
    document.querySelector('#flow-trial-modal-close').addEventListener('click', () => { flowTrialModal.hidden = true; });
    document.querySelector('#flow-trial-ok').addEventListener('click', () => { flowTrialModal.hidden = true; demoStatus.textContent = 'トライアル期限を確認しました。'; });

    // Flowデモ初期化
    document.querySelector('#reset-flow-demo').addEventListener('click', () => {
      document.querySelectorAll('[data-flow-cat]').forEach((b) => b.classList.toggle('is-active', b.dataset.flowCat === 'all'));
      document.querySelectorAll('[data-flow-service-cat]').forEach((c) => { c.hidden = false; });
      document.querySelector('#flow-list-title').textContent = 'すべてのサービス（3件）';
      showFlowView('home');
      demoStatus.textContent = 'Flowのデモを初期状態に戻しました。';
    });

    renderPetRecords();
  </script>
</BaseLayout>

