  .pet-card--care { align-items:center; gap:10px; }.pet-card__icon { width:36px; height:36px; display:grid; place-items:center; background:#fbe9d9; color:#b97129; }.pet-card--care > div { min-width:0; flex:1; }.pet-card--care small,.pet-card--care span { display:block; color:var(--muted); font-size:.66rem; }.pet-card--care strong { display:block; margin:2px 0; font-size:.76rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.pet-card--care > .material-icon { color:var(--muted); }
  .primary-phone-button,.modal-save { width:100%; min-height:49px; display:flex; justify-content:center; align-items:center; gap:8px; margin-top:15px; border:0; background:var(--coral); color:#fff; font:inherit; font-size:.83rem; font-weight:900; cursor:pointer; }.primary-phone-button:hover,.modal-save:hover { background:#b83f35; }.primary-phone-button .material-icon { font-size:1.1rem; }
  .phone-nav { position:absolute; right:0; bottom:0; left:0; display:grid; grid-template-columns:repeat(4,1fr); min-height:62px; border-top:1px solid #e0e9e5; background:#fff; }.phone-nav button { display:grid; place-content:center; gap:2px; border:0; background:#fff; color:#8a9998; font:inherit; font-size:.58rem; cursor:pointer; }.phone-nav .material-icon { font-size:1.25rem; }.phone-nav button.is-current { color:var(--teal); font-weight:900; }
  .phone-modal { position:absolute; z-index:4; inset:0; display:flex; align-items:end; background:rgba(14,34,39,.35); }.phone-modal[hidden] { display:none; }.phone-modal__sheet { position:relative; width:100%; padding:12px 20px 24px; border-radius:24px 24px 0 0; background:#fff; animation:sheet-in .2s ease-out; }.sheet-handle { width:40px; height:4px; margin:0 auto 15px; border-radius:99px; background:#ccd7d4; }.modal-close { position:absolute; top:20px; right:16px; border:0; background:transparent; color:var(--muted); cursor:pointer; }.phone-modal__sheet p { margin:0; color:var(--muted); font-size:.72rem; }.phone-modal__sheet h3 { margin:4px 0 19px; font-size:1.16rem; }.condition-options { display:grid; grid-template-columns:repeat(3,1fr); gap:7px; }.condition-options button { display:grid; gap:5px; place-items:center; min-height:78px; border:1px solid var(--line); background:#fff; color:var(--muted); font:inherit; font-size:.68rem; cursor:pointer; }.condition-options button.is-selected { border:2px solid var(--teal); background:#edf8f4; color:var(--teal); }.condition-options .material-icon { font-size:1.45rem; }.modal-description { padding:14px; background:#f3f7f5; color:var(--muted); font-size:.8rem; line-height:1.7; }.modal-save { margin-top:16px; }
  .screen-header { display:flex; justify-content:space-between; align-items:start; padding-top:5px; }.screen-header span { color:var(--muted); font-size:.7rem; }.screen-header h2 { margin:3px 0 0; font-size:1.35rem; }.screen-summary { display:flex; justify-content:space-between; align-items:center; margin-top:20px; padding:12px 14px; background:#e9f4ef; color:var(--teal); font-size:.76rem; }.screen-summary span { color:#347564; }.screen-summary b { font-size:1.05rem; }.record-list { display:grid; gap:8px; margin-top:12px; }.record-list article { position:relative; padding:14px 31px 14px 14px; border:1px solid #e0e9e5; background:#fff; }.record-list span { display:block; color:var(--muted); font-size:.66rem; }.record-list strong { display:block; margin:3px 0; font-size:.82rem; }.record-list small { display:block; color:var(--muted); font-size:.66rem; }.record-list i { position:absolute; top:50%; right:9px; color:var(--muted); font-style:normal; transform:translateY(-50%); }.secondary-phone-button { width:100%; min-height:46px; display:flex; justify-content:center; align-items:center; gap:7px; margin-top:16px; border:1px solid var(--teal); background:#fff; color:var(--teal); font:inherit; font-size:.79rem; font-weight:900; cursor:pointer; }.schedule-card { margin-top:20px; padding:18px; border:1px solid #dce8e3; background:#fff; }.schedule-card > span { color:var(--muted); font-size:.68rem; }.schedule-card strong { display:block; margin-top:4px; color:var(--teal); font-size:1.2rem; }.schedule-card p { margin:10px 0 14px; font-size:.82rem; line-height:1.6; }.schedule-card p small { color:var(--muted); }.schedule-card button { min-height:38px; display:flex; align-items:center; gap:6px; border:0; background:#e9f4ef; color:#267158; font:inherit; font-size:.72rem; font-weight:800; cursor:pointer; }.schedule-card button:disabled { color:var(--muted); }.schedule-list > p,.settings-group > p { margin:20px 0 8px; color:var(--muted); font-size:.7rem; font-weight:800; }.schedule-list > div { display:flex; justify-content:space-between; padding:13px; border-bottom:1px solid #e3ebe7; background:#fff; font-size:.74rem; }.schedule-list span { color:var(--muted); }.settings-group { display:grid; margin-top:18px; }.settings-group p { grid-column:1 / -1; }.settings-group label,.settings-group button { min-height:48px; display:flex; justify-content:space-between; align-items:center; padding:0 13px; border:1px solid #e1eae6; background:#fff; color:var(--ink); font:inherit; font-size:.75rem; }.settings-group label + label,.settings-group button + button { border-top:0; }.settings-group > span { padding:13px; border:1px solid #e1eae6; background:#fff; color:var(--muted); font-size:.72rem; line-height:1.6; }.settings-group > span + button { border-top:0; color:var(--coral); cursor:pointer; }.settings-group input { accent-color:var(--teal); }

  /* 体重入力 */
