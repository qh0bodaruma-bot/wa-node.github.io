---
import BaseLayout from '../layouts/BaseLayout.astro';
import MaterialIcon from '../components/MaterialIcon.astro';

const title = 'Androidアプリ体験デモ｜ペット健康手帳・Flow｜和-Node';
const description = 'ペット健康手帳とサブスク管理アプリFlowの自主制作デモです。体重・ワクチン記録・病院持参、サブスク費用の一覧・カレンダー・支出分析など、日常利用の画面をブラウザで体験できます。';
---

<BaseLayout title={title} description={description} noindex={true}>
  <main id="main" class="app-demo" data-glossary-skip>
    <section class="demo-notice" aria-label="デモについての注意">
      <div class="demo-shell demo-notice__inner">
        <span>自主制作・架空アプリデモ</span>
        <p>画面内の情報はすべてサンプルです。操作内容はブラウザ内だけで反映され、送信・課金・保存は行われません。</p>
        <a href="/works/">制作例へ戻る</a>
      </div>
    </section>

    <section class="demo-hero">
      <div class="demo-shell demo-hero__grid">
        <div class="demo-hero__copy">
          <p class="eyebrow">MOBILE APP INTERACTIVE DEMO</p>
          <h1>毎日使う流れを、<br />アプリで分かりやすく。</h1>
          <p>「ペット健康手帳」と「Flow（サブスク管理）」を実際に開発したアプリをベースにしたデモです。スマートフォンらしい画面遷移と、利用者・運用者に必要な情報のまとまりを確認できます。</p>
          <dl class="demo-hero__points">
            <div><dt><MaterialIcon name="touch_app" /></dt><dd><strong>操作できる</strong><span>画面を切り替え、記録・分析を試せます</span></dd></div>
            <div><dt><MaterialIcon name="smartphone" /></dt><dd><strong>Android風UI</strong><span>実機の利用場面を想定した縦長の画面構成です</span></dd></div>
            <div><dt><MaterialIcon name="account_tree" /></dt><dd><strong>用途別の設計</strong><span>記録・管理・分析の異なる目的を比較できます</span></dd></div>
          </dl>
        </div>

        <div class="demo-selector" aria-labelledby="app-selector-title">
          <p class="demo-selector__label" id="app-selector-title">体験するアプリを選ぶ</p>
          <div class="app-choice-list" role="tablist" aria-label="アプリデモの切り替え">
            <button type="button" class="app-choice is-active" role="tab" aria-selected="true" aria-controls="pet-panel" id="pet-tab" data-app-choice="pet">
              <span class="app-choice__icon app-choice__icon--pet"><MaterialIcon name="pets" /></span>
              <span><strong>ペット健康手帳</strong><small>体重・ワクチン・通院・病院持参</small></span>
              <MaterialIcon name="arrow_forward" />
            </button>
            <button type="button" class="app-choice" role="tab" aria-selected="false" aria-controls="flow-panel" id="flow-tab" data-app-choice="flow" tabindex="-1">
              <span class="app-choice__icon app-choice__icon--flow"><MaterialIcon name="receipt_long" /></span>
              <span><strong>Flow（サブスク管理）</strong><small>費用管理・カレンダー・支出分析</small></span>
              <MaterialIcon name="arrow_forward" />
            </button>
          </div>
          <p class="demo-selector__note"><MaterialIcon name="info" /> どちらも実際に開発中のAndroidアプリをベースにした画面・導線サンプルです。</p>
        </div>
      </div>
    </section>

    <section class="demo-stage" aria-label="Androidアプリ体験">
      <div class="demo-shell demo-stage__grid">
        <aside class="app-explanation">
          <div class="app-explanation__panel" data-copy-panel="pet">
            <p class="section-kicker">PET HEALTH NOTE</p>
            <h2>気になる変化を、<br />いつもの記録にする。</h2>
            <p>体重・ワクチン・通院など、飼い主と動物病院が共有したい情報を整理。「病院へ持参する」機能で、診察時にそのまま画面を見せられます。400円買い切り・広告なし。</p>
            <dl class="feature-list">
              <div><dt><MaterialIcon name="monitor_weight" /></dt><dd><strong>記録</strong><span>体重・体調・通院を最大3タップで記録</span></dd></div>
              <div><dt><MaterialIcon name="event" /></dt><dd><strong>予定</strong><span>ワクチン・通院の期限を見落としにくく表示</span></dd></div>
              <div><dt><MaterialIcon name="local_hospital" /></dt><dd><strong>病院持参</strong><span>アレルギー・体重・次回予定をフルスクリーンで表示</span></dd></div>
            </dl>
          </div>
          <div class="app-explanation__panel" data-copy-panel="flow" hidden>
            <p class="section-kicker">FLOW — SUBSCRIPTION MANAGER</p>
            <h2>払っているものを、<br />全部把握する。</h2>
            <p>Netflix・Spotify・Adobe CCなど複数のサブスクを登録し、月間支出・請求日・カテゴリ別の内訳を一画面で確認。無料トライアルの期限も自動で警告します。</p>
            <dl class="feature-list">
              <div><dt><MaterialIcon name="payments" /></dt><dd><strong>費用管理</strong><span>月払い・年払いをまとめて把握、月間¥X,XXX換算</span></dd></div>
              <div><dt><MaterialIcon name="calendar_month" /></dt><dd><strong>請求カレンダー</strong><span>いつ何が引き落とされるかを月単位で確認</span></dd></div>
              <div><dt><MaterialIcon name="bar_chart" /></dt><dd><strong>支出分析</strong><span>月別・カテゴリ別の傾向とトライアル期限を管理</span></dd></div>
            </dl>
          </div>
          <div class="app-scope">
            <span>制作時に整理すること</span>
            <p>利用者、必要な記録、通知、会員情報、外部システム連携、管理画面、公開後の保守範囲を、必要な順番で確認します。</p>
            <a href="/contact/?source=mobile_app_demo">近いアプリについて相談する <MaterialIcon name="arrow_forward" /></a>
          </div>
        </aside>

        <div class="phone-area">
          <div class="phone" aria-label="Androidアプリのサンプル画面">
            <div class="phone__speaker" aria-hidden="true"></div>
            <div class="phone__screen">

              <!-- ペット健康手帳 -->
              <section class="phone-panel is-active" id="pet-panel" role="tabpanel" aria-labelledby="pet-tab" data-app-panel="pet">
                <div class="status-bar" aria-hidden="true"><span>9:41</span><span><MaterialIcon name="signal_cellular_alt" /><MaterialIcon name="wifi" /><MaterialIcon name="battery_full" /></span></div>

                <!-- ホーム -->
                <div class="phone-view is-active" data-pet-view="home">
                  <header class="pet-header">
                    <div><span>おはよう、サンプルさん</span><h2>ルナの健康手帳</h2></div>
                    <button type="button" class="round-button" aria-label="通知を見る"><MaterialIcon name="notifications" /><i></i></button>
                  </header>
                  <div class="pet-profile">
                    <div class="pet-avatar" aria-hidden="true"><MaterialIcon name="pets" /></div>
                    <div><strong>ルナ</strong><span>トイプードル / 4歳</span></div>
                    <button type="button" class="pet-switch" aria-label="ペットを切り替える"><MaterialIcon name="keyboard_arrow_down" /></button>
                  </div>
                  <div class="pet-summary">
                    <p>今日の様子</p>
                    <div><strong id="pet-condition">元気です</strong><span><MaterialIcon name="sentiment_satisfied" /> 記録済み</span></div>
                    <small>前回の記録：昨日 20:18</small>
                  </div>
                  <section class="pet-card pet-card--weight" aria-label="体重の記録">
                    <div><span>体重</span><strong id="pet-weight">4.2<small>kg</small></strong><small class="weight-change"><MaterialIcon name="trending_down" /> 前回から -0.1kg</small></div>
                    <div class="mini-chart" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                  </section>
                  <section class="pet-card pet-card--care" aria-label="次のケア予定">
                    <span class="pet-card__icon"><MaterialIcon name="event" /></span>
                    <div><small>次のケア予定</small><strong>8月18日（月） ワクチン相談</strong><span>さくら動物クリニック 10:30</span></div>
                    <MaterialIcon name="chevron_right" />
                  </section>
                  <button type="button" class="primary-phone-button" id="pet-record-button"><MaterialIcon name="edit_note" /> 今日の記録を追加する</button>
                </div>

                <!-- 記録タブ -->
                <div class="phone-view" data-pet-view="records" hidden>
                  <header class="screen-header"><div><span>ルナの健康手帳</span><h2>記録</h2></div><button type="button" class="round-button" data-pet-to-home aria-label="ホームへ戻る"><MaterialIcon name="close" /></button></header>
                  <div class="screen-summary"><strong>今週の記録</strong><span><b id="pet-record-count">3</b>件</span></div>
                  <div class="record-list" id="pet-record-list" aria-live="polite"></div>
                  <button type="button" class="secondary-phone-button" id="pet-record-from-list"><MaterialIcon name="add" /> 今日の記録を追加</button>
                </div>

                <!-- 予定タブ -->
                <div class="phone-view" data-pet-view="schedule" hidden>
                  <header class="screen-header"><div><span>ルナの健康手帳</span><h2>予定</h2></div><button type="button" class="round-button" data-pet-to-home aria-label="ホームへ戻る"><MaterialIcon name="close" /></button></header>
                  <div class="schedule-card schedule-card--next"><span>次の予定</span><strong>8月18日（月）</strong><p>ワクチン相談<br /><small>さくら動物クリニック 10:30</small></p><button type="button" id="schedule-complete"><MaterialIcon name="task_alt" /> 完了にする</button></div>
                  <div class="schedule-list"><p>これからの予定</p><div><b>9月02日（火）</b><span>トリミング</span></div><div><b>9月16日（火）</b><span>フィラリア予防</span></div></div>
                </div>

                <!-- 情報タブ -->
                <div class="phone-view" data-pet-view="info" hidden>
                  <header class="screen-header"><div><span>ルナの健康手帳</span><h2>情報</h2></div><button type="button" class="round-button" data-pet-to-home aria-label="ホームへ戻る"><MaterialIcon name="close" /></button></header>
                  <div class="pet-allergy-box">
                    <p><MaterialIcon name="warning" /> アレルギー・禁忌薬</p>
                    <div><span>アレルギー</span><strong>なし</strong></div>
                    <div><span>禁忌薬</span><strong>なし</strong></div>
                  </div>
                  <div class="pet-info-group">
                    <p>基本情報</p>
                    <div><span>名前</span><strong>ルナ</strong></div>
                    <div><span>種別</span><strong>トイプードル・メス</strong></div>
                    <div><span>年齢</span><strong>4歳</strong></div>
                    <div><span>去勢・避妊</span><strong>済</strong></div>
                    <div><span>最終体重</span><strong>4.2 kg</strong></div>
                    <div><span>次回通院</span><strong>8月18日（ワクチン）</strong></div>
                  </div>
                  <button type="button" class="primary-phone-button" id="pet-hospital-button"><MaterialIcon name="local_hospital" /> 病院へ持参する</button>
                  <div class="settings-group" style="margin-top:14px"><p>このデモについて</p><span>入力内容はこのブラウザだけに保存されます。</span><button type="button" id="reset-pet-demo"><MaterialIcon name="restart_alt" /> デモを初期化する</button></div>
                </div>

                <nav class="phone-nav" aria-label="ペット健康手帳のメニュー">
                  <button type="button" class="is-current" data-pet-nav="home"><MaterialIcon name="home" /><span>ホーム</span></button>
                  <button type="button" data-pet-nav="records"><MaterialIcon name="timeline" /><span>記録</span></button>
                  <button type="button" data-pet-nav="schedule"><MaterialIcon name="calendar_month" /><span>予定</span></button>
                  <button type="button" data-pet-nav="info"><MaterialIcon name="info" /><span>情報</span></button>
                </nav>

                <!-- 記録入力モーダル -->
                <div class="phone-modal" id="pet-record-modal" hidden>
                  <div class="phone-modal__sheet" role="dialog" aria-modal="true" aria-labelledby="pet-record-title">
                    <div class="sheet-handle" aria-hidden="true"></div>
                    <button type="button" class="modal-close" id="pet-record-close" aria-label="記録画面を閉じる"><MaterialIcon name="close" /></button>
                    <p>8月10日（日）</p><h3 id="pet-record-title">今日の様子を記録</h3>
                    <div class="condition-options" role="group" aria-label="今日の様子">
                      <button type="button" class="is-selected" data-condition="元気です"><MaterialIcon name="sentiment_satisfied" /><span>元気</span></button>
                      <button type="button" data-condition="少し気になる"><MaterialIcon name="sentiment_neutral" /><span>ふつう</span></button>
                      <button type="button" data-condition="気になることあり"><MaterialIcon name="sentiment_dissatisfied" /><span>気になる</span></button>
                    </div>
                    <div class="modal-weight-row">
                      <label for="pet-weight-input">体重（任意）</label>
                      <div class="modal-weight-input-wrap">
                        <input type="number" id="pet-weight-input" step="0.1" min="0" max="99" placeholder="4.2" />
                        <span>kg</span>
                      </div>
                    </div>
                    <button type="button" class="modal-save" id="pet-record-save">この内容で記録する</button>
                  </div>
                </div>

                <!-- 病院モーダル -->
                <div class="phone-modal" id="pet-hospital-modal" hidden>
                  <div class="hospital-mode" role="dialog" aria-modal="true" aria-labelledby="hospital-title">
                    <div class="hospital-mode__inner">
                      <p class="hospital-mode__label">病院持参モード</p>
                      <h3 id="hospital-title">ルナ</h3>
                      <p class="hospital-mode__sub">トイプードル・メス・4歳</p>
                      <div class="hospital-allergy">
                        <p><MaterialIcon name="warning" /> アレルギー・禁忌薬</p>
                        <div><span>アレルギー</span><strong>なし</strong></div>
                        <div><span>禁忌薬</span><strong>なし</strong></div>
                      </div>
                      <div class="hospital-stats">
                        <div><span>最終体重</span><strong>4.2 kg</strong></div>
                        <div><span>最終通院</span><strong>2026/07/20</strong></div>
                        <div><span>服用中の薬</span><strong>なし</strong></div>
                        <div><span>次回予定</span><strong>8/18 ワクチン</strong></div>
                      </div>
                      <button type="button" id="pet-hospital-close" class="hospital-close-btn">閉じる</button>
                    </div>
                  </div>
                </div>
              </section>

              <!-- Flow（サブスク管理）-->
              <section class="phone-panel flow-panel" id="flow-panel" role="tabpanel" aria-labelledby="flow-tab" data-app-panel="flow" hidden>
                <div class="status-bar flow-status-bar" aria-hidden="true"><span>9:41</span><span><MaterialIcon name="signal_cellular_alt" /><MaterialIcon name="wifi" /><MaterialIcon name="battery_full" /></span></div>

                <!-- ホーム -->
                <div class="phone-view is-active" data-flow-view="home">
                  <header class="flow-header">
                    <strong class="flow-logo">Flow</strong>
                    <button type="button" class="round-button flow-round-btn" id="flow-trial-bell" aria-label="トライアル期限を確認">
                      <MaterialIcon name="notifications_none" /><i></i>
                    </button>
                  </header>

                  <div class="flow-summary-card">
                    <div class="flow-summary-top">
                      <span>今月の支出</span>
                      <span class="flow-badge">3件登録中</span>
                    </div>
                    <strong class="flow-amount">¥3,978</strong>
                    <span class="flow-yearly">年間換算 ¥47,736</span>
                    <div class="flow-weekly-alert">
                      <i class="flow-dot-warn"></i>
                      <span>今週 2件の請求予定</span>
                      <span class="flow-weekly-total">¥1,970</span>
                    </div>
                  </div>

                  <div class="flow-upcoming-section">
                    <p class="flow-section-label">今週の請求</p>
                    <div class="flow-upcoming-list">
                      <div class="flow-upcoming-card flow-upcoming-urgent">
                        <div class="flow-upcoming-top">
                          <span class="flow-emoji">🎬</span>
                          <span class="flow-due-tag flow-due-urgent">あと3日</span>
                        </div>
                        <span class="flow-upcoming-name">Netflix</span>
                        <strong class="flow-upcoming-price flow-color-video">¥990</strong>
                      </div>
                      <div class="flow-upcoming-card">
                        <div class="flow-upcoming-top">
                          <span class="flow-emoji">🎵</span>
                          <span class="flow-due-tag flow-due-normal">あと5日</span>
                        </div>
                        <span class="flow-upcoming-name">Spotify</span>
                        <strong class="flow-upcoming-price flow-color-music">¥980</strong>
                      </div>
                    </div>
                  </div>

                  <div class="flow-filter-row" role="group" aria-label="カテゴリフィルター">
                    <button class="flow-chip is-active" data-flow-cat="all">すべて</button>
                    <button class="flow-chip" data-flow-cat="video">🎬 動画</button>
                    <button class="flow-chip" data-flow-cat="music">🎵 音楽</button>
                    <button class="flow-chip" data-flow-cat="work">💼 作業</button>
                  </div>

                  <p class="flow-list-title" id="flow-list-title">すべてのサービス（3件）</p>
                  <div class="flow-service-list">
                    <div class="flow-service-card" data-flow-service-cat="video">
                      <span class="flow-service-icon flow-icon-video">🎬</span>
                      <div class="flow-service-info">
                        <strong>Netflix</strong>
                        <small>毎月15日 · クレカ</small>
                      </div>
                      <div class="flow-service-price">
                        <strong>¥990</strong><small>/月</small>
                      </div>
                    </div>
                    <div class="flow-service-card" data-flow-service-cat="music">
                      <span class="flow-service-icon flow-icon-music">🎵</span>
                      <div class="flow-service-info">
                        <strong>Spotify</strong>
                        <small>毎月17日 · 銀行</small>
                      </div>
                      <div class="flow-service-price">
                        <strong>¥980</strong><small>/月</small>
                      </div>
                    </div>
                    <div class="flow-service-card" data-flow-service-cat="work">
                      <span class="flow-service-icon flow-icon-work">💼</span>
                      <div class="flow-service-info">
                        <strong>Adobe CC</strong>
                        <small>毎月26日 · クレカ</small>
                        <span class="flow-trial-tag">⚡ トライアル 残り12日</span>
                      </div>
                      <div class="flow-service-price">
                        <strong>¥2,728</strong><small>/月</small>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- カレンダー -->
                <div class="phone-view" data-flow-view="calendar" hidden>
                  <header class="screen-header flow-screen-header"><div><span>Flow</span><h2>請求カレンダー</h2></div><button type="button" class="round-button flow-round-btn" data-flow-to-home aria-label="ホームへ戻る"><MaterialIcon name="close" /></button></header>
                  <div class="flow-calendar">
                    <div class="flow-cal-header">
                      <span>2026年8月</span>
                    </div>
                    <div class="flow-cal-dow">
                      <span>日</span><span>月</span><span>火</span><span>水</span><span>木</span><span>金</span><span>土</span>
                    </div>
                    <div class="flow-cal-grid">
                      <span></span><span></span><span></span><span></span><span></span><span></span>
                      <button data-flow-day="1">1</button>
                      <button data-flow-day="2">2</button>
                      <button data-flow-day="3">3</button>
                      <button data-flow-day="4">4</button>
                      <button data-flow-day="5">5</button>
                      <button data-flow-day="6">6</button>
                      <button data-flow-day="7">7</button>
                      <button data-flow-day="8">8</button>
                      <button data-flow-day="9">9</button>
                      <button class="flow-cal-today" data-flow-day="10">10</button>
                      <button data-flow-day="11">11</button>
                      <button data-flow-day="12">12</button>
                      <button data-flow-day="13">13</button>
                      <button data-flow-day="14">14</button>
                      <button class="flow-cal-event" data-flow-day="15">15</button>
                      <button data-flow-day="16">16</button>
                      <button class="flow-cal-event" data-flow-day="17">17</button>
                      <button data-flow-day="18">18</button>
                      <button data-flow-day="19">19</button>
                      <button data-flow-day="20">20</button>
                      <button data-flow-day="21">21</button>
                      <button data-flow-day="22">22</button>
                      <button data-flow-day="23">23</button>
                      <button data-flow-day="24">24</button>
                      <button data-flow-day="25">25</button>
                      <button class="flow-cal-event" data-flow-day="26">26</button>
                      <button data-flow-day="27">27</button>
                      <button data-flow-day="28">28</button>
                      <button data-flow-day="29">29</button>
                      <button data-flow-day="30">30</button>
                      <button data-flow-day="31">31</button>
                    </div>
                  </div>
                  <div class="flow-cal-detail">
                    <p id="flow-cal-label" class="flow-cal-label-text">日付をタップすると請求が表示されます</p>
                    <div id="flow-cal-events"></div>
                  </div>
                </div>

                <!-- 分析 -->
                <div class="phone-view" data-flow-view="analytics" hidden>
                  <header class="screen-header flow-screen-header"><div><span>Flow</span><h2>支出分析</h2></div><button type="button" class="round-button flow-round-btn" data-flow-to-home aria-label="ホームへ戻る"><MaterialIcon name="close" /></button></header>
                  <div class="flow-analytics-total">
                    <div>
                      <span>月間合計</span>
                      <strong>¥3,978</strong>
                    </div>
                    <div class="flow-analytics-divider"></div>
                    <div>
                      <span>年間合計</span>
                      <strong class="flow-color-primary">¥47,736</strong>
                    </div>
                  </div>
                  <p class="flow-section-label" style="margin-top:20px">月別支出</p>
                  <div class="flow-bar-chart" aria-label="月別支出グラフ">
                    <div class="flow-bars">
                      <div class="flow-bar" style="--h:42%"><span>3月</span></div>
                      <div class="flow-bar" style="--h:60%"><span>4月</span></div>
                      <div class="flow-bar" style="--h:52%"><span>5月</span></div>
                      <div class="flow-bar" style="--h:75%"><span>6月</span></div>
                      <div class="flow-bar" style="--h:68%"><span>7月</span></div>
                      <div class="flow-bar flow-bar-current" style="--h:100%"><span>8月</span></div>
                    </div>
                  </div>
