---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageContent from '../components/HomepageContent.astro';
import {
  createServiceSchema,
  createWebPageSchema,
  organizationSchema,
  websiteSchema,
} from '../data/structuredData';

const title = "LINE×Salesforce連携構築｜LIFF開発・自動連携の専門窓口｜和-Node";
const description = "LINEで集めた顧客情報をSalesforceへ自動連携。二重入力・対応漏れをなくす仕組みを設計から実装まで一気通貫で構築します。BtoB企業のIT担当者からのご相談歓迎。";
const structuredData = [
  organizationSchema,
  websiteSchema,
  createWebPageSchema({ name: title, description, path: "/" }),
  createServiceSchema({
    name: "LINE×Salesforce連携構築",
    description:
      "LIFF開発・Messaging API・Salesforce連携を一気通貫で構築。設計から実装・テストまで1社で対応します。",
    path: "/pricing/",
    serviceType: "LINE LIFF development and Salesforce integration",
    priceFrom: "400000",
  }),
];
---
<BaseLayout lang="ja" title={title} description={description} structuredData={structuredData}>
  <HomepageContent lang="ja" />
</BaseLayout>
