---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageContent from '../components/HomepageContent.astro';
import {
  createServiceSchema,
  createWebPageSchema,
  organizationSchema,
  websiteSchema,
} from '../data/structuredData';

const title = "LINE連携・iOS/Androidアプリ開発・Web制作｜和-Node";
const description = "LINEとSalesforce・kintone等の連携から、iOS・Androidアプリ、Web・LP制作まで。使う人と現場に合わせて、要件整理・設計・実装・公開を支援します。初回30分の無料相談。";
const structuredData = [
  organizationSchema,
  websiteSchema,
  createWebPageSchema({ name: title, description, path: "/" }),
  createServiceSchema({
    name: "LINE連携構築（Salesforce・kintone・HubSpot等）",
    description:
      "LIFF開発・Messaging API・各種システム連携を一気通貫で構築。設計から実装・テストまで1社で対応します。",
    path: "/pricing/",
    serviceType: "LINE LIFF development and CRM/SFA integration",
    priceFrom: "100000",
  }),
];
---
<BaseLayout lang="ja" title={title} description={description} structuredData={structuredData}>
  <HomepageContent lang="ja" />
</BaseLayout>
