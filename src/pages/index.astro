---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageContent from '../components/HomepageContent.astro';
import {
  createServiceSchema,
  createWebPageSchema,
  organizationSchema,
  websiteSchema,
} from '../data/structuredData';

const title = "LINE連携構築｜Salesforce・kintone・HubSpot・スプレッドシート｜和-Node";
const description = "LINE公式アカウントとSalesforce・kintone・HubSpot・Googleスプレッドシートの連携構築。LINEで受けた申込・問い合わせを業務システムへ自動で登録し、転記や二重入力を減らします。初回30分の無料相談。";
const structuredData = [
  organizationSchema,
  websiteSchema,
  createWebPageSchema({ name: title, description, path: "/" }),
  createServiceSchema({
    name: "LINE連携構築（Salesforce・kintone・HubSpot等）",
    description:
      "LIFF開発・Messaging API・各種システム連携を一気通貫で構築。設計から実装・テストまで1社で対応します。",
    path: "/pricing/",
    serviceType: "LINE LIFF development and CRM/SFA integration",
    priceFrom: "100000",
  }),
];
---
<BaseLayout lang="ja" title={title} description={description} structuredData={structuredData}>
  <HomepageContent lang="ja" />
</BaseLayout>
