---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "ホームページ制作 特別モニター受付終了｜和-Node";
const pageDescription = "和-Nodeの特別モニター企画は受付を終了しました。通常の制作相談は無料相談フォームから承ります。";
---

<BaseLayout title={pageTitle} description={pageDescription} noindex={true}>
  <main id="main" class="closed-page">
    <section class="section">
      <div class="closed-card">
        <p class="eyebrow">Applications Closed</p>
        <h1>特別モニターの受付は終了しました</h1>
        <p>
          このページでご案内していた特別モニター企画は終了しました。
          旧企画の条件による申込みは受け付けておらず、このページから個人情報が外部フォームサービスへ送信されることもありません。
        </p>
        <p>Webサイト・LP制作の通常相談は、現在の料金・対応範囲をご確認のうえ、無料相談フォームからお申し込みください。</p>
        <div class="actions">
          <a href="/pricing/" class="btn secondary">現在の料金・対応範囲を見る</a>
          <a href="/contact/?source=closed_monitor" class="btn primary">無料相談（30分）へ</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .closed-page { min-height: 70vh; background: #fdfcf9; }
  .closed-card { max-width: 760px; margin: 60px auto; padding: 44px; text-align: center; background: #fff; border: 1px solid var(--line); border-radius: 24px; }
  h1 { margin: 12px 0 26px; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.35; }
  .closed-card > p:not(.eyebrow) { line-height: 1.9; }
  .actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  @media (max-width: 600px) { .closed-card { margin: 30px auto; padding: 30px 22px; } .actions { display: grid; } }
</style>
