---
import BaseLayout from '../layouts/BaseLayout.astro';
import MaterialIcon from '../components/MaterialIcon.astro';
import {
  createBreadcrumbSchema,
  createFAQSchema,
  createServiceSchema,
  createWebPageSchema,
  organizationSchema,
} from '../data/structuredData';

const title = "料金・費用の目安｜LINE連携・iOS/Androidアプリ開発｜和-Node";
const description = "LINE連携構築とiOS/Androidアプリ開発の料金目安。Salesforce・kintone・HubSpot等との連携、業務・顧客接点アプリの要件整理から実装・テスト・公開支援まで対応します。初回相談は無料。";

const faqItems = [
  {
    question: "費用の目安を教えてください。",
    answer: "LINE連携は、Salesforce連携40万円〜、kintone連携25万円〜、HubSpot連携20万円〜、Googleスプレッドシート連携10万円〜（いずれも税別）が目安です。iOS・Androidアプリは、小規模業務アプリ80万円〜、顧客向けアプリの初期版150万円〜が目安です。必要な画面数や連携内容を確認したうえで、正式なお見積りをご提示します。",
  },
  {
    question: "何が価格に影響しますか？",
    answer: "LINE連携では、データ項目、LIFF画面、連携先システムの設定状況・API権限が主な変動要因です。アプリでは、画面数、ユーザー種別、ログイン・通知・決済の有無、外部システム連携、ストア公開支援の範囲が費用に影響します。",
  },
  {
    question: "Salesforce以外のシステムでも対応してもらえますか？",
    answer: "Salesforce・kintone・HubSpot・Googleスプレッドシートなど、各種システムとの連携をご相談いただけます。LINE連携だけでなく、業務・顧客接点アプリからこれらのシステムを利用する構成も、要件に応じて検討します。",
  },
  {
    question: "LINEとアプリのどちらが向いていますか？",
    answer: "友だち追加済みの方への案内や簡単なフォームはLINE・LIFFが向いています。毎日使う業務、会員向け機能、複数手順の操作などはアプリが向く場合があります。要件が固まっていない段階でも、目的と使う人を伺って一緒に整理します。",
  },
  {
    question: "App Store・Google Playへの公開も依頼できますか？",
    answer: "公開準備と申請手続きの支援に対応します。Apple・Googleの開発者アカウントは原則としてお客様名義で管理いただき、登録費用・外部サービス利用料は制作費とは別にご負担いただきます。ストア審査の通過そのものは保証できません。",
  },
  {
    question: "初回相談は有料ですか？",
    answer: "初回相談・要件整理は無料で対応しています。ご相談後に必ず契約する必要はありません。",
  },
  {
    question: "開発期間はどれくらいかかりますか？",
    answer: "必要な情報・権限がそろった時点から4〜6週間が目安です。連携先システムのAPI権限や仕様が固まっているほど短くなります。",
  },
];

const structuredData = [
  organizationSchema,
  createWebPageSchema({ name: title, description, path: "/pricing/" }),
  createBreadcrumbSchema([
    { name: "ホーム", path: "/" },
    { name: "料金・費用の目安", path: "/pricing/" },
  ]),
  createServiceSchema({
    name: "LINE連携構築（Salesforce・kintone・HubSpot等）",
    description: "LIFF開発・Messaging API・各種システム連携を一気通貫で構築。設計から実装・テストまで1社で対応します。",
    path: "/pricing/",
    serviceType: "LINE LIFF development and CRM/SFA integration",
    priceFrom: "100000",
  }),
  createServiceSchema({
    name: "業務・顧客接点アプリ開発（iOS / Android）",
    description: "業務利用・顧客接点に必要なiOS・Androidアプリを、要件整理、画面設計、実装、実機テスト、公開準備まで対応します。",
    path: "/pricing/",
    serviceType: "iOS and Android business application development",
    priceFrom: "800000",
  }),
  createFAQSchema(faqItems),
];

const includes = [
  { icon: "handshake", text: "要件定義・ヒアリング" },
  { icon: "architecture", text: "API設計・システム設計" },
  { icon: "code", text: "実装（LIFF開発 / 各システム連携設定 / Messaging API）" },
  { icon: "phone_iphone", text: "実機テスト（iOS・Android LINE アプリ）" },
  { icon: "rocket_launch", text: "本番移行・運用引継ぎメモ" },
];

const appIncludes = [
  { icon: "handshake", text: "要件整理・利用者と業務フローの確認" },
  { icon: "dashboard", text: "画面構成・操作導線の設計" },
  { icon: "phone_iphone", text: "iOS・Android向けアプリ実装" },
  { icon: "sync_alt", text: "必要に応じた既存システム・API連携" },
  { icon: "fact_check", text: "実機テスト・公開準備・引継ぎメモ" },
];

const priceFactors = [
  "連携するデータ項目の種類と数",
  "LIFF画面（LINEアプリ内ページ）の有無と画面数",
  "連携先システムの設定状況・API権限",
];

const appPriceFactors = [
  "画面数・利用者の種類・主要な業務フローの数",
  "ログイン、通知、カメラ、決済などの機能",
  "連携先システム・API・既存データの状態",
  "App Store・Google Play公開支援と公開後の保守範囲",
];

const canDo = [
  "LINEアプリ内で動くフォーム・ページ（LIFF）の開発",
  "Messaging API による自動メッセージ送信の設定",
  "Salesforce・kintone・HubSpot・Googleスプレッドシート等へのREST API連携",
  "連携に必要な範囲のシステム設定（カスタム項目・APIユーザー設定等）",
  "実機テスト・本番移行・引継ぎドキュメント作成",
  "業務・顧客接点向けのiOS・Androidアプリ開発",
  "アプリからの既存システム・API連携",
  "ストア公開準備・申請手続きの支援",
];

const cannotDo = [
  "Salesforce ApexによるSalesforceカスタム開発・大規模改修",
  "各システムの新規導入・ライセンス手配",
  "LINE公式アカウントの運用代行・広告配信",
  "App Store・Google Playの審査通過保証",
  "Apple・Google開発者アカウント費用や外部サービス利用料の立替",
  "医療・金融など、高度な規制対応を要するアプリの単独判断",
];
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <main id="main" class="pricing-page" data-glossary-skip>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-inner">
        <p class="eyebrow">Pricing</p>
        <h1 class="page-heading">料金・費用の目安</h1>
        <p class="lead">LINE連携と、iOS・Androidアプリ開発の費用目安をご案内します。<br>どの手段が合うかの整理から、初回無料でご相談いただけます。</p>
      </div>
    </section>

    <!-- 手段の選び方 -->
    <section class="section" aria-labelledby="choice-heading">
      <div class="section-inner">
        <p class="section-kicker">Choose the right channel</p>
        <h2 id="choice-heading" class="section-heading">LINE・Web・アプリ。目的から選べます。</h2>
        <div class="choice-grid">
          <article class="choice-card">
            <MaterialIcon name="chat" />
            <h3>LINE・LIFF</h3>
            <p>友だち追加済みの方へ案内する、簡単なフォームを届ける、既存システムへ情報をつなぐ場合。</p>
          </article>
          <article class="choice-card">
            <MaterialIcon name="language" />
            <h3>Webサイト・LP</h3>
            <p>初めて訪れる方へ、サービス・料金・相談方法を分かりやすく伝える場合。</p>
          </article>
          <article class="choice-card">
            <MaterialIcon name="phone_iphone" />
            <h3>iOS・Androidアプリ</h3>
            <p>毎日使う業務、会員向け機能、複数手順の操作を分かりやすくまとめる場合。</p>
          </article>
        </div>
        <p class="choice-note">どれが合うか決まっていない場合も、利用者・目的・今の業務をもとに整理します。</p>
      </div>
    </section>

    <!-- 料金カード -->
    <section class="section" aria-labelledby="price-card-heading">
      <div class="section-inner">
        <div class="price-card">
          <h2 id="price-card-heading" class="price-card__title">LINE連携構築 料金目安</h2>
          <p class="price-card__includes">要件定義・設計・実装・テストを含みます。</p>
          <div class="price-tiers">
            <div class="price-tier">
              <span class="price-tier__label">Salesforce連携</span>
              <span class="price-tier__price">40万円〜<small>（税別）</small></span>
            </div>
            <div class="price-tier">
              <span class="price-tier__label">kintone連携</span>
              <span class="price-tier__price">25万円〜<small>（税別）</small></span>
            </div>
            <div class="price-tier">
              <span class="price-tier__label">HubSpot連携</span>
              <span class="price-tier__price">20万円〜<small>（税別）</small></span>
            </div>
            <div class="price-tier">
              <span class="price-tier__label">Googleスプレッドシート連携</span>
              <span class="price-tier__price">10万円〜<small>（税別）</small></span>
            </div>
          </div>

          <div class="price-card__details">
            <h3 class="price-card__sub-heading">含まれるもの</h3>
            <ul class="price-card__list">
              {includes.map(item => (
                <li>
                  <MaterialIcon name={item.icon} />
                  <span>{item.text}</span>
                </li>
              ))}
            </ul>

            <h3 class="price-card__sub-heading">価格に影響する要素</h3>
            <ul class="price-card__factors">
              {priceFactors.map(text => (
                <li>
                  <MaterialIcon name="tune" />
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </div>

          <p class="price-card__note">正式なお見積りは、要件をヒアリングしたうえでご提示します。</p>
          <a href="/contact/" class="cta-button">無料で費用感を聞く</a>
        </div>
      </div>
    </section>

    <!-- アプリ開発料金カード -->
    <section class="section section--alt" aria-labelledby="app-price-card-heading">
      <div class="section-inner">
        <div class="price-card price-card--app">
          <p class="service-kicker"><MaterialIcon name="phone_iphone" /> iOS / Android App</p>
          <h2 id="app-price-card-heading" class="price-card__title">業務・顧客接点アプリ開発 料金目安</h2>
          <p class="price-card__includes">日常的に使う業務や、会員・予約などの顧客接点をアプリとして整える初期版の目安です。</p>
          <div class="price-tiers">
            <div class="price-tier">
              <span class="price-tier__label">小規模業務アプリ</span>
              <span class="price-tier__price">80万円〜<small>（税別）</small></span>
            </div>
            <div class="price-tier">
              <span class="price-tier__label">顧客向けアプリ MVP</span>
              <span class="price-tier__price">150万円〜<small>（税別）</small></span>
            </div>
            <div class="price-tier">
              <span class="price-tier__label">ストア公開支援</span>
              <span class="price-tier__price">15万円〜<small>（税別）</small></span>
            </div>
          </div>

          <div class="price-card__details">
            <h3 class="price-card__sub-heading">含まれるもの</h3>
            <ul class="price-card__list">
              {appIncludes.map(item => (
                <li>
                  <MaterialIcon name={item.icon} />
                  <span>{item.text}</span>
                </li>
              ))}
            </ul>

            <h3 class="price-card__sub-heading">価格に影響する要素</h3>
            <ul class="price-card__factors">
              {appPriceFactors.map(text => (
                <li>
                  <MaterialIcon name="tune" />
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </div>

          <p class="price-card__note">Apple・Googleの開発者アカウント費、クラウド・外部APIなどの利用料は制作費に含まれません。公開後の保守は内容に応じて別途お見積りします。</p>
          <a href="/contact/?source=pricing_app" class="cta-button">アプリ化の費用感を聞く</a>
        </div>
      </div>
    </section>

    <!-- 対応範囲 -->
    <section class="section section--alt" aria-labelledby="scope-heading">
      <div class="section-inner">
        <h2 id="scope-heading" class="section-heading">対応できること・できないこと</h2>
        <div class="scope-grid">
          <div class="scope-col scope-col--can">
            <h3 class="scope-col__heading scope-col__heading--can">
              <MaterialIcon name="check_circle" />
              対応できる
            </h3>
            <ul class="scope-list">
              {canDo.map(text => (
                <li>
                  <MaterialIcon name="check" class="icon-can" />
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="scope-col scope-col--cannot">
            <h3 class="scope-col__heading scope-col__heading--cannot">
              <MaterialIcon name="cancel" />
              対応できない
            </h3>
            <ul class="scope-list">
              {cannotDo.map(text => (
                <li>
                  <MaterialIcon name="close" class="icon-cannot" />
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-labelledby="faq-heading">
      <div class="section-inner">
        <h2 id="faq-heading" class="section-heading">よくあるご質問</h2>
        <dl class="faq-list">
          {faqItems.map(item => (
            <div class="faq-item">
              <dt class="faq-q">
                <MaterialIcon name="help" class="faq-icon" />
                {item.question}
              </dt>
              <dd class="faq-a">{item.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="section section--cta" aria-labelledby="cta-heading">
      <div class="section-inner cta-inner">
        <h2 id="cta-heading" class="cta-heading">まずは、30分の無料相談。</h2>
        <p class="cta-lead">費用感だけでも知りたい方、要件がまだ固まっていない方、<br class="sp-hide">お気軽にご相談ください。</p>
        <a href="/contact/" class="cta-button cta-button--large">無料相談を予約する</a>
        <p class="cta-note">返信は営業日2日以内 / 相談後の契約義務はありません</p>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* ---- Layout ---- */
  .pricing-page {
    color: var(--text);
  }

  .section {
    padding: 4rem 1.5rem;
  }

  .section--alt {
    background: var(--surface-muted);
  }

  .section-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    text-align: center;
    margin: 0 0 2.5rem;
    color: var(--trust);
  }

  /* ---- Hero ---- */
  .hero {
    background: var(--trust);
    color: var(--white);
    padding: 5rem 1.5rem 3.5rem;
    text-align: center;
  }

  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.75;
    margin: 0 0 0.75rem;
  }

  .page-heading {
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 1.25rem;
    line-height: 1.3;
  }

  .lead {
    font-size: 1.05rem;
    line-height: 1.8;
    opacity: 0.92;
    margin: 0;
  }

  /* ---- Price Card ---- */
  .price-card {
    background: var(--white);
    border: 2px solid var(--trust);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow);
    text-align: center;
  }

  .price-card--app {
    border-color: #4f8c79;
  }

  .service-kicker,
  .section-kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0 0 0.65rem;
    color: #3f7867;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-kicker .material-icon {
    font-size: 1rem;
  }

  .price-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--trust);
    margin: 0 0 0.75rem;
  }

  .price-card__includes {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0 0 1.25rem;
    font-weight: 700;
  }

  .price-tiers {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 1.5rem;
    border: 1px solid var(--trust);
    border-radius: 8px;
    overflow: hidden;
  }

  .price-tier {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid rgba(15, 76, 92, 0.15);
    gap: 1rem;
  }

  .price-tier:last-child {
    border-bottom: none;
  }

  .price-tier:first-child {
    background: rgba(15, 76, 92, 0.04);
  }

  .price-tier__label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--trust);
    flex-shrink: 0;
  }

  .price-tier__price {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-deep, #1a1a1a);
    line-height: 1;
    text-align: right;
  }

  .price-tier__price small {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--muted);
    margin-left: 2px;
  }

  .price-card__details {
    text-align: left;
    margin-bottom: 1.5rem;
  }

  .price-card__sub-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    margin: 1.5rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }

  .price-card__list,
  .price-card__factors {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .price-card__list li,
  .price-card__factors li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .price-card__list li .material-icon,
  .price-card__factors li .material-icon {
    color: var(--trust);
    font-size: 1.2rem;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .price-card__note {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 1rem 0 1.5rem;
  }

  .choice-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .choice-card {
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }

  .choice-card .material-icon {
    color: var(--trust);
    font-size: 1.8rem;
  }

  .choice-card h3 {
    margin: 0.8rem 0 0.45rem;
    color: var(--trust);
    font-size: 1.05rem;
  }

  .choice-card p,
  .choice-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .choice-note {
    margin-top: 1rem;
    text-align: center;
  }

  /* ---- CTA Button ---- */
  .cta-button {
    display: inline-block;
    background: var(--trust);
    color: var(--white);
    font-size: 1rem;
    font-weight: 700;
    padding: 0.9rem 2.25rem;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s, box-shadow 0.2s;
  }

  .cta-button:hover {
    background: var(--trust-mid);
    box-shadow: var(--shadow-hover);
  }

  .cta-button--large {
    font-size: 1.1rem;
    padding: 1rem 2.75rem;
  }

  /* ---- Scope Grid ---- */
  .scope-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .scope-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .choice-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .scope-col {
    background: var(--white);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-soft);
  }

  .scope-col__heading {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }

  .scope-col__heading--can {
    color: var(--trust);
  }

  .scope-col__heading--can .material-icon {
    color: var(--trust);
  }

  .scope-col__heading--cannot {
    color: var(--muted);
  }

  .scope-col__heading--cannot .material-icon {
    color: var(--muted);
  }

