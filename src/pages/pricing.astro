---
import BaseLayout from '../layouts/BaseLayout.astro';
import MaterialIcon from '../components/MaterialIcon.astro';
import {
  createBreadcrumbSchema,
  createFAQSchema,
  createServiceSchema,
  createWebPageSchema,
  organizationSchema,
} from '../data/structuredData';

const title = "料金・費用の目安｜LINE×Salesforce連携構築｜和-Node";
const description = "LINE×Salesforce連携構築の料金目安は40万円〜（税別）。要件定義・設計・実装・テストを含みます。初回相談は無料。費用の詳細はお気軽にご相談ください。";

const faqItems = [
  {
    question: "費用の目安を教えてください。",
    answer: "LINE×Salesforce連携構築は40万円〜（税別）が目安です。要件定義・設計・実装・テストを含みます。連携するデータの種類や画面数により変動するため、まずヒアリングで範囲を確認したうえでお見積りします。",
  },
  {
    question: "何が価格に影響しますか？",
    answer: "連携するSalesforceオブジェクト・データ項目の種類と数、LIFF画面（LINEアプリ内ページ）の有無と画面数、既存Salesforce環境の設定状況が主な変動要因です。",
  },
  {
    question: "Salesforceを導入していないと依頼できませんか？",
    answer: "Salesforceを導入済み、またはこれから導入予定の企業を対象としています。LINE公式アカウントはお持ちであれば問題ありません。",
  },
  {
    question: "初回相談は有料ですか？",
    answer: "初回相談・要件整理は無料で対応しています。ご相談後に必ず契約する必要はありません。",
  },
  {
    question: "開発期間はどれくらいかかりますか？",
    answer: "必要な情報・権限がそろった時点から4〜6週間が目安です。SalesforceのAPI権限やオブジェクト仕様が固まっているほど短くなります。",
  },
];

const structuredData = [
  organizationSchema,
  createWebPageSchema({ name: title, description, path: "/pricing/" }),
  createBreadcrumbSchema([
    { name: "ホーム", path: "/" },
    { name: "料金・費用の目安", path: "/pricing/" },
  ]),
  createServiceSchema({
    name: "LINE × Salesforce 連携構築",
    description: "LIFF開発・Messaging API・Salesforce連携を一気通貫で構築。設計から実装・テストまで1社で対応します。",
    path: "/pricing/",
    serviceType: "LINE LIFF development and Salesforce integration",
    priceFrom: "400000",
  }),
  createFAQSchema(faqItems),
];

const includes = [
  { icon: "handshake", text: "要件定義・ヒアリング" },
  { icon: "architecture", text: "API設計・システム設計" },
  { icon: "code", text: "実装（LIFF開発 / Salesforce連携設定 / Messaging API）" },
  { icon: "phone_iphone", text: "実機テスト（iOS・Android LINE アプリ）" },
  { icon: "rocket_launch", text: "本番移行・運用引継ぎメモ" },
];

const priceFactors = [
  "連携するSalesforceオブジェクト・データ項目の種類と数",
  "LIFF画面（LINEアプリ内ページ）の有無と画面数",
  "既存Salesforce環境の設定状況",
];

const canDo = [
  "LINEアプリ内で動くフォーム・ページ（LIFF）の開発",
  "Messaging API による自動メッセージ送信の設定",
  "SalesforceへのREST API連携（リード・取引先・カスタムオブジェクト）",
  "必要範囲のSalesforceカスタム項目・APIユーザー設定",
  "実機テスト・本番移行・引継ぎドキュメント作成",
];

const cannotDo = [
  "ApexによるSalesforceカスタム開発",
  "Salesforceの新規導入・ライセンス手配",
  "LINE公式アカウントの運用代行・広告配信",
  "予算40万円未満の案件",
];
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <main id="main" class="pricing-page" data-glossary-skip>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-inner">
        <p class="eyebrow">Pricing</p>
        <h1 class="page-heading">料金・費用の目安</h1>
        <p class="lead">LINE × Salesforce 連携構築の費用目安をご案内します。<br>初回のご相談・要件整理は無料です。</p>
      </div>
    </section>

    <!-- 料金カード -->
    <section class="section" aria-labelledby="price-card-heading">
      <div class="section-inner">
        <div class="price-card">
          <h2 id="price-card-heading" class="price-card__title">LINE × Salesforce 連携構築</h2>
          <p class="price-card__price"><span class="price-card__number">40</span><span class="price-card__unit">万円〜<small>（税別）</small></span></p>

          <div class="price-card__details">
            <h3 class="price-card__sub-heading">含まれるもの</h3>
            <ul class="price-card__list">
              {includes.map(item => (
                <li>
                  <MaterialIcon name={item.icon} />
                  <span>{item.text}</span>
                </li>
              ))}
            </ul>

            <h3 class="price-card__sub-heading">価格に影響する要素</h3>
            <ul class="price-card__factors">
              {priceFactors.map(text => (
                <li>
                  <MaterialIcon name="tune" />
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </div>

          <p class="price-card__note">正式なお見積りは、要件をヒアリングしたうえでご提示します。</p>
          <a href="/contact/" class="cta-button">無料で費用感を聞く</a>
        </div>
      </div>
    </section>

    <!-- 対応範囲 -->
    <section class="section section--alt" aria-labelledby="scope-heading">
      <div class="section-inner">
        <h2 id="scope-heading" class="section-heading">対応できること・できないこと</h2>
        <div class="scope-grid">
          <div class="scope-col scope-col--can">
            <h3 class="scope-col__heading scope-col__heading--can">
              <MaterialIcon name="check_circle" />
              対応できる
            </h3>
            <ul class="scope-list">
              {canDo.map(text => (
                <li>
                  <MaterialIcon name="check" class="icon-can" />
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="scope-col scope-col--cannot">
            <h3 class="scope-col__heading scope-col__heading--cannot">
              <MaterialIcon name="cancel" />
              対応できない
            </h3>
            <ul class="scope-list">
              {cannotDo.map(text => (
                <li>
                  <MaterialIcon name="close" class="icon-cannot" />
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-labelledby="faq-heading">
      <div class="section-inner">
        <h2 id="faq-heading" class="section-heading">よくあるご質問</h2>
        <dl class="faq-list">
          {faqItems.map(item => (
            <div class="faq-item">
              <dt class="faq-q">
                <MaterialIcon name="help" class="faq-icon" />
                {item.question}
              </dt>
              <dd class="faq-a">{item.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- CTA -->
    <section class="section section--cta" aria-labelledby="cta-heading">
      <div class="section-inner cta-inner">
        <h2 id="cta-heading" class="cta-heading">まずは、30分の無料相談。</h2>
        <p class="cta-lead">費用感だけでも知りたい方、要件がまだ固まっていない方、<br class="sp-hide">お気軽にご相談ください。</p>
        <a href="/contact/" class="cta-button cta-button--large">無料相談を予約する</a>
        <p class="cta-note">返信は営業日2日以内 / 相談後の契約義務はありません</p>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* ---- Layout ---- */
  .pricing-page {
    color: var(--text);
  }

  .section {
    padding: 4rem 1.5rem;
  }

  .section--alt {
    background: var(--surface-muted);
  }

  .section-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    text-align: center;
    margin: 0 0 2.5rem;
    color: var(--trust);
  }

  /* ---- Hero ---- */
  .hero {
    background: var(--trust);
    color: var(--white);
    padding: 5rem 1.5rem 3.5rem;
    text-align: center;
  }

  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.75;
    margin: 0 0 0.75rem;
  }

  .page-heading {
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 1.25rem;
    line-height: 1.3;
  }

  .lead {
    font-size: 1.05rem;
    line-height: 1.8;
    opacity: 0.92;
    margin: 0;
  }

  /* ---- Price Card ---- */
  .price-card {
    background: var(--white);
    border: 2px solid var(--trust);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow);
    text-align: center;
  }

  .price-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--trust);
    margin: 0 0 1.25rem;
  }

  .price-card__price {
    margin: 0 0 2rem;
    line-height: 1;
  }

  .price-card__number {
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--trust);
    letter-spacing: -0.02em;
  }

  .price-card__unit {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--muted);
    margin-left: 0.25rem;
  }

  .price-card__unit small {
    font-weight: 400;
    font-size: 0.9rem;
  }

  .price-card__details {
    text-align: left;
    margin-bottom: 1.5rem;
  }

  .price-card__sub-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    margin: 1.5rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }

  .price-card__list,
  .price-card__factors {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .price-card__list li,
  .price-card__factors li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .price-card__list li .material-icon,
  .price-card__factors li .material-icon {
    color: var(--trust);
    font-size: 1.2rem;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .price-card__note {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 1rem 0 1.5rem;
  }

  /* ---- CTA Button ---- */
  .cta-button {
    display: inline-block;
    background: var(--trust);
    color: var(--white);
    font-size: 1rem;
    font-weight: 700;
    padding: 0.9rem 2.25rem;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s, box-shadow 0.2s;
  }

  .cta-button:hover {
    background: var(--trust-mid);
    box-shadow: var(--shadow-hover);
  }

  .cta-button--large {
    font-size: 1.1rem;
    padding: 1rem 2.75rem;
  }

  /* ---- Scope Grid ---- */
  .scope-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .scope-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .scope-col {
    background: var(--white);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-soft);
  }

  .scope-col__heading {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }

  .scope-col__heading--can {
    color: var(--trust);
  }

  .scope-col__heading--can .material-icon {
    color: var(--trust);
  }

  .scope-col__heading--cannot {
    color: var(--muted);
  }

  .scope-col__heading--cannot .material-icon {
    color: var(--muted);
  }

  .scope-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .scope-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.45rem 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .scope-list li .material-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .icon-can {
    color: var(--trust);
  }

  .icon-cannot {
    color: #b0a8a0;
  }

  /* ---- FAQ ---- */
  .faq-list {
    margin: 0;
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
    padding: 1.25rem 0;
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-q {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
  }

  .faq-icon {
    color: var(--trust);
    font-size: 1.2rem;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .faq-a {
    margin: 0.5rem 0 0 1.7rem;
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--muted);
  }

  /* ---- CTA Section ---- */
  .section--cta {
    background: var(--trust);
    color: var(--white);
    text-align: center;
    padding: 4.5rem 1.5rem;
  }

  .cta-inner {
    max-width: 600px;
  }

  .cta-heading {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0 0 1rem;
  }

  .cta-lead {
    font-size: 1rem;
    line-height: 1.8;
    opacity: 0.92;
    margin: 0 0 2rem;
  }

  .section--cta .cta-button {
    background: var(--white);
    color: var(--trust);
  }

  .section--cta .cta-button:hover {
    background: var(--surface-muted);
    box-shadow: var(--shadow-hover);
  }

  .cta-note {
    font-size: 0.8rem;
    opacity: 0.7;
    margin: 1rem 0 0;
  }

  /* ---- Responsive ---- */
  @media (min-width: 768px) {
    .page-heading {
      font-size: 2.5rem;
    }

    .hero {
      padding: 6rem 2rem 4rem;
    }

    .section {
      padding: 5rem 2rem;
    }

    .cta-heading {
      font-size: 1.8rem;
    }
  }

  .sp-hide {
    display: none;
  }

  @media (min-width: 640px) {
    .sp-hide {
      display: inline;
    }
  }
</style>
