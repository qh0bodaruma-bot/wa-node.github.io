---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingContent from '../components/PricingContent.astro';
import { createBreadcrumbSchema, createServiceSchema, createWebPageSchema, organizationSchema } from '../data/structuredData';
import { servicePrices } from '../data/services';
const title = "支援内容・料金と対応範囲｜和-Node";
const description = "AX・DXによる業務改善、ICT活用、LINE連携・アプリ開発の支援内容。作業範囲とお見積りの考え方、個別の開発料金をご案内します。";
const structuredData = [organizationSchema, createWebPageSchema({name:title,description,path:'/pricing/'}),createBreadcrumbSchema([{name:'ホーム',path:'/'},{name:'料金・対応範囲',path:'/pricing/'}]),createServiceSchema({name:'LINE連携構築',description:'LINEと業務システムの連携設計・実装・テスト・公開支援。',path:'/pricing/#line',serviceType:'LINE integration',priceFrom:String(servicePrices.lineSheets)}),createServiceSchema({name:'iOS・Androidアプリ開発',description:'業務・顧客向けアプリの設計・開発・実機確認・公開準備。',path:'/pricing/#app',serviceType:'Mobile application development',priceFrom:String(servicePrices.businessApp)})];
---
<BaseLayout title={title} description={description} structuredData={structuredData}><PricingContent lang="ja"/></BaseLayout>
