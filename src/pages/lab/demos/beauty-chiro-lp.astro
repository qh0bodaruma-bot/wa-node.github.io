---
import BaseLayout from '../../../layouts/BaseLayout.astro';

/*
  美容カイロLP ひな形（Claude Design「美容カイロLP ワイヤーフレーム」3a 確定版フレームの実装）
  - 出典ワイヤーフレーム: Claude Design project 77482def-70b6-4861-b3a2-736de7f76bbf / 3a
  - 用途: 複数の施術院で写真・院名・料金を差し替えて使うひな形
  - 制約: JavaScript非依存 / 常時アニメーションなし / AI生成画像なし
  - 差し替え箇所は下の shop・content にまとめてあり、ここだけ編集すれば1院分が完成する
*/

const title = '美容カイロLP ひな形｜和-Node 制作用';
const description =
  '美容カイロプラクティック向けランディングページのひな形。院名・写真・料金を差し替えて使う制作用のフレームです。';

// ── 差し替え枠：院ごとの情報 ─────────────────────────────
const shop = {
  name: '○○○○院',
  nameEn: 'BEAUTY CHIROPRACTIC',
  tel: '00-0000-0000',
  telHref: 'tel:0000000000',
  reserveHref: '#reserve',
  address: '○○県○○市○○ 0-0-0 ○○ビル 0F',
  access: '○○線 ○○駅 徒歩0分／駐車場0台',
  hours: '00:00〜00:00（最終受付 00:00）',
  closed: '○曜日・祝日',
};

// ── 差し替え枠：本文 ─────────────────────────────────────
const assurances = [
  { title: 'カウンセリングから始めます', body: 'いきなり施術には入りません。今の状態とご希望をうかがってから進めます。' },
  { title: '施術内容は事前にご説明', body: '何を、どこまで行うのかをお伝えし、ご納得いただいてから始めます。' },
  { title: '着替え・お荷物のご用意あり', body: 'お仕事帰りや外出のついでにも立ち寄っていただけます。' },
];

const firstVisitThree = [
  { no: '01', title: 'お話をうかがう', body: '気になっていること、普段の姿勢や過ごし方をお聞きします。' },
  { no: '02', title: '身体の状態を確認する', body: '立ち姿勢や動きを見ながら、今の状態を一緒に確認します。' },
  { no: '03', title: '今日できることを行う', body: 'その日の状態に合わせて、無理のない範囲で施術を行います。' },
];

const forWhom = [
  '鏡や写真で、姿勢や顔まわりの左右差が気になる方',
  'デスクワークや育児で、同じ姿勢が続きやすい方',
  '身体の土台から整えたいと考えている方',
];

const beforeConsult = [
  '妊娠中の方、通院中・投薬中の方',
  '過去に手術を受けた部位がある方',
  '当日に強い痛みや発熱がある方',
];

const flowSteps = [
  { title: 'ご予約', body: 'お電話またはご予約フォームから、ご希望の日時をお知らせください。' },
  { title: 'ご来店・受付', body: 'カウンセリングシートにご記入いただきます。' },
  { title: 'カウンセリング', body: '気になっていることと、ご希望をうかがいます。' },
  { title: '施術', body: 'その日の状態に合わせて進めます。' },
  { title: 'ご説明・お会計', body: '今日行ったことと、ご自宅でできることをお伝えします。' },
];

const voices = [
  { who: '40代・女性', body: '何をするのか先に説明してもらえたので、初回でも身構えずに済みました。' },
  { who: '30代・女性', body: '姿勢のことを相談できる場所が近くにあるのは、思っていたより気が楽です。' },
  { who: '50代・女性', body: '毎日の座り方についても具体的に教えてもらえました。' },
];

const faqs = [
  { q: '初めてでも大丈夫ですか。', a: 'はじめての方が多くお越しになります。カウンセリングから始めますので、当日にご相談いただければ大丈夫です。' },
  { q: 'どんな服装で行けばよいですか。', a: '動きやすい服装をおすすめしています。お着替えのご用意もありますので、お仕事帰りでもお越しいただけます。' },
  { q: 'どのくらいの時間がかかりますか。', a: '初回はカウンセリングを含めてお時間をいただきます。目安はご予約時にお伝えします。' },
  { q: '痛みはありますか。', a: '強い刺激を無理に加えることはありません。気になる点はその場でお伝えください。' },
];
---

<BaseLayout title={title} description={description} noindex={true} showSiteChrome={false}>
  {/* data-reveal="off": BaseLayout の共通スクロール表示スクリプトが .bclp-card を
      自動で対象にしてしまうため除外する。このLPはJavaScript非依存を条件にしている。 */}
  <div class="bclp" data-reveal="off">
    <p class="bclp-notice">
      このページは制作用のひな形です。院名・写真・料金・お客様の声は差し替え前提の枠として配置しています。
    </p>

    <!-- ヘッダー -->
    <header class="bclp-head">
      <a class="bclp-brand" href="#top">
        <span class="bclp-brand-name">{shop.name}</span>
        <span class="bclp-kick">{shop.nameEn}</span>
      </a>

      <nav class="bclp-nav" aria-label="ページ内メニュー">
        <a href="#first">はじめての方</a>
        <a href="#care">施術</a>
        <a href="#price">料金</a>
        <a href="#flow">流れ</a>
        <a href="#faq">FAQ</a>
        <a href="#access">アクセス</a>
      </nav>

      <div class="bclp-head-cta">
        <a class="bclp-btn bclp-btn-tel" href={shop.telHref}>お電話</a>
        <a class="bclp-btn bclp-btn-fill" href={shop.reserveHref}>ご予約</a>
      </div>

      <details class="bclp-menu">
        <summary aria-label="メニューを開く"><span class="bclp-menu-bars" aria-hidden="true"></span></summary>
        <nav class="bclp-menu-list" aria-label="ページ内メニュー（モバイル）">
          <a href="#first">はじめての方</a>
          <a href="#care">施術</a>
          <a href="#price">料金</a>
          <a href="#flow">流れ</a>
          <a href="#faq">FAQ</a>
          <a href="#access">アクセス</a>
        </nav>
      </details>
    </header>

    <main id="top">
      <!-- 01 ファーストビュー -->
      <section class="bclp-fv">
        <div class="bclp-ph bclp-fv-photo" role="img" aria-label="院の雰囲気がわかる横長の支給写真">
          <span>01 FV：支給写真（横長・院の雰囲気）</span>
        </div>
        <div class="bclp-fv-inner">
          <div class="bclp-card bclp-fv-card">
            <span class="bclp-kick">はじめての方へ</span>
            <h1 class="bclp-h1">身体の土台を整えて、<br />毎日の見え方をすこし変える</h1>
            <p class="bclp-lead">
              姿勢や身体の使い方から見直していく、美容カイロプラクティックです。まずはお話をうかがうところから始めます。
            </p>
            <div class="bclp-fv-btns">
              <a class="bclp-btn bclp-btn-fill bclp-btn-lg" href={shop.reserveHref}>初回のご相談</a>
              <a class="bclp-btn bclp-btn-line bclp-btn-lg" href="#care">施術を見る</a>
            </div>
          </div>
          <div class="bclp-ill bclp-fv-ill" role="img" aria-label="姿勢のイラスト差し替え枠">イラスト</div>
        </div>
      </section>

      <!-- 来店判断の情報を先出し -->
      <section class="bclp-sec bclp-info">
        <ul class="bclp-info-list">
          <li class="bclp-card">
            <span class="bclp-kick">OPEN</span>
            <p class="bclp-info-main">{shop.hours}</p>
            <p class="bclp-note">定休日：{shop.closed}</p>
          </li>
          <li class="bclp-card">
            <span class="bclp-kick">ACCESS</span>
            <p class="bclp-info-main">{shop.access}</p>
            <p class="bclp-note">詳しい行き方はページ下部に掲載</p>
          </li>
          <li class="bclp-card">
            <span class="bclp-kick">TEL</span>
            <p class="bclp-info-main"><a href={shop.telHref}>{shop.tel}</a></p>
            <p class="bclp-note">ご予約フォームからも承ります</p>
          </li>
        </ul>
      </section>

      <!-- 02 安心材料 -->
      <section class="bclp-sec" id="first">
        <p class="bclp-num">02</p>
        <h2 class="bclp-h2">はじめての方に、先にお伝えしていること</h2>
        <ul class="bclp-cards-3">
          {assurances.map((item) => (
            <li class="bclp-card bclp-card-center">
              <span class="bclp-ill bclp-ill-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3.5 5 6.5v5c0 4 3 7.4 7 9 4-1.6 7-5 7-9v-5Z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              </span>
              <h3 class="bclp-h3">{item.title}</h3>
              <p class="bclp-body">{item.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- 03 違和感 -->
      <section class="bclp-band">
        <div class="bclp-band-inner">
          <p class="bclp-num">03</p>
          <h2 class="bclp-h2">鏡や写真を見たときの、あの違和感</h2>
          <div class="bclp-pair">
            <div class="bclp-ph bclp-ph-wide" role="img" aria-label="姿勢が分かる支給写真">
              <span>姿勢</span>
            </div>
            <div class="bclp-pair-text">
              <p class="bclp-body">
                写真に写った自分の姿勢が、思っていたより傾いていた。左右で顔まわりの印象が違う気がする。
                そうした違和感は、多くの場合その部分だけの問題ではありません。
              </p>
              <p class="bclp-body">
                立ち方・座り方・毎日くり返している動作。身体の土台にあたる部分が、見え方に関わっています。
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- 04 美容カイロの考え方 -->
      <section class="bclp-band bclp-band-blue" id="care">
        <div class="bclp-band-inner">
          <p class="bclp-num">04</p>
          <h2 class="bclp-h2">美容カイロプラクティックの考え方</h2>
          <div class="bclp-pair bclp-pair-rev">
            <div class="bclp-pair-text">
              <p class="bclp-body">
                顔まわりだけを扱うのではなく、身体全体の土台から見ていきます。骨格や姿勢のバランスを整えることと、
                日々の習慣を見直すことを、同じ流れの中で考えます。
              </p>
              <p class="bclp-body">
                一度で変わるものではありません。だからこそ、ご自宅でできることも一緒にお伝えしています。
              </p>
              <p class="bclp-note">※ 施術は医療行為ではありません。診断・治療を目的とするものではありません。</p>
            </div>
            <div class="bclp-ill bclp-ill-box" role="img" aria-label="考え方を説明する図解イラスト差し替え枠">図解イラスト</div>
          </div>
        </div>
      </section>

      <!-- 05 初回に行う3つのこと -->
      <section class="bclp-sec">
        <p class="bclp-num">05</p>
        <h2 class="bclp-h2">初回に行う3つのこと</h2>
        <ul class="bclp-cards-3">
          {firstVisitThree.map((item) => (
            <li class="bclp-card">
              <span class="bclp-num bclp-num-lg">{item.no}</span>
              <h3 class="bclp-h3">{item.title}</h3>
              <p class="bclp-body">{item.body}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- 06 担当者紹介 -->
      <section class="bclp-band">
        <div class="bclp-band-inner">
          <p class="bclp-num">06</p>
          <h2 class="bclp-h2">担当者紹介</h2>
          <div class="bclp-pair bclp-pair-center">
            <div class="bclp-ph bclp-ph-round" role="img" aria-label="担当者の支給写真">
              <span>担当者</span>
            </div>
            <div class="bclp-pair-text">
              <p class="bclp-person">○○ ○○（役職・資格を差し替え）</p>
              <p class="bclp-body">
                身近な人の姿勢の悩みに向き合ったことが、この仕事を始めたきっかけでした。
                身体のことは、その日その日で違います。だから毎回うかがうところから始めます。
              </p>
              <p class="bclp-note">開始理由・想いを短文で（院ごとに差し替え）</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 07 施術写真 -->
      <section class="bclp-sec">
        <p class="bclp-num">07</p>
        <h2 class="bclp-h2">フェイス・身体の施術</h2>
        <ul class="bclp-cards-2">
          <li>
            <div class="bclp-ph bclp-ph-tall" role="img" aria-label="フェイス施術の支給写真"><span>フェイス</span></div>
            <p class="bclp-note">キャプション（施術名・所要時間などを差し替え）</p>
          </li>
          <li>
            <div class="bclp-ph bclp-ph-tall" role="img" aria-label="身体の施術の支給写真"><span>身体</span></div>
            <p class="bclp-note">キャプション（施術名・所要時間などを差し替え）</p>
          </li>
        </ul>
      </section>

      <!-- 08 向いている方 / 事前相談 -->
      <section class="bclp-band bclp-band-blue">
        <div class="bclp-band-inner">
          <p class="bclp-num">08</p>
          <h2 class="bclp-h2">向いている方／事前にご相談いただく事項</h2>
          <div class="bclp-cards-2">
            <div class="bclp-card">
              <span class="bclp-tag">向いている方</span>
              <ul class="bclp-list">
                {forWhom.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="bclp-card">
              <span class="bclp-tag">事前相談</span>
              <ul class="bclp-list">
                {beforeConsult.map((item) => <li>{item}</li>)}
              </ul>
              <p class="bclp-note">該当する方はご予約時にお知らせください。お受けできない場合があります。</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 09 初回来店の流れ -->
      <section class="bclp-sec" id="flow">
        <p class="bclp-num">09</p>
        <h2 class="bclp-h2">初回来店の流れ</h2>
        <ol class="bclp-flow">
          {flowSteps.map((step, i) => (
            <li class="bclp-flow-item">
              <span class="bclp-flow-no" aria-hidden="true">{i + 1}</span>
              <div class="bclp-card bclp-flow-card">
                <h3 class="bclp-h3">{step.title}</h3>
                <p class="bclp-body">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- 10 初回料金 -->
      <section class="bclp-band" id="price">
        <div class="bclp-band-inner">
          <p class="bclp-num">10</p>
          <h2 class="bclp-h2">初回料金</h2>
          <div class="bclp-card bclp-price">
            <p class="bclp-price-label">初回カウンセリング＋施術</p>
            <p class="bclp-price-value">○○,○○○円<span>（税込）</span></p>
            <p class="bclp-note">
              ※ 料金・キャンペーンは未確定です。確定後にこの枠を差し替えてください。
            </p>
          </div>
        </div>
      </section>

      <!-- 11 お客様の声 -->
      <section class="bclp-sec">
        <p class="bclp-num">11</p>
        <h2 class="bclp-h2">お客様の声</h2>
        <p class="bclp-note bclp-note-lead">スマートフォンでは横スワイプで表示します。掲載許可を得た内容に差し替えてください。</p>
        <ul class="bclp-voices">
          {voices.map((v) => (
            <li class="bclp-card bclp-voice">
              <div class="bclp-voice-head">
                <span class="bclp-ill bclp-ill-face" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                    <circle cx="12" cy="9" r="3.4" />
                    <path d="M5.5 19.5a6.5 6.5 0 0 1 13 0" />
                  </svg>
                </span>
                <span class="bclp-note">{v.who}</span>
              </div>
              <p class="bclp-body">{v.body}</p>
            </li>
          ))}
        </ul>
        <p class="bclp-note">※ 個人の感想であり、効果を保証するものではありません。</p>
      </section>

      <!-- 12 FAQ -->
      <section class="bclp-band bclp-band-blue" id="faq">
        <div class="bclp-band-inner">
          <p class="bclp-num">12</p>
          <h2 class="bclp-h2">よくあるご質問</h2>
          <div class="bclp-faq">
            {faqs.map((f) => (
              <details class="bclp-card bclp-faq-item">
                <summary>
                  <span>{f.q}</span>
                  <span class="bclp-faq-mark" aria-hidden="true"></span>
                </summary>
                <p class="bclp-body">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- 13 将来像 -->
      <section class="bclp-sec">
        <p class="bclp-num">13</p>
        <h2 class="bclp-h2">5年後、10年後のこと</h2>
        <div class="bclp-pair bclp-pair-center">
          <div class="bclp-pair-text">
            <p class="bclp-body">
              いま気になっている姿勢や見え方は、これから積み重なる毎日の使い方とつながっています。
              身体の土台を整える習慣を持っておくことは、先のご自身のための準備でもあります。
            </p>
            <p class="bclp-body">
              長く付き合っていける場所として、通いやすさも大切にしています。
            </p>
          </div>
          <div class="bclp-ph bclp-ph-round bclp-ph-round-lg" role="img" aria-label="将来像を表す支給写真"><span>写真</span></div>
        </div>
      </section>

      <div class="bclp-wave" aria-hidden="true"></div>

      <!-- 14 店舗情報 + 最終CTA -->
      <section class="bclp-sec bclp-last" id="access">
        <p class="bclp-num">14</p>
        <h2 class="bclp-h2">店舗情報</h2>
        <div class="bclp-pair">
          <div class="bclp-pair-text">
            <table class="bclp-table">
              <tbody>
                <tr><th scope="row">院名</th><td>{shop.name}</td></tr>
                <tr><th scope="row">住所</th><td>{shop.address}</td></tr>
                <tr><th scope="row">アクセス</th><td>{shop.access}</td></tr>
                <tr><th scope="row">電話</th><td><a href={shop.telHref}>{shop.tel}</a></td></tr>
                <tr><th scope="row">営業時間</th><td>{shop.hours}</td></tr>
                <tr><th scope="row">定休日</th><td>{shop.closed}</td></tr>
              </tbody>
            </table>
            <p class="bclp-note">院名・住所・電話・営業時間・定休日は差し替え枠です。</p>
          </div>
          <div class="bclp-ph bclp-ph-map" role="img" aria-label="地図の差し替え枠"><span>地図</span></div>
        </div>

        <div class="bclp-last-cta" id="reserve">
          <a class="bclp-btn bclp-btn-fill bclp-btn-lg" href={shop.reserveHref}>ご予約</a>
          <a class="bclp-btn bclp-btn-tel bclp-btn-lg" href={shop.telHref}>お電話 {shop.tel}</a>
        </div>
      </section>
    </main>

    <!-- モバイル固定CTA -->
    <div class="bclp-sticky">
      <a class="bclp-btn bclp-btn-tel" href={shop.telHref}>お電話</a>
      <a class="bclp-btn bclp-btn-fill bclp-sticky-main" href={shop.reserveHref}>ご予約</a>
    </div>
  </div>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Zen+Kurenaido&family=Klee+One:wght@400;600&display=swap');

  /* ワイヤーフレーム 3a のトークン（.wf2 系）をそのまま採用 */
  .bclp {
    --pink: #f2919f;
    --pink-line: #f0a5b4;
    --pink-text: #c76b7f;
    --pink-soft: #f2c3cb;
    --blue: #8fc9d8;
    --cream: #fdf5ef;
    --pale: #f0f7fa;
