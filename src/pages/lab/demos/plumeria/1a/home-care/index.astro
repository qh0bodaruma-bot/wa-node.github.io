---
import PlumeriaServicePage from '../../../../../../components/plumeria/PlumeriaServicePage.astro';
import { routes, homeCareTasks, homeCareStrengths } from '../../../../../../data/plumeria';
---
<PlumeriaServicePage
  title="訪問介護｜プルメリア（修正版ラフ）"
  description="プルメリアの訪問介護は、ホームヘルパーがご自宅を訪問し、身体介護・生活援助を行います。"
  currentPath={routes.homeCare}
  breadcrumbLabel="訪問介護"
  heroTitle="訪問介護"
  heroLead="ホームヘルパーがご自宅を訪問し、身体介護・生活援助を行います。"
  heroImg="/images/plumeria/feature-01.webp"
  heroAlt="入居者とスタッフが同じ目線の高さで話している様子（イメージ）"
  fitFor={[
    'ご自宅での入浴・排せつ・食事の介助が必要な方',
    '掃除・洗濯・調理などの生活援助が必要な方',
    'ご家族の介護負担を減らしたい方',
  ]}
  content={[
    { label: '身体介護', body: '入浴・排せつ・食事・通院や外出の付き添いなど、体に直接ふれる介助を行います。' },
    { label: '生活援助', body: '調理・洗濯・掃除・買い物代行などをお手伝いします。' },
    { label: '専門スタッフ', body: '介護福祉士などの有資格者が担当し、専属の責任者を配置しています。' },
  ]}
  targetInfo={[
    { label: '対象となる方', body: '要介護・要支援の認定を受けている方' },
    { label: '対応地域', body: 'お住まいの地域で利用できるかは、窓口にご確認ください。' },
  ]}
  costInfo="自己負担割合や支援内容によって異なります。保険外の支援は、対応できる内容と料金を事前にご確認ください。"
  flowSteps={[
    { title: 'お問い合わせ', body: '相談窓口へ、ご希望の支援内容をお伝えください。' },
    { title: 'ご相談・確認', body: '現在の状況、ケアプランの有無等を確認します。' },
    { title: 'ご利用開始', body: '内容にご納得いただいたうえで、利用を開始します。' },
  ]}
  contactCategory="home-care"
>
  <Fragment slot="extra">
    <section class="pl-sec pl-sec-beige" id="tasks">
      <div class="pl-wrap">
        <h2 class="pl-h2">具体的なサービス内容</h2>
        <div class="pl-grid-2">
          {homeCareTasks.map((group) => (
            <div class="pl-card">
              <h3 class="pl-h3">{group.title}</h3>
              <ul class="pl-body pl-check-list">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="pl-note" style="margin-top:14px">できることは継続していただき、買い物や薬の受け取りの代行など、ご本人・ご家族にとって難しいことをサポートします。</p>
      </div>
    </section>

    <section class="pl-sec" id="strengths">
      <div class="pl-wrap">
        <h2 class="pl-h2">プルメリアの訪問介護の特長</h2>
        <div class="pl-grid-2">
          {homeCareStrengths.map((item) => (
            <div class="pl-card">
              <h3 class="pl-h3">{item.name}</h3>
              <p class="pl-body">{item.body}</p>
            </div>
          ))}
        </div>
        <p class="pl-note" style="margin-top:14px"><a href="https://home-plumeria.jp/visit_care/" data-astro-reload>公式の訪問介護サービスのご案内を見る</a>（2026年9月16日確認）</p>
      </div>
    </section>
  </Fragment>
</PlumeriaServicePage>
