---
import PlumeriaLayout from '../../../../../../layouts/PlumeriaLayout.astro';
import { routes, housingUnits, genericFaqs, corp } from '../../../../../../data/plumeria';

export function getStaticPaths() {
  return housingUnits.map((u) => ({ params: { id: u.id }, props: { unit: u } }));
}

const { unit } = Astro.props;
const contactHref = `${routes.contact}?service=housing&unit=${unit.id}`;
---
<PlumeriaLayout
  title={`${unit.name}｜プルメリア（修正版ラフ）`}
  description={`${unit.name}（${unit.kind}）のご案内です。`}
  currentPath={routes.housingUnit(unit.id)}
>
  <div class="pl-wrap" style="padding-top:28px">
    <p class="pl-breadcrumb">
      <a href={routes.top}>トップ</a>
      <span aria-hidden="true">/</span>
      <a href={routes.housing}>サービス付き高齢者向け住宅</a>
      <span aria-hidden="true">/</span>
      <span>{unit.name}</span>
    </p>
  </div>

  <section class="pl-sec pl-sec-tight">
    <div class="pl-wrap">
      <h1 class="pl-h1" style="font-size:clamp(1.7rem,4vw,2.4rem)">{unit.name}</h1>
      <p class="pl-sec-lead">サービス付き高齢者向け住宅（{unit.kind}）</p>
      <img class="pl-page-photo" src={unit.img} alt={unit.alt} width="1200" height="675" loading="eager" decoding="async" />
      <p class="pl-photo-note">※ 掲載写真はイメージ写真です。実際の施設・スタッフではありません。</p>
    </div>
  </section>

  <section class="pl-sec">
    <div class="pl-wrap">
      <h2 class="pl-h2">住宅の概要</h2>
      <dl class="pl-spec-list">
        <div><dt>タイプ</dt><dd>{unit.kind}（対象：{unit.target}）</dd></div>
        <div><dt>所在地</dt><dd>{corp.address ?? '確認中'}</dd></div>
        <div><dt>居室</dt><dd>{unit.roomType}／{unit.roomSize}</dd></div>
        <div><dt>費用</dt><dd>{unit.priceFrom}（{unit.deposit}）</dd></div>
        <div><dt>空室状況</dt><dd><span class="pl-pending-note">確認中</span>（お手数ですがお問い合わせください）</dd></div>
      </dl>
      <p class="pl-note" style="margin-top:10px">月額基本料金の目安です。食費や介護保険自己負担分などは別途ご確認ください。<a href="https://home-plumeria.jp/plumeria0102/fee.html">公式の料金内訳</a>（2026年9月8日確認）</p>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige">
    <div class="pl-wrap">
      <h2 class="pl-h2">見学の流れ</h2>
      <ol class="pl-auto-grid pl-auto-grid-3">
        {[
          { title: 'お問い合わせ', body: '相談窓口から、見学したい住宅をお伝えください。' },
          { title: '見学日程の調整', body: 'ご都合の良い日時を調整します。' },
          { title: 'ご見学・ご相談', body: '居室・共用部をご案内し、ご不明点にお答えします。' },
        ].map((step, i) => (
          <li class="pl-flow-card">
            <span class="pl-num-face pl-flow-num" aria-hidden="true">{i + 1}</span>
            <h3 class="pl-flow-title">{step.title}</h3>
            <p class="pl-flow-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="pl-sec">
    <div class="pl-wrap">
      <h2 class="pl-h2">よくあるご質問</h2>
      <div class="pl-faq-list">
        {genericFaqs.slice(0, 2).map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" style="text-align:center">
    <div class="pl-wrap">
      <h2 class="pl-h2" style="justify-content:center">{unit.name}を見学・相談する</h2>
      <div class="pl-btn-row" style="justify-content:center">
        <a class="pl-btn pl-btn-main" href={contactHref}>{unit.name}について相談する</a>
        <a class="pl-btn pl-btn-outline" href={routes.housing}>他の住宅と比較する</a>
      </div>
    </div>
  </section>
</PlumeriaLayout>
