---
import PlumeriaServicePage from '../../../../../../components/plumeria/PlumeriaServicePage.astro';
import { routes, corp, shortStayTel } from '../../../../../../data/plumeria';
---
<PlumeriaServicePage
  title="居宅介護支援｜プルメリア（修正版ラフ）"
  description="プルメリアの居宅介護支援では、ケアマネジャーが介護サービス全体の計画・調整をお手伝いします。"
  currentPath={routes.careManagement}
  breadcrumbLabel="居宅介護支援"
  heroTitle="居宅介護支援"
  heroLead="ケアマネジャーが、介護サービス全体の計画・調整をお手伝いします。"
  heroImg="/images/plumeria/feature-03.webp"
  heroAlt="ご家族が自宅のダイニングで相談している様子（イメージ）"
  fitFor={[
    '介護保険サービスの利用方法が分からない方',
    '複数の介護サービスを組み合わせたい方',
    'ケアプランの見直しを相談したい方',
  ]}
  content={[
    { label: 'ケアプラン作成', body: 'ご本人・ご家族の希望をうかがい、ケアプランを作成します。' },
    { label: '申請サポート', body: '要介護認定の申請手続きをサポートします。' },
    { label: '相談・調整', body: '介護保険サービス全般のご相談と、事業所との調整を行います。' },
  ]}
  targetInfo={[
    { label: '対象となる方', body: '要支援・要介護の認定を受けている方、これから申請予定の方' },
    { label: '対応地域', body: '岐阜県可児市周辺' },
    { label: 'お問い合わせ（住宅）', body: `${corp.tel}（平日10:00〜17:30）` },
    { label: 'お問い合わせ（ショートステイ）', body: `${shortStayTel}（平日10:00〜17:30）` },
  ]}
  costInfo="介護保険により、自己負担なくご利用いただけます。"
  flowSteps={[
    { title: 'お問い合わせ', body: '電話またはフォームでご連絡ください。' },
    { title: 'ご相談', body: '現在の状況、ご希望をうかがいます。' },
    { title: 'ケアプラン作成', body: 'ご本人・ご家族と相談のうえ、プランを作成します。' },
  ]}
  contactCategory="care-management"
/>
