---
import PlumeriaLayout from '../../../../../layouts/PlumeriaLayout.astro';
import PlumeriaGuideQuiz from '../../../../../components/plumeria/PlumeriaGuideQuiz.astro';
import { services, routes, corp } from '../../../../../data/plumeria';

const heroSlides = [
  { img: '/images/plumeria/hero-01.webp', label: '入居者とスタッフ', alt: '入居者とスタッフが穏やかに話す様子（イメージ）' },
  { img: '/images/plumeria/hero-02.webp', label: '建物の外観', alt: '植栽に囲まれた建物（イメージ）' },
  { img: '/images/plumeria/hero-03.webp', label: '共用リビング', alt: '明るいリビングでくつろぐ様子（イメージ）' },
  { img: '/images/plumeria/hero-04.webp', label: 'スタッフ', alt: 'スタッフが会話する様子（イメージ）' },
];
---
<PlumeriaLayout
  title="プルメリア｜可児市の住まい・介護・看護のご案内（デモ）"
  description="岐阜県可児市のプルメリア。住まい、短期宿泊、ご自宅での介護・看護など、6つのサービスをご案内します。"
  currentPath={routes.top}
>
  <section class="pl-hero">
    <div class="pl-hero-media">
      <div class="pl-slider" data-pl-slider>
        {heroSlides.map((s, i) => (
          <img class={i === 0 ? 'pl-hero-photo is-on' : 'pl-hero-photo'}
            src={i === 0 ? s.img : undefined} data-src={i === 0 ? undefined : s.img}
            alt={s.alt} width="1600" height="900" fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async" aria-hidden={i === 0 ? undefined : 'true'} />
        ))}
        <div class="pl-slider-ui">
          <ul class="pl-dots">
            {heroSlides.map((s, i) => (
              <li><button type="button" class={i === 0 ? 'pl-dot is-on' : 'pl-dot'}
                data-pl-dot={String(i)} aria-current={i === 0 ? 'true' : 'false'}>
                <span class="pl-sr">{s.label}を表示</span>
              </button></li>
            ))}
          </ul>
          <button type="button" class="pl-slider-toggle" data-pl-toggle data-playing="false">
            <span class="pl-slider-toggle-icon" aria-hidden="true"></span>
            <span class="pl-sr" data-pl-toggle-label>スライドショーを再生</span>
          </button>
        </div>
      </div>
    </div>
    <div class="pl-wrap pl-hero-inner">
      <div class="pl-hero-copy">
        <p class="pl-eyebrow">岐阜県可児市｜介護事業部の総合案内</p>
        <h1 class="pl-h1">これからの暮らしに、<br />必要な支えを。</h1>
        <p class="pl-hero-lead">住まいを探す方も、ご自宅での介護を考える方も。<br />知りたいサービスからご覧ください。</p>
        <a class="pl-more" href="#guide">どこに相談するか迷ったら →</a>
        <p class="pl-photo-note">写真はイメージです。実際の施設・スタッフとは異なります。</p>
      </div>
      <nav class="pl-hero-tiles" aria-label="6つのサービス">
        <ul class="pl-tiles">
          {services.map((s) => (
            <li><a class="pl-tile" href={s.href} data-pl-gtag="service_select" data-pl-service={s.id} data-pl-cta="hero_tile">
              <span class="pl-tile-icon" aria-hidden="true"><svg><use href={`#pl-i-${s.icon}`} /></svg></span>
              <span class="pl-tile-label">{s.name}</span>
              {['housing', 'short-stay'].includes(s.id) && <span class="pl-tile-sub">{s.tagline}</span>}
            </a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <div class="pl-wrap">
    <a class="pl-recruit-strip" href={routes.recruit} data-pl-gtag="recruit_click" data-pl-cta="top_recruit_banner">
      <span><strong>プルメリアで働く</strong><span>介護職・看護職の募集情報</span></span>
      <span>採用情報を見る →</span>
    </a>
  </div>

  <PlumeriaGuideQuiz />

  <section class="pl-sec" id="services">
    <div class="pl-wrap">
      <h2 class="pl-h2"><span class="pl-h2-en">SERVICES</span>暮らしを支える6つのサービス</h2>
      <p class="pl-sec-lead">対象となる方・費用・ご相談の流れを、各ページにまとめています。</p>
      <div class="pl-service-intro-grid">
        {services.map((s) => (
          <a class="pl-card pl-service-intro-card" href={s.href} data-pl-gtag="service_select" data-pl-service={s.id} data-pl-cta="service_intro_card">
            <img src={s.img} alt={s.alt} width="900" height="675" loading="lazy" decoding="async" />
            <h3 class="pl-h3">{s.name}</h3>
            <p class="pl-body">{s.summary}</p>
            <span class="pl-service-intro-more">くわしく見る →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige">
    <div class="pl-wrap pl-reading">
      <h2 class="pl-h2">プルメリアについて</h2>
      <p class="pl-body">プルメリアは、可児市で住まい・介護・看護を支える6つの事業を運営しています。ご本人の暮らし方や、ご家族の状況に合わせてサービスをご検討いただけます。</p>
      <p class="pl-note">運営：{corp.groupName}</p>
      <a class="pl-more" href={corp.currentSiteUrl}>施設のお知らせ・現在の公式サイトを見る →</a>
    </div>
  </section>

  <section class="pl-sec" id="contact-cta">
    <div class="pl-wrap" style="text-align:center">
      <h2 class="pl-h2">見学・ご相談の窓口</h2>
      <p class="pl-sec-lead">住宅とショートステイの電話窓口、各サービスの連絡先をご案内します。</p>
      <div class="pl-btn-row" style="justify-content:center">
        <a class="pl-btn pl-btn-main" href={routes.contact}>連絡先・相談方法を見る</a>
      </div>
    </div>
  </section>
</PlumeriaLayout>
<script>
  import { initPlumeriaSlider, disposePlumeriaSlider } from '../../../../../scripts/plumeriaSlider';
  initPlumeriaSlider();
  document.addEventListener('astro:page-load', initPlumeriaSlider);
  document.addEventListener('astro:before-swap', disposePlumeriaSlider);
</script>
