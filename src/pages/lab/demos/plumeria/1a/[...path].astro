---
// 旧URL（/lab/demos/plumeria/1a/ 以下）から新URLへの転送ページ。
// 2026-09-17 に 1a を /lab/demos/plumeria/ 直下へ移した。先方へ旧URLを案内済みのため、404 にせず転送する。
// GitHub Pages は _redirects を解釈しないため、静的HTMLの meta refresh と location.replace で転送する。
import { PLUMERIA_BASE, housingUnits } from '../../../../../data/plumeria';

export function getStaticPaths() {
  const sections = [
    'services', 'housing', 'short-stay', 'home-care', 'home-nursing', 'care-management',
    'welfare-equipment', 'recruit', 'contact', 'privacy', 'important-matters', 'company',
    'magazine', 'sitemap',
  ];
  const paths = [undefined, ...sections, ...housingUnits.map((u) => `housing/${u.id}`)];
  return paths.map((path) => ({ params: { path } }));
}

const { path } = Astro.params;
const to = `${PLUMERIA_BASE}/${path ? `${path}/` : ''}`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>ページを移動しました</title>
    <link rel="canonical" href={new URL(to, Astro.site).href} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to }}>
      location.replace(to + location.search + location.hash);
    </script>
  </head>
  <body>
    <p>ページを移動しました。<a href={to}>こちら</a>からご覧ください。</p>
  </body>
</html>
