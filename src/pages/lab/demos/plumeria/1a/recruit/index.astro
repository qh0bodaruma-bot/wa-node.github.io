---
import PlumeriaLayout from '../../../../../../layouts/PlumeriaLayout.astro';
import PlumeriaDemoForm from '../../../../../../components/plumeria/PlumeriaDemoForm.astro';
import { routes, corp } from '../../../../../../data/plumeria';
const positions = [
  {
    name: '介護職員・ヘルパー', employment: 'パート',
    pay: '時給1,065円〜1,250円（処遇改善手当等あり、昇給・賞与あり）',
    hours: '夜勤フルタイム 22:00〜翌7:00／朝食帯 6:00〜10:00（3〜4時間程度）／夕食帯 16:30〜19:00（2時間〜程度）。シフト交代制で、勤務時間・曜日は応相談。',
    holiday: '週休2日制（希望休申請制度あり）',
    requirement: '介護福祉士／介護職員初任者研修修了／ホームヘルパー2級のいずれか',
    benefits: '交通費支給、有給休暇あり',
    jobContent: 'サービス付き高齢者向け住宅でのケア業務全般',
    contact: '採用担当：冨田・山本',
    url: 'https://home-plumeria.jp/recruit/detail/masterid/10/',
  },
  {
    name: '看護師（施設内）', employment: '正社員・フルパート・パート',
    pay: '月給25万〜27万円程度（経験考慮）／時給1,300〜1,400円程度',
    hours: '8:00〜17:00／9:00〜18:00／その他応相談',
    holiday: '週休2日制（毎週）、年間休日120日前後',
    requirement: '看護師または准看護師の資格',
    benefits: '交通費支給、有給休暇、賞与年2回、育児・介護休業／時短制度、研修・資格取得支援制度',
    jobContent: 'ショートステイ内での看護・介護業務',
    contact: '採用担当：山本・日比野',
    url: 'https://home-plumeria.jp/recruit/detail/masterid/9/',
  },
];
---
<PlumeriaLayout title="採用情報｜プルメリア（デモ）" description="プルメリアの介護職・看護職の募集情報と応募窓口をご案内します。" currentPath={routes.recruit}>
  <div class="pl-wrap" style="padding-top:28px"><p class="pl-breadcrumb"><a href={routes.top}>トップ</a><span aria-hidden="true">/</span><span>採用情報</span></p></div>
  <section class="pl-sec pl-sec-tight">
    <div class="pl-wrap">
      <h1 class="pl-h1">プルメリアで働く</h1>
      <p class="pl-sec-lead">介護職・看護職の募集情報をご案内します。</p>
      <img class="pl-page-photo" src="/images/plumeria/recruit-01.webp" alt="スタッフどうしが会話する様子（イメージ）" width="1200" height="675" decoding="async" />
      <p class="pl-photo-note">写真はイメージです。実際のスタッフとは異なります。</p>
    </div>
  </section>
  <section class="pl-sec">
    <div class="pl-wrap">
      <h2 class="pl-h2">募集職種</h2>
      <p class="pl-sec-lead">現在の公式サイトに掲載されている職種です。クリックすると詳しい条件が開きます。募集状況・勤務条件はご応募前にご確認ください。</p>
      <div class="pl-job-list">
        {positions.map((p) => <details class="pl-purpose-guide pl-job-card">
          <summary>
            <span class="pl-h3">{p.name}</span>
            <span class="pl-body pl-job-employment">{p.employment}</span>
          </summary>
          <dl class="pl-access-list pl-job-detail">
            <div><dt>給与</dt><dd>{p.pay}</dd></div>
            <div><dt>勤務時間</dt><dd>{p.hours}</dd></div>
            <div><dt>休日</dt><dd>{p.holiday}</dd></div>
            <div><dt>応募資格</dt><dd>{p.requirement}</dd></div>
            <div><dt>待遇</dt><dd>{p.benefits}</dd></div>
            <div><dt>仕事内容</dt><dd>{p.jobContent}</dd></div>
            <div><dt>採用担当</dt><dd>{p.contact}</dd></div>
          </dl>
          <a class="pl-more" href={p.url} data-astro-reload>公式の募集要項を見る →</a>
        </details>)}
      </div>
      <p class="pl-note">掲載元の更新日：2025年11月12日／本デモでの確認日：2026年9月8日</p>
    </div>
  </section>
  <section class="pl-sec pl-sec-beige" id="application">
    <div class="pl-wrap pl-reading">
      <h2 class="pl-h2">応募・職場見学について</h2>
      <p class="pl-body">ご希望の職種を添えて、採用窓口へお問い合わせください。</p>
      <a class="pl-desk" href={`tel:${corp.tel?.replaceAll('-', '')}`} data-pl-gtag="phone_click" data-pl-service="recruit" data-pl-cta="recruit_desk"><span>採用窓口</span><strong>{corp.tel}</strong></a>
      <p class="pl-note">公式募集要項の受付時間：平日10:00〜17:30</p>
      <details class="pl-purpose-guide">
        <summary>応募フォームの入力デモを見る</summary>
        <PlumeriaDemoForm kind="recruit" />
      </details>
    </div>
  </section>
</PlumeriaLayout>
