---
import PlumeriaLayout from '../../../../../../layouts/PlumeriaLayout.astro';
import { routes, contactCategories } from '../../../../../../data/plumeria';
---
<PlumeriaLayout
  title="お問い合わせ・ご相談｜プルメリア（修正版ラフ）"
  description="プルメリアへのお問い合わせ・ご相談フォームです。住宅・ショートステイ・訪問介護・訪問看護・居宅介護支援・福祉用具についてご相談いただけます。"
  currentPath={routes.contact}
>
  <div class="pl-wrap" style="padding-top:28px">
    <p class="pl-breadcrumb">
      <a href={routes.top}>トップ</a>
      <span aria-hidden="true">/</span>
      <span>お問い合わせ・ご相談</span>
    </p>
  </div>

  <section class="pl-sec pl-sec-tight">
    <div class="pl-wrap">
      <h1 class="pl-h1" style="font-size:clamp(1.7rem,4vw,2.4rem)">お問い合わせ・ご相談</h1>
      <p class="pl-sec-lead">
        見学・入居のご相談、各サービスについてのご質問はこちらから承ります。
        まだ内容が決まっていない場合もお気軽にご相談ください。
      </p>
    </div>
  </section>

  <section class="pl-sec">
    <div class="pl-wrap" style="max-width:640px">
      <div class="pl-form-disabled-banner">
        <strong>このフォームからは送信されません。</strong><br />
        修正版ラフの確認用フォームです。入力・入力エラーの表示までご確認いただけますが、
        実際の送信・保存・外部送信は行われません。本番の受信先は確認中です。
      </div>

      <form id="pl-contact-form" novalidate data-pl-form>
        <div class="pl-form-field">
          <label for="pl-name">お名前<span class="pl-required">必須</span></label>
          <input type="text" id="pl-name" name="name" required autocomplete="name" />
          <p class="pl-form-error-text" data-error-for="name" hidden></p>
        </div>

        <div class="pl-form-field">
          <label for="pl-contact-info">ご連絡先（電話番号またはメールアドレス）<span class="pl-required">必須</span></label>
          <input type="text" id="pl-contact-info" name="contactInfo" required autocomplete="tel" />
          <p class="pl-form-error-text" data-error-for="contactInfo" hidden></p>
        </div>

        <div class="pl-form-field">
          <label for="pl-category">ご相談内容の分類<span class="pl-required">必須</span></label>
          <select id="pl-category" name="category" required>
            <option value="">選択してください</option>
            {contactCategories.map((c) => <option value={c.value}>{c.label}</option>)}
          </select>
          <p class="pl-form-error-text" data-error-for="category" hidden></p>
        </div>

        <div class="pl-form-field">
          <label for="pl-message">ご相談内容<span class="pl-required">必須</span></label>
          <textarea id="pl-message" name="message" rows="5" required></textarea>
          <p class="pl-form-error-text" data-error-for="message" hidden></p>
        </div>

        <p class="pl-form-note">
          入力いただいた内容は、<a href={routes.privacy}>個人情報の取扱いについて</a>に沿って取り扱います（本番の運用方針は確認中です）。
        </p>

        <button type="submit" class="pl-btn pl-btn-main" style="width:100%;justify-content:center;margin-top:10px">
          この内容を確認する
        </button>

        <p class="pl-form-success" role="status" hidden data-pl-success>
          入力内容の確認ができました。このラフでは実際の送信は行われません。
        </p>
        <p class="pl-form-error" role="alert" hidden data-pl-form-error>
          未入力の項目があります。エラー表示の項目をご確認ください。
        </p>
      </form>
    </div>
  </section>
</PlumeriaLayout>

<script>
  import { contactCategories } from '../../../../../../data/plumeria';

  function preselectCategory() {
    const select = document.querySelector<HTMLSelectElement>('#pl-category');
    if (!select) return;
    const params = new URLSearchParams(window.location.search);
    const service = params.get('service');
    if (!service) return;
    const match = contactCategories.find((c) => c.value === service);
    if (match) select.value = match.value;
  }

  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>('[data-pl-form]');
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    const successEl = form.querySelector<HTMLElement>('[data-pl-success]');
    const formErrorEl = form.querySelector<HTMLElement>('[data-pl-form-error]');

    function fieldError(name: string): HTMLElement | null {
      return form!.querySelector(`[data-error-for="${name}"]`);
    }

    function validate(): boolean {
      let firstInvalid: HTMLElement | null = null;
      let ok = true;
      const fields: [string, string][] = [
        ['name', 'お名前を入力してください。'],
        ['contactInfo', 'ご連絡先を入力してください。'],
        ['category', 'ご相談内容の分類を選択してください。'],
        ['message', 'ご相談内容を入力してください。'],
      ];
      fields.forEach(([name, message]) => {
        const el = form!.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`);
        const errorEl = fieldError(name);
        const invalid = !el || !el.value.trim();
        if (errorEl) {
          errorEl.textContent = invalid ? message : '';
          errorEl.hidden = !invalid;
        }
        if (invalid) {
          ok = false;
          if (!firstInvalid && el) firstInvalid = el;
        }
      });
      if (firstInvalid) (firstInvalid as HTMLElement).focus();
      return ok;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (successEl) successEl.hidden = true;
      if (formErrorEl) formErrorEl.hidden = true;
      const valid = validate();
      if (!valid) {
        if (formErrorEl) formErrorEl.hidden = false;
        return;
      }
      // ラフのため実際の送信は行わない。個人情報の保存・外部送信もしない。
      if (successEl) successEl.hidden = false;
    });
  }

  preselectCategory();
  initContactForm();
  document.addEventListener('astro:page-load', () => { preselectCategory(); initContactForm(); });
</script>
