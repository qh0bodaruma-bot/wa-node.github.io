<script>
  /*
    ヒーロースライダー。参照サイトの挙動（4枚・フェード・5秒・切替0.7秒・ドット）を
    自前の素のJSで再現する。jQuery / slick は使わない。

    JSが動かない場合は1枚目だけが見える静止ヒーローになる。
    HTML側で1枚目に is-on を付け、操作UIは `.is-ready` が付くまでCSSで隠してあるため、
    「ドットは出ているのに押しても何も起きない」状態にはならない。
  */
  const initHeroSlider = () => {
    const root = document.querySelector('[data-pl-slider]');
    if (!root || root.dataset.plReady === '1') return;

    const slides = Array.from(root.querySelectorAll('.pl-hero-photo'));
    const dots = Array.from(root.querySelectorAll('[data-pl-dot]'));
    const toggle = root.querySelector('[data-pl-toggle]');
    const toggleLabel = root.querySelector('[data-pl-toggle-label]');
    if (slides.length < 2 || !toggle) return;
    root.dataset.plReady = '1';

    const INTERVAL = 5000;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let wantPlay = false;
    let timer = null;

    const render = () => {
      slides.forEach((el, i) => {
        el.classList.toggle('is-on', i === index);
        if (i === index) el.removeAttribute('aria-hidden');
        else el.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((el, i) => {
        el.classList.toggle('is-on', i === index);
        el.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
    };

    // 裏タブでタイマーを回し続けない
    const arm = () => {
      if (timer) { clearInterval(timer); timer = null; }
      if (!wantPlay || document.hidden) return;
      timer = window.setInterval(() => {
        index = (index + 1) % slides.length;
        render();
      }, INTERVAL);
    };

    const setPlay = (on) => {
      wantPlay = on;
      toggle.setAttribute('data-playing', on ? 'true' : 'false');
      if (toggleLabel) {
        toggleLabel.textContent = on ? 'スライドショーを停止' : 'スライドショーを再生';
      }
      arm();
    };

    dots.forEach((el, i) => {
      el.addEventListener('click', () => { index = i; render(); arm(); });
    });
    toggle.addEventListener('click', () => setPlay(!wantPlay));
    document.addEventListener('visibilitychange', arm);
    reduce.addEventListener('change', (e) => setPlay(!e.matches));

    // 2枚目以降は初回描画が終わってから取りに行く。重ねて置いてあるので
    // loading="lazy" では遅延しない（どれもビューポート内と判定されるため）
    const loadRest = () => slides.forEach((el) => {
      const src = el.dataset.src;
      if (src) { el.src = src; delete el.dataset.src; }
    });
    if (document.readyState === 'complete') loadRest();
    else window.addEventListener('load', loadRest, { once: true });

    root.classList.add('is-ready');
    render();
    setPlay(!reduce.matches);   // 動きを減らす設定なら1枚目で止める
  };

  initHeroSlider();
  // BaseLayout が ViewTransitions を使うため、遷移後にも初期化する（二重初期化は上で弾く）
  document.addEventListener('astro:page-load', initHeroSlider);
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Roboto+Condensed:wght@400;500;600&display=swap');

  .pl {
    /* ── 配色（ブリーフ準拠）──────────────────────── */
    --bg: #faf9f2;          /* やや黄みのあるオフホワイト／生成り */
    --surface: #ffffff;     /* 白 */
    --mint: #eef6f2;        /* ごく薄いミント */
    --beige: #f4efe3;       /* 淡いベージュ */
    --ink: #002a1d;         /* 深いフォレストグリーン */
    --green: #349f87;       /* メインカラー */
    --green-deep: #257562;  /* 小さい文字・小さいボタン用。#349f87 は14pxで3.2:1 */
    --accent: #efa661;      /* 木の実色。面と装飾にのみ使う（文字には使わない） */
    --muted: #566f66;
    --line: rgba(0, 42, 29, 0.13);

    /* 影は薄く広く。黒い強いドロップシャドウは使わない */
    --shadow: 0 4px 20px rgba(52, 159, 135, 0.08);
    --shadow-lift: 0 8px 26px rgba(52, 159, 135, 0.14);

    --wrap: 1160px;
    --radius: 14px;      /* 角張らせない */
    --radius-sm: 10px;

    font-family: 'Zen Kaku Gothic New', 'Noto Sans JP', 'ヒラギノ角ゴ Pro W3',
      'Hiragino Kaku Gothic Pro', 'Yu Gothic Medium', 'YuGothic', Meiryo, sans-serif;
    font-size: 16px;
    line-height: 2;            /* 行間を十分に */
    letter-spacing: 0.03em;    /* 字間を少しだけ広げる */
    color: var(--ink);
    background: var(--bg);
    padding-bottom: 92px;
    overflow-x: hidden;
  }

  .pl :is(h1, h2, h3, p, ul, ol, dl, dd, figure, table) { margin: 0; }
  .pl :is(ul, ol) { padding: 0; list-style: none; }
  .pl a:not([class]) { color: inherit; }
  .pl img { max-width: 100%; }
  .pl-brand, .pl-nav a, .pl-menu-list a, .pl-foot-links a { color: inherit; }
  .pl-defs { position: absolute; width: 0; height: 0; }

  /* アイコンは細めの線画で統一し、角張らせない */
  .pl svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pl-hill svg,
  .pl-hill svg path { fill: currentColor; stroke: none; }

  .pl-num-face {
    font-family: 'Roboto Condensed', 'Zen Kaku Gothic New', sans-serif;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .pl-wrap { width: min(100% - 44px, var(--wrap)); margin-inline: auto; }

  .pl-notice {
    background: var(--ink);
    color: var(--bg);
    font-size: 12px;
    line-height: 1.7;
    text-align: center;
    padding: 9px 20px;
  }

  /* ── ヘッダー ───────────────────────────── */
  .pl-head {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .pl-head-inner {
    width: min(100% - 32px, var(--wrap));
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 18px;
    min-height: 76px;
  }
  .pl-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; line-height: 1.25; }
  .pl-brand-mark {
    width: 34px; height: 34px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--mint);
    color: var(--green-deep);
    flex: none;
  }
  .pl-brand-mark svg { width: 20px; height: 20px; }
  .pl-brand-text { display: grid; }
  .pl-brand-name { font-size: 18px; font-weight: 700; letter-spacing: 0.1em; }
  .pl-brand-en {
    font-family: 'Roboto Condensed', sans-serif;
    font-size: 10px; font-weight: 500; letter-spacing: 0.22em;
    color: var(--green-deep);
  }

  /* メニューは右寄せ。各項目は同じ幅にそろえ、
     ヘッダーCTA「見学のご予約」（実測 116.7×58.5px）より一回り小さく取る。
     最長ラベル「訪問看護」は実測49.9pxなので 100px 幅に余裕で収まる。 */
  .pl-nav { display: flex; gap: 2px; margin-left: auto; }
  .pl-nav a {
    display: grid; justify-items: center; gap: 2px;
    width: 100px;
    padding: 5px 4px;
    border-radius: var(--radius-sm);
    font-size: 12px; font-weight: 500;
    text-decoration: none; white-space: nowrap;
    transition: background-color 0.3s, color 0.3s;
  }
  .pl-nav a:hover { background: var(--mint); color: var(--green-deep); }
  .pl-nav-icon { display: grid; place-items: center; color: var(--green-deep); }
  .pl-nav-icon svg { width: 20px; height: 20px; }

  .pl-head-cta { display: flex; gap: 8px; flex: none; }
  .pl-head-tel { font-size: 17px; line-height: 1.15; }

  /* ── ボタン ─────────────────────────────── */
  .pl-btn {
    display: inline-flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 1px;
    min-height: 58px; min-width: 232px;
    padding: 10px 26px;
    border-radius: 999px;         /* やわらかいフレーム */
    border: 1.5px solid transparent;
    font-size: 15px; font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none; text-align: center;
    transition: background-color 0.3s, color 0.3s, border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }
  /* ホバーは派手に変えず、少し明るく・少し浮く */
  .pl-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-lift); }

  .pl-btn-sm { min-height: 46px; min-width: 0; padding: 7px 16px; font-size: 13px; border-radius: 999px; }
  .pl-btn-sticky { min-height: 54px; min-width: 0; padding: 8px 14px; font-size: 16px; font-weight: 700; }

  /* メインCTA: ブリーフ指定の #349f87 ＋白文字。
     19px/700 にして「大きい文字」の 3:1 基準を満たす（3.25:1）。 */
  .pl-btn-main {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
    font-size: 19px;
    font-weight: 700;
  }
  .pl-btn-main:hover { background: #3cb096; border-color: #3cb096; }

  /* 小さい文字のCTAは同系の濃いめ。白文字で 5.5:1 */
  .pl-btn-deep { background: var(--green-deep); border-color: var(--green-deep); color: #fff; }
  .pl-btn-deep:hover { background: var(--green); border-color: var(--green); }

  /* 電話・緊急連絡は濃いフォレストグリーン */
  .pl-btn-ink { background: var(--ink); border-color: var(--ink); color: #fff; }
  .pl-btn-ink:hover { background: #0a4030; border-color: #0a4030; }

  .pl-btn-outline { background: var(--surface); border-color: var(--green); color: var(--green-deep); }
  .pl-btn-outline:hover { background: var(--mint); }

  .pl-btn-label { font-size: 11px; letter-spacing: 0.14em; }
  .pl-btn-tel-no { font-size: 23px; line-height: 1.2; font-weight: 600; }
  .pl-btn-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 24px; }

  /* ── モバイルメニュー ─────────────────────── */
  .pl-menu { display: none; position: relative; margin-left: auto; }
  .pl-menu > summary {
    list-style: none;
    width: 50px; height: 50px;
    display: grid; place-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .pl-menu > summary::-webkit-details-marker { display: none; }
  .pl-menu-bars, .pl-menu-bars::before, .pl-menu-bars::after {
    display: block; width: 21px; height: 1.5px; background: var(--ink); content: '';
  }
  .pl-menu-bars { position: relative; }
  .pl-menu-bars::before { position: absolute; top: -6px; }
  .pl-menu-bars::after { position: absolute; top: 6px; }

  /* display を明示すると details 既定の非表示が効かなくなるため [open] で分岐する */
  .pl-menu-list { display: none; }
  .pl-menu[open] .pl-menu-list {
    position: absolute; right: 0; top: calc(100% + 8px);
    display: grid; min-width: 262px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .pl-menu-list a {
    display: flex; align-items: center; gap: 11px;
    padding: 15px 18px;        /* 大きなタップ領域 */
    font-size: 15px; text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .pl-menu-list a:last-child { border-bottom: 0; }
  .pl-menu-list .pl-nav-icon svg { width: 20px; height: 20px; }

  /* ── ファーストビュー ───────────────────── */
  .pl-hero { position: relative; }
  .pl-hero-media { background: linear-gradient(var(--mint) 0%, var(--bg) 100%); }
  /* ── ヒーロースライダー ─────────────────────────── */
  .pl-slider { position: relative; }
  .pl-hero-photo {
    display: block;
    width: 100%;
    height: clamp(280px, 38vw, 520px);
    object-fit: cover;
    /* 器が 16:9 より横長になるため上下が切れる。顔が残る高さに寄せる */
    object-position: center 40%;
    clip-path: url(#pl-hero-clip);   /* 下辺をゆるやかな丘で切る */
  }
  /* 1枚目だけ流れに残して高さを作り、2枚目以降を上に重ねる */
  .pl-hero-photo + .pl-hero-photo {
    position: absolute;
    inset: 0;
    height: 100%;
  }
  .pl-slider .pl-hero-photo {
    opacity: 0;
    transition: opacity 0.7s ease;
  }
  .pl-slider .pl-hero-photo.is-on { opacity: 1; }

  /* 操作UIはJSが動いたときだけ出す（`is-ready` はJSが付ける） */
  .pl-slider-ui {
    display: none;
    position: absolute;
    right: clamp(16px, 3vw, 34px);
    bottom: clamp(46px, 7vw, 84px);   /* 丘の切り抜きに食われない高さ */
    align-items: center;
    gap: 14px;
    z-index: 2;
  }
  .pl-slider.is-ready .pl-slider-ui { display: flex; }
  .pl-dots { display: flex; gap: 9px; }
  .pl-dot {
    width: 30px;
    height: 30px;                      /* タップ領域は確保し、見た目だけ小さくする */
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .pl-dot::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 30%, transparent);
    border: 1px solid color-mix(in srgb, var(--bg) 70%, transparent);
    transition: background-color 0.3s, transform 0.3s;
  }
  .pl-dot.is-on::before { background: var(--green); transform: scale(1.35); }
  .pl-dot:hover::before { background: var(--green-deep); }

  .pl-slider-toggle {
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--bg) 70%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    color: var(--ink);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background-color 0.3s;
  }
  .pl-slider-toggle:hover { background: var(--bg); }
  /* 再生中は「一時停止」の形、停止中は「再生」の形にする */
  .pl-slider-toggle-icon {
    width: 10px;
    height: 11px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .pl-slider-toggle[data-playing='false'] .pl-slider-toggle-icon {
    width: 0;
    height: 0;
    border: 6px solid transparent;
    border-left: 10px solid currentColor;
    margin-left: 3px;
  }

  /* 読み上げ専用 */
  .pl-sr {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .pl-hero-inner { margin-top: -78px; position: relative; }
  .pl-hero-copy {
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    border-radius: var(--radius);
    padding: 30px clamp(22px, 3vw, 46px) 34px;
    max-width: 600px;          /* 文字を詰め込まず余白を確保 */
    margin-left: auto;         /* 写真の余白が右側にあるため見出しも右へ */
  }
  .pl-h1 {
    font-size: clamp(23px, 2.9vw, 35px);
    font-weight: 700; line-height: 1.6; letter-spacing: 0.06em;
    margin-top: 10px;
  }
  .pl-hero-lead { margin-top: 14px; font-size: 15px; color: var(--muted); }
  .pl-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; font-weight: 700; letter-spacing: 0.16em;
    color: var(--green-deep);
  }
  .pl-eyebrow-center { justify-self: center; }
  .pl-eyebrow-mark { display: grid; place-items: center; }
  .pl-eyebrow-mark svg { width: 17px; height: 17px; }

  /* ── 丘の切り替え（直線で分断しない）────────── */
  .pl-hill { line-height: 0; }
  .pl-hill svg { width: 100%; height: clamp(38px, 5vw, 80px); display: block; }
  .pl-hill-to-mint { color: var(--mint); }
  .pl-hill-from-mint { color: var(--mint); background: var(--bg); }
  .pl-hill-to-mint { background: var(--bg); }
  .pl-hill-foot { color: var(--beige); background: var(--bg); }

  /* ── セクション共通 ─────────────────────── */
  .pl-sec { padding-block: clamp(52px, 6.5vw, 88px); position: relative; }
  .pl-sec-tight { padding-block: clamp(38px, 4.5vw, 58px); }
  /* 和紙テクスチャ。地色をフォールバックに敷き、写真と文字の邪魔をしない濃度で重ねる。
     繰り返すと継ぎ目が出るため cover で1枚だけ伸ばす。 */
  .pl-sec-beige {
    background-color: var(--beige);
    background-image: url('/images/plumeria/background-01.webp');
    background-size: cover;
    background-position: center;
  }
  .pl-h2 {
    display: grid; justify-items: center; gap: 4px;
    text-align: center;
    font-size: clamp(19px, 2.1vw, 24px);
    font-weight: 700; letter-spacing: 0.1em; line-height: 1.6;
  }
  .pl-h2-en, .pl-h3-en {
    font-family: 'Roboto Condensed', sans-serif;
    font-weight: 500; letter-spacing: 0.26em;
    color: var(--green-deep);
  }
  .pl-h2-en { font-size: 11px; }
  .pl-h3-en { font-size: 10px; margin-left: 9px; }
  .pl-sec-lead { margin-top: 14px; text-align: center; font-size: 14px; color: var(--muted); }
  .pl-h3 { font-size: 16px; font-weight: 700; letter-spacing: 0.06em; line-height: 1.65; }
  .pl-body { font-size: 14px; line-height: 2; }
  .pl-note { font-size: 13px; line-height: 1.85; color: var(--muted); }

  /* ── お知らせ ───────────────────────────── */
  .pl-news { margin-top: 24px; display: grid; border-top: 1px solid var(--line); }
  .pl-news > li {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 15px 4px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }
  .pl-news-date { font-size: 14px; color: var(--muted); }
  .pl-cat {
    font-size: 12px; font-weight: 700; letter-spacing: 0.06em;
    border-radius: 999px;              /* 小さな角丸ラベル */
    padding: 3px 14px;
    white-space: nowrap;
    line-height: 1.7;
  }
  .pl-cat-green  { background: var(--green-deep); color: #fff; }
  .pl-cat-accent { background: var(--accent); color: var(--ink); }   /* 木の実色は面で使う */
  .pl-cat-beige  { background: var(--beige); color: var(--ink); border: 1px solid var(--line); }
  .pl-news-text { line-height: 1.8; }
  .pl-more {
    justify-self: start;
    margin-top: 18px;
    font-size: 14px; font-weight: 500;
    color: var(--green-deep); text-decoration: none;
    padding-bottom: 3px;
    background-image: linear-gradient(to top, currentColor 1px, transparent 1px);
  }

  /* ── プルメリアについて ─────────────────── */
  .pl-about {
    position: relative;
    background: var(--mint);
    padding-block: clamp(48px, 6vw, 84px);
    overflow: hidden;
  }
  .pl-about-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  .pl-about-text { display: grid; justify-items: start; }
  .pl-about-catch {
    margin-top: 12px;
    font-size: clamp(19px, 2.1vw, 25px);
    font-weight: 700; line-height: 1.75; letter-spacing: 0.06em;
    color: var(--ink);
  }
  .pl-about-body { margin: 18px 0 14px; }
  .pl-about-photo {
    display: block; width: 100%; height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  /* 装飾モチーフ。うるさくならない濃度で置く */
  .pl-deco { position: absolute; color: var(--green); pointer-events: none; }
  .pl-deco svg { width: 100%; height: 100%; stroke-width: 0.7; }
  /* 社名のプルメリア。透過PNG由来なので地色の上にそのまま置ける。
     主役の写真とテキストにかからない外周の角にだけ、控えめな濃度で置く。 */
  .pl-deco-flower {
    position: absolute;
    pointer-events: none;
    user-select: none;
    opacity: 0.5;
    height: auto;
  }
  .pl-deco-flower-bl { left: -40px; bottom: -34px; width: clamp(170px, 20vw, 290px); }
  .pl-deco-flower-tr { right: -30px; top: -26px; width: clamp(150px, 17vw, 250px); opacity: 0.45; }
  .pl-deco-bird { right: 7%; top: 14%; width: 54px; height: 54px; opacity: 0.24; }
  .pl-deco-sun  { right: 16%; bottom: 12%; width: 72px; height: 72px; opacity: 0.13; color: var(--accent); }
  .pl-deco-leaf-l { left: -54px; top: 46%; width: 230px; height: 230px; opacity: 0.09; }
  .pl-deco-leaf-r { right: -54px; top: 20%; width: 190px; height: 190px; opacity: 0.09; transform: scaleX(-1); }

  /* ── カード・グリッド ───────────────────── */
  .pl-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .pl-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .pl-services { margin-top: 40px; position: relative; }
  .pl-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 24px 22px;
    display: grid; align-content: start; gap: 11px;
  }

  /* ── サービスカード（基準サイズを維持）────── */
  .pl-services-sec { overflow: hidden; }
  .pl-svc {
    height: 100%;
    padding: 26px 24px;
    gap: 8px;
    text-decoration: none; color: inherit;
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }
  a.pl-svc:hover { border-color: var(--green); transform: translateY(-2px); box-shadow: var(--shadow-lift); }
  .pl-svc-ph {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;       /* 支給画像の比率に合わせる */
    object-fit: cover;
    border-radius: var(--radius-sm);
    margin-bottom: 8px;
    background: var(--mint);   /* 読み込み前の下地 */
  }
  .pl-svc-icon {
    display: inline-grid; place-items: center;
    width: 26px; height: 26px;
    color: var(--green-deep);
    vertical-align: -6px;
    margin-right: 4px;
  }
  .pl-svc-icon svg { width: 22px; height: 22px; }
  .pl-svc-name { font-size: 19px; font-weight: 700; letter-spacing: 0.06em; }
  .pl-svc-kind { font-size: 15px; color: var(--muted); line-height: 1.75; }
  .pl-svc-more {
    border-style: dashed; background: transparent; box-shadow: none;
    align-content: center; justify-items: center; text-align: center;
  }
  .pl-svc-more .pl-svc-name { font-size: 17px; }

  /* 受入状況。色だけに頼らず必ず文字でも示す */
  .pl-badge {
    justify-self: start;
    font-size: 14px; font-weight: 700; letter-spacing: 0.06em;
    border-radius: 999px; padding: 2px 13px;
    border: 1.5px solid currentColor; line-height: 1.7;
  }
  .pl-badge-open { color: var(--green-deep); background: var(--mint); }
  .pl-badge-full { color: var(--muted); background: transparent; }

  /* ── 3つの強み ──────────────────────────── */
  .pl-reasons { margin-top: 36px; }
  .pl-reason { justify-items: center; text-align: center; gap: 13px; padding-top: 0; overflow: hidden; }
  /* .pl img[cid] は (0,2,1)。クラス単体 (0,2,0) では負けるので .pl を前置する */
  .pl .pl-reason-photo {
    display: block;
    width: calc(100% + 44px);        /* カードの左右パディング分を打ち消して全幅に */
    max-width: none;                 /* .pl img の max-width:100% を上書きしないと効かない */
    margin: -24px -22px 0;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--mint);
  }
  /* 写真の下端に少し重ねて、丸アイコンを橋渡しにする */
  .pl-reason-icon {
    width: 66px; height: 66px;
    margin-top: -33px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: var(--surface);
    border: 3px solid var(--surface);
    box-shadow: var(--shadow);
    color: var(--green-deep);
    position: relative;
  }
  .pl-reason-icon svg { width: 31px; height: 31px; }

  /* ── 一日の流れ ─────────────────────────── */
  .pl-day-photo {
    display: block;
    width: 100%;
    margin-top: 30px;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    object-position: center 42%;
    border-radius: var(--radius);
    background: var(--mint);
  }
  .pl-day { margin-top: 34px; display: grid; grid-template-columns: repeat(6, 1fr); position: relative; }
  .pl-day::before {
    content: ''; position: absolute; left: 8%; right: 8%; top: 8px;
    height: 1px; background: var(--line);
  }
  .pl-day-item { display: grid; justify-items: center; gap: 9px; text-align: center; position: relative; }
  .pl-day-dot { width: 17px; height: 17px; border-radius: 50%; background: var(--bg); border: 2px solid var(--green); }
  .pl-day-time { font-size: 17px; color: var(--green-deep); line-height: 1.2; font-weight: 600; }
  .pl-day-label { font-size: 13px; color: var(--muted); line-height: 1.7; }

  /* ── 空室・採用 ─────────────────────────── */
  .pl-vac-sec { background: var(--mint); padding-block: clamp(40px, 5vw, 66px); }
  .pl-recruit { overflow: hidden; }
  .pl .pl-recruit-photo {
    display: block;
    width: calc(100% + 44px);
    max-width: none;                 /* .pl img の max-width:100% を上書き */
    margin: -24px -22px 4px;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--mint);
  }
  .pl-vacancy { display: grid; gap: 10px; }
  .pl-vacancy > li {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding-bottom: 10px; border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  /* ── アクセス ───────────────────────────── */
  .pl-access { margin-top: 34px; display: grid; grid-template-columns: 1fr 1fr; gap: 36px; align-items: start; }
  .pl-ph {
    display: grid; place-items: center;
    background: var(--beige);
    color: var(--muted);
    font-size: 13px; letter-spacing: 0.1em; text-align: center;
    padding: 14px;
  }
  .pl-ph-map { aspect-ratio: 4 / 3; border-radius: var(--radius); }
  .pl-access-text { display: grid; gap: 18px; justify-items: start; }
  .pl-access-addr { font-size: 17px; font-weight: 700; letter-spacing: 0.04em; }
  .pl-access-list { display: grid; gap: 13px; }
  .pl-access-list dt { font-size: 13px; font-weight: 700; color: var(--green-deep); letter-spacing: 0.08em; }
  .pl-access-list dd { font-size: 14px; line-height: 1.85; }

  .pl-table-wrap { width: 100%; overflow-x: auto; }
  .pl-table {
    width: 100%; min-width: 460px;
    border-collapse: collapse; font-size: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .pl-table :is(th, td) { padding: 11px 13px; border-bottom: 1px solid var(--line); text-align: center; }
  .pl-table thead th { background: var(--mint); font-size: 13px; font-weight: 700; color: var(--green-deep); }
  .pl-table tbody th { text-align: left; font-weight: 500; white-space: nowrap; }
  .pl-table tbody tr:last-child :is(th, td) { border-bottom: 0; }

  /* ── フッター：明るい生成りを基調にする ────── */
  .pl-foot {
    background-color: var(--beige);
    background-image: url('/images/plumeria/background-01.webp');
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;   /* 角の花がはみ出さないように */
  }
  .pl-hill-foot { margin-top: -1px; }
  .pl-foot-inner {
    display: flex; flex-wrap: wrap; gap: 30px;
    justify-content: space-between; align-items: flex-start;
    padding-bottom: 40px;
  }
  .pl-foot-brand { display: grid; gap: 3px; justify-items: start; }
  .pl-foot-name { font-size: 20px; font-weight: 700; letter-spacing: 0.1em; }
  .pl-foot-brand .pl-brand-mark { background: var(--surface); margin-bottom: 6px; }
  .pl-foot-links { display: grid; gap: 12px; font-size: 14px; }
  .pl-foot-links a {
    justify-self: start; text-decoration: none; padding-bottom: 3px;
    background-image: linear-gradient(to top, var(--line) 1px, transparent 1px);
    transition: background-image 0.3s, color 0.3s;
  }
  .pl-foot-links a:hover { color: var(--green-deep); background-image: linear-gradient(to top, currentColor 1px, transparent 1px); }

  /* ── モバイル固定CTA ────────────────────── */
  .pl-sticky {
    display: none;
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    gap: 9px;
    padding: 10px 13px calc(10px + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    border-top: 1px solid var(--line);
  }
  .pl-sticky .pl-btn { flex: 1; }
  .pl-sticky-main { flex: 1.7; }

  /* ── レスポンシブ ───────────────────────── */
  @media (max-width: 1180px) {
    .pl-nav a { width: 84px; padding: 5px 4px; font-size: 11px; }
    .pl-nav-icon svg { width: 18px; height: 18px; }
    .pl-head-tel { font-size: 15px; }
  }

  @media (max-width: 1000px) {
    .pl-nav, .pl-head-cta { display: none; }
    .pl-menu { display: block; }
    .pl-sticky { display: flex; }
    .pl-grid-3 { grid-template-columns: 1fr 1fr; }
    .pl-day { grid-template-columns: repeat(3, 1fr); row-gap: 26px; }
    .pl-day::before { display: none; }
    .pl-deco-leaf-l, .pl-deco-leaf-r { width: 160px; height: 160px; }
  }

  @media (max-width: 720px) {
    .pl { line-height: 1.9; }
    .pl-hero-inner { margin-top: -44px; }
    .pl-hero-copy { max-width: none; padding: 24px 20px 28px; }
    .pl-grid-3, .pl-grid-2, .pl-access, .pl-about-inner { grid-template-columns: 1fr; gap: 16px; }
    .pl-about-inner { gap: 26px; }
    .pl-day-photo { aspect-ratio: 16 / 10; }
    .pl-access { gap: 24px; }
    .pl-services, .pl-reasons { margin-top: 28px; }
    .pl-day { grid-template-columns: repeat(2, 1fr); }
    .pl-news > li { grid-template-columns: auto 1fr; gap: 8px 12px; }
    .pl-news-text { grid-column: 1 / -1; }
    .pl-btn { min-width: 100%; }
    .pl-btn-sm, .pl-btn-sticky { min-width: 0; }
    .pl-deco-leaf-l, .pl-deco-leaf-r, .pl-deco-sun { display: none; }
    .pl-foot-inner { gap: 24px; }
  }

  /* ══════════════════════════════════════════════════════════
     アニメーション

     方針：モチーフ（木漏れ日・葉・見守る）に沿った3種類だけ。
     ブリーフの「過度なアニメーション」「派手な変形」を避けるため、
     振れ幅は肉眼でぎりぎり分かる程度に抑えている。

     JavaScript は使わない。スクロール連動は CSS の animation-timeline: view()。
     未対応ブラウザ（Firefox・一部Safari）では @supports が効かず
     アニメーションが付かないだけで、要素は最初から見えている。
     ── 初期状態を透明にしないのはこのため。消えたまま戻らない事故を防ぐ。
     ══════════════════════════════════════════════════════════ */

  /* ① 木漏れ日：ヒーローの光がゆっくり移ろう */
  .pl-hero-media { position: relative; }
  .pl-hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: url(#pl-hero-clip);
    background:
      radial-gradient(38% 46% at 22% 16%, rgba(255, 255, 255, 0.34), transparent 62%),
      radial-gradient(26% 34% at 70% 6%, rgba(255, 251, 232, 0.3), transparent 66%),
      radial-gradient(20% 26% at 46% 30%, rgba(255, 255, 255, 0.2), transparent 70%);
    mix-blend-mode: soft-light;
    pointer-events: none;
    opacity: 0.7;
  }

  /* ② 葉と花のゆらぎ：風がわずかに触れる程度 */
  @keyframes pl-sway {
    from { rotate: -1.2deg; }
    to   { rotate: 1.4deg; }
  }
  @keyframes pl-komorebi {
    from { opacity: 0.5; transform: translate3d(0, 0, 0) scale(1); }
    to   { opacity: 0.95; transform: translate3d(2.6%, 1.6%, 0) scale(1.06); }
  }
  /* ③ スクロールでの立ち上がり：下から静かに現れる */
  @keyframes pl-rise {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pl-hero-media::after {
      animation: pl-komorebi 19s ease-in-out infinite alternate;
    }
    .pl-deco-flower-bl { transform-origin: 12% 88%; animation: pl-sway 11s ease-in-out infinite alternate; }
    .pl-deco-flower-tr { transform-origin: 88% 12%; animation: pl-sway 13s ease-in-out -4s infinite alternate; }
    .pl-deco-leaf-l    { transform-origin: 20% 80%; animation: pl-sway 15s ease-in-out -2s infinite alternate; }
    .pl-deco-leaf-r    { transform-origin: 80% 80%; animation: pl-sway 17s ease-in-out -7s infinite alternate; }
    .pl-deco-bird      { transform-origin: 50% 70%; animation: pl-sway 9s  ease-in-out -3s infinite alternate; }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pl-h2,
      .pl-sec-lead,
      .pl-about-text,
