---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

/*
  プルメリア 総合トップ ラフ「1a 信頼感」（/lab/demos/plumeria/1a）

  - 出典ワイヤー: Claude Design project 6994e837-c54f-420d-a714-f1832f1ebef0
      ／「プルメリア 1a 信頼感.dc.html」（index 総合トップ・PC/SP）
  - デザイン方針: 支給されたデザインブリーフ（森・木漏れ日・地域拠点／やさしい安心感）に準拠。
      参照サイト c-morinosato.com は「雰囲気の参考」であり、ロゴ・木の形・イラスト・写真・
      文言は一切複製していない。モチーフはすべてこのファイル内で書き起こしたオリジナルSVG。
  - 用途: プルメリア様への提出用ラフ。電話番号・空室状況・お知らせは仮
  - 写真: ボスが用意したプロンプトで生成された画像を支給。
      元PNG 26.1MB を WebP へ変換して public/images/plumeria/ に配置（合計 497KB）。
      これらは「イメージ写真」であり、実際の施設・スタッフではない。
      提案時にその旨を明示すること。
  - JavaScript: ヒーロースライダーのためだけに解禁（自前・素のJS。jQuery / slick は使わない）。
      それ以外は引き続きJSなし。スクロール連動は CSS の animation-timeline: view()、
      モバイルメニューは <details> のまま。
      JSが落ちてもヒーローは1枚目が出て、操作UIは隠れたままになる。
  - アニメーション: ボス指示により解禁。モチーフに沿った3種のみ（木漏れ日／葉のゆらぎ／立ち上がり）。
      ブリーフの「過度なアニメーション」を避けるため振れ幅は最小限。
      prefers-reduced-motion: reduce で全停止する。
  - 大きさの方針: 施設カード（.pl-svc）は基準サイズを維持し、それ以外を一段落とす。

  【ブリーフとの相違点（1点だけ・意図的）】
  ブリーフは「メインCTAはミントグリーン(#349F87)＋白文字」だが、この組み合わせは
  コントラスト比 3.25:1 で通常サイズの文字ではWCAG AAに届かない。
  大きい文字（18.66px以上の太字）なら3:1基準を満たすため、
  主要CTAは #349F87 のまま文字を19px/700に拡大して両立させている。
  文字が小さくなるヘッダーCTAだけは同系の濃いめ #257562 を使う。
*/

const title = 'プルメリア｜サービス付き高齢者向け住宅・ショートステイ・訪問看護';
const description =
  'プルメリアは、サービス付き高齢者向け住宅・ショートステイ・訪問看護・レンタル介護用品を運営しています。見学・入居のご相談を承ります。';

// ── 差し替え枠：法人情報 ─────────────────────────────────
const corp = {
  name: 'プルメリア',
  nameEn: 'PLUMERIA',
  tel: '000-000-0000',
  telHref: 'tel:0000000000',
  contactHref: '#contact',
  address: '○○県○○市○○ 0-0-0（住所は差し替え枠）',
};

// ── ヒーロースライダー ───────────────────────────────────
// 参照サイトと同じ「4枚・フェード・5秒・切替0.7秒・ドット・矢印なし」の挙動。
// 実装は自前の素のJS（jQuery / slick は使わない）。
// 1枚目だけ即読み込み、2枚目以降は初回描画が終わってから data-src を差し込む。
const heroSlides = [
  { img: '/images/plumeria/hero-01.webp', label: '入居者とスタッフ',
    alt: '建物のエントランス付近で、入居者とスタッフが穏やかに話している様子' },
  { img: '/images/plumeria/hero-02.webp', label: '建物の外観',
    alt: '朝の光のなか、植栽に囲まれた低層の建物とアプローチ' },
  { img: '/images/plumeria/hero-03.webp', label: '共用リビング',
    alt: '明るい共用リビングで、入居者がそれぞれ読書やお茶をして過ごしている様子' },
  { img: '/images/plumeria/hero-04.webp', label: 'スタッフ',
    alt: '施設の廊下で、介護スタッフ3名が仕事の合間に会話している様子' },
];

// ── 差し替え枠：5つのサービス ────────────────────────────
// tone は写真枠の地色だけに使う。枠線・文字・ボタンは緑と濃色に統一する
const services = [
  { name: 'プルメリアⅠ', short: 'Ⅰ', kind: 'サービス付き高齢者向け住宅', status: '空室あり', open: true, tone: 'mint', icon: 'home', id: 'service-1',
    img: '/images/plumeria/services-01.webp', alt: '窓から光の入る居室で、入居者が自分らしく過ごしている様子' },
  { name: 'プルメリアⅡ', short: 'Ⅱ', kind: 'サービス付き高齢者向け住宅', status: '満室', open: false, tone: 'mint', icon: 'home', id: 'service-2',
    img: '/images/plumeria/services-02.webp', alt: '共用ラウンジで入居者どうしが穏やかに会話している様子' },
  { name: 'プルメリアⅢ', short: 'Ⅲ', kind: 'ショートステイ', status: '受入可', open: true, tone: 'beige', icon: 'bed', id: 'service-3',
    img: '/images/plumeria/services-03.webp', alt: '短期滞在の方を居室の入口で迎えているスタッフ' },
  { name: '訪問看護', short: '訪問看護', kind: '看護師がご自宅へ訪問します', status: '', open: null, tone: 'mint', icon: 'care', id: 'service-4',
    img: '/images/plumeria/services-04.webp', alt: 'ご自宅のリビングで看護師が健康状態を確認している様子' },
  { name: 'レンタル介護用品', short: 'レンタル', kind: '福祉用具貸与', status: '', open: null, tone: 'beige', icon: 'chair', id: 'service-5',
    img: '/images/plumeria/services-05.webp', alt: '歩行器の使い方をスタッフが説明している様子' },
];

// ── 差し替え枠：対応時間 ─────────────────────────────────
const hours = [
  { label: '見学・ご相談の受付', weekday: '9:00〜18:00', saturday: '9:00〜12:00', sunday: '－' },
  { label: 'お電話でのお問い合わせ', weekday: '9:00〜18:00', saturday: '9:00〜17:00', sunday: '－' },
  { label: '訪問看護', weekday: '9:00〜17:00', saturday: '要相談', sunday: '要相談' },
];

// ── 差し替え枠：強み（3項目）─────────────────────────────
const reasons = [
  { icon: 'staff', title: '寄り添う対応', body: '日中は職員が常駐しています。困りごとをその場でうかがい、ご家族にもお伝えします。（体制の詳細は差し替え枠）',
    img: '/images/plumeria/feature-01.webp', alt: '入居者とスタッフが同じ目線の高さで話している様子' },
  { icon: 'care', title: '専門的な支援', body: '訪問看護を自社で運営しています。看護と介護を切り離さずにお預かりできます。（連携先は差し替え枠）',
    img: '/images/plumeria/feature-02.webp', alt: '看護師と介護スタッフが情報を共有している様子' },
  { icon: 'sprout', title: '自宅からの相談', body: 'ご来所前に、お電話とフォームでご相談いただけます。用品のレンタルまで同じ窓口で承ります。',
    img: '/images/plumeria/feature-03.webp', alt: 'ご家族が自宅のダイニングで相談している様子' },
];

// ── 差し替え枠：一日の流れ ───────────────────────────────
const day = [
  { time: '7:00', label: '起床・朝食' },
  { time: '10:00', label: '健康チェック' },
  { time: '12:00', label: '昼食' },
  { time: '15:00', label: '自由時間' },
  { time: '18:00', label: '夕食' },
  { time: '21:00', label: '消灯' },
];

// ── 差し替え枠：お知らせ（カテゴリ付き）──────────────────
const news = [
  { date: '2026.08.00', cat: 'お知らせ', catTone: 'green', text: '（お知らせの見出しが入ります）' },
  { date: '2026.07.00', cat: '空室情報', catTone: 'accent', text: '（お知らせの見出しが入ります）' },
  { date: '2026.07.00', cat: '採用', catTone: 'beige', text: '（お知らせの見出しが入ります）' },
];

const vacancy = [
  { name: 'プルメリアⅠ', status: '空室あり', open: true },
  { name: 'プルメリアⅡ', status: '満室', open: false },
  { name: 'プルメリアⅢ', status: '受入可', open: true },
];

const access = [
  { key: 'お車でお越しの方', body: '○○インターより約0分。駐車場0台（差し替え枠）' },
  { key: '電車・バスでお越しの方', body: '○○線 ○○駅より徒歩0分／○○バス停下車すぐ（差し替え枠）' },
];

const footerLinks = [
  { label: 'アクセス・地図', href: '#access' },
  { label: '料金・重要事項説明書', href: '#price' },
  { label: '法人概要', href: '#company' },
  { label: 'プライバシーポリシー', href: '#privacy' },
];
---

<BaseLayout title={title} description={description} noindex={true} showSiteChrome={false}>
  {/* data-reveal="off": BaseLayout の共通スクロール表示スクリプトが .pl-card を
      自動で対象にしてしまうため除外する。このラフはJavaScript非依存を条件にしている。 */}
  <div class="pl" data-reveal="off">
    {/* モチーフはすべてここで定義したオリジナルの線画。外部画像は使わない。 */}
    <svg class="pl-defs" aria-hidden="true" focusable="false">
      <defs>
        {/* ヒーローの下辺をゆるやかな丘の線で切り抜く */}
        <clipPath id="pl-hero-clip" clipPathUnits="objectBoundingBox">
          <path d="M0,0 H1 V0.82 C0.78,0.97 0.56,0.86 0.34,0.93 C0.20,0.97 0.09,1 0,1 Z" />
        </clipPath>

        <symbol id="pl-i-home" viewBox="0 0 24 24">
          <path d="M4 10.8 12 4.5l8 6.3V19a1.6 1.6 0 0 1-1.6 1.6h-3.2v-5.4H8.8v5.4H5.6A1.6 1.6 0 0 1 4 19z" />
        </symbol>
        <symbol id="pl-i-bed" viewBox="0 0 24 24">
          <path d="M3 18.5v-9M3 13.2h18v5.3M21 18.5v-4.1a3 3 0 0 0-3-3h-5.6v1.8" />
          <circle cx="7.4" cy="11.4" r="1.9" />
        </symbol>
        <symbol id="pl-i-care" viewBox="0 0 24 24">
          <path d="M12 19.6s-6.3-4.1-6.3-8.4A3.5 3.5 0 0 1 12 8.8a3.5 3.5 0 0 1 6.3 2.4c0 4.3-6.3 8.4-6.3 8.4Z" />
          <path d="M9.4 12.8h1.5l.9-1.7.9 3.1.9-1.4h1.6" />
        </symbol>
        <symbol id="pl-i-chair" viewBox="0 0 24 24">
          <circle cx="10" cy="16.8" r="3.9" />
          <path d="M10 4.4v8.9h5.9l2.9 4.9M8.1 7.2h3.9" />
        </symbol>
        <symbol id="pl-i-staff" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="3.1" />
          <path d="M5.2 19.8a6.8 6.8 0 0 1 13.6 0" />
        </symbol>
        {/* 葉 */}
        <symbol id="pl-i-leaf" viewBox="0 0 24 24">
          <path d="M5 19.2C5 11.4 9.8 5.4 19 5.4c0 9.2-6.1 13.8-14 13.8Z" />
          <path d="M5 19.2c2.9-4.9 6-7.9 10.9-9.8" />
        </symbol>
        {/* 若葉・芽吹き */}
        <symbol id="pl-i-sprout" viewBox="0 0 24 24">
          <path d="M12 20.5v-7.2" />
          <path d="M12 13.3C12 9.6 9.4 7 5.7 7c0 3.7 2.6 6.3 6.3 6.3Z" />
          <path d="M12 12.4c0-3.2 2.2-5.4 5.4-5.4 0 3.2-2.2 5.4-5.4 5.4Z" />
        </symbol>
        {/* 木 */}
        <symbol id="pl-i-tree" viewBox="0 0 24 24">
          <path d="M12 20.6v-6.4" />
          <path d="M12 14.2 8.2 10.7M12 12.4l3.5-3.2" />
          <path d="M12 3.6c3.6 0 6.2 2.6 6.2 5.7 0 3-2.6 5.2-6.2 5.2S5.8 12.3 5.8 9.3c0-3.1 2.6-5.7 6.2-5.7Z" />
        </symbol>
        {/* 小鳥 */}
        <symbol id="pl-i-bird" viewBox="0 0 24 24">
          <path d="M4.2 14.6c0-3.1 2.5-5.6 5.6-5.6h3.4l3.1-2.6v2.6h2.1c.9 0 1.6.7 1.6 1.6 0 2.1-1.7 3.8-3.8 3.8h-1.1l-2.6 5.1H9.8l1-3.6a5.6 5.6 0 0 1-6.6-1.3Z" />
          <path d="M16.2 10.4h.02" />
        </symbol>
        {/* 木漏れ日（丸の集まり） */}
        <symbol id="pl-i-sun" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 3.4v2.1M12 18.5v2.1M3.4 12h2.1M18.5 12h2.1M6 6l1.5 1.5M16.5 16.5 18 18M18 6l-1.5 1.5M7.5 16.5 6 18" />
        </symbol>
      </defs>
    </svg>

    <p class="pl-notice">
      これはご提案用のラフです。写真・電話番号・空室状況・お知らせはすべて仮置きの枠で、
      情報が未確定のセクションは図形とプレースホルダで構成しています。
    </p>

    <!-- ヘッダー -->
    <header class="pl-head">
      <div class="pl-head-inner">
        <a class="pl-brand" href="#top">
          <span class="pl-brand-mark" aria-hidden="true"><svg><use href="#pl-i-sprout" /></svg></span>
          <span class="pl-brand-text">
            <span class="pl-brand-name">{corp.name}</span>
            <span class="pl-brand-en">{corp.nameEn}</span>
          </span>
        </a>

        <nav class="pl-nav" aria-label="サービス">
          {services.map((s) => (
            <a href={`#${s.id}`}>
              <span class="pl-nav-icon" aria-hidden="true"><svg><use href={`#pl-i-${s.icon}`} /></svg></span>
              <span class="pl-nav-label">{s.short}</span>
            </a>
          ))}
        </nav>

        <div class="pl-head-cta">
          {/* 緊急性のある連絡手段は濃いフォレストグリーンで別枠にする */}
          <a class="pl-btn pl-btn-ink pl-btn-sm" href={corp.telHref}>
            <span class="pl-btn-label">お電話</span>
            <span class="pl-num-face pl-head-tel">{corp.tel}</span>
          </a>
          <a class="pl-btn pl-btn-deep pl-btn-sm" href={corp.contactHref}>見学のご予約</a>
        </div>

        <details class="pl-menu">
          <summary aria-label="メニューを開く"><span class="pl-menu-bars" aria-hidden="true"></span></summary>
          <nav class="pl-menu-list" aria-label="メニュー（モバイル）">
            {services.map((s) => (
              <a href={`#${s.id}`}>
                <span class="pl-nav-icon" aria-hidden="true"><svg><use href={`#pl-i-${s.icon}`} /></svg></span>
                {s.name}
              </a>
            ))}
            <a href="#about"><span class="pl-nav-icon" aria-hidden="true"><svg><use href="#pl-i-tree" /></svg></span>プルメリアについて</a>
            <a href="#news"><span class="pl-nav-icon" aria-hidden="true"><svg><use href="#pl-i-bird" /></svg></span>お知らせ</a>
            <a href="#access"><span class="pl-nav-icon" aria-hidden="true"><svg><use href="#pl-i-home" /></svg></span>アクセス・対応時間</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="top">
      <!-- 01 ファーストビュー -->
      <section class="pl-hero">
        <div class="pl-hero-media">
          {/* いずれも被写体が左寄りで右に余白のある構図。見出しは右側に置く。
              JSが動かない場合は1枚目だけが見える静止ヒーローになる（ドットも出ない）。 */}
          <div class="pl-slider" data-pl-slider>
            {heroSlides.map((s, i) => (
              <img
                class={i === 0 ? 'pl-hero-photo is-on' : 'pl-hero-photo'}
                src={i === 0 ? s.img : undefined}
                data-src={i === 0 ? undefined : s.img}
                alt={s.alt}
                width="1600"
                height="900"
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding="async"
                aria-hidden={i === 0 ? undefined : 'true'}
              />
            ))}

            <div class="pl-slider-ui">
              <ul class="pl-dots">
                {heroSlides.map((s, i) => (
                  <li>
                    <button type="button" class={i === 0 ? 'pl-dot is-on' : 'pl-dot'}
                            data-pl-dot={String(i)} aria-current={i === 0 ? 'true' : 'false'}>
                      <span class="pl-sr">{s.label}を表示</span>
                    </button>
                  </li>
                ))}
              </ul>
              {/* 自動で切り替わる内容は止められる必要がある（WCAG 2.2.2） */}
              <button type="button" class="pl-slider-toggle" data-pl-toggle data-playing="true">
                <span class="pl-slider-toggle-icon" aria-hidden="true"></span>
                <span class="pl-sr" data-pl-toggle-label>スライドショーを停止</span>
              </button>
            </div>
          </div>
        </div>
        <div class="pl-wrap pl-hero-inner">
          <div class="pl-hero-copy">
            <p class="pl-eyebrow">
              <span class="pl-eyebrow-mark" aria-hidden="true"><svg><use href="#pl-i-leaf" /></svg></span>
              地域で暮らしを見守る
            </p>
            <h1 class="pl-h1">温かい心と笑顔で、<br />安らぎの毎日を。</h1>
            <p class="pl-hero-lead">住まいと看護と用品を、ひとつづきでお預かりします。</p>
            <div class="pl-btn-row">
              <a class="pl-btn pl-btn-main" href={corp.contactHref}>見学・入居のご相談</a>
              <a class="pl-btn pl-btn-outline" href={corp.telHref}>
                <span class="pl-btn-label">お電話でのご相談</span>
                <span class="pl-num-face pl-btn-tel-no">{corp.tel}</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 お知らせ -->
      <section class="pl-sec pl-sec-tight" id="news">
        <div class="pl-wrap">
          <h2 class="pl-h2"><span class="pl-h2-en">NEWS</span>お知らせ</h2>
          <ul class="pl-news">
            {news.map((n) => (
              <li>
                <span class="pl-num-face pl-news-date">{n.date}</span>
                <span class={`pl-cat pl-cat-${n.catTone}`}>{n.cat}</span>
                <span class="pl-news-text">{n.text}</span>
              </li>
            ))}
          </ul>
          <a class="pl-more" href="#news-index">お知らせ一覧</a>
        </div>
      </section>

      <!-- 丘の切り替え -->
      <div class="pl-hill pl-hill-to-mint" aria-hidden="true">
        <svg viewBox="0 0 1440 90" preserveAspectRatio="none"><path d="M0 90V44c220-34 430 20 700 12S1230 8 1440 30v60Z" /></svg>
      </div>

      <!-- 03 プルメリアについて -->
      <section class="pl-about" id="about">
        {/* 社名のプルメリアを実際の植物画で。抽象SVGの木より brand に近い */}
        <img class="pl-deco-flower pl-deco-flower-bl" src="/images/plumeria/decoration-bl.webp" alt=""
             width="520" height="515" loading="lazy" decoding="async" aria-hidden="true" />
        <span class="pl-deco pl-deco-bird" aria-hidden="true"><svg><use href="#pl-i-bird" /></svg></span>
        <span class="pl-deco pl-deco-sun" aria-hidden="true"><svg><use href="#pl-i-sun" /></svg></span>
        <div class="pl-wrap pl-about-inner">
          <div class="pl-about-text">
            <p class="pl-eyebrow"><span class="pl-eyebrow-mark" aria-hidden="true"><svg><use href="#pl-i-sprout" /></svg></span>ABOUT</p>
            <h2 class="pl-about-catch">住まい、看護、暮らしの道具。<br />別々にしないほうが、たぶん楽です。</h2>
            <p class="pl-body pl-about-body">
              住む場所を探し、看護の相談先を探し、用品の手配先を探す。
              ご本人にもご家族にも、その往復はけっこうな負担になります。
              プルメリアは5つのサービスを、ひとつの窓口でお預かりしています。
            </p>
            <p class="pl-note">※ 理念・沿革はご提供いただいた内容に差し替えます。</p>
          </div>
          <img class="pl-about-photo" src="/images/plumeria/about-01.webp" alt="窓辺の椅子に座る入居者とスタッフが穏やかに話している共用リビング"
