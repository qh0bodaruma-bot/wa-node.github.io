---
import PlumeriaLayout from '../../../../../layouts/PlumeriaLayout.astro';
import { routes, magazineIssues, magazineListUrl } from '../../../../../data/plumeria';
---
<PlumeriaLayout
  title="プルメリアだより｜プルメリア（デモ）"
  description="毎月発行しているプルメリアだよりのご案内です。行事や暮らしの様子、介護のはなしを掲載しています。"
  currentPath={routes.magazine}
>
  <div class="pl-wrap" style="padding-top:28px">
    <p class="pl-breadcrumb">
      <a href={routes.top}>トップ</a>
      <span aria-hidden="true">/</span>
      <span>プルメリアだより</span>
    </p>
  </div>

  <section class="pl-sec pl-sec-tight">
    <div class="pl-wrap pl-reading">
      <h1 class="pl-h1">プルメリアだより</h1>
      <p class="pl-sec-lead">
        毎月発行しているプルメリアだよりでは、毎月の行事や暮らしの様子、介護のはなしなどをご紹介しています。
      </p>
      <p class="pl-body">ショートステイのイベント予定も、プルメリアだよりでご確認いただけます。</p>
    </div>
  </section>

  <section class="pl-sec">
    <div class="pl-wrap pl-reading">
      <h2 class="pl-h2">バックナンバー</h2>
      <ul class="pl-news">
        {magazineIssues.map((issue, i) => (
          <li>
            {i === 0 && <span class="pl-cat pl-cat-green">最新号</span>}
            <span class="pl-news-text">
              <a href={issue.url} data-astro-reload>{issue.title}（PDF）</a>
            </span>
          </li>
        ))}
      </ul>
      <p class="pl-note" style="margin-top:14px">
        <a href={magazineListUrl} data-astro-reload>バックナンバーの一覧を見る（現在の公式サイト）→</a>
      </p>
      <p class="pl-note">
        PDFは現在の公式サイトで配信されているものです（2026年9月16日確認）。本番サイトでは、このページから直接配信する形に切り替えます。
      </p>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige">
    <div class="pl-wrap pl-reading">
      <h2 class="pl-h2">施設からのお知らせ</h2>
      <p class="pl-body">プルメリアだよりの発行は、トップページのお知らせ欄でもご案内しています。</p>
      <a class="pl-more" href={`${routes.top}#news`}>お知らせを見る →</a>
    </div>
  </section>
</PlumeriaLayout>
