  /* ══ アニメーション ══════════════════════════════
     JSが有効なときだけ初期状態を隠す。無ければ最初から見える。 */
  .pb.is-js [data-rv] { opacity: 0; transform: translateY(26px); }
  .pb [data-rv] {
    transition: opacity 0.7s var(--e2) var(--d, 0ms), transform 0.8s var(--e) var(--d, 0ms);
  }
  .pb [data-rv].is-in { opacity: 1; transform: none; }

  /* 1文字ずつのスタガー表示。行の下から立ち上がる */
  .pb-split { display: inline-flex; flex-wrap: wrap; overflow: hidden; vertical-align: bottom; }
  .pb-split > span { display: inline-block; }
  .pb.is-js .pb-split > span:not(.pb-sr) { transform: translateY(110%); opacity: 0; }
  .pb .pb-split > span:not(.pb-sr) {
    transition:
      transform 0.55s var(--e) calc(var(--i, 0) * 34ms + var(--d, 0ms)),
      opacity 0.5s var(--e2) calc(var(--i, 0) * 34ms + var(--d, 0ms));
  }
  .pb .is-in .pb-split > span:not(.pb-sr) { transform: none; opacity: 1; }
  /* ヒーロー下部の Scroll だけは監視対象外なので最初から出す */
  .pb.is-js .pb-split-static > span { transform: none; opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .pb [data-rv], .pb .pb-split > span { transition: none !important; opacity: 1 !important; transform: none !important; }
    .pb * { animation: none !important; }
