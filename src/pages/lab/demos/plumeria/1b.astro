  .pb a:not([class]) { color: inherit; }
  .pb-defs { position: absolute; width: 0; height: 0; }

  .pb svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 英字・数字は和文と別書体にする（参照サイトと同じ作法） */
  .pb-num, .pb-en {
    font-family: 'Archivo', 'Noto Sans JP', sans-serif;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .pb-en { font-size: 12px; letter-spacing: 0.14em; color: var(--green-deep); }

  .pb-sr {
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0;
  }

  .pb-wrap { width: min(100% - 40px, var(--wrap)); margin-inline: auto; }
  .pb-body { font-size: 16px; }
  .pb-note { font-size: 13px; line-height: 1.9; color: var(--muted); }
