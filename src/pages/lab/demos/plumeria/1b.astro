// ── 差し替え枠：法人の客観情報 ───────────────────────────
// 数値には対象時点・算出範囲を必ず添える
const facts = [
  { num: '○○○○', unit: '年', label: '設立', note: '（登記上の設立年）' },
  { num: '○', unit: '拠点', label: '運営する施設・事業所', note: '（○○○○年○月現在）' },
