<script>
  // 表示アニメーション。JSが無い/失敗した場合は .is-js が付かず、初期状態を隠さないので
  // 内容はすべて見える（プログレッシブエンハンスメント）。
  (() => {
    const root = document.querySelector('.pb');
    if (!root) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    root.classList.add('is-js');

    const targets = root.querySelectorAll('[data-rv]');
    if (!('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-in'));
      return;
    }

    let delivered = false;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          delivered = true;
          e.target.classList.add('is-in');
          io.unobserve(e.target); // 一度出したら戻さない（往復させると読みにくい）
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
    );
    targets.forEach((el) => io.observe(el));

    // ヒーローは監視を待たずに出す（requestAnimationFrame は
    // 描画されていないタブで発火しないため、同期で付ける）
    root.querySelectorAll('.pb-hero [data-rv]').forEach((el) => el.classList.add('is-in'));

    // 安全弁：監視が一度も発火しない環境（描画されないタブ等）では
    // 内容が隠れたままになるので、一定時間後にすべて表示する。
    window.setTimeout(() => {
      if (delivered) return;
      targets.forEach((el) => el.classList.add('is-in'));
    }, 2500);
  })();
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Archivo:wght@400;500;600;700&display=swap');

  .pb {
    /* ── 配色（参照サイトの実測値に寄せた）────────────────
