    --wrap: 1160px;
    --r: 14px;
    --r-sm: 7px;

    /* 参照サイトで支配的だったイージング */
    --e: cubic-bezier(0.26, 0.06, 0, 1);
    --e2: cubic-bezier(0.47, 0.16, 0.24, 1);
    --e3: cubic-bezier(0.43, 0.05, 0.17, 1);

    font-family: 'Noto Sans JP', 'ヒラギノ角ゴ ProN', 'Hiragino Kaku Gothic ProN',
      'Yu Gothic Medium', 'YuGothic', Meiryo, sans-serif;
    font-size: 17px;
    line-height: 2;
    letter-spacing: 0.04em;
    color: var(--ink);
    background: var(--bg);
    padding-bottom: 96px;
    overflow-x: hidden;
  }

  .pb :is(h1, h2, h3, p, ul, ol, dl, dd, figure, table, blockquote) { margin: 0; }
  .pb :is(ul, ol) { padding: 0; list-style: none; }
