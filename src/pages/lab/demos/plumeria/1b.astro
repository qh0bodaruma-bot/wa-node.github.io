      電話番号・住所・空室状況・数値・お知らせはすべて仮置きの差し替え枠です。
    </p>

    <!-- ヘッダー -->
    <header class="pb-head">
      <div class="pb-head-inner">
        <a class="pb-brand" href="#top">
          <span class="pb-brand-mark" aria-hidden="true"><svg><use href="#pb-i-flower" /></svg></span>
          <span class="pb-brand-text">
            <span class="pb-brand-name">{corp.name}</span>
            <span class="pb-brand-sub">{corp.nameEn}</span>
          </span>
        </a>

        <nav class="pb-nav" aria-label="メインメニュー">
          <a href="#facilities"><span>施設を探す</span></a>
          <a href="#services"><span>サービスを探す</span></a>
          <a href="#values"><span>法人について</span></a>
          <a href="#news"><span>お知らせ</span></a>
          <a href="#recruit"><span>採用情報</span></a>
        </nav>

        <div class="pb-head-cta">
          <a class="pb-headtel" href={corp.telHref}>
            <span class="pb-headtel-icon" aria-hidden="true"><svg><use href="#pb-i-phone" /></svg></span>
            <span class="pb-headtel-body">
              <span class="pb-num pb-headtel-no">{corp.tel}</span>
              <span class="pb-headtel-hours">{corp.telHours}</span>
            </span>
          </a>
          <a class="pb-btn pb-btn-green pb-btn-sm" href="#contact">
            <span class="pb-btn-fill" aria-hidden="true"></span>
            <span class="pb-btn-label">見学・資料請求</span>
            <span class="pb-btn-dot" aria-hidden="true"><svg><use href="#pb-i-arrow" /></svg></span>
          </a>
        </div>

        <details class="pb-menu">
          <summary aria-label="メニューを開く"><span class="pb-menu-bars" aria-hidden="true"></span></summary>
          <nav class="pb-menu-list" aria-label="メニュー（モバイル）">
            <a href="#facilities"><span class="pb-mi" aria-hidden="true"><svg><use href="#pb-i-home" /></svg></span>施設を探す</a>
            <a href="#services"><span class="pb-mi" aria-hidden="true"><svg><use href="#pb-i-care" /></svg></span>サービスを探す</a>
            <a href="#values"><span class="pb-mi" aria-hidden="true"><svg><use href="#pb-i-flower" /></svg></span>大切にしていること</a>
            <a href="#company"><span class="pb-mi" aria-hidden="true"><svg><use href="#pb-i-shield" /></svg></span>法人概要・体制</a>
            <a href="#contact"><span class="pb-mi" aria-hidden="true"><svg><use href="#pb-i-doc" /></svg></span>見学・資料請求・ご相談</a>
            <a href="#news"><span class="pb-mi" aria-hidden="true"><svg><use href="#pb-i-clock" /></svg></span>お知らせ</a>
            <a href="#recruit"><span class="pb-mi" aria-hidden="true"><svg><use href="#pb-i-staff" /></svg></span>採用情報</a>
            <a href="#access"><span class="pb-mi" aria-hidden="true"><svg><use href="#pb-i-map" /></svg></span>アクセス</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="top">
      <!-- 01 ファーストビュー -->
      <section class="pb-hero">
        <div class="pb-wrap pb-hero-inner">
          {/* 写真の代わりに、有機的なブロブと線画で面をつくる */}
          <div class="pb-hero-art" aria-hidden="true" data-rv>
            <span class="pb-blob pb-blob-a"></span>
            <span class="pb-blob pb-blob-b"></span>
            <span class="pb-blob pb-blob-c"></span>
            <span class="pb-art pb-art-flower" style="--ai:0"><svg><use href="#pb-i-flower" /></svg></span>
            <span class="pb-art pb-art-home" style="--ai:1"><svg><use href="#pb-i-home" /></svg></span>
            <span class="pb-art pb-art-tree" style="--ai:2"><svg><use href="#pb-i-tree" /></svg></span>
            <span class="pb-art pb-art-hands" style="--ai:3"><svg><use href="#pb-i-hands" /></svg></span>
            <span class="pb-art pb-art-leaf" style="--ai:4"><svg><use href="#pb-i-leaf" /></svg></span>
          </div>

          <div class="pb-hero-copy" data-rv>
            <h1 class="pb-hero-catch">
              <span class="pb-split">
                <span class="pb-sr">{corp.catch}</span>
                {chars(corp.catch).map((o) => (<span aria-hidden="true" style={`--i:${o.i}`}>{o.c}</span>))}
              </span>
            </h1>

            <p class="pb-hero-sub">
              私たちは、住まい・在宅での看護と介護・暮らしの道具を、<br class="pb-br-pc" />
              ひとつの窓口でお預かりする{corp.kind}です。
            </p>

            <ul class="pb-hero-counts">
              {heroCounts.map((c, i) => (
                <li style={`--i:${i}`}>
                  <span class="pb-num pb-hero-count-num">{c.num}</span>
                  <span class="pb-hero-count-unit">{c.unit}</span>
                  <span class="pb-hero-dot" aria-hidden="true"></span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <span class="pb-scroll" aria-hidden="true">
          <span class="pb-split pb-split-static">
            {chars('Scroll').map((o) => (<span style={`--i:${o.i}`}>{o.c}</span>))}
          </span>
        </span>
      </section>

      <!-- 02 最優先の3導線 -->
      <section class="pb-sec pb-paths-sec">
        <div class="pb-wrap">
          <ul class="pb-paths">
            {primaryPaths.map((p, i) => (
              <li data-rv style={`--d:${i * 90}ms`}>
                <a class="pb-path" href={p.href}>
                  <span class="pb-path-fill" aria-hidden="true"></span>
                  <span class="pb-path-icon" aria-hidden="true"><svg><use href={`#pb-i-${p.icon}`} /></svg></span>
                  <span class="pb-path-text">
                    <span class="pb-en">{p.en}</span>
                    <span class="pb-path-label">{p.label}</span>
                    <span class="pb-path-body">{p.body}</span>
                  </span>
                  <span class="pb-dot" aria-hidden="true"><svg><use href="#pb-i-arrow" /></svg></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 03 法人の想い -->
      <section class="pb-sec pb-mind" id="mind">
        <span class="pb-blob pb-blob-mind" aria-hidden="true"></span>
        <div class="pb-wrap pb-mind-inner">
          <p class="pb-eyebrow" data-rv>
            <span class="pb-eyebrow-mark" aria-hidden="true"><svg><use href="#pb-i-flower" /></svg></span>
            <span class="pb-split">
              <span class="pb-sr">Message</span>
              {chars('Message').map((o) => (<span aria-hidden="true" style={`--i:${o.i}`}>{o.c}</span>))}
            </span>
            <span class="pb-eyebrow-ja">法人の想い</span>
          </p>

          <div class="pb-mind-body">
            <p class="pb-mind-line" data-rv style="--d:0ms">介護が必要になったとき、</p>
            <p class="pb-mind-line" data-rv style="--d:90ms">多くのご家族は、まず自分を責めます。</p>
            <p class="pb-mind-line" data-rv style="--d:180ms">もっと早く気づけたのではないか、と。</p>
            <p class="pb-mind-line pb-mind-gap" data-rv style="--d:0ms">けれど、暮らしを支える方法はひとつではありません。</p>
            <p class="pb-mind-line" data-rv style="--d:90ms">住み替えるという選択も、</p>
            <p class="pb-mind-line" data-rv style="--d:180ms">自宅のまま看護と介護を入れる方法もあります。</p>
            <p class="pb-mind-line" data-rv style="--d:270ms">短い期間だけお預かりして、ご家族が休むこともできます。</p>
            <p class="pb-mind-line pb-mind-gap pb-mind-strong" data-rv style="--d:0ms">私たちは、そのどれかを勧めるためではなく、</p>
            <p class="pb-mind-line pb-mind-strong" data-rv style="--d:90ms">ご本人が「これまでの自分」を手放さずにいられる形を、</p>
            <p class="pb-mind-line pb-mind-strong" data-rv style="--d:180ms">一緒に探すためにここにいます。</p>
          </div>

          <p class="pb-sign" data-rv>{corp.name}　代表　○○ ○○（差し替え枠）</p>
        </div>
      </section>

      <!-- 04 大切にしていること -->
      <section class="pb-sec pb-values" id="values">
        <div class="pb-wrap">
          <div class="pb-head2" data-rv>
            <p class="pb-eyebrow">
              <span class="pb-eyebrow-mark" aria-hidden="true"><svg><use href="#pb-i-leaf" /></svg></span>
              <span class="pb-split">
                <span class="pb-sr">Values</span>
                {chars('Values').map((o) => (<span aria-hidden="true" style={`--i:${o.i}`}>{o.c}</span>))}
              </span>
            </p>
            <h2 class="pb-h2">プルメリアの<br />大切にしていること</h2>
            <p class="pb-lead">言葉だけにならないよう、3つに絞って、やっていることを書いています。</p>
          </div>

          <ul class="pb-value-list">
            {values.map((v, i) => (
              <li class={`pb-value pb-tone-${v.tone}`} data-rv style={`--d:${i * 110}ms`}>
                <div class="pb-value-art" aria-hidden="true">
                  <span class="pb-blob pb-blob-value"></span>
                  <span class="pb-value-icon"><svg><use href={`#pb-i-${v.icon}`} /></svg></span>
                </div>
                <div class="pb-value-text">
                  <p class="pb-value-no"><span class="pb-num">{v.no}</span><span class="pb-en">{v.en}</span></p>
                  <h3 class="pb-h3">{v.title}</h3>
                  <ul class="pb-value-lines">
                    {v.lines.map((l) => (<li>{l}</li>))}
                  </ul>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 05 法人の歩みと体制 -->
      <section class="pb-sec pb-facts" id="company">
        <div class="pb-wrap">
          <div class="pb-head2" data-rv>
            <p class="pb-eyebrow">
              <span class="pb-eyebrow-mark" aria-hidden="true"><svg><use href="#pb-i-shield" /></svg></span>
              <span class="pb-split">
                <span class="pb-sr">About us</span>
                {chars('About us').map((o) => (<span aria-hidden="true" style={`--i:${o.i}`}>{o.c}</span>))}
              </span>
            </p>
            <h2 class="pb-h2">法人の歩みと体制</h2>
            <p class="pb-lead">確認できる事実だけを載せます。数値は対象時点と算出範囲を添えて出します。</p>
          </div>

          <ul class="pb-fact-list">
            {facts.map((f, i) => (
              <li class="pb-fact" data-rv style={`--d:${i * 80}ms`}>
                <p class="pb-fact-num">
                  <span class="pb-num">{f.num}</span><span class="pb-fact-unit">{f.unit}</span>
                  <span class="pb-fact-dot" aria-hidden="true"></span>
                </p>
                <p class="pb-fact-label">{f.label}</p>
                {f.label2 && <p class="pb-fact-label2">{f.label2}</p>}
                <p class="pb-fact-note">{f.note}</p>
              </li>
            ))}
          </ul>

          <dl class="pb-deflist pb-fact-def" data-rv>
            {structure.map((s) => (<div><dt>{s.dt}</dt><dd>{s.dd}</dd></div>))}
          </dl>
          <p class="pb-note" data-rv>
            ※ 法人概要（名称・設立・所在地・代表者・事業所一覧）は下層ページにまとめます。このラフでは枠のみ置いています。
          </p>
        </div>
      </section>

      <!-- 06 施設を探す -->
      <section class="pb-sec pb-facilities" id="facilities">
        <div class="pb-wrap">
          <div class="pb-head2" data-rv>
            <p class="pb-eyebrow">
              <span class="pb-eyebrow-mark" aria-hidden="true"><svg><use href="#pb-i-home" /></svg></span>
              <span class="pb-split">
                <span class="pb-sr">Facility</span>
                {chars('Facility').map((o) => (<span aria-hidden="true" style={`--i:${o.i}`}>{o.c}</span>))}
              </span>
            </p>
            <h2 class="pb-h2">施設を探す</h2>
            <p class="pb-lead">住まいと、短期の泊まり。受入状況は色だけでなく必ず文字でも示しています。</p>
          </div>

          <ul class="pb-fac-list">
            {facilities.map((f, i) => (
              <li class={`pb-fac pb-tone-${f.tone}`} id={f.id} data-rv style={`--d:${i * 110}ms`}>
                <div class="pb-fac-art" aria-hidden="true">
                  <span class="pb-blob pb-blob-fac"></span>
                  <span class="pb-fac-icon"><svg><use href={`#pb-i-${f.icon}`} /></svg></span>
                  <span class="pb-fac-leaf"><svg><use href="#pb-i-leaf" /></svg></span>
                </div>
                <div class="pb-fac-text">
                  <p class="pb-fac-kind">{f.kind}</p>
                  <h3 class="pb-fac-name">{f.name}</h3>
                  <p class="pb-fac-area"><span class="pb-fac-area-icon" aria-hidden="true"><svg><use href="#pb-i-map" /></svg></span>{f.area}</p>
                  <p class={`pb-status pb-status-${f.statusTone}`}>{f.status}</p>
                  <p class="pb-body">{f.body}</p>
                  <div class="pb-fac-links">
                    <a class="pb-btn pb-btn-outline pb-btn-sm" href="#">
                      <span class="pb-btn-fill" aria-hidden="true"></span>
                      <span class="pb-btn-label">施設のページを見る</span>
                      <span class="pb-btn-dot" aria-hidden="true"><svg><use href="#pb-i-arrow" /></svg></span>
                    </a>
                    <a class="pb-btn pb-btn-green pb-btn-sm" href="#contact">
                      <span class="pb-btn-fill" aria-hidden="true"></span>
                      <span class="pb-btn-label">見学を申し込む</span>
                      <span class="pb-btn-dot" aria-hidden="true"><svg><use href="#pb-i-arrow" /></svg></span>
                    </a>
                  </div>
                </div>
              </li>
            ))}
          </ul>

          <p class="pb-note pb-note-center" data-rv>
            ※ 空室・受入状況は○○○○年○月○日時点の予定です。更新のタイミングと担当は運用時に決めます。
          </p>
        </div>
      </section>

      <!-- 07 サービスを探す -->
      <section class="pb-sec pb-services" id="services">
        <div class="pb-wrap">
          <div class="pb-head2" data-rv>
            <p class="pb-eyebrow">
              <span class="pb-eyebrow-mark" aria-hidden="true"><svg><use href="#pb-i-care" /></svg></span>
              <span class="pb-split">
                <span class="pb-sr">Service</span>
                {chars('Service').map((o) => (<span aria-hidden="true" style={`--i:${o.i}`}>{o.c}</span>))}
              </span>
            </p>
            <h2 class="pb-h2">サービスを探す</h2>
            <p class="pb-lead">「いま困っていること」から選べるようにしています。</p>
          </div>

          <ul class="pb-sv-list">
            {services.map((s, i) => (
              <li class={`pb-sv pb-tone-${s.tone}`} id={s.id} data-rv style={`--d:${(i % 2) * 110}ms`}>
                <a class="pb-sv-link" href="#">
                  <span class="pb-sv-art" aria-hidden="true">
                    <span class="pb-blob pb-blob-sv"></span>
                    <span class="pb-sv-icon"><svg><use href={`#pb-i-${s.icon}`} /></svg></span>
                  </span>
                  <span class="pb-sv-text">
                    <span class="pb-sv-cat">{s.cat}</span>
                    <span class="pb-sv-name">{s.name}</span>
                    <span class="pb-sv-trouble">「{s.trouble}」という方へ</span>
                    <span class="pb-sv-body">{s.body}</span>
                  </span>
                  <span class="pb-dot pb-sv-dot" aria-hidden="true"><svg><use href="#pb-i-arrow" /></svg></span>
                </a>
              </li>
            ))}
          </ul>

          <p class="pb-note pb-note-center" data-rv>
            ※ 上記以外の事業（障がい児者支援など）を行っている場合は、この並びに追加します。
            当方で内容を推測して書かないため、実施事業をご教示ください。
          </p>
        </div>
      </section>

      <!-- 08 見学・資料請求・お問い合わせ -->
      <section class="pb-sec pb-contact" id="contact">
        <span class="pb-blob pb-blob-contact" aria-hidden="true"></span>
        <div class="pb-wrap">
          <div class="pb-head2" data-rv>
            <p class="pb-eyebrow">
              <span class="pb-eyebrow-mark" aria-hidden="true"><svg><use href="#pb-i-hands" /></svg></span>
              <span class="pb-split">
                <span class="pb-sr">Contact</span>
                {chars('Contact').map((o) => (<span aria-hidden="true" style={`--i:${o.i}`}>{o.c}</span>))}
              </span>
            </p>
            <h2 class="pb-h2">見学・資料請求・ご相談</h2>
            <p class="pb-lead">ご用件によって担当が変わります。近いものをお選びください。</p>
          </div>

          <ul class="pb-desk-list">
            {desks.map((d, i) => (
              <li class={`pb-desk pb-tone-${d.tone}`} data-rv style={`--d:${i * 100}ms`}>
                <p class="pb-desk-head">
                  <span class="pb-desk-icon" aria-hidden="true"><svg><use href={`#pb-i-${d.icon}`} /></svg></span>
                  <span class="pb-en">{d.en}</span>
                </p>
                <p class="pb-desk-title">{d.title}</p>
                <p class="pb-desk-target">{d.target}</p>
                <a class="pb-desk-tel" href={d.telHref}>
                  <span class="pb-desk-tel-icon" aria-hidden="true"><svg><use href="#pb-i-phone" /></svg></span>
                  <span class="pb-num pb-desk-tel-no">{d.tel}</span>
                </a>
                <p class="pb-desk-hours">
                  <span class="pb-desk-hours-icon" aria-hidden="true"><svg><use href="#pb-i-clock" /></svg></span>
                  受付 {d.hours}
                </p>
                <p class="pb-desk-staff">{d.staff}</p>
                <a class="pb-btn pb-btn-green pb-btn-block" href="#form">
                  <span class="pb-btn-fill" aria-hidden="true"></span>
                  <span class="pb-btn-label">{d.ctaLabel}</span>
                  <span class="pb-btn-dot" aria-hidden="true"><svg><use href="#pb-i-arrow" /></svg></span>
                </a>
              </li>
            ))}
          </ul>

          <div class="pb-form-block" id="form" data-rv>
            <div class="pb-form-text">
              <p class="pb-en pb-form-en">Form</p>
              <h3 class="pb-h3">フォームでのお申し込み</h3>
              <p class="pb-body">
                お名前・ご連絡先・ご用件をお送りいただければ、担当から折り返しご連絡します。
                お急ぎの場合はお電話のほうが早くつながります。
              </p>
              <p class="pb-form-doc-title">資料請求でお届けするもの</p>
              <ul class="pb-doclist">
                {docItems.map((d) => (
                  <li><span class="pb-doclist-mark" aria-hidden="true"><svg><use href="#pb-i-doc" /></svg></span>{d}</li>
                ))}
              </ul>
              <p class="pb-note">※ フォームは実装時に設置します。このラフでは動作しません。</p>
            </div>

            {/* 見た目の確認用。送信はしない */}
            <div class="pb-form-mock" aria-hidden="true">
              <p class="pb-form-mock-label">ご用件</p>
              <p class="pb-form-mock-field">見学のお申し込み　▼</p>
              <p class="pb-form-mock-label">お名前</p>
              <p class="pb-form-mock-field"></p>
              <p class="pb-form-mock-label">お電話番号</p>
              <p class="pb-form-mock-field"></p>
              <p class="pb-form-mock-label">ご相談内容</p>
              <p class="pb-form-mock-field pb-form-mock-area"></p>
              <p class="pb-form-mock-btn">送信する</p>
            </div>
          </div>

          <div class="pb-hours" id="access" data-rv>
            <p class="pb-en pb-form-en">Access</p>
            <h3 class="pb-h3">受付時間とアクセス</h3>
            <div class="pb-hours-grid">
              <div class="pb-table-wrap">
                <table class="pb-table">
                  <thead>
                    <tr><th scope="col">窓口</th><th scope="col">平日</th><th scope="col">土曜</th><th scope="col">日・祝</th></tr>
                  </thead>
                  <tbody>
                    {hours.map((h) => (
                      <tr>
                        <th scope="row">{h.label}</th>
                        <td class="pb-num">{h.weekday}</td>
                        <td class="pb-num">{h.saturday}</td>
                        <td class="pb-num">{h.sunday}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <div class="pb-access">
                <dl class="pb-deflist pb-deflist-sm">
                  {access.map((a) => (<div><dt>{a.dt}</dt><dd>{a.dd}</dd></div>))}
                </dl>
                <div class="pb-map" aria-hidden="true">
                  <span class="pb-map-icon"><svg><use href="#pb-i-map" /></svg></span>
                  <span class="pb-map-label">地図（実装時に埋め込み）</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 09 お知らせ -->
      <section class="pb-sec pb-news" id="news">
        <div class="pb-wrap">
          <div class="pb-news-head" data-rv>
            <div>
              <p class="pb-eyebrow">
                <span class="pb-eyebrow-mark" aria-hidden="true"><svg><use href="#pb-i-clock" /></svg></span>
                <span class="pb-split">
                  <span class="pb-sr">News</span>
                  {chars('News').map((o) => (<span aria-hidden="true" style={`--i:${o.i}`}>{o.c}</span>))}
                </span>
              </p>
              <h2 class="pb-h2">お知らせ</h2>
            </div>
            <a class="pb-more" href="#">
              <span>お知らせをすべて見る</span>
              <span class="pb-dot" aria-hidden="true"><svg><use href="#pb-i-arrow" /></svg></span>
            </a>
          </div>

          <ul class="pb-news-list">
            {news.map((n, i) => (
              <li data-rv style={`--d:${i * 70}ms`}>
                <a href="#">
                  <span class="pb-num pb-news-date">{n.date}</span>
                  <span class={`pb-cat pb-cat-${n.catTone}`}>{n.cat}</span>
                  <span class="pb-news-text">{n.text}</span>
