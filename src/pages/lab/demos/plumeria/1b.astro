    name: '福祉用具貸与（レンタル介護用品）',
    body: 'ベッド・車いす・歩行器などを、お住まいの状況に合わせてご用意します。',
    trouble: '段差や立ち上がりが、家の中で危ない',
    img: '/images/plumeria/services-05.webp',
    alt: '歩行器の使い方をスタッフが説明している様子',
  },
];

// ── 差し替え枠：目的別の相談窓口 ─────────────────────────
// ブリーフの「窓口を一つにまとめない」に対応。窓口ごとに担当・電話・受付時間を分ける
const desks = [
  {
    icon: 'home',
    tone: 'green',
    title: '入居・見学のご相談',
    target: 'サービス付き高齢者向け住宅／ショートステイ',
    tel: '000-000-0000',
    telHref: 'tel:0000000000',
    hours: '9:00〜18:00（日祝を除く）',
    staff: '担当：入居相談窓口（差し替え枠）',
    ctaLabel: '見学を申し込む',
  },
  {
    icon: 'care',
    tone: 'navy',
    title: '在宅サービス・ケアプランのご相談',
    target: '訪問看護／訪問介護／居宅介護支援',
    tel: '000-000-0000',
    telHref: 'tel:0000000000',
    hours: '9:00〜17:00（日祝を除く）',
    staff: '担当：ケアマネジャー・看護師（差し替え枠）',
    ctaLabel: '在宅の相談をする',
  },
  {
    icon: 'chair',
    tone: 'beige',
    title: '福祉用具・住まいの環境のご相談',
    target: '福祉用具貸与／住宅改修のご相談',
    tel: '000-000-0000',
    telHref: 'tel:0000000000',
    hours: '9:00〜17:00（日祝を除く）',
    staff: '担当：福祉用具専門相談員（差し替え枠）',
    ctaLabel: '用品について相談する',
  },
];

// ── 差し替え枠：資料請求で届くもの ───────────────────────
const docItems = [
  'パンフレット（施設のご案内）',
  '料金表・重要事項説明書',
  '見学の申込書',
];

// ── 差し替え枠：受付時間 ─────────────────────────────────
const hours = [
  { label: '見学・入居のご相談', weekday: '9:00〜18:00', saturday: '9:00〜12:00', sunday: '－' },
  { label: '在宅サービスのご相談', weekday: '9:00〜17:00', saturday: '要相談', sunday: '要相談' },
  { label: '訪問看護（緊急時の連絡）', weekday: '24時間', saturday: '24時間', sunday: '24時間' },
];

// ── 差し替え枠：お知らせ ─────────────────────────────────
const news = [
  { date: '2026.08.00', cat: 'お知らせ', catTone: 'green', text: '（お知らせの見出しが入ります）' },
  { date: '2026.08.00', cat: '空室情報', catTone: 'beige', text: '（空室・受入状況の更新見出しが入ります）' },
  { date: '2026.07.00', cat: '採用', catTone: 'navy', text: '（採用に関する見出しが入ります）' },
  { date: '2026.07.00', cat: '行事', catTone: 'green', text: '（施設の行事の見出しが入ります）' },
];

// ── 差し替え枠：採用 ─────────────────────────────────────
const recruitFacts = [
  { num: '○', unit: '年', label: '平均勤続年数', note: '（○○○○年○月現在・全職種）' },
  { num: '○○', unit: '%', label: '資格取得支援の利用率', note: '（○○○○年度・対象は常勤職員）' },
  { num: '○', unit: '日', label: '年間休日', note: '（○○○○年度・シフト制）' },
];

const recruitPolicy = [
  '本人の暮らしを、こちらの都合で決めない',
  '気づいたことは、その日のうちに共有する',
  '分からないことは、分からないと言える',
];

const recruitSupport = [
  { title: '研修', body: '入職時研修と、年間の内部研修（差し替え枠）。未経験の方は先輩職員が付きます。' },
  { title: '資格取得支援', body: '介護福祉士・実務者研修などの受講費用の支援制度（内容は差し替え枠）。' },
