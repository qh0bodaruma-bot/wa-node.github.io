  .pb-headtel-no { font-size: 24px; font-weight: 700; }
  .pb-headtel-hours { font-size: 10px; color: var(--muted); letter-spacing: 0.02em; }

  /* ── 01 ファーストビュー ─────────────────────── */
  .pb-hero { position: relative; padding-block: clamp(28px, 4vw, 56px) clamp(64px, 7vw, 104px); }
  .pb-hero-inner { position: relative; display: grid; gap: 30px; }

  .pb-hero-art { position: relative; height: clamp(280px, 44vw, 440px); }
  .pb-blob-a {
    width: 62%; aspect-ratio: 1.15; left: 4%; top: 4%;
    background: var(--green);
  }
  .pb-blob-b {
    width: 40%; aspect-ratio: 1; right: 2%; top: 26%;
    background: var(--mint);
  }
  .pb-blob-c {
    width: 26%; aspect-ratio: 1; left: 46%; bottom: -2%;
    background: var(--beige);
  }
  .pb-art { position: absolute; display: block; color: var(--ink); }
  .pb-art svg { width: 100%; height: 100%; stroke-width: 1.1; }
  .pb-art-flower { width: clamp(58px, 8.4vw, 96px); aspect-ratio: 1; left: 15%; top: 20%; color: #fff; }
  .pb-art-home   { width: clamp(46px, 6.6vw, 74px); aspect-ratio: 1; left: 36%; top: 46%; color: #fff; }
  .pb-art-tree   { width: clamp(44px, 6vw, 68px);   aspect-ratio: 1; right: 13%; top: 36%; }
  .pb-art-hands  { width: clamp(44px, 6vw, 68px);   aspect-ratio: 1; left: 49%; bottom: 6%; }
  .pb-art-leaf   { width: clamp(34px, 4.6vw, 52px); aspect-ratio: 1; left: 7%; bottom: 10%; color: var(--green-soft); }

  .pb-hero-copy { display: grid; justify-items: start; gap: 22px; }
  .pb-hero-catch {
    font-size: clamp(27px, 3.8vw, 42px);
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.1em;
  }
  .pb-hero-sub { font-size: 16px; color: var(--muted); line-height: 2.1; }
  .pb-br-pc { display: none; }

  .pb-hero-counts { display: flex; gap: 26px; flex-wrap: wrap; }
  .pb-hero-counts li { display: flex; align-items: baseline; gap: 5px; }
  .pb-hero-count-num { font-size: 34px; font-weight: 700; line-height: 1; }
  .pb-hero-count-unit { font-size: 13px; }
  .pb-hero-dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--green);
    align-self: center;
    transform: scale(0);
    transition: transform 0.5s var(--e) calc(var(--i) * 120ms + 400ms);
  }
  .pb .is-in .pb-hero-dot { transform: scale(1); }

  .pb-scroll {
    position: absolute;
    left: 22px; bottom: 16px;
    display: inline-flex;
    align-items: center;
    padding: 5px 15px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: 'Archivo', sans-serif;
    font-size: 11px; letter-spacing: 0.16em; color: var(--muted);
  }

  /* ── 02 3導線 ──────────────────────────────── */
  .pb-paths-sec { padding-block: 0 clamp(56px, 7vw, 96px); }
  .pb-paths { display: grid; gap: 16px; }
  .pb-path {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 20px 20px 22px;
    border-radius: var(--r);
    background: var(--paper);
    text-decoration: none;
    color: inherit;
    transition: color 0.3s var(--e);
  }
  .pb-path-fill {
    position: absolute; inset: 0; z-index: -1;
    background: var(--green-deep);
    transform: scaleY(0);
    transform-origin: bottom;
    border-radius: 999px 999px 0 0 / 80px 80px 0 0;
    transition: transform 0.5s var(--e), border-radius 0.4s var(--e3);
  }
  .pb-path:hover .pb-path-fill, .pb-path:focus-visible .pb-path-fill { transform: scaleY(1); border-radius: 0; }
  .pb-path:hover { color: #fff; }
  .pb-path:hover .pb-en, .pb-path:hover .pb-path-body { color: #fff; }
  .pb-path:hover .pb-path-icon { background: rgba(255, 255, 255, 0.22); color: #fff; border-radius: 44% 56% 62% 38% / 55% 42% 58% 45%; }
  .pb-path:hover .pb-dot { background: #fff; color: var(--green-deep); transform: translateX(3px); }
  .pb-path-icon {
    width: 56px; height: 56px; flex: none;
    display: grid; place-items: center;
    border-radius: 58% 42% 47% 53% / 44% 51% 49% 56%;
    background: var(--mint);
    color: var(--green-deep);
    transition: background-color 0.3s var(--e), color 0.3s var(--e), border-radius 0.6s var(--e);
  }
  .pb-path-icon svg { width: 26px; height: 26px; }
  .pb-path-text { display: grid; gap: 1px; min-width: 0; }
  .pb-path-label { font-size: 19px; font-weight: 700; line-height: 1.6; }
  .pb-path-body { font-size: 13px; color: var(--muted); line-height: 1.7; transition: color 0.3s var(--e); }
  .pb-path .pb-dot { margin-left: auto; }

  /* ── 見出し ─────────────────────────────────── */
  .pb-sec { padding-block: clamp(60px, 7.5vw, 104px); position: relative; }
  .pb-eyebrow { display: inline-flex; align-items: center; gap: 9px; }
  .pb-eyebrow .pb-split {
    font-family: 'Archivo', sans-serif;
    font-size: 13px; font-weight: 600; letter-spacing: 0.16em; color: var(--green-deep);
  }
  .pb-eyebrow-mark { width: 19px; height: 19px; flex: none; color: var(--green-deep); }
  .pb-eyebrow-mark svg { width: 19px; height: 19px; }
  .pb-eyebrow-ja { font-size: 13px; color: var(--muted); }

  .pb-h2 {
    font-size: clamp(24px, 2.8vw, 34px);
    font-weight: 700;
    line-height: 1.65;
    letter-spacing: 0.06em;
    margin-top: 12px;
  }
  .pb-h3 { font-size: 19px; font-weight: 700; line-height: 1.7; letter-spacing: 0.05em; }
  .pb-lead { font-size: 16px; color: var(--muted); margin-top: 14px; }
  .pb-head2 { margin-bottom: 44px; }
  .pb-head2 .pb-lead { max-width: 40em; }

  /* ── 03 法人の想い ───────────────────────────── */
  .pb-mind { overflow: hidden; }
  .pb-blob-mind {
    width: min(52vw, 540px); aspect-ratio: 1.2;
    right: -12%; top: 14%;
    background: var(--mint);
    opacity: 0.7;
  }
  .pb-mind-inner { position: relative; }
  .pb-mind-body { margin-top: 32px; display: grid; gap: 2px; }
  .pb-mind-line { font-size: clamp(17px, 1.8vw, 21px); line-height: 2.1; letter-spacing: 0.06em; }
  .pb-mind-gap { margin-top: 26px; }
  .pb-mind-strong { font-weight: 700; }
  .pb-sign { margin-top: 28px; font-size: 15px; color: var(--muted); }

  /* ── 04 大切にしていること ───────────────────── */
  .pb-value-list { display: grid; gap: 20px; }
  .pb-value {
    background: var(--paper);
    border-radius: var(--r);
    overflow: hidden;
    transition: transform 0.5s var(--e);
  }
  .pb-value:hover { transform: translateY(-4px); }
  .pb-value-art { position: relative; height: 164px; display: grid; place-items: center; }
  .pb-blob-value {
    position: absolute;
    width: 124px; aspect-ratio: 1;
    background: var(--mint);
    transition: border-radius 0.9s var(--e), transform 0.6s var(--e);
  }
  .pb-tone-green .pb-blob-value { background: #d6efd0; }
  .pb-tone-beige .pb-blob-value { background: var(--beige); }
  .pb-value:hover .pb-blob-value { border-radius: 44% 56% 62% 38% / 55% 42% 58% 45%; transform: scale(1.06); }
  .pb-value-icon { position: relative; width: 50px; height: 50px; color: var(--green-deep); }
  .pb-value-icon svg { width: 50px; height: 50px; stroke-width: 1.2; }
  .pb-value-text { padding: 4px 24px 30px; }
  .pb-value-no { display: flex; align-items: baseline; gap: 10px; }
  .pb-value-no .pb-num { font-size: 20px; color: var(--green-deep); }
  .pb-value-text .pb-h3 { margin-top: 4px; }
  .pb-value-lines { margin-top: 14px; display: grid; gap: 9px; }
  .pb-value-lines li { position: relative; padding-left: 20px; font-size: 15px; line-height: 1.9; }
  .pb-value-lines li::before {
    content: '';
    position: absolute; left: 2px; top: 12px;
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--green);
  }

  /* ── 05 法人の歩みと体制 ─────────────────────── */
  .pb-fact-list { display: grid; gap: 14px; }
  .pb-fact { background: var(--paper); border-radius: var(--r); padding: 26px 20px; }
  .pb-fact-num { display: flex; align-items: baseline; gap: 4px; line-height: 1.15; }
  .pb-fact-num .pb-num { font-size: 36px; font-weight: 700; }
  .pb-fact-unit { font-size: 15px; }
  .pb-fact-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--green);
    align-self: center; margin-left: 4px;
    transform: scale(0);
    transition: transform 0.5s var(--e) calc(var(--d, 0ms) + 320ms);
  }
  .pb .is-in .pb-fact-dot { transform: scale(1); }
  .pb-fact-label { font-size: 15px; font-weight: 700; margin-top: 8px; line-height: 1.7; }
  .pb-fact-label2 { font-size: 13px; color: var(--muted); line-height: 1.7; }
  .pb-fact-note { font-size: 12px; color: var(--muted); line-height: 1.8; margin-top: 6px; }

  .pb-deflist { display: grid; gap: 14px; }
  .pb-fact-def { margin-top: 28px; align-items: start; }
  .pb-fact-def > div { background: var(--paper); border-radius: var(--r); padding: 20px 22px; }
  .pb-deflist dt { font-size: 15px; font-weight: 700; color: var(--green-deep); }
  .pb-deflist dd { font-size: 15px; line-height: 1.95; margin-top: 4px; }
  .pb-deflist-sm > div { padding: 0 0 14px; border-bottom: 1px solid var(--line-soft); background: transparent; }
  .pb-facts .pb-note { margin-top: 18px; }

  /* ── 06 施設を探す ───────────────────────────── */
  .pb-fac-list { display: grid; gap: 20px; }
  .pb-fac {
    background: var(--paper);
    border-radius: var(--r);
    overflow: hidden;
    transition: transform 0.5s var(--e);
  }
  .pb-fac:hover { transform: translateY(-4px); }
  .pb-fac-art { position: relative; height: 172px; display: grid; place-items: center; overflow: hidden; }
  .pb-blob-fac {
    position: absolute;
    width: 164px; aspect-ratio: 1.1;
    background: var(--mint);
    transition: border-radius 0.9s var(--e), transform 0.6s var(--e);
  }
  .pb-tone-green .pb-blob-fac { background: #d6efd0; }
  .pb-tone-beige .pb-blob-fac { background: var(--beige); }
  .pb-fac:hover .pb-blob-fac { border-radius: 63% 37% 41% 59% / 38% 60% 40% 62%; transform: scale(1.05); }
  .pb-fac-icon { position: relative; width: 54px; height: 54px; color: var(--green-deep); }
  .pb-fac-icon svg { width: 54px; height: 54px; stroke-width: 1.15; }
  .pb-fac-leaf {
    position: absolute; right: 22px; bottom: 16px;
    width: 28px; height: 28px; color: var(--green-soft);
  }
  .pb-fac-leaf svg { width: 28px; height: 28px; stroke-width: 1.2; }
  .pb-fac-text { padding: 22px 22px 26px; }
  .pb-fac-kind { font-size: 13px; font-weight: 500; color: var(--green-deep); }
  .pb-fac-name { font-size: 24px; font-weight: 700; line-height: 1.5; letter-spacing: 0.08em; margin-top: 3px; }
  .pb-fac-area { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); margin-top: 6px; }
  .pb-fac-area-icon { width: 17px; height: 17px; flex: none; }
  .pb-fac-area-icon svg { width: 17px; height: 17px; }
  .pb-fac-text .pb-body { margin-top: 12px; }
  .pb-fac-links { display: grid; gap: 10px; margin-top: 20px; }

  .pb-status {
    display: inline-block; margin-top: 12px;
    padding: 4px 14px; border-radius: 999px;
    font-size: 14px; font-weight: 700; line-height: 1.7;
  }
  .pb-status-open { background: var(--green-deep); color: #fff; }
  .pb-status-full { background: var(--bg); color: var(--muted); border: 1px solid var(--line); }

  /* ── 07 サービスを探す ───────────────────────── */
  .pb-sv-list { display: grid; gap: 16px; }
  .pb-sv-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 18px;
    border-radius: var(--r);
    background: var(--paper);
    text-decoration: none;
    color: inherit;
    transition: transform 0.5s var(--e);
  }
  .pb-sv-link:hover { transform: translateY(-3px); }
  .pb-sv-art { position: relative; flex: none; width: 92px; height: 92px; display: grid; place-items: center; }
  .pb-blob-sv {
    position: absolute; inset: 0;
    background: var(--mint);
    transition: border-radius 0.9s var(--e), transform 0.6s var(--e);
  }
  .pb-tone-green .pb-blob-sv { background: #d6efd0; }
  .pb-tone-beige .pb-blob-sv { background: var(--beige); }
  .pb-sv-link:hover .pb-blob-sv { border-radius: 44% 56% 62% 38% / 55% 42% 58% 45%; transform: scale(1.06); }
  .pb-sv-icon { position: relative; width: 40px; height: 40px; color: var(--green-deep); }
  .pb-sv-icon svg { width: 40px; height: 40px; stroke-width: 1.2; }
  .pb-sv-text { display: grid; gap: 4px; min-width: 0; }
  .pb-sv-cat {
    justify-self: start;
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em;
    color: var(--green-deep); background: var(--mint);
    border-radius: 999px; padding: 2px 11px; line-height: 1.8;
  }
  .pb-sv-name { font-size: 19px; font-weight: 700; line-height: 1.6; letter-spacing: 0.04em; }
  .pb-sv-trouble { font-size: 15px; font-weight: 500; color: var(--green-deep); line-height: 1.85; }
  .pb-sv-body { font-size: 15px; line-height: 1.9; }
  .pb-sv-dot { align-self: center; }
  .pb-sv-link:hover .pb-sv-dot { transform: translateX(3px); }

  /* ── 08 見学・資料請求 ───────────────────────── */
  .pb-contact { overflow: hidden; }
  .pb-blob-contact {
    width: min(46vw, 500px); aspect-ratio: 1.1;
    left: -14%; top: 24%;
    background: var(--sky);
    opacity: 0.8;
  }
  .pb-contact .pb-wrap { position: relative; }
  .pb-desk-list { display: grid; gap: 16px; }
  .pb-desk {
    background: var(--paper);
    border-radius: var(--r);
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    transition: transform 0.5s var(--e);
  }
  .pb-desk:hover { transform: translateY(-4px); }
  .pb-desk-head { display: flex; align-items: center; gap: 11px; }
  .pb-desk-icon {
    width: 46px; height: 46px; flex: none;
    display: grid; place-items: center;
    border-radius: 58% 42% 47% 53% / 44% 51% 49% 56%;
    background: var(--mint); color: var(--green-deep);
    transition: border-radius 0.7s var(--e);
  }
  .pb-tone-green .pb-desk-icon { background: #d6efd0; }
  .pb-tone-beige .pb-desk-icon { background: var(--beige); }
  .pb-desk:hover .pb-desk-icon { border-radius: 63% 37% 41% 59% / 38% 60% 40% 62%; }
  .pb-desk-icon svg { width: 23px; height: 23px; }
  .pb-desk-title { font-size: 18px; font-weight: 700; line-height: 1.65; margin-top: 12px; }
  .pb-desk-target { font-size: 13px; color: var(--muted); margin-top: 6px; line-height: 1.85; }
  .pb-desk-tel { display: flex; align-items: center; gap: 8px; margin-top: 14px; text-decoration: none; color: var(--green-deep); }
  .pb-desk-tel-icon { width: 23px; height: 23px; flex: none; }
  .pb-desk-tel-icon svg { width: 23px; height: 23px; }
  .pb-desk-tel-no { font-size: 30px; font-weight: 700; line-height: 1.3; }
  .pb-desk-hours { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); }
  .pb-desk-hours-icon { width: 17px; height: 17px; flex: none; }
  .pb-desk-hours-icon svg { width: 17px; height: 17px; }
  .pb-desk-staff { font-size: 12px; color: var(--muted); line-height: 1.85; margin-bottom: 16px; }
  .pb-desk .pb-btn { margin-top: auto; }

  .pb-form-block {
    margin-top: 26px;
    background: var(--paper);
    border-radius: var(--r);
    padding: 30px 24px;
    display: grid;
    gap: 28px;
    align-items: start;
  }
  .pb-form-en { display: block; margin-bottom: 4px; }
  .pb-form-doc-title { font-size: 15px; font-weight: 700; margin-top: 20px; }
  .pb-doclist { display: grid; gap: 8px; margin-top: 8px; }
  .pb-doclist li { display: flex; align-items: flex-start; gap: 9px; font-size: 15px; line-height: 1.85; }
  .pb-doclist-mark { width: 19px; height: 19px; flex: none; color: var(--green-deep); margin-top: 5px; }
  .pb-doclist-mark svg { width: 19px; height: 19px; }
  .pb-form-text .pb-note { margin-top: 16px; }

  .pb-form-mock { background: var(--bg); border-radius: var(--r); padding: 22px 20px; }
  .pb-form-mock-label { font-size: 12px; font-weight: 700; color: var(--muted); margin-bottom: 6px; }
  .pb-form-mock-field {
    height: 46px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--paper);
    margin-bottom: 14px;
    font-size: 14px; color: var(--muted);
    line-height: 46px; padding-inline: 12px;
  }
  .pb-form-mock-area { height: 96px; }
  .pb-form-mock-btn {
    height: 54px; border-radius: var(--r-sm);
    background: var(--green); color: #fff;
    /* #1da700 に白文字は「大きい文字」(18.66px以上・太字) でないとAAに届かない */
    font-size: 19px; font-weight: 700; text-align: center; line-height: 54px;
  }

  .pb-hours { margin-top: 26px; background: var(--paper); border-radius: var(--r); padding: 28px 24px; }
  .pb-hours-grid { display: grid; gap: 26px; margin-top: 18px; }
  .pb-table-wrap { overflow-x: auto; }
  .pb-table { width: 100%; border-collapse: collapse; min-width: 460px; font-size: 15px; }
  .pb-table :is(th, td) { padding: 12px 14px; border-bottom: 1px solid var(--line-soft); text-align: left; line-height: 1.7; }
  .pb-table thead th { background: var(--mint); font-size: 13px; font-weight: 700; white-space: nowrap; }
  .pb-table tbody th { font-weight: 500; }
  .pb-map {
    margin-top: 16px; height: 190px;
    border: 1px dashed var(--line);
    border-radius: var(--r);
    background: var(--bg);
    display: grid; place-items: center; align-content: center; gap: 6px;
    color: var(--muted);
  }
  .pb-map-icon { width: 28px; height: 28px; }
  .pb-map-icon svg { width: 28px; height: 28px; }
  .pb-map-label { font-size: 13px; }

  /* ── 09 お知らせ ─────────────────────────────── */
  .pb-news-head { display: grid; gap: 18px; margin-bottom: 26px; }
  .pb-news-list { border-top: 1px solid var(--line-soft); }
  .pb-news-list li { border-bottom: 1px solid var(--line-soft); }
  .pb-news-list a {
    display: grid;
    gap: 4px 16px;
    padding: 18px 4px;
    text-decoration: none;
    color: inherit;
    transition: color 0.3s var(--e);
  }
  .pb-news-list a:hover { color: var(--green-deep); }
  .pb-news-list a:hover .pb-news-dot { transform: translateX(3px); }
  .pb-news-date { font-size: 14px; color: var(--muted); }
  .pb-cat {
    justify-self: start;
    font-size: 11px; font-weight: 700; letter-spacing: 0.06em;
    border-radius: 999px; padding: 2px 12px; line-height: 1.8;
  }
  .pb-cat-green { background: var(--mint); color: var(--green-deep); }
  .pb-cat-sky { background: var(--sky); color: #1f4a63; }
  .pb-cat-beige { background: var(--beige); color: #6b4f1d; }
  .pb-news-text { font-size: 16px; line-height: 1.85; }
  .pb-news-dot { justify-self: end; align-self: center; }

  /* ── 10 採用 ─────────────────────────────────── */
  .pb-recruit { overflow: hidden; }
  .pb-blob-rec-a {
    width: min(40vw, 400px); aspect-ratio: 1; right: -10%; top: 10%;
    background: var(--mint); opacity: 0.75;
  }
  .pb-blob-rec-b {
    width: min(30vw, 280px); aspect-ratio: 1; left: -8%; bottom: 12%;
    background: var(--beige); opacity: 0.7;
  }
  .pb-recruit .pb-wrap { position: relative; }
  .pb-rec-top { display: grid; gap: 20px; align-items: start; }
  .pb-rec-interview, .pb-rec-policy, .pb-rec-support, .pb-jobs {
    background: var(--paper); border-radius: var(--r); padding: 26px 24px;
  }
  .pb-rec-tag {
    display: inline-block;
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em;
    color: var(--green-deep); background: var(--mint);
    border-radius: 999px; padding: 2px 12px;
  }
  .pb-quote { font-size: 17px; line-height: 2.05; margin-top: 14px; padding-left: 16px; border-left: 3px solid var(--green); }
  .pb-rec-who { font-size: 14px; color: var(--muted); margin-top: 12px; }
  .pb-rec-interview .pb-more { margin-top: 14px; }
  .pb-rec-policy .pb-h3 { margin-top: 4px; }
  .pb-checklist { display: grid; gap: 12px; margin-top: 14px; }
  .pb-checklist li { display: flex; align-items: flex-start; gap: 10px; font-size: 16px; line-height: 1.85; }
