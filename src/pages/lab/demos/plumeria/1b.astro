<BaseLayout title={title} description={description} noindex={true} showSiteChrome={false}>
  {/* data-reveal="off": BaseLayout 共通のスクロール表示スクリプトは使わない。
      このページは自前の IntersectionObserver で制御する。 */}
  <div class="pb" data-reveal="off">
    {/* モチーフはすべてこのファイルで書き起こした線画。外部の画像・イラストは使わない。 */}
    <svg class="pb-defs" aria-hidden="true" focusable="false">
      <defs>
        <symbol id="pb-i-home" viewBox="0 0 24 24">
          <path d="M4 10.6 12 4.4l8 6.2V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1Z" />
          <path d="M9.6 20v-5.2h4.8V20" />
        </symbol>
        <symbol id="pb-i-bed" viewBox="0 0 24 24">
          <path d="M3 18v-7.4h13.4A4.6 4.6 0 0 1 21 15.2V18" />
