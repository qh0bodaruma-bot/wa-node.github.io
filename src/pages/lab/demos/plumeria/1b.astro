  .pb .pb-hero-art.is-in .pb-blob { transform: none; }
  .pb .pb-hero-art.is-in .pb-blob-a { border-radius: 63% 37% 41% 59% / 38% 60% 40% 62%; }
  .pb .pb-hero-art.is-in .pb-blob-b { border-radius: 44% 56% 62% 38% / 55% 42% 58% 45%; }
  .pb .pb-hero-art.is-in .pb-blob-c { border-radius: 52% 48% 58% 42% / 60% 45% 55% 40%; }

