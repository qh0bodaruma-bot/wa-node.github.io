import BaseLayout from '../../../../layouts/BaseLayout.astro';

/*
  プルメリア 総合トップ ラフ「1b 法人グループ型」（/lab/demos/plumeria/1b）

  ── 2026-08-31 改稿（第2版）─────────────────────────────
  ボス指示：(1) 写真をいったん全削除 (2) https://www.yamatoen.or.jp/
  （社会福祉法人 功有会）のテーマ・モチーフに寄せる (3) それに見合うアニメーションを付ける。

  参照サイトから採ったのは「デザイン言語」だけで、素材は一切複製していない。
  - 採った：地色 #f3f1ef／緑2色／純黒の本文／大きな余白／白カード＋緑の丸矢印／
           「小さな英ラベル＋大きな和文」の見出し／縦組みの理念／数字＋緑の丸バッジ／
           有機的な雲形ブロブ／1文字ずつのスタガー表示／
           ボタンのホバーで下からアーチ状の塗りがせり上がり角丸が消える動き／
           イージング cubic-bezier(0.26,0.06,0,1)
  - 採っていない：功有会のロゴ、手描き人物イラスト、写真、コピー文、採用カードの並び。
    モチーフはすべてこのファイル内で書き起こしたオリジナルSVG（社名にちなみ花・葉・木・家）。

  【制約の変更】
  - 写真：**全削除**。面はブロブと線画で作る。public/images/plumeria/ は参照していない。
  - JavaScript：**解禁**（表示アニメーションに IntersectionObserver を使う）。
    ただしJSが動かない環境でも内容は全て見える（`.pb.is-js` が付いたときだけ初期状態を隠す）。
  - 常時アニメーションはヒーローのブロブの超低速モーフと Scroll ラベルのみ。
    `prefers-reduced-motion` で全アニメーションを停止する。

  数値・固有情報はすべて差し替え枠（○）。実績・利用者の声・職員インタビューは創作していない。
*/

const title = 'プルメリア｜住まい・在宅支援・福祉用具を地域で支える';
const description =
