  { icon: 'care', label: 'サービスを探す', body: 'お困りごとから選ぶ', href: '#services' },
  { icon: 'doc', label: '見学・資料請求', body: '目的別の相談窓口へ', href: '#contact' },
];

// ── 差し替え枠：大切にしていること（3項目）─────────────────
const values = [
  {
    icon: 'home',
    en: 'LIVING',
    title: '暮らしの場をつくる',
    body:
      '居室・食堂・浴室・共用部の使い方を、ご本人の生活時間に合わせます。起きる時間も、お風呂の順番も、こちらの都合で決めません。',
    img: '/images/plumeria/feature-01.webp',
    alt: '窓辺の椅子に座る入居者と、同じ目線の高さで話すスタッフ',
  },
  {
    icon: 'care',
    en: 'SUPPORT',
    title: '誠実に支援する',
    body:
      'できることは奪わず、できないことだけをお手伝いします。ご家族には、良い変化も良くない変化も同じ温度でお伝えします。',
    img: '/images/plumeria/feature-02.webp',
    alt: 'テーブルを囲んで、ご家族と職員が手元の画面を見ながら話し合っている様子',
  },
  {
    icon: 'shield',
    en: 'SAFETY',
    title: '安心と安全を守る',
    body:
