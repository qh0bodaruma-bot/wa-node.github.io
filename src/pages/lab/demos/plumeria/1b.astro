const structure = [
  { dt: '資格・研修', dd: '介護福祉士・看護師・ケアマネジャーなどの配置状況と、年間の研修計画を掲載します（内容は差し替え枠）。' },
  { dt: '安全への対応', dd: '事故発生時の連絡経路、夜間の対応体制、防災訓練と感染対策の実施記録を施設ごとに公開します（差し替え枠）。' },
  { dt: '地域とのつながり', dd: '地域の行事、実習生の受け入れ、連携する医療機関などを掲載します（差し替え枠）。' },
