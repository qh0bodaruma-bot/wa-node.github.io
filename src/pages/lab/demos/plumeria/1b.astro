// ── 差し替え枠：サービスを探す（困りごとから）───────────────
const services = [
  {
    id: 'sv-1', icon: 'care', cat: '在宅支援',
    name: '訪問看護',
    body: '看護師がご自宅へ伺い、健康状態の確認や医療的な処置を行います。主治医と連携します。',
    trouble: '自宅で療養したいが、体調の変化が不安',
    img: '/images/plumeria/services-04.webp',
    alt: 'ご自宅のリビングで看護師が健康状態を確認している様子',
  },
  {
    id: 'sv-2', icon: 'staff', cat: '在宅支援',
    name: '訪問介護',
    body: 'ご自宅での身体介護と生活援助を行います。曜日・時間はケアプランに沿って調整します。',
    trouble: '入浴や食事の準備を、ひとりでは続けられない',
    img: '',
    alt: '',
  },
  {
    id: 'sv-3', icon: 'doc', cat: '相談',
    name: '居宅介護支援（ケアプラン作成）',
