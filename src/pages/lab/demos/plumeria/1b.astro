  { icon: 'care', tone: 'mint', en: 'Home care', title: '在宅サービス・ケアプランのご相談',
    target: '訪問看護／訪問介護／居宅介護支援',
    tel: '000-000-0000', telHref: 'tel:0000000000',
    hours: '9:00〜17:00（日祝を除く）', staff: '担当：ケアマネジャー・看護師（差し替え枠）', ctaLabel: '在宅の相談をする' },
  { icon: 'chair', tone: 'beige', en: 'Equipment', title: '福祉用具・住まいの環境のご相談',
    target: '福祉用具貸与／住宅改修のご相談',
