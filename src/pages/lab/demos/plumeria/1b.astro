    transition: opacity 0.7s var(--e2) calc(var(--ai, 0) * 110ms + 260ms),
                transform 0.8s var(--e) calc(var(--ai, 0) * 110ms + 260ms);
  }
  .pb .pb-hero-art.is-in .pb-art { opacity: 1; transform: none; }
  .pb:not(.is-js) .pb-hero-art .pb-art { opacity: 1; transform: none; }

  /* ══ 丸い矢印（参照サイトのモチーフ）══════════════ */
  .pb-dot {
    width: 32px; height: 32px; flex: none;
    display: grid; place-items: center;
    border-radius: 50%;
