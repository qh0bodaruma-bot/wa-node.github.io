---
import PlumeriaTrialLayout from '../../../../../layouts/PlumeriaTrialLayout.astro';
import { trialRoutes } from '../../../../../data/plumeriaTrial';
---
<PlumeriaTrialLayout title="ゴミ箱" currentPath={trialRoutes.trash} hello="ゴミ箱">
  <section class="pa-sec">
    <div class="pa-card">
      <div class="pa-card-head">
        <div>
          <div class="pa-eyebrow">TRASH</div>
          <h2 class="pa-h2">ゴミ箱に移したお知らせ</h2>
          <p class="pa-lead">ここにあるお知らせは、ホームページにも一覧にも出ません。「元に戻す」を押すと、移す前の状態に戻ります。公開中だったものは、念のため「非公開」で戻ります。</p>
          <p class="pa-lead" data-pt-approver hidden>いらないものは「完全に削除」で消せます。添付した写真・PDFも一緒に消え、元に戻せません。</p>
        </div>
        <span class="pa-badge pa-badge-off" data-pt-trash-count>—</span>
      </div>
      <p class="pa-note" data-pt-writer hidden>ご自分が書いた下書き・差し戻しのお知らせだけを戻せます。</p>
      <table class="pa-table">
        <thead><tr><th>タイトル</th><th>種類</th><th>移す前</th><th>移した日時</th><th>操作</th></tr></thead>
        <tbody data-pt-trash><tr><td colspan="5" class="pt-empty">読み込み中…</td></tr></tbody>
      </table>
    </div>
  </section>
</PlumeriaTrialLayout>

<script>
  import { loadSession, currentProfile, api, h, handleError, showMsg, fmtDateTime, statusLabel, deletePostForever, type Profile } from '../../../../../lib/plumeriaTrial';

  const SEL = 'id,category,title,trashed_from,trashed_at,author_id,attachments,author:profiles!posts_author_id_fkey(display_name),trasher:profiles!posts_trashed_by_fkey(display_name)';
  let profile: Profile;

  const canRestore = (p: any) => profile.role === 'approver' || (p.author_id === profile.id && ['draft', 'returned'].includes(p.trashed_from));

  async function restore(p: any) {
    try {
      await api(`posts?id=eq.${p.id}`, { method: 'PATCH', body: { status: p.trashed_from === 'published' ? 'hidden' : p.trashed_from }, prefer: 'return=minimal' });
      showMsg(p.trashed_from === 'published'
        ? `「${p.title}」を「非公開」で戻しました。ホームページに出すときは「いまの状況」の画面で「もう一度公開する」を押してください。`
        : `「${p.title}」を元に戻しました（${statusLabel[p.trashed_from]?.t ?? ''}）。`);
      document.dispatchEvent(new CustomEvent('pt:posts-changed'));
      await render();
    } catch (e) { handleError(e, (m) => showMsg(m, true)); }
  }

  // 完全に削除（公開の権限がある人だけ。添付ファイルも消す）
  async function removeForever(p: any) {
    try {
      const r = await deletePostForever(p);
      if (!r.deleted) return;
      showMsg(r.filesLeft
        ? `「${p.title}」を完全に削除しました。ただし添付ファイルのうち${r.filesLeft}件を消せませんでした。和-Nodeまでご連絡ください。`
        : `「${p.title}」を完全に削除しました。`, r.filesLeft > 0);
      await render();
    } catch (e) { handleError(e, (m) => showMsg(m, true)); }
  }

  async function render() {
    const rows = await api<any[]>(`posts?select=${SEL}&status=eq.trashed&order=trashed_at.desc&limit=100`);
    document.querySelector('[data-pt-trash-count]')!.textContent = `${rows.length}件`;
    const tbody = document.querySelector<HTMLElement>('[data-pt-trash]')!;
    if (!rows.length) { tbody.replaceChildren(h('tr', {}, h('td', { colspan: 5, class: 'pt-empty' }, 'ゴミ箱は空です。'))); return; }
    tbody.replaceChildren(...rows.map((p) => {
      const st = statusLabel[p.trashed_from] ?? { t: '—', badge: 'off' };
      return h('tr', {},
        h('td', { class: 'pa-ttl' }, p.title, h('span', { class: 'pa-sub' }, `作成：${p.author?.display_name ?? '—'}`)),
        h('td', {}, p.category),
        h('td', {}, h('span', { class: `pa-badge pa-badge-${st.badge}` }, st.t)),
        h('td', {}, fmtDateTime(p.trashed_at), h('span', { class: 'pa-sub' }, `移した人：${p.trasher?.display_name ?? '—'}`)),
        h('td', {}, canRestore(p) || profile.role === 'approver'
          ? h('div', { class: 'pa-btn-row' },
              canRestore(p) && h('button', { type: 'button', class: 'pa-btn', onclick: () => restore(p) }, '元に戻す'),
              profile.role === 'approver' && h('button', { type: 'button', class: 'pa-btn pa-btn-warn', onclick: () => removeForever(p) }, '完全に削除'))
          : '—'));
    }));
  }

  async function init() {
    if (!document.querySelector('[data-pt-trash]') || !loadSession()) return;
    try {
      const p = await currentProfile();
      if (!p) return;
      profile = p;
      document.querySelector<HTMLElement>('[data-pt-writer]')!.hidden = profile.role === 'approver';
      document.querySelector<HTMLElement>('[data-pt-approver]')!.hidden = profile.role !== 'approver';
      await render();
    } catch (e) { handleError(e, (m) => showMsg(m, true)); }
  }
  document.addEventListener('astro:page-load', init, { once: true });
</script>
