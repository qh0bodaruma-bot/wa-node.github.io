---
import PlumeriaTrialLayout from '../../../../layouts/PlumeriaTrialLayout.astro';
import { trialRoutes, postCategories } from '../../../../data/plumeriaTrial';

// アクセス分析はお試し版では仮の数字（本番では Looker Studio などの実データにつなぐ予定）
const months = ['4月', '5月', '6月', '7月', '8月', '9月'];
const visits = [62, 78, 91, 85, 104, 128];
const reached = [21, 30, 38, 33, 47, 61];
const max = 140;
const chartH = 230;
const slot = 100;
const barW = 30;
const chartW = slot * months.length;
const catDesc: Record<string, string> = {
  'お知らせ': '行事の報告、施設からのご案内',
  '事業課からの通知': '加算、料金改定、制度変更',
  '採用情報': '募集職種の追加・募集終了',
  'コンプライアンス掲示': '重要事項説明、指定事業所番号',
};
---
<PlumeriaTrialLayout title="ホーム" currentPath={trialRoutes.home} hello="こんにちは">
  <section class="pa-sec">
    <div class="pa-kpis">
      <div class="pa-kpi" data-pt-kpi-card="pending"><p class="pa-kpi-t">最終確認まち</p><div><span class="pa-kpi-v" data-pt-kpi="pending">—</span><span class="pa-kpi-u">件</span></div><p class="pt-kpi-note" data-pt-note="pending"></p><div class="pa-kpi-sub"><a href={trialRoutes.approve} data-astro-reload>最終確認を開く →</a></div></div>
      <div class="pa-kpi"><p class="pa-kpi-t">公開中のお知らせ</p><div><span class="pa-kpi-v" data-pt-kpi="published">—</span><span class="pa-kpi-u">件</span></div><p class="pt-kpi-note" data-pt-note="published"></p><div class="pa-kpi-sub"><span>ホームページのお試し表示に出ています</span></div></div>
      <div class="pa-kpi"><p class="pa-kpi-t">自分の下書き・差し戻し</p><div><span class="pa-kpi-v" data-pt-kpi="mine">—</span><span class="pa-kpi-u">件</span></div><p class="pt-kpi-note" data-pt-note="mine"></p><div class="pa-kpi-sub"><span>書きかけ・直しが必要なもの</span></div></div>
      <div class="pa-kpi"><p class="pa-kpi-t">空室情報の最終更新</p><div><span class="pa-kpi-v" style="font-size:22px" data-pt-kpi="vacancy">—</span></div><p class="pt-kpi-note" data-pt-note="vacancy"></p><div class="pa-kpi-sub"><a href={trialRoutes.vacancy} data-astro-reload>空室情報を開く →</a></div></div>
    </div>
  </section>

  <section class="pa-sec" data-pt-queue hidden>
    <div class="pa-card pt-queue">
      <div class="pa-card-head">
        <div>
          <div class="pa-eyebrow">WAITING</div>
          <h2 class="pa-h2">最終確認を待っているもの</h2>
          <p class="pa-lead" data-pt-queue-lead></p>
        </div>
        <span class="pa-badge pa-badge-wait" data-pt-queue-count>—</span>
      </div>
      <ul class="pt-queue-list" data-pt-queue-list></ul>
      <p class="pt-queue-more" data-pt-queue-more hidden><a href={trialRoutes.approve} data-astro-reload>すべての確認まちを見る →</a></p>
    </div>
  </section>

  <section class="pa-sec pa-grid2">
    <div class="pa-card">
      <div class="pa-eyebrow">MY POSTS</div>
      <h2 class="pa-h2">自分が書いたもの</h2>
      <p class="pa-lead" style="margin-bottom:14px">下書き・確認まち・公開中をまとめて確認できます。タイトルを押すと開きます。</p>
      <table class="pa-table">
        <thead><tr><th>タイトル</th><th>種類</th><th>状態</th></tr></thead>
        <tbody data-pt-mine><tr><td colspan="3" class="pt-empty">読み込み中…</td></tr></tbody>
      </table>
      <div class="pa-note"><strong>いらなくなったものは「ゴミ箱に移す」で一覧から外せます。</strong>ゴミ箱からいつでも元に戻せます。</div>
    </div>
    <div class="pa-card">
      <div class="pa-eyebrow">NEW</div>
      <h2 class="pa-h2">新しく書く</h2>
      <p class="pa-lead" style="margin-bottom:14px">種類を選ぶと、その種類を選んだ状態で入力画面が開きます。</p>
      <div class="pa-new" style="grid-template-columns:1fr">
        {postCategories.map((c) => (
          <a href={`${trialRoutes.post}?cat=${encodeURIComponent(c)}`} data-astro-reload>
            <span class="pa-new-t">{c}</span>
            <span class="pa-new-d">{catDesc[c]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pa-sec" id="analytics">
    <div class="pa-card">
      <div class="pa-card-head">
        <div>
          <div class="pa-eyebrow">ANALYTICS · 仮データ</div>
          <h2 class="pa-h2">アクセス分析（お試し版では仮の数字）</h2>
          <p class="pa-lead">本番では、ホームページの実際の訪問数を表示する予定です。お試し版では、画面の見え方だけをご確認ください。</p>
        </div>
        <div class="pa-legend">
          <span><i style="background:#137792"></i>訪問数</span>
          <span><i style="background:#a8d3e0"></i>空室情報まで</span>
        </div>
      </div>
      <svg class="pa-chart" viewBox={`0 0 ${chartW} ${chartH + 40}`} role="img" aria-label="訪問数と空室情報到達数の6か月推移（仮データ）">
        {[0, 0.25, 0.5, 0.75, 1].map((r) => (
          <line x1="0" x2={chartW} y1={chartH - chartH * r} y2={chartH - chartH * r} stroke="#e6eef1" stroke-width="1" />
        ))}
        {months.map((m, i) => {
          const cx = i * slot + slot / 2;
          const hv = (visits[i] / max) * chartH;
          const hr = (reached[i] / max) * chartH;
          return (
            <g>
              <rect x={cx - barW - 3} y={chartH - hv} width={barW} height={hv} rx="5" fill="#137792" />
              <rect x={cx + 3} y={chartH - hr} width={barW} height={hr} rx="5" fill="#a8d3e0" />
              <text x={cx - barW / 2 - 3} y={chartH - hv - 8} text-anchor="middle" font-size="12.5" fill="#083c4a" font-weight="700">{visits[i]}</text>
              <text x={cx + barW / 2 + 3} y={chartH - hr - 8} text-anchor="middle" font-size="12.5" fill="#587680">{reached[i]}</text>
              <text x={cx} y={chartH + 24} text-anchor="middle" font-size="13" fill="#587680">{m}</text>
            </g>
          );
        })}
      </svg>
    </div>
  </section>
</PlumeriaTrialLayout>

<script>
  import { loadSession, currentProfile, api, h, handleError, showMsg, fmtDateTime, statusLabel } from '../../../../lib/plumeriaTrial';
  import { trialRoutes } from '../../../../data/plumeriaTrial';

  function setKpi(k: string, v: string) {
    const el = document.querySelector(`[data-pt-kpi="${k}"]`);
    if (el) el.textContent = v;
  }

  // 数字の下に添える一文。warn のときだけ橙にして「手を付けてほしい」ことを示す
  function setNote(k: string, text: string, warn = false) {
    const el = document.querySelector<HTMLElement>(`[data-pt-note="${k}"]`);
    if (!el) return;
    el.textContent = text;
    el.classList.toggle('is-warn', warn);
  }

  // 経過時間を「3日」「5時間」「30分」の形にする
  function elapsed(iso: string): { text: string; days: number } {
    const min = Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 60000));
    const days = Math.floor(min / 1440);
    if (days >= 1) return { text: `${days}日`, days };
    if (min >= 60) return { text: `${Math.floor(min / 60)}時間`, days: 0 };
    return { text: `${min}分`, days: 0 };
  }

  // 確認まちがこの日数を超えたら、補足の文を橙にする
  const PENDING_WARN_DAYS = 3;
  // 空室情報がこの日数更新されていなければ、補足の文を橙にする
  const VACANCY_WARN_DAYS = 14;
  // ホームに並べる確認まちの件数（残りは「すべて見る」から）
  const QUEUE_MAX = 3;

  function renderQueue(pending: any[], isApprover: boolean) {
    const sec = document.querySelector<HTMLElement>('[data-pt-queue]');
    if (!sec) return;
    sec.hidden = pending.length === 0;
    if (!pending.length) return;
    document.querySelector('[data-pt-queue-count]')!.textContent = `${pending.length}件`;
    document.querySelector('[data-pt-queue-lead]')!.textContent = isApprover
      ? '古いものから順に並んでいます。「確認する」を押すと、最終確認の画面でその記事が開きます。'
      : '公開の権限をお持ちの方の確認を待っています。古いものから順に並んでいます。';
    const list = document.querySelector<HTMLElement>('[data-pt-queue-list]')!;
    list.replaceChildren(...pending.slice(0, QUEUE_MAX).map((p) => {
      const e = elapsed(p.updated_at);
      return h('li', { class: 'pt-queue-item' },
        h('div', { class: 'pt-queue-main' },
          h('p', { class: 'pt-queue-title' }, p.title),
          h('p', { class: 'pt-queue-meta' }, `${p.category} ／ ${p.author?.display_name ?? '—'} さん ／ ${fmtDateTime(p.updated_at)} 送信`)),
        h('span', { class: `pt-queue-age${e.days >= PENDING_WARN_DAYS ? ' is-warn' : ''}` }, `${e.text}まち`),
        h('a', { class: `pa-btn${isApprover ? '' : ' pa-btn-ghost'}`, href: `${trialRoutes.approve}#pt-post-${p.id}`, 'data-astro-reload': true }, isApprover ? '確認する' : '内容を見る'));
    }));
    document.querySelector<HTMLElement>('[data-pt-queue-more]')!.hidden = pending.length <= QUEUE_MAX;
  }

  async function render() {
    const profile = await currentProfile();
    if (!profile) return;
    const isApprover = profile.role === 'approver';
    const rows = await api<any[]>('posts?select=id,title,category,status,updated_at,published_at,author:profiles!posts_author_id_fkey(display_name)&status=in.(pending,published)&order=updated_at.asc');
    const pending = rows.filter((r) => r.status === 'pending');
    const published = rows.filter((r) => r.status === 'published');

    setKpi('pending', String(pending.length));
    const card = document.querySelector<HTMLElement>('[data-pt-kpi-card="pending"]');
    if (pending.length) {
      const oldest = elapsed(pending[0].updated_at);
      setNote('pending', `いちばん古いもので${oldest.text}まち`, oldest.days >= PENDING_WARN_DAYS);
      // 点滅は付けたときに一度だけ始まる（付けたままの間は再描画しても繰り返さない）
      card?.classList.add('is-alert');
    } else {
      setNote('pending', '確認まちはありません');
      card?.classList.remove('is-alert');
    }
    renderQueue(pending, isApprover);

    setKpi('published', String(published.length));
    const latest = published.map((r) => r.published_at).filter(Boolean).sort().pop();
    setNote('published', latest ? `最新の公開：${fmtDateTime(latest)}` : 'まだ公開したものはありません');

    const vac = await api<{ updated_at: string }[]>('vacancies?select=updated_at&order=updated_at.desc&limit=1');
    setKpi('vacancy', vac[0] ? fmtDateTime(vac[0].updated_at) : '—');
    if (vac[0]) {
      const e = elapsed(vac[0].updated_at);
      setNote('vacancy', e.days >= 1 ? `最終更新から${e.text}たっています` : '今日更新されています', e.days >= VACANCY_WARN_DAYS);
    } else setNote('vacancy', '');

    const mine = await api<any[]>(`posts?select=id,title,category,status,updated_at&author_id=eq.${profile.id}&status=neq.trashed&order=updated_at.desc&limit=10`);
    setKpi('mine', String(mine.filter((m) => m.status === 'draft' || m.status === 'returned').length));
    const returned = mine.filter((m) => m.status === 'returned').length;
    const drafts = mine.filter((m) => m.status === 'draft').length;
    if (returned) setNote('mine', `差し戻し${returned}件・下書き${drafts}件`, true);
    else setNote('mine', drafts ? `下書き${drafts}件` : '書きかけのものはありません');
    const tbody = document.querySelector<HTMLElement>('[data-pt-mine]')!;
    if (!mine.length) { tbody.replaceChildren(h('tr', {}, h('td', { colspan: 3, class: 'pt-empty' }, 'まだありません。右の「新しく書く」から始めてください。'))); return; }
    tbody.replaceChildren(...mine.map((r) => {
      const st = statusLabel[r.status] ?? { t: r.status, badge: 'off' };
      return h('tr', {},
        h('td', { class: 'pa-ttl' }, h('a', { href: `${trialRoutes.post}?id=${r.id}`, 'data-astro-reload': true }, r.title), h('span', { class: 'pa-sub' }, fmtDateTime(r.updated_at))),
        h('td', {}, r.category),
        h('td', {}, h('span', { class: `pa-badge pa-badge-${st.badge}` }, st.t)));
    }));
  }

  async function init() {
    if (!document.querySelector('[data-pt-kpi]') || !loadSession()) return;
    try { await render(); } catch (e) { handleError(e, (m) => showMsg(m, true)); }
    document.addEventListener('pt:vacancy-changed', () => render().catch(() => {}));
  }
  document.addEventListener('astro:page-load', init, { once: true });
</script>

<style is:global>
  .pt-kpi-note { margin: 8px 0 0; font-size: 13px; line-height: 1.5; color: var(--muted); min-height: 1.5em; }
  .pt-kpi-note.is-warn { color: #a35f00; font-weight: 700; }

  /* 確認まちがあるときの「最終確認まち」の強調は、サイドメニューと共通で PlumeriaTrialLayout.astro に置く */
  .pa-kpi.is-alert .pa-kpi-v { color: #a3172b; }
  .pa-kpi.is-alert .pt-kpi-note.is-warn { color: #a3172b; }

  .pt-queue { border-left: 4px solid #a35f00; }
  .pt-queue-list { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 8px; }
  .pt-queue-item { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: #fff; }
  .pt-queue-main { flex: 1; min-width: 0; }
  .pt-queue-title { margin: 0; font-weight: 700; overflow-wrap: anywhere; }
  .pt-queue-meta { margin: 2px 0 0; font-size: 12.5px; color: var(--muted); }
  .pt-queue-age { font-size: 12.5px; font-weight: 700; color: var(--muted); white-space: nowrap; }
  .pt-queue-age.is-warn { color: #a35f00; }
  .pt-queue-item .pa-btn { text-decoration: none; white-space: nowrap; cursor: pointer; color: #fff; }
  .pt-queue-item .pa-btn.pa-btn-ghost { color: var(--green-deep); }
  .pt-queue-item .pa-btn:focus-visible { outline: 3px solid #137792; outline-offset: 2px; }
  .pt-queue-more { margin: 12px 0 0; font-size: 13px; font-weight: 700; }
  @media (max-width: 560px) {
    .pt-queue-item { flex-wrap: wrap; }
    .pt-queue-main { flex-basis: 100%; }
  }
</style>
