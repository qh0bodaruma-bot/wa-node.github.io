---
import PlumeriaLayout from '../../../../layouts/PlumeriaLayout.astro';
import { routes, companyProfile, parentCompany, brandOrigin } from '../../../../data/plumeria';
---
<PlumeriaLayout
  title="会社概要｜プルメリア（デモ）"
  description="DS TOKAI株式会社 介護事業部プルメリアの会社概要、事業内容、介護保険指定事業所番号、提携医療機関のご案内です。"
  currentPath={routes.company}
>
  <div class="pl-wrap" style="padding-top:28px">
    <p class="pl-breadcrumb">
      <a href={routes.top}>トップ</a>
      <span aria-hidden="true">/</span>
      <span>会社概要</span>
    </p>
  </div>

  <section class="pl-sec pl-sec-tight">
    <div class="pl-wrap pl-reading">
      <h1 class="pl-h1">会社概要</h1>
      <p class="pl-sec-lead">プルメリアを運営する法人の概要です。</p>
      <nav class="pl-hs-jump" aria-label="このページの内容">
        <a href="#profile">会社案内</a>
        <a href="#licenses">指定事業所番号</a>
        <a href="#clinics">提携医療機関</a>
        <a href="#about">社名の由来・運営法人</a>
      </nav>
    </div>
  </section>

  <section class="pl-sec" id="profile">
    <div class="pl-wrap pl-reading">
      <h2 class="pl-h2">運営は、{parentCompany.name}の介護事業部です</h2>
      <div class="pl-hs-spec pl-hs-spec-sm">
        <dl class="pl-hs-facts">
          {companyProfile.rows.map((row) => (
            <div><dt>{row.label}</dt><dd>{row.value}</dd></div>
          ))}
          <div>
            <dt>事業内容</dt>
            <dd>
              <ul class="pl-check-list" style="margin:0">
                {companyProfile.business.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" id="licenses">
    <div class="pl-wrap pl-reading">
      <h2 class="pl-h2">{companyProfile.licenses.length}つの事業所が、介護保険の指定を受けています</h2>
      <div class="pl-hs-lines pl-hs-lines-2 pl-hs-lines-value" style="margin-top:24px">
        {companyProfile.licenses.map((item) => (
          <div class="pl-hs-line">
            <h3 class="pl-hs-line-name">{item.label}</h3>
            <p class="pl-hs-line-body pl-num-face">{item.no}</p>
          </div>
        ))}
      </div>
      <p class="pl-note" style="margin-top:18px">{companyProfile.licenseNote}</p>
      <p class="pl-note">サービスの内容・費用・契約条件は<a href={routes.importantMatters}>重要事項説明について</a>もあわせてご確認ください。</p>
    </div>
  </section>

  <section class="pl-sec" id="clinics">
    <div class="pl-wrap">
      <h2 class="pl-h2">往診や急な体調の変化に、{companyProfile.partnerClinics.length}つの医療機関と連携しています</h2>
      <div class="pl-grid-2" style="margin-top:28px">
        {companyProfile.partnerClinics.map((clinic) => (
          <div class="pl-hs-spec pl-hs-spec-sm">
            <h3 class="pl-hs-line-name" style="margin-top:18px">{clinic.name}</h3>
            <dl class="pl-hs-facts">
              <div><dt>所在地</dt><dd>{clinic.address}</dd></div>
              <div><dt>TEL</dt><dd class="pl-num-face">{clinic.tel}</dd></div>
            </dl>
            <p style="margin:0 0 16px"><a class="pl-more" href={clinic.url} data-astro-reload>医療機関のサイトを見る →</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" id="about">
    <div class="pl-wrap">
      <div class="pl-grid-2">
        <div>
          <h2 class="pl-hs-line-name">社名の由来は、花言葉の「{brandOrigin.flowerWord}」です</h2>
          <p class="pl-hs-line-body" style="margin-top:12px">{brandOrigin.body}</p>
        </div>
        <div>
          <h2 class="pl-hs-line-name">運営法人は、{parentCompany.name}です</h2>
          <p class="pl-hs-line-body" style="margin-top:12px">{parentCompany.body}</p>
          <a class="pl-more" style="margin:10px 0 0 17px" href={parentCompany.url} data-astro-reload>{parentCompany.name}のサイトを見る →</a>
        </div>
      </div>
      <p class="pl-note" style="margin-top:28px">
        掲載内容は<a href={companyProfile.sourceUrl} data-astro-reload>現在の公式サイトの会社概要</a>を2026年9月16日に確認したものです。本番サイトへの掲載にあたっては、運営法人に最新の内容をご確認いただきます。
      </p>
    </div>
  </section>
</PlumeriaLayout>
