---
import PlumeriaLayout from '../../../../layouts/PlumeriaLayout.astro';
import PlumeriaVacancyStatus from '../../../../components/plumeria/PlumeriaVacancyStatus.astro';
import {
  routes, housingUnits, corp,
  housingFeeTable, housingAdmissionConditions, housingAdmissionCautions, housingAdmissionFlow,
  housingCommonAreas, housingBasicServices, housingOptionalServices, housingSafetyItems, housingNeighborhood,
} from '../../../../data/plumeria';

// 月額合計の行（見出しと大きな数字に使う）。表の値をそのまま引く。
const feeTotal = housingFeeTable.rows[housingFeeTable.rows.length - 1].values;

// 料金の列がどちらの住宅に属するか（Aタイプ・B・Cタイプ＝Ⅰ、介護対応型＝Ⅱ）。
const feeGroups = [
  { name: housingUnits[0].name, span: 2, tone: 'a' },
  { name: housingUnits[1].name, span: housingFeeTable.columns.length - 2, tone: 'b' },
];
// 表の中で強弱をつける行。月額合計は最も強く、面積と水道光熱費は補足として弱くする。
const feeRowClass = (label: string) =>
  label === '月額合計' ? 'is-total' : (label === '面積' || label === '水道光熱費') ? 'is-minor' : '';

// 入居までの流れ。公式の6手順を変えずに、3つのまとまりで見せる。
const flowGroups = [
  housingAdmissionFlow.slice(0, 1),
  housingAdmissionFlow.slice(1, 4),
  housingAdmissionFlow.slice(4),
];

// 一日の流れ（参考）。時刻は住宅ごとに確認中のため、公開情報ではなく一般的な一例として示す。
const day = [
  { time: '7:00', label: '起床・朝食' },
  { time: '10:00', label: '健康チェック' },
  { time: '12:00', label: '昼食' },
  { time: '15:00', label: '自由時間' },
  { time: '18:00', label: '夕食' },
  { time: '21:00', label: '消灯' },
];
---
<PlumeriaLayout
  title="サービス付き高齢者向け住宅 Ⅰ・Ⅱ 比較｜プルメリア（修正版ラフ）"
  description="プルメリアが運営するサービス付き高齢者向け住宅Ⅰ・Ⅱの比較・ご案内です。"
  currentPath={routes.housing}
>
  <div class="pl-wrap" style="padding-top:28px">
    <p class="pl-breadcrumb">
      <a href={routes.top}>トップ</a>
      <span aria-hidden="true">/</span>
      <span>サービス付き高齢者向け住宅</span>
    </p>
  </div>

  <section class="pl-sec pl-sec-tight">
    <div class="pl-wrap">
      <h1 class="pl-h1" style="font-size:calc(clamp(1.7rem,4vw,2.4rem) * var(--pl-fs))">サービス付き高齢者向け住宅 Ⅰ・Ⅱ</h1>
      <p class="pl-sec-lead">
        安否確認と生活相談のある住宅です。自立向けのⅠと、介護対応型のⅡを比較してご案内します。
      </p>
      <nav class="pl-hs-jump" aria-label="このページの内容">
        <a href="#choice">ⅠとⅡの違い</a>
        <a href="#fee">料金</a>
        <a href="#admission">入居の手順</a>
        <a href="#facility">共用の施設</a>
        <a href="#services">サービス</a>
        <a href="#safety">安全</a>
        <a href="#access">アクセス</a>
      </nav>
      <p class="pl-note" style="text-align:center">※ 短期入所（ショートステイ）をお探しの方は<a href={routes.shortStay}>プルメリアⅢ（ショートステイ）</a>をご覧ください。</p>
    </div>
  </section>

  <section class="pl-sec" id="choice">
    <div class="pl-wrap">
      <h2 class="pl-h2">Ⅰは自立・介護予防向け、Ⅱは介護対応型です</h2>
      <div class="pl-hs-choice">
        {housingUnits.map((u) => (
          <article class="pl-hs-panel">
            <p class="pl-hs-kind">{u.kind}</p>
            <h3 class="pl-hs-name">{u.name}</h3>
            <p class="pl-hs-price pl-num-face">{u.priceFrom}</p>
            <dl class="pl-hs-facts">
              <div><dt>対象</dt><dd>{u.target}</dd></div>
              <div><dt>居室</dt><dd>{u.roomType}<br />{u.roomSize}</dd></div>
              <div><dt>敷金</dt><dd>{u.deposit.replace('敷金 ', '')}</dd></div>
              <div><dt>状況</dt><dd><PlumeriaVacancyStatus facilityId={`plumeria-${u.id}`} /></dd></div>
            </dl>
            <a class="pl-btn pl-btn-outline" href={routes.housingUnit(u.id)}>{u.name}を見る</a>
          </article>
        ))}
      </div>
      <p class="pl-note" style="margin-top:14px">※ 所在地はいずれも{corp.address}。金額は月額基本料金の目安で、生活費の総額ではありません。食費や介護保険自己負担分など、別途必要な費用をご確認ください。</p>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" id="fee">
    <div class="pl-wrap">
      <h2 class="pl-h2">月額の目安は、Ⅰが{feeTotal[0]}、Ⅱが{feeTotal[2]}（1名）です</h2>
      <p class="pl-sec-lead">食費や介護保険の自己負担分は別にかかります。入居時の敷金と、月々の内訳は次のとおりです。</p>
      <ul class="pl-hs-totals">
        {housingFeeTable.columns.map((col, i) => (
          <li data-tone={i < 2 ? 'a' : 'b'}>
            <span class="pl-hs-total-unit">{i < 2 ? housingUnits[0].name : housingUnits[1].name}</span>
            <span class="pl-hs-total-label">{col}</span>
            <strong class="pl-hs-total-num pl-num-face">{feeTotal[i]}</strong>
          </li>
        ))}
      </ul>
      <p class="pl-table-caption" aria-hidden="true">居室タイプ別の料金（横にスクロールできます）</p>
      <div class="pl-compare-table-wrap">
        <table class="pl-compare-table pl-hs-fee">
          <caption class="pl-sr-only">居室タイプ別の料金（横にスクロールできます）</caption>
          <thead>
            <tr class="pl-hs-fee-group">
              <td></td>
              {feeGroups.map((g) => <th scope="colgroup" colspan={g.span} data-tone={g.tone}>{g.name}</th>)}
            </tr>
            <tr>
              <th scope="col">項目</th>
              {housingFeeTable.columns.map((col) => <th scope="col">{col}</th>)}
            </tr>
          </thead>
          <tbody>
            {housingFeeTable.rows.map((row) => (
              <tr class={feeRowClass(row.label)}>
                <th scope="row">{row.label}</th>
                {row.values.map((value) => <td class="pl-num-face">{value}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="pl-note pl-check-list" style="margin-top:12px">
        {housingFeeTable.notes.map((note) => <li>{note}</li>)}
      </ul>
      <p class="pl-note"><a href="https://home-plumeria.jp/plumeria0102/fee.html" data-astro-reload>公式の料金内訳を見る</a>（2026年9月16日確認）</p>
    </div>
  </section>

  <section class="pl-sec" id="admission">
    <div class="pl-wrap">
      <h2 class="pl-h2">入居は、見学から正式入居まで6つの手順です</h2>
      <p class="pl-sec-lead">見学のお申し込みから正式入居までの流れです。ご不明な点は、見学の際にお尋ねください。</p>
      <ol class="pl-hs-flow">
        {flowGroups.map((group, g) => (
          <li class="pl-hs-stage">
            <ol class="pl-hs-steps" style={`--from:${flowGroups.slice(0, g).reduce((n, x) => n + x.length, 0)}`}>
              {group.map((step) => <li>{step}</li>)}
            </ol>
          </li>
        ))}
      </ol>

      <h3 class="pl-h3" style="margin-top:36px">入居の条件</h3>
      <div class="pl-grid-2" style="margin-top:12px">
        {housingAdmissionConditions.map((group) => (
          <div class="pl-card">
            <h4 class="pl-h3">{group.title}</h4>
            <ul class="pl-body pl-check-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <ul class="pl-note pl-check-list" style="margin-top:14px">
        {housingAdmissionCautions.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" id="facility">
    <div class="pl-wrap">
      <h2 class="pl-h2">共用の施設は、来訪されたご家族・ご友人もお使いいただけます</h2>
      <div class="pl-hs-lines pl-hs-lines-2">
        {housingCommonAreas.map((area) => (
          <div class="pl-hs-line">
            <h3 class="pl-hs-line-name">{area.name}</h3>
            <p class="pl-hs-line-body">{area.body}</p>
          </div>
        ))}
      </div>
      <p class="pl-note" style="margin-top:14px">このほか、庭園・菜園・遊歩道・活動室・カラオケルームがあり、コンサートや寄席などのイベントも定期的に企画しています。地域の方にもお集まりいただけます。</p>
      <p class="pl-note">居室の間取り・設備は、各住宅のページでご案内しています。</p>
    </div>
  </section>

  <section class="pl-sec">
    <div class="pl-wrap">
      <h2 class="pl-h2">一日の流れ（参考）</h2>
      <p class="pl-sec-lead">サービス付き高齢者向け住宅での過ごし方の一例です。実際の時間は住宅ごとに確認中です。</p>
      <p class="pl-note" style="text-align:center">※ 太陽が示しているのは、ご覧いただいている「今」の時刻です。すでに過ぎた時間は印の色が変わります。</p>
      <div class="pl-day-wrap">
        <span class="pl-day-sun" aria-hidden="true"><svg><use href="#pl-i-sun" /></svg></span>
        <ol class="pl-day">
          {day.map((d) => (
            <li class="pl-day-item">
              <span class="pl-num-face pl-day-time">{d.time}</span>
              <span class="pl-day-dot" aria-hidden="true"></span>
              <span class="pl-day-label">{d.label}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" id="services">
    <div class="pl-wrap">
      <h2 class="pl-h2">基礎サービス{housingBasicServices.length}つは、サービス管理費に含まれます</h2>
      <p class="pl-sec-lead">全入居者にご利用いただけるサービスです。</p>
      <div class="pl-hs-lines pl-hs-lines-2">
        {housingBasicServices.map((item) => (
          <div class="pl-hs-line">
            <h3 class="pl-hs-line-name">{item.name}</h3>
            <p class="pl-hs-line-body">{item.body}</p>
          </div>
        ))}
      </div>

      <h2 class="pl-h2" style="margin-top:44px">希望サービスは、必要なときに追加できます</h2>
      <p class="pl-sec-lead">基礎サービスに加えてご利用いただけます。要介護の認定を受けていない方もご相談いただけます。</p>
      <div class="pl-hs-lines pl-hs-lines-2">
        {housingOptionalServices.map((item) => (
          <div class="pl-hs-line">
            <h3 class="pl-hs-line-name">{item.name}</h3>
            <p class="pl-hs-line-body">{item.body}</p>
          </div>
        ))}
      </div>
      <p class="pl-note" style="margin-top:14px">希望サービスのご相談は1階の管理事務所で承ります。<a href="https://home-plumeria.jp/plumeria0102/service.html" data-astro-reload>公式のサービス内容を見る</a>（2026年9月16日確認）</p>
    </div>
  </section>

  <section class="pl-sec" id="safety">
    <div class="pl-wrap">
      <h2 class="pl-h2">24時間の緊急対応やAED、防犯カメラなど、{housingSafetyItems.length}つの備えがあります</h2>
      <ul class="pl-auto-grid pl-auto-grid-4">
        {housingSafetyItems.map((item) => <li class="pl-fit-item">{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" id="access">
    <div class="pl-wrap pl-reading">
      <h2 class="pl-h2">今渡駅から徒歩3分。周囲に銀行・病院・公共ホールがあります</h2>
      <p class="pl-body">{corp.address}</p>
      <p class="pl-body">{housingNeighborhood}</p>
      <dl class="pl-access-list">
        <div><dt>名鉄でお越しの方</dt><dd>名鉄 日本ライン「今渡駅」から徒歩3分</dd></div>
        <div><dt>JRでお越しの方</dt><dd>JR「名古屋駅」より約50分、「可児駅」下車・タクシーで約5分</dd></div>
        <div><dt>お車でお越しの方</dt><dd>中央自動車道「多治見」ICから国道248号線経由で約20分／東海環状自動車道「可児御嵩」ICから国道21号線経由で約10分</dd></div>
      </dl>
      <a class="pl-more" href="https://home-plumeria.jp/plumeria0102/" data-astro-reload>公式の地図付きアクセス案内を見る →</a>
    </div>
  </section>

  <section class="pl-sec">
    <div class="pl-wrap pl-reading">
      <h2 class="pl-h2">見学で確かめたいこと</h2>
      <ul class="pl-body pl-check-list">
        <li>居室の広さや設備が、ご自身の生活に合うか</li>
        <li>必要な介護・看護を利用できるか</li>
        <li>食事・光熱費・介護サービスを含めた月々の総額</li>
      </ul>
      <p class="pl-note">暮らし方や支援内容は、住宅とご本人の状況によって異なります。</p>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" style="text-align:center">
    <div class="pl-wrap">
      <h2 class="pl-h2" style="justify-content:center">見学・入居のご相談</h2>
      <div class="pl-btn-row" style="justify-content:center">
        <a class="pl-btn pl-btn-main" href={`${routes.contact}?service=housing`} data-pl-gtag="contact_click" data-pl-service="housing" data-pl-cta="page_cta">住宅について相談する</a>
      </div>
    </div>
  </section>
</PlumeriaLayout>

<script>
  // 一日の流れ：太陽の位置と各ドットの点灯を、閲覧している今の時刻と連動させる。
  // View Transitions でこのページに戻ってくるたびに astro:page-load が発火するので、
  // トップレベルIIFEではなく名前付き関数として束ね、毎回タイマーを張り直す。
  let plDayClockTimer: number | null = null;

  function initPlumeriaDayClock() {
    if (plDayClockTimer !== null) { window.clearInterval(plDayClockTimer); plDayClockTimer = null; }

    const sun = document.querySelector<HTMLElement>('.pl-day-sun');
    const items = [...document.querySelectorAll<HTMLElement>('.pl-day-item')];
    if (!sun || !items.length) return;

    const minutesOf = (item: HTMLElement): number | null => {
      const label = item.querySelector('.pl-day-time')?.textContent?.trim() ?? '';
      const [h, m] = label.split(':').map((v) => Number(v));
      return Number.isFinite(h) ? h * 60 + (Number.isFinite(m) ? m : 0) : null;
    };

    const times = items.map(minutesOf);
    if (times.some((t) => t === null) || times.length < 2) return;

    const first = times[0] as number;
    const last = times[times.length - 1] as number;
    if (last <= first) return;

    function update() {
      const now = new Date();
      const nowMinutes = now.getHours() * 60 + now.getMinutes();
      const clamped = Math.min(Math.max(nowMinutes, first), last);
      const ratio = (clamped - first) / (last - first);
      const percent = 8 + ratio * (92 - 8);
      sun!.style.left = `${percent}%`;

      items.forEach((item, i) => {
        const dot = item.querySelector('.pl-day-dot');
        dot?.classList.toggle('is-past', (times[i] as number) <= nowMinutes);
      });
    }

    update();
    plDayClockTimer = window.setInterval(update, 60000);
  }

  document.addEventListener('astro:page-load', initPlumeriaDayClock);
  document.addEventListener('astro:before-swap', () => {
    if (plDayClockTimer !== null) { window.clearInterval(plDayClockTimer); plDayClockTimer = null; }
  });
</script>
