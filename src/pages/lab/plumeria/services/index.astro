---
import PlumeriaLayout from '../../../../layouts/PlumeriaLayout.astro';
import PlumeriaGuideQuiz from '../../../../components/plumeria/PlumeriaGuideQuiz.astro';
import { routes, services } from '../../../../data/plumeria';

// サービスのまとまりはフッター・トップと同じ区分（住まい／在宅サービス）。
const serviceGroups = [
  { title: '住まい', ids: ['housing', 'short-stay'] },
  { title: '在宅サービス', ids: ['home-care', 'home-nursing', 'care-management', 'welfare-equipment'] },
].map((g) => ({ ...g, items: g.ids.map((id) => services.find((s) => s.id === id)!) }));
---
<PlumeriaLayout
  title="サービス一覧・選び方｜プルメリア（修正版ラフ）"
  description="プルメリアが提供する住まい・ショートステイ・訪問介護・訪問看護・居宅介護支援・福祉用具の一覧と選び方のご案内です。"
  currentPath={routes.services}
>
  <div class="pl-wrap" style="padding-top:28px">
    <p class="pl-breadcrumb">
      <a href={routes.top}>トップ</a>
      <span aria-hidden="true">/</span>
      <span>サービス一覧</span>
    </p>
  </div>

  <section class="pl-sec pl-sec-tight">
    <div class="pl-wrap">
      <h1 class="pl-h1" style="font-size:calc(clamp(1.7rem,4vw,2.4rem) * var(--pl-fs))">サービス一覧・選び方</h1>
      <p class="pl-sec-lead">
        住まい・短期宿泊・ご自宅での支援からお選びください。
      </p>
    </div>
  </section>

  <PlumeriaGuideQuiz />

  <section class="pl-sec" id="list">
    <div class="pl-wrap">
      <h2 class="pl-h2">住まいと在宅の{services.length}つのサービスから、お選びいただけます</h2>
      {serviceGroups.map((g) => (
        <div class="pl-hs-group">
          <h3 class="pl-hs-group-title">{g.title}</h3>
          <div class={`pl-hs-svc-grid pl-hs-svc-grid-${g.items.length}`}>
            {g.items.map((s) => (
              <a class="pl-card pl-service-intro-card" href={s.href} data-pl-gtag="service_select" data-pl-service={s.id} data-pl-cta="services_list">
                <img src={s.img} alt={s.alt} width="900" height="675" loading="lazy" decoding="async" />
                <p class="pl-hs-tag">{s.tagline}</p>
                <h4 class="pl-hs-line-name pl-hs-svc-name">{s.name}</h4>
                <p class="pl-hs-line-body">{s.summary}</p>
                <span class="pl-service-intro-more">くわしく見る →</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" style="text-align:center">
    <div class="pl-wrap">
      <h2 class="pl-h2" style="justify-content:center">まだ決まっていない場合も、ご相談ください</h2>
      <div class="pl-btn-row" style="justify-content:center">
        <a class="pl-btn pl-btn-main" href={`${routes.contact}?service=undecided`} data-pl-gtag="contact_click" data-pl-service="undecided" data-pl-cta="page_cta">お問い合わせ・ご相談へ</a>
      </div>
    </div>
  </section>
</PlumeriaLayout>
