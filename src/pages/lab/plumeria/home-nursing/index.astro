---
import PlumeriaServicePage from '../../../../components/plumeria/PlumeriaServicePage.astro';
import { routes, homeNursingTasks, homeNursingStrengths, plImg } from '../../../../data/plumeria';

// 大きく見せる数字（出典：homeNursingStrengths の「寄り添う看護」、homeNursingTasks の分類と項目数）
const taskCount = homeNursingTasks.reduce((n, g) => n + g.items.length, 0);
const keyFacts = [
  { num: '24', unit: '時間', label: '365日の緊急時対応' },
  { num: String(homeNursingTasks.length), unit: '種類', label: homeNursingTasks.map((g) => g.title.replace('サービス', '')).join('と') + 'のサービス' },
  { num: String(taskCount), unit: '項目', label: '具体的なケアの内容' },
];

// ケアの内容の2分類を枠で見せる。色は同じにし、分類名の札で区別する（項目は data/plumeria.ts のまま）
const taskGroups = homeNursingTasks.map((g) => ({ ...g, badge: g.title.replace('サービス', '') }));
---
<PlumeriaServicePage
  title="訪問看護｜プルメリア（修正版ラフ）"
  description="看護師がご自宅で体調の確認や医師の指示に基づくケアを行います。対象・費用・ご相談の流れをご案内します。"
  currentPath={routes.homeNursing}
  breadcrumbLabel="訪問看護"
  heroTitle="訪問看護"
  heroLead="看護師がご自宅で、体調の確認や医師の指示に基づくケアを行います。"
  heroImg={plImg('services-04.webp')}
  heroAlt="ご自宅のリビングで看護師が健康状態を確認している様子（イメージ）"
  fitFor={[
    '通院が難しく、ご自宅での医療的なケアが必要な方',
    '持病の管理や服薬について相談したい方',
    'ご家族が医療面のケアに不安を感じている方',
  ]}
  content={[
    { label: '医療的なケア', body: '医師の指示に基づく処置を行います。' },
    { label: '健康管理', body: '体調・服薬の管理と、療養中の生活面のケアです。' },
    { label: '緊急時の支援', body: '24時間365日対応します。利用条件と連絡方法はご契約時にご確認ください。' },
  ]}
  targetInfo={[
    { label: '対象となる方', body: '主治医の指示のもとで訪問看護が必要な方' },
    { label: '対応地域', body: 'お住まいの地域で利用できるかは、窓口にご確認ください。' },
  ]}
  costInfo="医療保険・介護保険いずれの適用かにより異なります。正式な費用は個別にご案内します。"
  flowSteps={[
    { title: 'お問い合わせ', body: '相談窓口へ、ご希望の支援内容をお伝えください。' },
    { title: '主治医への確認', body: '指示書など、必要な手続きをご案内します。' },
    { title: 'ご利用開始', body: '訪問の日程を決めて始めます。' },
  ]}
  contactCategory="home-nursing"
  supportHeading="医療的なケア・健康管理・緊急時の支援の、3つを行います"
  conditionsHeading="対象は、主治医の指示のもとで訪問看護が必要な方です"
  flowHeading="ご利用開始まで、3つの手順です"
>
  <ul slot="hero-facts" class="pl-stats" aria-label="訪問看護の要点">
    {keyFacts.map((f) => (
      <li>
        <span class="pl-stat-num pl-num-face">{f.num}{f.unit && <small>{f.unit}</small>}</span>
        <span class="pl-stat-label">{f.label}</span>
      </li>
    ))}
  </ul>

  <Fragment slot="extra">
    <section class="pl-sec pl-sec-beige" id="tasks">
      <div class="pl-wrap">
        <h2 class="pl-h2">訪問看護には、医療保険と介護保険の2種類のサービスがあります</h2>
        <div class="pl-taskgroups">
          {taskGroups.map((g) => (
            <section class="pl-taskgroup">
              <h3 class="pl-taskgroup-head"><span class="pl-taskgroup-badge">{g.badge}</span><span class="pl-med-count">（{g.items.length}項目）</span></h3>
              <ul class="pl-chips">
                {g.items.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ))}
        </div>
        <p class="pl-note" style="margin-top:14px">どちらの保険が適用されるかは、主治医の指示内容やご本人の状況によって決まります。窓口へご相談ください。</p>
      </div>
    </section>

    <section class="pl-sec" id="strengths">
      <div class="pl-wrap">
        <h2 class="pl-h2">プルメリアの訪問看護には、{homeNursingStrengths.length}つの特長があります</h2>
        <div class="pl-hs-lines pl-hs-lines-2">
          {homeNursingStrengths.map((item) => (
            <div class="pl-hs-line">
              <h3 class="pl-hs-line-name">{item.name}</h3>
              <p class="pl-hs-line-body">{item.body}</p>
            </div>
          ))}
        </div>
        <p class="pl-note" style="margin-top:14px"><a href="https://home-plumeria.jp/visit_nursing/" data-astro-reload>公式の訪問看護サービスのご案内を見る</a>（2026年9月16日確認）。具体的な対応可否はご相談時にご確認ください。</p>
      </div>
    </section>
  </Fragment>
</PlumeriaServicePage>
