---
import PlumeriaServicePage from '../../../../components/plumeria/PlumeriaServicePage.astro';
import { routes, homeCareTasks, homeCareStrengths, plImg } from '../../../../data/plumeria';

// 大きく見せる数字（出典：homeCareTasks の分類と項目数、homeCareStrengths の「継続的な研修」）
const taskCount = homeCareTasks.reduce((n, g) => n + g.items.length, 0);
const keyFacts = [
  { num: String(homeCareTasks.length), unit: '種類', label: homeCareTasks.map((g) => g.title.replace('サービス', '')).join('と') },
  { num: String(taskCount), unit: '項目', label: '具体的な支援の内容' },
  { num: '毎月', unit: '', label: '社内研修で介護技術を向上' },
];

// 支援内容の2分類を枠で見せる。色は同じにし、分類名の札で区別する（項目は data/plumeria.ts のまま）
const taskGroups = homeCareTasks.map((g) => ({ ...g, badge: g.title.replace('サービス', '') }));
---
<PlumeriaServicePage
  title="訪問介護｜プルメリア（修正版ラフ）"
  description="プルメリアの訪問介護は、ホームヘルパーがご自宅を訪問し、身体介護・生活援助を行います。"
  currentPath={routes.homeCare}
  breadcrumbLabel="訪問介護"
  heroTitle="訪問介護"
  heroLead="ホームヘルパーがご自宅を訪問し、身体介護・生活援助を行います。"
  heroImg={plImg('feature-01.webp')}
  heroAlt="入居者とスタッフが同じ目線の高さで話している様子（イメージ）"
  fitFor={[
    'ご自宅での入浴・排せつ・食事の介助が必要な方',
    '掃除・洗濯・調理などの生活援助が必要な方',
    'ご家族の介護負担を減らしたい方',
  ]}
  content={[
    { label: '身体介護', body: '入浴・排せつ・食事など、体に直接ふれる介助です。' },
    { label: '生活援助', body: '調理・洗濯・掃除・買い物などの家事のお手伝いです。' },
    { label: '専門スタッフ', body: '介護福祉士などの有資格者と、専属の責任者が担当します。' },
  ]}
  targetInfo={[
    { label: '対象となる方', body: '要介護・要支援の認定を受けている方' },
    { label: '対応地域', body: 'お住まいの地域で利用できるかは、窓口にご確認ください。' },
  ]}
  costInfo="自己負担割合や支援内容によって異なります。保険外の支援は、対応できる内容と料金を事前にご確認ください。"
  flowSteps={[
    { title: 'お問い合わせ', body: '相談窓口へ、ご希望の支援内容をお伝えください。' },
    { title: 'ご相談・確認', body: '今の状況とケアプランの有無を確認します。' },
    { title: 'ご利用開始', body: 'ご納得いただいてから始めます。' },
  ]}
  contactCategory="home-care"
  supportHeading="ご自宅で、身体介護と生活援助を行います"
  conditionsHeading="対象は、要介護・要支援の認定を受けている方です"
  flowHeading="ご利用開始まで、3つの手順です"
>
  <ul slot="hero-facts" class="pl-stats" aria-label="訪問介護の要点">
    {keyFacts.map((f) => (
      <li>
        <span class="pl-stat-num pl-num-face">{f.num}{f.unit && <small>{f.unit}</small>}</span>
        <span class="pl-stat-label">{f.label}</span>
      </li>
    ))}
  </ul>

  <figure slot="conditions-figure" class="pl-fitmap">
    <figcaption class="pl-sr-only">介護認定から見た、ご利用の対象</figcaption>
    <ol class="pl-fitmap-scale" aria-hidden="true">
      <li>認定なし</li><li>要支援</li><li>要介護</li>
    </ol>
    <p class="pl-fitmap-bar" data-tone="a" style="grid-column:2 / 4"><span class="pl-fitmap-main"><strong>訪問介護</strong>要支援・要介護の認定を受けている方</span></p>
  </figure>

  <Fragment slot="extra">
    <section class="pl-sec pl-sec-beige" id="tasks">
      <div class="pl-wrap">
        <h2 class="pl-h2">身体介護と生活援助の、2種類のサービスがあります</h2>
        <div class="pl-taskgroups">
          {taskGroups.map((g) => (
            <section class="pl-taskgroup">
              <h3 class="pl-taskgroup-head"><span class="pl-taskgroup-badge">{g.badge}</span><span class="pl-med-count">（{g.items.length}項目）</span></h3>
              <ul class="pl-chips">
                {g.items.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          ))}
        </div>
        <p class="pl-note" style="margin-top:14px">できることは継続していただき、買い物や薬の受け取りの代行など、ご本人・ご家族にとって難しいことをサポートします。</p>
      </div>
    </section>

    <section class="pl-sec" id="strengths">
      <div class="pl-wrap">
        <h2 class="pl-h2">プルメリアの訪問介護には、{homeCareStrengths.length}つの特長があります</h2>
        <div class="pl-hs-lines pl-hs-lines-2">
          {homeCareStrengths.map((item) => (
            <div class="pl-hs-line">
              <h3 class="pl-hs-line-name">{item.name}</h3>
              <p class="pl-hs-line-body">{item.body}</p>
            </div>
          ))}
        </div>
        <p class="pl-note" style="margin-top:14px"><a href="https://home-plumeria.jp/visit_care/" data-astro-reload>公式の訪問介護サービスのご案内を見る</a>（2026年9月16日確認）</p>
      </div>
    </section>
  </Fragment>
</PlumeriaServicePage>
