---
/*
  Claude Designプロジェクト「ウェブデザイン心理学のヒーローリデザイン」の
  Homepage.dc.html を実装したプレビュー。現行トップページとの比較用で、noindex。

  元データからの意図的な変更:
  - 「相談は月3件まで」「今月は残り2枠」は、根拠が確認できない件数の訴求のため、
    AvailabilityStatus.astro と同じ「随時変動する空き状況」の言い方に置き換えている。
  - 元は min-width:1280px の固定幅。スマホ・タブレットでも崩れないよう段組みを可変にした。
  - ホバーでしか出ない補足は、キーボード操作時とタッチ環境でも読めるようにしている。
*/
import BroadsheetLayout from '../../layouts/BroadsheetLayout.astro';

const navItems = [
  { label: '改善ラボ', href: '/lab/' },
  { label: '制作例・デモ', href: '/demos/' },
  { label: 'サービス・料金', href: '/pricing/' },
  { label: '和-Nodeについて', href: '/about/' },
];

// 「PAGE ORDER — PREVIEW」。元データは pick='price' の状態で描画される。
const orderName = '費用ファースト';
const orderNote = '料金の目安を最初に置くと、「高いのでは」という不安が先に解けます。';
const orderBlocks = [
  { rank: '01', title: '料金の目安', desc: 'HP 40,000円〜／LP診断 15,000円〜' },
  { rank: '02', title: '制作例・デモ', desc: '業種別のサンプルと改善前後' },
  { rank: '03', title: '無料相談の流れ', desc: '30分・聞くことは3つだけ' },
];

const guides = [
  {
    num: '01',
    title: '必要なもの',
    desc: '素材・情報の目安',
    note: '写真や文章が未整備でも進められます。あるものから始めます。',
  },
  {
    num: '02',
    title: '料金の目安',
    desc: '規模別の考え方',
    note: 'HP 40,000円〜／LP診断 15,000円〜／月額 15,000円〜。先にお見せします。',
  },
  {
    num: '03',
    title: '進め方',
    desc: '相談から公開まで',
    note: '相談 → 方向性の整理 → 制作 → 公開後の改善。各段で止められます。',
  },
];

const signals = [
  { value: '20年以上', label: 'IT・Web制作の現場経験' },
  { value: 'カウンセラーとして', label: '心理学を導線設計へ応用' },
  { value: 'SECURITY ACTION', label: '情報管理への取り組みを宣言' },
  { value: '公開後', label: '改善・運用まで継続支援' },
];

const steps = [
  {
    number: 'Step 01',
    title: '迷いを言葉にする',
    desc: '現状の課題や不安、伝えたい想いを、対話と心理学の視点から整理します。',
  },
  {
    number: 'Step 02',
    title: '順番を整える',
    desc: '誰に何をどの順番で届けるかを決め、情報と相談導線を設計します。',
  },
  {
    number: 'Step 03',
    title: '相談できる形へ',
    desc: 'ホームページとして形にし、公開後も反応を見ながら改善を重ねます。',
  },
];

const phases = [
  {
    label: '情報の順番',
    before: '強み・料金・相談方法が別々に見えて、初見の人が判断しにくい。',
    after: '誰向けか、何を頼めるか、次に何をすればいいかが自然に追える。',
  },
  {
    label: '相談前の不安',
    before: '「いくらかかるのか」「何を聞かれるのか」が分からず、フォーム前で止まりやすい。',
    after: '料金目安、流れ、相談範囲を先に見せて、安心して問い合わせに進める。',
  },
  {
    label: '公開後の改善',
    before: '作って終わりになり、反応が悪い理由を後から見つけにくい。',
    after: 'アクセス解析や問い合わせ状況を見ながら、改善しやすいWeb環境に育てる。',
  },
];

const services = [
  {
    tag: 'Web Design',
    price: '40,000円〜',
    title: 'ホームページ制作を相談したい',
    fit: 'まず信頼されるサイトを作りたい方へ',
    summary: '信頼・料金・相談の流れを、初見で伝わる形に整えます。',
    link: 'HP制作の内容を見る',
    href: '/pricing/',
  },
  {
    tag: 'Web Improvement',
    price: '15,000円〜',
    title: '今あるLPを改善したい',
    fit: '今あるLPを改善したい方へ',
    summary: '迷いどころを見つけ、相談につながる導線へ組み直します。',
    link: 'LP診断の内容を見る',
    href: '/pricing/',
  },
  {
    tag: 'Ongoing Partnership',
    price: '15,000円/月〜',
    title: '作った後も相談したい',
    fit: '公開後も改善や判断を相談したい方へ',
    summary: 'Web・AI・業務の判断を、継続して相談できる形にします。',
    link: '月額の伴走を見る',
    href: '/pricing/',
  },
  {
    tag: 'ICT & System',
    price: '5,000円〜',
    title: 'AI・ICTで業務を整えたい',
    fit: '業務整理やAI活用から始めたい方へ',
    summary: '日々の作業を整理し、使いやすいICT活用へつなげます。',
    link: 'スポット相談を見る',
    href: '/pricing/',
  },
];

const demos = [
  { title: '選ばれる導線デモ', desc: '心理学的根拠を可視化したデモページ。', href: '/psychology-demo/' },
  { title: 'AI相談ナビ', desc: 'AIがあなたの課題を整理します。', href: '/ai-chat-demo/' },
  { title: '料金シミュレーター', desc: '概算費用と納期をその場で確認。', href: '/simulator/' },
];

const flow = [
  { n: '1', title: '無料相談（30-60分）', desc: 'フォームまたはLINEより。現状の課題を丁寧に整理します。' },
  { n: '2', title: '方向性整理・お見積り', desc: '必要に応じて簡易メモ・概要案を添え、最適なプランをご提示します。' },
  { n: '3', title: 'ご契約・着手', desc: '内容にご納得いただいた上で、制作・改善をスタートします。' },
];

// フッターの構成とラベルは現行の Footer.astro／translations.json に合わせている
const footerColumns = [
  {
    heading: 'ホームページ制作・副操縦士',
    label: 'Services',
    items: [
      { text: '行動心理に基づくWeb制作', href: '/pricing/#web-production' },
      { text: 'ホームページ・LP制作', href: '/pricing/#web-production' },
      { text: 'ビジネスの副操縦士（月額）', href: '/pricing/#copilot' },
      { text: 'ご契約後の進行フロー', href: '/pricing/#project-flow' },
      { text: '制作例・サンプル', href: '/works/' },
    ],
  },
  {
    heading: '相談前に見る',
    label: 'Start Here',
    items: [
      { text: '無料相談', href: '/contact/' },
      { text: '料金を見る', href: '/pricing/' },
      { text: '制作例・デモを見る', href: '/works/' },
    ],
  },
  {
    heading: '補足コンテンツ',
    label: 'Resources',
    items: [
      { text: '和-Node 知恵袋（ブログ）', href: '/blog/' },
      { text: '選ばれる導線デモ', href: '/psychology-demo/' },
      { text: 'WASMファーストビュー・色彩診断', href: '/wasm-diagnosis/' },
      { text: '当サイトの技術（Tech Stack）', href: '/tech-stack/' },
      { text: 'Web・自動化やさしい解説', href: '/easy-guide/' },
      { text: 'KDP出版実績', href: '/kdp_books/' },
    ],
  },
  {
    heading: '運営・規約ポリシー',
    label: 'Imprint',
    items: [
      { text: '利用規約', href: '/terms/' },
      { text: 'プライバシーポリシー', href: '/privacy/' },
      { text: '情報セキュリティ方針', href: '/security-policy/' },
      { text: '特定商取引法に基づく表記', href: '/tokutei/' },
      { text: 'LINE Mini App 利用規約', href: '/terms_miniapp/' },
    ],
  },
];
---

<BroadsheetLayout
  title="トップページ再設計プレビュー｜和-Node"
  description="Claude Designで作成したトップページ再設計案の実装プレビューです。現行サイトとの比較用で、検索結果には表示されません。"
>
  <header class="masthead">
    <div class="sheet masthead-top">
      <a class="brand" href="/">
        和-Node<span class="brand-sub">心理学 × ウェブデザイン</span>
      </a>
      <nav class="masthead-nav" aria-label="メイン">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="nav-cta" href="/contact/">相談する</a>
      </nav>
    </div>
    <div class="sheet masthead-strip">
      <span>中小企業のWeb担当者のための、伝わる順番のはなし</span>
      <span>初回30分・無料／空き状況はお問い合わせください</span>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="sheet hero-grid">
        <div>
          <h1 class="hero-title">
            安心して、<br />ちょっと、<span class="term-wrap"
              ><button type="button" class="term term-peak" aria-describedby="tip-peak"
                >わくわくしながら</button
              ><svg class="term-rule" viewBox="0 0 320 46" preserveAspectRatio="none" aria-hidden="true"
                ><path d="M4 30 C60 8, 250 6, 314 24" /></svg
              ><span class="tip" id="tip-peak" role="tooltip"
                >ピーク・エンドの法則：体験の「山」と「終わり」の印象が、いちばん記憶に残ります。</span
              ></span
            ><br />選んでもらう。
          </h1>
          <p class="hero-lead">
            むずかしい言葉は使いません。<span class="term-wrap term-wrap-inline"
              ><button type="button" class="term term-load" aria-describedby="tip-load">どこで迷うか</button
              ><span class="tip tip-sm" id="tip-load" role="tooltip"
                >認知的負荷：情報と選択肢が増えるほど、人は決められなくなります。</span
              ></span
            >を心理学の視点で見つけて、料金・強み・相談の流れを、初見の人が読める順番に整えます。
          </p>
        </div>

        <div class="order-panel">
          <i class="corner corner-tl" aria-hidden="true"></i>
          <i class="corner corner-tr" aria-hidden="true"></i>
          <i class="corner corner-bl" aria-hidden="true"></i>
          <i class="corner corner-br" aria-hidden="true"></i>
          <div class="order-head">
            <span>PAGE ORDER — PREVIEW</span><span>{orderName}</span>
          </div>
          <ol class="order-list">
            {
              orderBlocks.map((b, i) => (
                <li class:list={['order-row', { 'is-lead': i === 0 }]}>
                  <span class="order-rank">{b.rank}</span>
                  <span>
                    <strong class="order-title">{b.title}</strong>
                    <small class="order-desc">{b.desc}</small>
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="order-note">{orderNote}</p>
        </div>
      </div>

      <figure class="cmyk hero-figure">
        <div class="print">
          <img
            src="/images/lab/homepage-redesign-hero.webp"
            alt="打ち合わせの場で、資料を見ながら和やかに方向性を選んでいる様子"
            width="1200"
            height="675"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </figure>
    </section>

    <section class="band band-guide">
      <div class="sheet">
        <div class="lede-grid">
          <div>
            <div class="eyebrow">Consultation Guide</div>
            <h2 class="h-lg">相談前の見通しを、先に。</h2>
          </div>
          <p class="lede-text">
            準備物・料金・進め方を、無料相談の前に見える形にしておきます。「何を聞かれるんだろう」がなくなると、話は早くなります。
          </p>
        </div>
        <div class="rule-heavy"></div>
        <div class="grid-3">
          {
            guides.map((g) => (
              <div class="card elev-sm guide-card" tabindex="0">
                <div class="cmyk-num guide-num">
                  <span class="paper">{g.num}</span>
                  <span class="plate plate-c" aria-hidden="true">
                    {g.num}
                  </span>
                  <span class="plate plate-m" aria-hidden="true">
                    {g.num}
                  </span>
                  <span class="plate plate-y" aria-hidden="true">
                    {g.num}
                  </span>
                </div>
                <strong class="guide-title">{g.title}</strong>
                <span class="guide-desc">{g.desc}</span>
                <span class="guide-note">{g.note}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band band-signals">
      <div class="sheet">
        <ul class="signal-row">
          {
            signals.map((s) => (
              <li class="signal">
                <strong class="signal-value">{s.value}</strong>
                <span class="signal-label">{s.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="band band-clarity">
      <div class="sheet clarity-grid">
        <div>
          <div class="eyebrow">From uncertainty to clarity</div>
          <h2 class="h-lg">つくる前に、迷いを<br />相談できる形へ。</h2>
          <p class="body-text">
            技術を先に当てはめるのではなく、伝える相手と順番を整えてから、必要なWeb制作へ進みます。
          </p>
          <p class="availability">
            <span class="availability-dot" aria-hidden="true"></span>現在受付中（空き状況は随時変動します）
          </p>
        </div>
        <ol class="step-list">
          {
            steps.map((st) => (
              <li class="step">
                <span class="step-number">{st.number}</span>
                <span>
                  <strong class="step-title">{st.title}</strong>
                  <span class="step-desc">{st.desc}</span>
                  <svg class="step-rule" viewBox="0 0 520 12" preserveAspectRatio="none" aria-hidden="true">
                    <path d="M2 8 C130 1, 380 1, 516 7" />
                  </svg>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="band band-problem">
      <div class="sheet">
        <div class="rule-heavy"></div>
        <div class="problem-grid">
          <div>
            <div class="eyebrow eyebrow-alt">こんなお悩みはありませんか？</div>
            <h2 class="h-lg">見た目は整っているのに、<br />なぜ相談につながらないのか。</h2>
            <p class="body-text">
              多くの場合、原因はデザインの良し悪しだけでなく、初見の人が迷う<em class="em-accent">情報の順番</em
              >と、相談前の不安にあります。
            </p>
          </div>
          <div class="problem-notes">
            <div>
              <strong class="note-title">「綺麗」だけでは、不安は減りません</strong>
              <span class="note-text">
                見た目が整っていても、料金・流れ・次の行動が分かりにくいと、訪問者は相談前に立ち止まりやすくなります。
              </span>
            </div>
            <div class="note-divided">
              <strong class="note-title">ICT × 統計 × 行動心理学</strong>
              <span class="note-text">
                20年のシステム構築経験とデータ分析に、カウンセラーとしての心理学の知見を組み合わせ、初見の人が迷いにくい導線を作ります。
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band band-phases">
      <div class="sheet">
        <div class="phase-head">
          <div>
            <div class="eyebrow">Before / After</div>
            <h2 class="h-md">伝わる順番が整うと、迷いが減ります。</h2>
          </div>
          <div class="phase-toggle" role="group" aria-label="BeforeとAfterの切り替え">
            <button type="button" class="phase-btn" data-phase="before" aria-pressed="false">Before</button>
            <button type="button" class="phase-btn is-on" data-phase="after" aria-pressed="true">After</button>
          </div>
        </div>
        <div class="rule-heavy"></div>
        <div class="grid-3" id="phase-cards">
          {
            phases.map((p) => (
              <div class="card elev-sm phase-card">
                <span class="phase-label">{p.label}</span>
                <p class="phase-copy" data-before={p.before} data-after={p.after}>
                  {p.after}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band band-services">
      <div class="sheet">
        <div class="section-head">
          <div class="eyebrow">Service Pillars</div>
          <h2 class="h-md">迷ったら、まずはこの4つから。</h2>
        </div>
        <div class="grid-2">
          {
            services.map((sv) => (
              <div class="card elev-sm service-card">
                <div class="service-top">
                  <span class="service-tag">{sv.tag}</span>
                  <span class="service-price">{sv.price}</span>
                </div>
                <strong class="service-title">{sv.title}</strong>
                <span class="service-fit">{sv.fit}</span>
                <span class="service-summary">{sv.summary}</span>
                <a class="service-link" href={sv.href}>
                  {sv.link} →
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band band-demos">
      <div class="sheet">
        <div class="section-head">
          <div class="eyebrow eyebrow-alt">Experience Demo</div>
          <h2 class="h-md">「伝わる」を、さわって確かめる。</h2>
        </div>
        <div class="rule-heavy"></div>
        <div class="grid-3">
          {
            demos.map((d) => (
              <a class="card elev-sm demo-card" href={d.href}>
                <strong class="demo-title">{d.title}</strong>
                <span class="demo-desc">{d.desc}</span>
                <span class="demo-cta">
                  試してみる<span class="demo-arrow" aria-hidden="true">
                    →
                  </span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="band band-flow">
      <div class="sheet flow-grid">
        <div>
          <div class="eyebrow">Flow</div>
          <h2 class="h-md">ご相談の流れ</h2>
          <p class="body-text flow-lead">
            まず30分。今の状況を一緒に整理するところから始めます。相談後の契約は必須ではありません。
          </p>
          <a class="cta" href="/contact/">
            <span>まず30分、話してみる</span><span aria-hidden="true">→</span>
          </a>
          <p class="cta-note">入力は約2分。フォームまたはLINEから。</p>
        </div>
        <ol class="flow-list">
          {
            flow.map((f) => (
              <li class="flow-item">
                <span class="cmyk-num flow-num">
                  <span class="paper">{f.n}</span>
                  <span class="plate plate-c" aria-hidden="true">
                    {f.n}
                  </span>
                  <span class="plate plate-m" aria-hidden="true">
                    {f.n}
                  </span>
                  <span class="plate plate-y" aria-hidden="true">
                    {f.n}
                  </span>
                </span>
                <span>
                  <strong class="flow-title">{f.title}</strong>
                  <span class="flow-desc">{f.desc}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="band band-closing">
      <div class="sheet">
        <div class="rule-heavy"></div>
        <div class="closing-row">
          <p class="closing-text">
            初回相談のあと、必要に応じて簡易メモ・概要案をお渡しします。詳細な設計に入る前に、進む方向と費用感を確認できます。
          </p>
          <span class="closing-mark">Step toward Quality</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="colophon">
    <div class="sheet">
      <div class="colophon-rule"></div>

      <div class="colophon-masthead">
        <div>
          <a class="colophon-brand" href="/">
            和-Node<span class="brand-sub">心理学 × ウェブデザイン</span>
          </a>
          <p class="colophon-lead">
            伝わる順番を整えるWeb制作と、公開後の改善までを一人で担当します。まずは30分の相談から。
          </p>
        </div>
        <a class="colophon-cta" href="/contact/">
          <span>無料で相談する</span><span aria-hidden="true">→</span>
        </a>
      </div>

      <nav class="colophon-grid" aria-label="フッター">
        {
          footerColumns.map((col) => (
            <div class="colophon-col">
              <div class="colophon-label">{col.label}</div>
              <h2 class="colophon-heading">{col.heading}</h2>
              <ul class="colophon-list">
                {col.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <div class="colophon-foot">
        <a class="colophon-badge" href="/security-policy/">
          <img
            src="/images/security-action-one-star.webp"
            alt="SECURITY ACTION 一つ星ロゴ"
            width="320"
            height="320"
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="colophon-imprint">
          <p class="colophon-note">
