</style>

<script>
  // Before / After の切り替え。元データの setBefore / setAfter に相当する。
  function initPhaseToggle() {
    const cards = document.getElementById('phase-cards');
    const buttons = document.querySelectorAll<HTMLButtonElement>('.phase-btn');
    if (!cards || buttons.length === 0) return;

    const copies = cards.querySelectorAll<HTMLElement>('.phase-copy');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const apply = (phase: string) => {
      cards.classList.toggle('is-before', phase === 'before');
      buttons.forEach((btn) => {
        const on = btn.dataset.phase === phase;
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', String(on));
      });

      const write = () => {
        copies.forEach((el) => {
          const next = phase === 'before' ? el.dataset.before : el.dataset.after;
          if (next) el.textContent = next;
        });
        cards.classList.remove('is-swapping');
      };

      // 差し替えの瞬間だけ薄くして、文章が入れ替わったことを分かるようにする
      if (reduceMotion) {
        write();
        return;
      }
      cards.classList.add('is-swapping');
      window.setTimeout(write, 180);
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => apply(btn.dataset.phase ?? 'after'));
    });
  }

  initPhaseToggle();
</script>
