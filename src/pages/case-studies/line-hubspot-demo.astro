---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaterialIcon from '../../components/MaterialIcon.astro';
import { createBreadcrumbSchema, createWebPageSchema, organizationSchema } from '../../data/structuredData';

export const prerender = true;

const title = 'LINE × HubSpot コンタクト自動登録デモ｜LINE連携構築｜和-Node';
const description = 'LINEで受け取った問い合わせをHubSpotにコンタクトとして自動登録し、ステージ管理・スコアリング・MA配信連動までをつなぐ連携構築のケーススタディです。';
const structuredData = [
  organizationSchema,
  createWebPageSchema({ name: title, description, path: '/case-studies/line-hubspot-demo/', type: 'CreativeWork' }),
  createBreadcrumbSchema([
    { name: 'ホーム', path: '/' },
    { name: '制作例・デモ', path: '/works/' },
    { name: 'LINE × HubSpot コンタクト管理', path: '/case-studies/line-hubspot-demo/' },
  ]),
];

const specs = [
  ['連携先', 'LINE公式アカウント × HubSpot'],
  ['対象業種', 'HubSpot導入済みのBtoB企業'],
  ['実現すること', 'コンタクト自動登録・ステージ更新・スコアリング・MA連動'],
  ['デモ仕様', 'ブラウザ内完結（外部API未使用）'],
];

const flow = [
  { step: '01', title: 'LINEから問い合わせ受信', desc: '顧客がLINE公式アカウントにメッセージを送信。内容・LINE IDを自動取得。' },
  { step: '02', title: 'HubSpotにコンタクト登録', desc: 'Webhookでリアルタイム転送。氏名・会社名・問い合わせ内容・ステージが自動入力される。' },
  { step: '03', title: 'スコアリング・ステージ更新', desc: '問い合わせ内容に応じて自動スコアリング。リード→MQL→SQLとステージが自動で進む。' },
  { step: '04', title: 'MA配信をLINEで連動', desc: 'HubSpotのワークフローと連動し、LINE上でのフォローアップ配信を自動化。' },
];

const designPoints = [
  { icon: 'contact_mail', title: 'LINEがコンタクト入口になる', text: '問い合わせフォームやメールと同じようにLINEからのコンタクトをHubSpotに自動登録。取りこぼしゼロ。' },
  { icon: 'leaderboard', title: 'スコアリングを自動化する', text: '問い合わせ内容・種別に応じてリードスコアを自動加算。MAの起動条件をLINEに拡張できる。' },
  { icon: 'account_tree', title: 'HubSpotのワークフローそのまま', text: '既存のシーケンス・ワークフロー設定を壊さず、LINE由来のコンタクトも同じフローに乗せる。' },
  { icon: 'campaign', title: 'LINE配信とMAを一元管理', text: 'HubSpotのMA配信トリガーをLINEメッセージと連動。開封・クリックデータもHubSpotで管理できる。' },
];
---

<BaseLayout noindex={true} title={title} description={description} structuredData={structuredData}>
  <main id="main" class="line-hs-case" data-glossary-skip>

    <section class="case-hero">
      <div class="hero-badge-row">
        <a href="/works/" class="back-link"><MaterialIcon name="arrow_back" /> 制作例・デモ一覧</a>
      </div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="kicker">CASE STUDY / LINE × HUBSPOT</p>
          <h1>LINEの問い合わせが、<br />HubSpotのコンタクトになる。</h1>
          <p class="hero-desc">担当者がLINEをチェックしてHubSpotに手入力する作業をなくし、問い合わせ受信からコンタクト登録・スコアリング・MA連動までを自動化します。</p>
          <div class="hero-chips">
            <span class="chip-line">LINE公式アカウント</span>
            <MaterialIcon name="sync_alt" />
            <span class="chip-hs">HubSpot</span>
          </div>
          <div class="hero-price">
            <span>参考価格</span>
            <strong>20万円〜</strong>
            <small>連携範囲・ワークフロー設計量で変動</small>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="visual-line">
            <div class="line-header"><span class="line-dot"></span><span>LINE公式アカウント</span></div>
            <div class="line-bubble">HubSpotのMA活用について相談したいです</div>
            <div class="line-bubble line-bubble--received">ありがとうございます。担当者よりHubSpotを通じてご連絡します</div>
          </div>
          <div class="visual-arrow"><MaterialIcon name="east" /><small>自動連携</small></div>
          <div class="visual-hs">
            <div class="hs-header"><span class="hs-dot"></span><span>HubSpot コンタクト管理</span></div>
            <div class="hs-row new-row">
              <span class="status-badge new">リード</span>
              <span>MA活用相談</span>
              <span class="score">30pt</span>
            </div>
            <div class="hs-row">
              <span class="status-badge mql">MQL</span>
              <span>ツール導入検討</span>
              <span class="score">75pt</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="case-disclaimer">
      <div class="container">
        <div class="disclaimer-inner">
          <MaterialIcon name="info" />
          <p><strong>自主制作・架空データのケーススタディです。</strong>実在企業の実績・成果数値を示すものではありません。LINE × HubSpot連携の実装範囲・設計意図をご確認いただくためのサンプルです。</p>
        </div>
      </div>
    </section>

    <section class="case-section">
      <div class="container case-two-col">
        <div>
          <span class="eyebrow">PROJECT SPECS</span>
          <h2>LINEをMAの<br/>入口にする。</h2>
          <p>HubSpotを使いこなしている企業ほど、LINEが独立したチャネルになりがちです。連携によってLINEからのコンタクトを既存のMAフローに統合します。</p>
        </div>
        <dl class="specs-list">
          {specs.map(([label, val]) => (
            <div><dt>{label}</dt><dd>{val}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="demo-section">
      <div class="container">
        <div class="demo-header">
          <span class="eyebrow">INTERACTIVE DEMO</span>
          <h2>連携の流れを体験する</h2>
          <p>実際の操作と同じ流れを再現したデモです。「体験する」ボタンを押してください。</p>
        </div>
        <div class="demo-stage">
          <div class="demo-panel demo-panel--line" id="demo-line">
            <div class="demo-panel-header demo-header-line">
              <span class="demo-dot"></span><span>LINE 公式アカウント</span>
              <span class="demo-live"><span class="live-dot"></span>デモ</span>
            </div>
            <div class="demo-messages" id="demo-messages">
              <div class="demo-msg demo-msg--sent">
                <div class="msg-bubble sent">HubSpotを活用したMA運用について相談したいのですが。</div>
                <span class="msg-time">10:05</span>
              </div>
            </div>
            <div class="demo-input-area">
              <div class="demo-input-options">
                <button class="demo-preset" data-msg="御社のHubSpotを使ったMA支援について詳しく聞きたいです" id="preset1">MA相談</button>
                <button class="demo-preset" data-msg="HubSpotの導入を検討しています。費用感を教えてください" id="preset2">導入相談</button>
                <button class="demo-preset" data-msg="LINEとHubSpotをつないでステップ配信したいです" id="preset3">配信連携</button>
              </div>
              <div class="demo-send-row">
                <div class="demo-input-field" id="demo-input-display">メッセージを選択してください</div>
                <button class="demo-send-btn" id="demo-send-btn" disabled><MaterialIcon name="send" /></button>
              </div>
            </div>
          </div>

          <div class="demo-connector">
            <div class="connector-line">
              <div class="connector-arrow" id="connector-arrow">
                <MaterialIcon name="east" /><small>自動連携</small>
              </div>
            </div>
          </div>

          <div class="demo-panel demo-panel--hs" id="demo-hs">
            <div class="demo-panel-header demo-header-hs">
              <span class="demo-dot"></span><span>HubSpot コンタクト管理</span>
              <span class="demo-live"><span class="live-dot hs-dot-color"></span>デモ</span>
            </div>
            <div class="hs-toolbar">
              <span class="hs-count">コンタクト一覧 全 <strong id="hs-count">2</strong> 件</span>
            </div>
            <div class="hs-table">
              <div class="hs-thead">
                <span>ステージ</span><span>名前（会社）</span><span>受信</span><span>スコア</span>
              </div>
              <div class="hs-tbody" id="hs-tbody">
                <div class="hs-tr">
                  <span><span class="hs-badge lead">リード</span></span>
                  <span>高橋 誠（株式会社DEF）</span>
                  <span>09:20</span>
                  <span class="score-cell">45pt</span>
                </div>
                <div class="hs-tr">
                  <span><span class="hs-badge mql">MQL</span></span>
                  <span>中村 幸子（△△商事）</span>
                  <span>09:55</span>
                  <span class="score-cell">82pt</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="demo-controls">
          <div class="demo-steps">
            <div class="demo-step" id="step-1"><span class="step-num">1</span><span>メッセージを選択</span></div>
            <MaterialIcon name="chevron_right" />
            <div class="demo-step" id="step-2"><span class="step-num">2</span><span>LINEから送信</span></div>
            <MaterialIcon name="chevron_right" />
            <div class="demo-step" id="step-3"><span class="step-num">3</span><span>HubSpotに自動登録</span></div>
            <MaterialIcon name="chevron_right" />
            <div class="demo-step" id="step-4"><span class="step-num">4</span><span>スコアリング完了</span></div>
          </div>
          <button class="demo-reset-btn" id="demo-reset-btn"><MaterialIcon name="refresh" /> リセット</button>
        </div>
        <p class="demo-note">※ このデモはブラウザ内のみで動作します。外部への送信・個人情報の取得は行いません。</p>
      </div>
    </section>

    <section class="case-section flow-section">
      <div class="container">
        <span class="eyebrow">INTEGRATION FLOW</span>
        <h2>4ステップで完結する<br/>コンタクト管理フロー。</h2>
        <div class="flow-grid">
          {flow.map((item) => (
            <div class="flow-card">
              <span class="flow-step">{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="case-section design-points-section">
      <div class="container">
        <span class="eyebrow">DESIGN DECISIONS</span>
        <h2>設計で意識した4つのこと。</h2>
        <div class="design-grid">
          {designPoints.map((item) => (
            <div class="design-card">
              <div class="design-icon"><MaterialIcon name={item.icon} /></div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="case-section scope-section">
      <div class="container">
        <div class="scope-inner">
          <div>
            <span class="eyebrow">SCOPE & PRICING</span>
            <h2>実装範囲と参考価格</h2>
            <p>HubSpot側のワークフロー設計、スコアリング条件の複雑さ、MA配信との連動範囲によって変動します。</p>
          </div>
          <div class="scope-cards">
            <div class="scope-card">
              <span>スタンダード</span>
              <strong>20万円〜</strong>
              <ul>
                <li>LINE → HubSpot コンタクト自動登録</li>
                <li>ステージ自動更新（リード→MQL）</li>
                <li>担当者割り当て通知（LINE）</li>
                <li>HubSpot項目マッピング設計</li>
              </ul>
            </div>
            <div class="scope-card scope-card--highlight">
              <span>カスタム連携</span>
              <strong>30万円〜</strong>
              <ul>
                <li>スタンダード全機能</li>
                <li>問い合わせ種別による自動スコアリング</li>
                <li>HubSpotワークフロー × LINE配信連動</li>
                <li>開封・クリック計測のHubSpot連携</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="case-section">
      <div class="container">
        <span class="eyebrow">RELATED SERVICES</span>
        <h2>他のシステムとも連携できます</h2>
        <div class="related-grid">
          <a href="/case-studies/line-salesforce-demo/" class="related-card">
            <span>Salesforce</span>
            <strong>LINE × Salesforce</strong>
            <p>リード自動登録から担当者割り当て・商談ステータス管理までをつなぐ。</p>
            <span class="related-price">40万円〜</span>
          </a>
          <a href="/case-studies/line-kintone-demo/" class="related-card">
            <span>kintone</span>
            <strong>LINE × kintone</strong>
            <p>問い合わせ受信からkintone自動登録・担当者割り当てまでをつなぐ。</p>
            <span class="related-price">25万円〜</span>
          </a>
          <a href="/case-studies/line-spreadsheet-demo/" class="related-card">
            <span>Googleスプレッドシート</span>
            <strong>LINE × スプレッドシート</strong>
            <p>既存の管理シートを活かしたシンプルな連携。スモールスタートに。</p>
            <span class="related-price">10万円〜</span>
          </a>
        </div>
      </div>
    </section>

    <section class="case-cta">
      <div class="container">
        <div class="cta-inner">
          <span class="eyebrow">READY TO START?</span>
          <h2>HubSpot連携の相談は<br/>無料で受け付けています。</h2>
          <p>現在のHubSpot活用状況、LINEの運用方法、必要なMA連動範囲をヒアリングした上で、実現方法と費用感をお伝えします。</p>
          <div class="cta-btns">
            <a href="/pricing/" class="btn-secondary">料金一覧を見る</a>
            <a href="/contact/?source=line-hubspot-demo" class="btn-primary">HubSpot連携を相談する</a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  :root {
    --line-green: #06C755; --line-dark: #00B449;
    --hs-orange: #FF7A59; --hs-dark: #e05c3a;
    --trust: #0f4c5c; --trust-mid: #1f6f78; --trust-line: rgba(15,76,92,0.18);
    --accent-red: #c7352f; --text-deep: #1a1a1a;
    --card-shadow: 0 16px 38px rgba(15,76,92,0.075), 0 4px 14px rgba(70,52,32,0.045);
  }
  .line-hs-case { background: linear-gradient(180deg,#fff 0%,#fffaf8 100%); padding-bottom: 100px; }
  .eyebrow { display: block; font-size: .78rem; font-weight: 900; color: var(--trust); letter-spacing: .3em; text-transform: uppercase; margin-bottom: 16px; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

  .case-hero { padding: 48px 0 60px; background: linear-gradient(135deg,#fffaf8 0%,#fff 55%,#fff3ef 100%); border-bottom: 1px solid var(--trust-line); }
  .hero-badge-row { max-width: 1200px; margin: 0 auto 24px; padding: 0 24px; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--trust); font-size: .88rem; font-weight: 800; text-decoration: none; opacity: .8; transition: .2s; }
  .back-link:hover { opacity: 1; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .kicker { font-size: .78rem; font-weight: 900; color: var(--hs-dark); letter-spacing: .28em; margin-bottom: 16px; }
  .hero-copy h1 { font-size: clamp(1.8rem,3.5vw,2.8rem); font-weight: 900; line-height: 1.3; color: var(--text-deep); margin-bottom: 20px; }
  .hero-desc { color: #555; line-height: 1.85; margin-bottom: 24px; }
  .hero-chips { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 28px; }
  .hero-chips span { padding: 8px 18px; border-radius: 999px; font-size: .88rem; font-weight: 900; border: 2px solid; background: #fff; }
  .chip-line { border-color: var(--line-green); color: var(--line-dark); }
  .chip-hs { border-color: var(--hs-dark); color: var(--hs-dark); }
  .hero-price { display: inline-flex; align-items: baseline; gap: 10px; padding: 14px 20px; border: 1px solid rgba(199,53,47,.18); border-radius: 18px; background: linear-gradient(135deg,rgba(199,53,47,.06),rgba(255,250,242,.94)); flex-wrap: wrap; }
  .hero-price span { color: var(--accent-red); font-size: .72rem; font-weight: 900; letter-spacing: .1em; }
  .hero-price strong { color: var(--text-deep); font-size: 1.5rem; font-weight: 900; }
  .hero-price small { color: #777; font-size: .8rem; font-weight: 700; }

  .hero-visual { display: flex; align-items: center; gap: 12px; }
  .visual-line, .visual-hs { flex: 1; border-radius: 16px; overflow: hidden; border: 1px solid rgba(0,0,0,.1); box-shadow: 0 8px 24px rgba(0,0,0,.07); }
  .visual-line { background: #fff; }
  .visual-hs { background: #fff; }
  .line-header { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--line-green); color: #fff; font-size: .75rem; font-weight: 900; }
  .hs-header { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--hs-dark); color: #fff; font-size: .75rem; font-weight: 900; }
  .line-dot, .hs-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.5); }
  .line-bubble { margin: 12px 14px; padding: 10px 14px; border-radius: 18px 18px 18px 4px; background: #f4f4f4; font-size: .82rem; line-height: 1.6; color: #333; max-width: 85%; }
  .line-bubble--received { background: var(--line-green); color: #fff; border-radius: 18px 18px 4px 18px; margin-left: auto; margin-right: 14px; }
  .hs-row { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid #f0f0f0; font-size: .78rem; }
  .hs-row.new-row { background: rgba(255,122,89,.05); }
  .status-badge { padding: 3px 8px; border-radius: 999px; font-size: .65rem; font-weight: 900; white-space: nowrap; }
  .status-badge.new { background: rgba(255,122,89,.15); color: var(--hs-orange); }
  .status-badge.mql { background: rgba(255,165,0,.15); color: #b86600; }
  .score { margin-left: auto; color: #777; font-size: .72rem; font-weight: 800; }
  .visual-arrow { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--trust); font-size: .72rem; font-weight: 900; padding: 0 4px; }

  .case-disclaimer { background: rgba(15,76,92,.04); border-bottom: 1px solid var(--trust-line); }
  .disclaimer-inner { display: flex; align-items: flex-start; gap: 12px; padding: 16px 0; color: var(--trust); font-size: .88rem; line-height: 1.8; }

  .case-section { padding: 72px 0; }
  .case-section + .case-section { border-top: 1px solid var(--trust-line); }
  .case-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .case-two-col h2 { font-size: clamp(1.55rem,2.8vw,2.1rem); font-weight: 900; line-height: 1.4; margin-bottom: 16px; color: var(--text-deep); }
  .case-two-col p { color: #555; line-height: 1.9; }
  .specs-list { display: grid; gap: 14px; }
  .specs-list > div { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 14px 16px; border: 1px solid var(--trust-line); border-radius: 14px; background: rgba(255,255,255,.82); }
  .specs-list dt { font-size: .78rem; font-weight: 900; color: var(--trust); }
  .specs-list dd { margin: 0; font-size: .9rem; font-weight: 700; color: var(--text-deep); }

  .demo-section { padding: 80px 0; background: linear-gradient(135deg,rgba(255,122,89,.04),rgba(6,199,85,.03)); border-top: 1px solid var(--trust-line); border-bottom: 1px solid var(--trust-line); }
  .demo-header { text-align: center; margin-bottom: 40px; }
  .demo-header h2 { font-size: clamp(1.55rem,3vw,2.2rem); font-weight: 900; color: var(--text-deep); margin-bottom: 12px; }
  .demo-header p { color: #666; line-height: 1.8; }
  .demo-stage { display: grid; grid-template-columns: 1fr 64px 1fr; align-items: stretch; margin-bottom: 32px; border: 1px solid var(--trust-line); border-radius: 24px; overflow: hidden; box-shadow: var(--card-shadow); background: #fff; }
  .demo-panel { display: flex; flex-direction: column; min-height: 420px; }
  .demo-panel-header { display: flex; align-items: center; gap: 8px; padding: 12px 16px; font-size: .8rem; font-weight: 900; }
  .demo-header-line { background: var(--line-green); color: #fff; }
  .demo-header-hs { background: var(--hs-dark); color: #fff; }
  .demo-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.5); }
  .demo-live { margin-left: auto; display: flex; align-items: center; gap: 5px; font-size: .7rem; opacity: .9; }
  .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #fff; animation: pulse 1.5s infinite; }
  .hs-dot-color { background: #ffb8a8; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }
  .demo-messages { flex: 1; padding: 16px; display: flex; flex-direction: column; gap: 10px; overflow-y: auto; background: #f5f5f5; }
  .demo-msg { display: flex; flex-direction: column; }
  .demo-msg--sent { align-items: flex-start; }
  .demo-msg--me { align-items: flex-end; }
  .msg-bubble { max-width: 85%; padding: 10px 14px; border-radius: 18px; font-size: .88rem; line-height: 1.65; }
  .msg-bubble.sent { background: #fff; border-radius: 4px 18px 18px 18px; color: #333; }
