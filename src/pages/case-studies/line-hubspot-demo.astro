<script is:inline>
(function () {
  let selectedMsg = '';
  let step = 0;
  const presets = document.querySelectorAll('.demo-preset');
  const inputDisplay = document.getElementById('demo-input-display');
  const sendBtn = document.getElementById('demo-send-btn');
  const messagesEl = document.getElementById('demo-messages');
  const hsBodyEl = document.getElementById('hs-tbody');
  const hsCountEl = document.getElementById('hs-count');
  const connectorArrow = document.getElementById('connector-arrow');
  const resetBtn = document.getElementById('demo-reset-btn');
  const steps = [document.getElementById('step-1'), document.getElementById('step-2'), document.getElementById('step-3'), document.getElementById('step-4')];

  function setStep(n) {
    steps.forEach((s, i) => { s.classList.remove('active','done'); if(i<n) s.classList.add('done'); if(i===n) s.classList.add('active'); });
    step = n;
  }
  setStep(0);

  presets.forEach(btn => {
    btn.addEventListener('click', () => {
      if (step > 1) return;
      presets.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      selectedMsg = btn.dataset.msg;
      inputDisplay.textContent = selectedMsg;
      inputDisplay.classList.add('has-text');
      sendBtn.classList.add('ready');
      sendBtn.disabled = false;
      setStep(1);
    });
  });

  sendBtn.addEventListener('click', () => {
    if (!selectedMsg || step > 1) return;
    sendBtn.disabled = true;
    sendBtn.classList.remove('ready');
    const now = new Date();
    const t = now.getHours() + ':' + String(now.getMinutes()).padStart(2,'0');
    const msgDiv = document.createElement('div');
    msgDiv.className = 'demo-msg demo-msg--me';
    msgDiv.innerHTML = `<div class="msg-bubble me-bubble">${selectedMsg}</div><span class="msg-time">${t}</span>`;
    messagesEl.appendChild(msgDiv);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    setStep(2);

    setTimeout(() => { connectorArrow.classList.add('active'); }, 600);

    setTimeout(() => {
      connectorArrow.classList.remove('active');
      const short = selectedMsg.length > 16 ? selectedMsg.slice(0,16)+'…' : selectedMsg;
      const tr = document.createElement('div');
      tr.className = 'hs-tr new-entry';
      tr.innerHTML = `<span><span class="hs-badge new-contact">新規</span></span><span>${short}</span><span>${t}</span><span class="score-cell">0pt</span>`;
      hsBodyEl.insertBefore(tr, hsBodyEl.firstChild);
      hsCountEl.textContent = hsBodyEl.querySelectorAll('.hs-tr').length;
      setStep(3);
    }, 1800);

    setTimeout(() => {
      const newTr = hsBodyEl.querySelector('.new-entry');
      if (newTr) {
        const badge = newTr.querySelector('.hs-badge');
        badge.classList.remove('new-contact'); badge.classList.add('lead'); badge.textContent = 'リード';
        const scoreCell = newTr.querySelector('.score-cell');
        if (scoreCell) scoreCell.textContent = '15pt';
      }
      const replyDiv = document.createElement('div');
      replyDiv.className = 'demo-msg demo-msg--sent';
      const t2 = new Date().getHours() + ':' + String(new Date().getMinutes()).padStart(2,'0');
      replyDiv.innerHTML = `<div class="msg-bubble received">ありがとうございます。担当者よりHubSpotを通じてご連絡いたします。</div><span class="msg-time">${t2}</span>`;
      messagesEl.appendChild(replyDiv);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      setStep(4);
    }, 3200);
  });

  resetBtn.addEventListener('click', () => {
    selectedMsg = ''; step = 0;
    presets.forEach(b => b.classList.remove('selected'));
    inputDisplay.textContent = 'メッセージを選択してください';
    inputDisplay.classList.remove('has-text');
    sendBtn.disabled = true; sendBtn.classList.remove('ready');
    connectorArrow.classList.remove('active');
    messagesEl.innerHTML = `<div class="demo-msg demo-msg--sent"><div class="msg-bubble sent">HubSpotを活用したMA運用について相談したいのですが。</div><span class="msg-time">10:05</span></div>`;
    hsBodyEl.innerHTML = `<div class="hs-tr"><span><span class="hs-badge lead">リード</span></span><span>高橋 誠（株式会社DEF）</span><span>09:20</span><span class="score-cell">45pt</span></div><div class="hs-tr"><span><span class="hs-badge mql">MQL</span></span><span>中村 幸子（△△商事）</span><span>09:55</span><span class="score-cell">82pt</span></div>`;
    hsCountEl.textContent = '2';
    setStep(0);
  });
})();
</script>
