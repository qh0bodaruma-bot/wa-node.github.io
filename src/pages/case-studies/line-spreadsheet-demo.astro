<script is:inline>
(function () {
  let selectedMsg = '';
  let step = 0;
  let rowCount = 2;
  const presets = document.querySelectorAll('.demo-preset');
  const inputDisplay = document.getElementById('demo-input-display');
  const sendBtn = document.getElementById('demo-send-btn');
  const messagesEl = document.getElementById('demo-messages');
  const ssBodyEl = document.getElementById('ss-tbody');
  const ssCountEl = document.getElementById('ss-count');
  const ssLastUpdated = document.getElementById('ss-last-updated');
  const connectorArrow = document.getElementById('connector-arrow');
  const resetBtn = document.getElementById('demo-reset-btn');
  const steps = [document.getElementById('step-1'), document.getElementById('step-2'), document.getElementById('step-3'), document.getElementById('step-4')];

  function setStep(n) {
    steps.forEach((s, i) => { s.classList.remove('active','done'); if(i<n) s.classList.add('done'); if(i===n) s.classList.add('active'); });
    step = n;
  }
  setStep(0);

  presets.forEach(btn => {
    btn.addEventListener('click', () => {
      if (step > 1) return;
      presets.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      selectedMsg = btn.dataset.msg;
      inputDisplay.textContent = selectedMsg;
      inputDisplay.classList.add('has-text');
      sendBtn.classList.add('ready');
      sendBtn.disabled = false;
      setStep(1);
    });
  });

  sendBtn.addEventListener('click', () => {
    if (!selectedMsg || step > 1) return;
    sendBtn.disabled = true;
    sendBtn.classList.remove('ready');
    const now = new Date();
    const t = now.getHours() + ':' + String(now.getMinutes()).padStart(2,'0');
    const msgDiv = document.createElement('div');
    msgDiv.className = 'demo-msg demo-msg--me';
    msgDiv.innerHTML = `<div class="msg-bubble me-bubble">${selectedMsg}</div><span class="msg-time">${t}</span>`;
    messagesEl.appendChild(msgDiv);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    setStep(2);

    setTimeout(() => { connectorArrow.classList.add('active'); }, 600);

    setTimeout(() => {
      connectorArrow.classList.remove('active');
      rowCount++;
      const short = selectedMsg.length > 18 ? selectedMsg.slice(0,18)+'…' : selectedMsg;
      const tr = document.createElement('div');
      tr.className = 'ss-tr new-entry';
      tr.innerHTML = `<span class="row-num">${rowCount}</span><span>${short}</span><span>${t}</span><span><span class="ss-badge new-record">未対応</span></span>`;
      ssBodyEl.appendChild(tr);
      ssCountEl.textContent = rowCount;
      ssLastUpdated.textContent = t;
      setStep(3);
    }, 1800);

    setTimeout(() => {
      const replyDiv = document.createElement('div');
      replyDiv.className = 'demo-msg demo-msg--sent';
      const t2 = new Date().getHours() + ':' + String(new Date().getMinutes()).padStart(2,'0');
      replyDiv.innerHTML = `<div class="msg-bubble received">ありがとうございます。シートに記録しました。担当者より改めてご連絡いたします。</div><span class="msg-time">${t2}</span>`;
      messagesEl.appendChild(replyDiv);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      setStep(4);
    }, 3200);
  });

  resetBtn.addEventListener('click', () => {
    selectedMsg = ''; step = 0; rowCount = 2;
    presets.forEach(b => b.classList.remove('selected'));
    inputDisplay.textContent = 'メッセージを選択してください';
    inputDisplay.classList.remove('has-text');
    sendBtn.disabled = true; sendBtn.classList.remove('ready');
    connectorArrow.classList.remove('active');
    messagesEl.innerHTML = `<div class="demo-msg demo-msg--sent"><div class="msg-bubble sent">資料請求をしたいのですが、どうすればいいですか？</div><span class="msg-time">10:05</span></div>`;
    ssBodyEl.innerHTML = `<div class="ss-tr"><span class="row-num">1</span><span>見積もり相談（製品A）</span><span>09:22</span><span><span class="ss-badge done">対応済</span></span></div><div class="ss-tr"><span class="row-num">2</span><span>サービス資料の請求</span><span>09:55</span><span><span class="ss-badge inprogress">対応中</span></span></div>`;
    ssCountEl.textContent = '2';
    ssLastUpdated.textContent = '09:55';
    setStep(0);
  });
})();
</script>
