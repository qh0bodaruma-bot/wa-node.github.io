---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaterialIcon from '../../components/MaterialIcon.astro';
import { createBreadcrumbSchema, createWebPageSchema, organizationSchema } from '../../data/structuredData';

export const prerender = true;

const title = 'LINE × Googleスプレッドシート 問い合わせ自動記録デモ｜LINE連携構築｜和-Node';
const description = 'LINEで受け取った問い合わせをGoogleスプレッドシートに自動記録し、既存の管理シートをそのまま活かしたシンプルなLINE連携構築のケーススタディです。';
const structuredData = [
  organizationSchema,
  createWebPageSchema({ name: title, description, path: '/case-studies/line-spreadsheet-demo/', type: 'CreativeWork' }),
  createBreadcrumbSchema([
    { name: 'ホーム', path: '/' },
    { name: '制作例・デモ', path: '/works/' },
    { name: 'LINE × スプレッドシート 問い合わせ記録', path: '/case-studies/line-spreadsheet-demo/' },
  ]),
];

const specs = [
  ['連携先', 'LINE公式アカウント × Googleスプレッドシート'],
  ['対象業種', 'スプレッドシートで管理業務を行っているBtoB企業'],
  ['実現すること', '問い合わせ自動記録・担当者通知・スプレッドシート即時更新'],
  ['デモ仕様', 'ブラウザ内完結（外部API未使用）'],
];

const flow = [
  { step: '01', title: 'LINEから問い合わせ受信', desc: '顧客がLINE公式アカウントにメッセージを送信。内容・受信時刻・LINE IDを自動取得。' },
  { step: '02', title: 'スプレッドシートに自動記録', desc: 'Google Apps ScriptまたはWebhookで即時転記。管理シートに新しい行が追加される。' },
  { step: '03', title: '担当者にLINEで通知', desc: '新着問い合わせを担当者のLINEにリアルタイム通知。スプレッドシートURLを添付できる。' },
  { step: '04', title: '対応状況をシートで管理', desc: 'ステータス列・担当者列を更新するだけで進捗管理。既存のシート運用をそのまま継続。' },
];

const designPoints = [
  { icon: 'table_chart', title: '今あるシートをそのまま使う', text: '新しいシステムを覚えなくてよい。今使っているスプレッドシートに列を追加するだけで運用開始できる。' },
  { icon: 'bolt', title: 'スモールスタートに最適', text: '10万円〜で始められる最小構成。CRMを導入する前の段階や、小規模チームの管理ツールとして最適。' },
  { icon: 'notifications', title: '見逃しをゼロにする', text: 'LINEに来た問い合わせを担当者のLINEにも即通知。「気づかなかった」を構造的になくす。' },
  { icon: 'upgrade', title: '後からCRM連携に移行できる', text: '蓄積データをそのまま活用してkintone・HubSpot・Salesforceへのステップアップが可能。' },
];
---

<BaseLayout noindex={true} title={title} description={description} structuredData={structuredData}>
  <main id="main" class="line-ss-case" data-glossary-skip>

    <section class="case-hero">
      <div class="hero-badge-row">
        <a href="/works/" class="back-link"><MaterialIcon name="arrow_back" /> 制作例・デモ一覧</a>
      </div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="kicker">CASE STUDY / LINE × GOOGLE SHEETS</p>
          <h1>LINEの問い合わせが、<br />スプレッドシートに自動記録される。</h1>
          <p class="hero-desc">担当者がLINEをチェックして手入力する作業をなくし、問い合わせ受信からスプレッドシート記録・担当者通知までを自動化します。既存シートをそのまま活用できるシンプルな連携です。</p>
          <div class="hero-chips">
            <span class="chip-line">LINE公式アカウント</span>
            <MaterialIcon name="sync_alt" />
            <span class="chip-ss">Googleスプレッドシート</span>
          </div>
          <div class="hero-price">
            <span>参考価格</span>
            <strong>10万円〜</strong>
            <small>記録項目数・通知設定の複雑さで変動</small>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="visual-line">
            <div class="line-header"><span class="line-dot"></span><span>LINE公式アカウント</span></div>
            <div class="line-bubble">資料請求をしたいのですが</div>
            <div class="line-bubble line-bubble--received">ありがとうございます。シートに記録しました。担当者より連絡いたします</div>
          </div>
          <div class="visual-arrow"><MaterialIcon name="east" /><small>自動記録</small></div>
          <div class="visual-ss">
            <div class="ss-header"><span class="ss-icon">&#9783;</span><span>問い合わせ管理シート</span></div>
            <div class="ss-row new-row">
              <span class="ss-status new">未対応</span>
              <span class="ss-content">資料請求</span>
              <span class="ss-time">10:05</span>
            </div>
            <div class="ss-row">
              <span class="ss-status done">対応済</span>
              <span class="ss-content">見積もり相談</span>
              <span class="ss-time">09:22</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="case-disclaimer">
      <div class="container">
        <div class="disclaimer-inner">
          <MaterialIcon name="info" />
          <p><strong>自主制作・架空データのケーススタディです。</strong>実在企業の実績・成果数値を示すものではありません。LINE × Googleスプレッドシート連携の実装範囲・設計意図をご確認いただくためのサンプルです。</p>
        </div>
      </div>
    </section>

    <section class="case-section">
      <div class="container case-two-col">
        <div>
          <span class="eyebrow">PROJECT SPECS</span>
          <h2>今のシートを活かして、<br/>自動化する。</h2>
          <p>新しいシステムを覚える必要はありません。今使っているスプレッドシートに「LINE受信列」を追加するだけで運用を開始できます。</p>
        </div>
        <dl class="specs-list">
          {specs.map(([label, val]) => (
            <div><dt>{label}</dt><dd>{val}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="demo-section">
      <div class="container">
        <div class="demo-header">
          <span class="eyebrow">INTERACTIVE DEMO</span>
          <h2>連携の流れを体験する</h2>
          <p>実際の操作と同じ流れを再現したデモです。「体験する」ボタンを押してください。</p>
        </div>
        <div class="demo-stage">
          <div class="demo-panel demo-panel--line" id="demo-line">
            <div class="demo-panel-header demo-header-line">
              <span class="demo-dot"></span><span>LINE 公式アカウント</span>
              <span class="demo-live"><span class="live-dot"></span>デモ</span>
            </div>
            <div class="demo-messages" id="demo-messages">
              <div class="demo-msg demo-msg--sent">
                <div class="msg-bubble sent">資料請求をしたいのですが、どうすればいいですか？</div>
                <span class="msg-time">10:05</span>
              </div>
            </div>
            <div class="demo-input-area">
              <div class="demo-input-options">
                <button class="demo-preset" data-msg="製品カタログの資料請求をお願いします" id="preset1">資料請求</button>
                <button class="demo-preset" data-msg="見積もりをお願いしたいです。概算でも構いません" id="preset2">見積もり依頼</button>
                <button class="demo-preset" data-msg="サービス内容について詳しく聞きたいです" id="preset3">サービス相談</button>
              </div>
              <div class="demo-send-row">
                <div class="demo-input-field" id="demo-input-display">メッセージを選択してください</div>
                <button class="demo-send-btn" id="demo-send-btn" disabled><MaterialIcon name="send" /></button>
              </div>
            </div>
          </div>

          <div class="demo-connector">
            <div class="connector-line">
              <div class="connector-arrow" id="connector-arrow">
                <MaterialIcon name="east" /><small>自動記録</small>
              </div>
            </div>
          </div>

          <div class="demo-panel demo-panel--ss" id="demo-ss">
            <div class="demo-panel-header demo-header-ss">
              <span class="ss-header-icon">&#9783;</span><span>問い合わせ管理シート</span>
              <span class="demo-live"><span class="live-dot ss-dot-color"></span>デモ</span>
            </div>
            <div class="ss-toolbar">
              <span class="ss-count">記録件数 全 <strong id="ss-count">2</strong> 件</span>
              <span class="ss-updated">最終更新: <span id="ss-last-updated">09:55</span></span>
            </div>
            <div class="ss-table">
              <div class="ss-thead">
                <span>No.</span><span>問い合わせ内容</span><span>受信時刻</span><span>ステータス</span>
              </div>
              <div class="ss-tbody" id="ss-tbody">
                <div class="ss-tr">
                  <span class="row-num">1</span>
                  <span>見積もり相談（製品A）</span>
                  <span>09:22</span>
                  <span><span class="ss-badge done">対応済</span></span>
                </div>
                <div class="ss-tr">
                  <span class="row-num">2</span>
                  <span>サービス資料の請求</span>
                  <span>09:55</span>
                  <span><span class="ss-badge inprogress">対応中</span></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="demo-controls">
          <div class="demo-steps">
            <div class="demo-step" id="step-1"><span class="step-num">1</span><span>メッセージを選択</span></div>
            <MaterialIcon name="chevron_right" />
            <div class="demo-step" id="step-2"><span class="step-num">2</span><span>LINEから送信</span></div>
            <MaterialIcon name="chevron_right" />
            <div class="demo-step" id="step-3"><span class="step-num">3</span><span>シートに自動記録</span></div>
            <MaterialIcon name="chevron_right" />
            <div class="demo-step" id="step-4"><span class="step-num">4</span><span>担当者に通知</span></div>
          </div>
          <button class="demo-reset-btn" id="demo-reset-btn"><MaterialIcon name="refresh" /> リセット</button>
        </div>
        <p class="demo-note">※ このデモはブラウザ内のみで動作します。外部への送信・個人情報の取得は行いません。</p>
      </div>
    </section>

    <section class="case-section flow-section">
      <div class="container">
        <span class="eyebrow">INTEGRATION FLOW</span>
        <h2>4ステップで完結する<br/>問い合わせ管理フロー。</h2>
        <div class="flow-grid">
          {flow.map((item) => (
            <div class="flow-card">
              <span class="flow-step">{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="case-section design-points-section">
      <div class="container">
        <span class="eyebrow">DESIGN DECISIONS</span>
        <h2>設計で意識した4つのこと。</h2>
        <div class="design-grid">
          {designPoints.map((item) => (
            <div class="design-card">
              <div class="design-icon"><MaterialIcon name={item.icon} /></div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="case-section scope-section">
      <div class="container">
        <div class="scope-inner">
          <div>
            <span class="eyebrow">SCOPE & PRICING</span>
            <h2>実装範囲と参考価格</h2>
            <p>記録する項目数、通知先の数、スプレッドシートのフォーマット複雑さによって変動します。</p>
          </div>
          <div class="scope-cards">
            <div class="scope-card">
              <span>スタンダード</span>
              <strong>10万円〜</strong>
              <ul>
                <li>LINE → スプレッドシート 自動記録</li>
                <li>問い合わせ内容・受信時刻の転記</li>
                <li>管理者への新着通知（LINE）</li>
                <li>既存シートへの列追加対応</li>
              </ul>
            </div>
            <div class="scope-card scope-card--highlight">
              <span>カスタム連携</span>
              <strong>15万円〜</strong>
              <ul>
                <li>スタンダード全機能</li>
                <li>担当者ローテーション自動割り当て</li>
                <li>ステータス更新→LINE返信自動化</li>
                <li>Google Formsとの統合記録</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="case-section">
      <div class="container">
        <span class="eyebrow">RELATED SERVICES</span>
        <h2>システムが育ったら次のステップへ</h2>
        <div class="related-grid">
          <a href="/case-studies/line-kintone-demo/" class="related-card">
            <span>kintone</span>
            <strong>LINE × kintone</strong>
            <p>スプレッドシートから卒業してkintoneで本格的な問い合わせ管理へ。</p>
            <span class="related-price">25万円〜</span>
          </a>
          <a href="/case-studies/line-hubspot-demo/" class="related-card">
            <span>HubSpot</span>
            <strong>LINE × HubSpot</strong>
            <p>マーケティングオートメーションと組み合わせてリードを育成する。</p>
            <span class="related-price">20万円〜</span>
          </a>
          <a href="/case-studies/line-salesforce-demo/" class="related-card">
            <span>Salesforce</span>
            <strong>LINE × Salesforce</strong>
            <p>本格的な営業CRMでリード管理・商談転換まで一元化する。</p>
            <span class="related-price">40万円〜</span>
          </a>
        </div>
      </div>
    </section>

    <section class="case-cta">
      <div class="container">
        <div class="cta-inner">
          <span class="eyebrow">READY TO START?</span>
          <h2>まずはスプレッドシート連携から<br/>始めませんか。</h2>
          <p>今使っているスプレッドシートの構成をヒアリングした上で、最小コストで始められる連携設計をご提案します。</p>
          <div class="cta-btns">
            <a href="/pricing/" class="btn-secondary">料金一覧を見る</a>
            <a href="/contact/?source=line-spreadsheet-demo" class="btn-primary">スプレッドシート連携を相談する</a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  :root {
    --line-green: #06C755; --line-dark: #00B449;
    --ss-green: #34A853; --ss-dark: #1e7e34;
    --trust: #0f4c5c; --trust-mid: #1f6f78; --trust-line: rgba(15,76,92,0.18);
    --accent-red: #c7352f; --text-deep: #1a1a1a;
    --card-shadow: 0 16px 38px rgba(15,76,92,0.075), 0 4px 14px rgba(70,52,32,0.045);
  }
  .line-ss-case { background: linear-gradient(180deg,#fff 0%,#f8fdf9 100%); padding-bottom: 100px; }
  .eyebrow { display: block; font-size: .78rem; font-weight: 900; color: var(--trust); letter-spacing: .3em; text-transform: uppercase; margin-bottom: 16px; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

  .case-hero { padding: 48px 0 60px; background: linear-gradient(135deg,#f8fdf9 0%,#fff 55%,#edfaf1 100%); border-bottom: 1px solid var(--trust-line); }
  .hero-badge-row { max-width: 1200px; margin: 0 auto 24px; padding: 0 24px; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--trust); font-size: .88rem; font-weight: 800; text-decoration: none; opacity: .8; transition: .2s; }
  .back-link:hover { opacity: 1; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .kicker { font-size: .78rem; font-weight: 900; color: var(--ss-dark); letter-spacing: .28em; margin-bottom: 16px; }
  .hero-copy h1 { font-size: clamp(1.8rem,3.5vw,2.8rem); font-weight: 900; line-height: 1.3; color: var(--text-deep); margin-bottom: 20px; }
  .hero-desc { color: #555; line-height: 1.85; margin-bottom: 24px; }
  .hero-chips { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 28px; }
  .hero-chips span { padding: 8px 18px; border-radius: 999px; font-size: .88rem; font-weight: 900; border: 2px solid; background: #fff; }
  .chip-line { border-color: var(--line-green); color: var(--line-dark); }
  .chip-ss { border-color: var(--ss-dark); color: var(--ss-dark); }
  .hero-price { display: inline-flex; align-items: baseline; gap: 10px; padding: 14px 20px; border: 1px solid rgba(199,53,47,.18); border-radius: 18px; background: linear-gradient(135deg,rgba(199,53,47,.06),rgba(255,250,242,.94)); flex-wrap: wrap; }
  .hero-price span { color: var(--accent-red); font-size: .72rem; font-weight: 900; letter-spacing: .1em; }
  .hero-price strong { color: var(--text-deep); font-size: 1.5rem; font-weight: 900; }
  .hero-price small { color: #777; font-size: .8rem; font-weight: 700; }

  .hero-visual { display: flex; align-items: center; gap: 12px; }
  .visual-line, .visual-ss { flex: 1; border-radius: 16px; overflow: hidden; border: 1px solid rgba(0,0,0,.1); box-shadow: 0 8px 24px rgba(0,0,0,.07); }
  .visual-line { background: #fff; }
  .visual-ss { background: #fff; }
  .line-header { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--line-green); color: #fff; font-size: .75rem; font-weight: 900; }
  .ss-header { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: var(--ss-dark); color: #fff; font-size: .75rem; font-weight: 900; }
  .ss-icon { font-size: 1rem; }
  .line-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.5); }
  .line-bubble { margin: 12px 14px; padding: 10px 14px; border-radius: 18px 18px 18px 4px; background: #f4f4f4; font-size: .82rem; line-height: 1.6; color: #333; max-width: 85%; }
  .line-bubble--received { background: var(--line-green); color: #fff; border-radius: 18px 18px 4px 18px; margin-left: auto; margin-right: 14px; }
  .ss-row { display: flex; align-items: center; gap: 6px; padding: 8px 12px; border-bottom: 1px solid #e8f5e9; font-size: .78rem; }
  .ss-row.new-row { background: rgba(52,168,83,.06); }
  .ss-status { padding: 2px 7px; border-radius: 4px; font-size: .64rem; font-weight: 900; white-space: nowrap; }
  .ss-status.new { background: rgba(255,165,0,.18); color: #c57800; }
  .ss-status.done { background: rgba(52,168,83,.15); color: var(--ss-dark); }
  .ss-content { flex: 1; }
  .ss-time { color: #999; font-size: .72rem; font-weight: 700; margin-left: auto; white-space: nowrap; }
  .visual-arrow { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--trust); font-size: .72rem; font-weight: 900; padding: 0 4px; }

  .case-disclaimer { background: rgba(15,76,92,.04); border-bottom: 1px solid var(--trust-line); }
  .disclaimer-inner { display: flex; align-items: flex-start; gap: 12px; padding: 16px 0; color: var(--trust); font-size: .88rem; line-height: 1.8; }

  .case-section { padding: 72px 0; }
  .case-section + .case-section { border-top: 1px solid var(--trust-line); }
  .case-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .case-two-col h2 { font-size: clamp(1.55rem,2.8vw,2.1rem); font-weight: 900; line-height: 1.4; margin-bottom: 16px; color: var(--text-deep); }
  .case-two-col p { color: #555; line-height: 1.9; }
  .specs-list { display: grid; gap: 14px; }
  .specs-list > div { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 14px 16px; border: 1px solid var(--trust-line); border-radius: 14px; background: rgba(255,255,255,.82); }
  .specs-list dt { font-size: .78rem; font-weight: 900; color: var(--trust); }
  .specs-list dd { margin: 0; font-size: .9rem; font-weight: 700; color: var(--text-deep); }

  .demo-section { padding: 80px 0; background: linear-gradient(135deg,rgba(52,168,83,.04),rgba(6,199,85,.03)); border-top: 1px solid var(--trust-line); border-bottom: 1px solid var(--trust-line); }
  .demo-header { text-align: center; margin-bottom: 40px; }
  .demo-header h2 { font-size: clamp(1.55rem,3vw,2.2rem); font-weight: 900; color: var(--text-deep); margin-bottom: 12px; }
  .demo-header p { color: #666; line-height: 1.8; }
  .demo-stage { display: grid; grid-template-columns: 1fr 64px 1fr; align-items: stretch; margin-bottom: 32px; border: 1px solid var(--trust-line); border-radius: 24px; overflow: hidden; box-shadow: var(--card-shadow); background: #fff; }
  .demo-panel { display: flex; flex-direction: column; min-height: 420px; }
  .demo-panel-header { display: flex; align-items: center; gap: 8px; padding: 12px 16px; font-size: .8rem; font-weight: 900; }
  .demo-header-line { background: var(--line-green); color: #fff; }
  .demo-header-ss { background: var(--ss-dark); color: #fff; }
  .ss-header-icon { font-size: 1rem; }
  .demo-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.5); }
  .demo-live { margin-left: auto; display: flex; align-items: center; gap: 5px; font-size: .7rem; opacity: .9; }
  .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #fff; animation: pulse 1.5s infinite; }
  .ss-dot-color { background: #a8e6b8; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }
  .demo-messages { flex: 1; padding: 16px; display: flex; flex-direction: column; gap: 10px; overflow-y: auto; background: #f5f5f5; }
  .demo-msg { display: flex; flex-direction: column; }
