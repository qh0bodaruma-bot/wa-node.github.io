---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaterialIcon from '../../components/MaterialIcon.astro';
import LineCaseDemo from '../../components/LineCaseDemo.astro';
import { getLineCase } from '../../data/lineCaseCatalog';
import { createBreadcrumbSchema, createWebPageSchema, organizationSchema } from '../../data/structuredData';

export const prerender = true;

const kase = getLineCase('sheets');

const title = 'LINE × Googleスプレッドシート 問い合わせ自動記録デモ｜LINE連携構築｜和-Node';
const description = 'LINEで受け取った問い合わせをGoogleスプレッドシートに自動記録し、既存の管理シートをそのまま活かしたシンプルなLINE連携構築のケーススタディです。';
const structuredData = [
  organizationSchema,
  createWebPageSchema({ name: title, description, path: '/case-studies/line-spreadsheet-demo/', type: 'CreativeWork' }),
  createBreadcrumbSchema([
    { name: 'ホーム', path: '/' },
    { name: '制作例・デモ', path: '/works/' },
    { name: 'LINE × Googleスプレッドシート 問い合わせ記録', path: '/case-studies/line-spreadsheet-demo/' },
  ]),
];

const specs = [
  ['連携先', 'LINE公式アカウント × Googleスプレッドシート'],
  ['対象業種', 'スプレッドシートで管理業務を行っているBtoB企業'],
  ['実現すること', '問い合わせ自動記録・担当者確認・スプレッドシート即時更新'],
  ['デモ仕様', 'ブラウザ内完結（外部API未使用）'],
];

const flow = [
  { step: '01', title: 'LINEから問い合わせ受信', desc: '顧客がLINE公式アカウントにメッセージを送信。内容・受信時刻・LINE IDを自動取得。' },
  { step: '02', title: 'スプレッドシートに自動記録', desc: 'Google Apps ScriptまたはWebhookで即時転記。管理シートに新しい行が追加される。' },
  { step: '03', title: '担当者が内容を確認', desc: '自動記録された行を担当者が確認。重複確認や担当調整を行う。' },
  { step: '04', title: '対応状況をシートで管理', desc: 'ステータス列・担当者列を更新するだけで進捗管理。既存のシート運用をそのまま継続。' },
];

const designPoints = [
  { icon: 'table_chart', title: '今あるシートをそのまま使う', text: '新しいシステムを覚えなくてよい。今使っているスプレッドシートに列を追加するだけで運用開始できる。' },
  { icon: 'bolt', title: 'スモールスタートに最適', text: '10万円〜で始められる最小構成。CRMを導入する前の段階や、小規模チームの管理ツールとして最適。' },
  { icon: 'notifications', title: '未処理を一覧で確認できる', text: 'LINEに来た問い合わせを担当者のLINEにも通知し、未処理の行を見つけやすくする。' },
  { icon: 'upgrade', title: '後からCRM連携に移行できる', text: '蓄積データをそのまま活用してkintone・HubSpot・Salesforceへのステップアップが可能。' },
];
---

<BaseLayout noindex={true} title={title} description={description} structuredData={structuredData}>
  <main id="main" class="line-case" data-glossary-skip>

    <LineCaseDemo config={kase} />

    <!-- Specs -->
    <section class="case-section">
      <div class="container case-two-col">
        <div>
          <span class="eyebrow">PROJECT SPECS</span>
          <h2>今のシートを活かして、<br/>転記の手間を減らす。</h2>
          <p>LINEは顧客にとって使いやすい反面、担当者側の管理に手間がかかります。既存のスプレッドシートと連携することで、受信から確認までの担当者の手間を減らします。</p>
        </div>
        <dl class="specs-list">
          {specs.map(([label, val]) => (
            <div>
              <dt>{label}</dt>
              <dd>{val}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Flow -->
    <section class="case-section flow-section">
      <div class="container">
        <span class="eyebrow">INTEGRATION FLOW</span>
        <h2>4ステップで完結する<br/>問い合わせ対応フロー。</h2>
        <div class="flow-grid">
          {flow.map((item) => (
            <div class="flow-card">
              <span class="flow-step">{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Design Points -->
    <section class="case-section design-points-section">
      <div class="container">
        <span class="eyebrow">DESIGN DECISIONS</span>
        <h2>設計で意識した4つのこと。</h2>
        <div class="design-grid">
          {designPoints.map((item) => (
            <div class="design-card">
              <div class="design-icon">
                <MaterialIcon name={item.icon} />
              </div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Implementation Scope -->
    <section class="case-section scope-section">
      <div class="container">
        <div class="scope-inner">
          <div>
            <span class="eyebrow">SCOPE & PRICING</span>
            <h2>実装範囲と参考価格</h2>
            <p>連携先のAPIへのアクセス方法、通知のカスタマイズ範囲、シートの構成によって変動します。</p>
          </div>
          <div class="scope-cards">
            <div class="scope-card">
              <span>スタンダード</span>
              <strong>10万円〜</strong>
              <ul>
                <li>LINE → スプレッドシート 自動記録</li>
                <li>問い合わせ内容・受信時刻の転記</li>
                <li>担当者確認の状態表示</li>
                <li>既存シートへの列追加対応</li>
              </ul>
            </div>
            <div class="scope-card scope-card--highlight">
              <span>カスタム連携</span>
              <strong>15万円〜</strong>
              <ul>
                <li>スタンダード全機能</li>
                <li>担当者ローテーション自動割り当て</li>
                <li>ステータス更新→LINE返信自動化</li>
                <li>Google Formsとの統合記録</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related -->
    <section class="case-section">
      <div class="container">
        <span class="eyebrow">RELATED SERVICES</span>
        <h2>システムが育ったら次のステップへ</h2>
        <div class="related-grid">
          <a href="/case-studies/line-kintone-demo/" class="related-card">
            <span>kintone</span>
            <strong>LINE × kintone</strong>
            <p>スプレッドシートから卒業してkintoneで本格的な問い合わせ管理へ。</p>
            <span class="related-price">25万円〜</span>
          </a>
          <a href="/case-studies/line-hubspot-demo/" class="related-card">
            <span>HubSpot</span>
            <strong>LINE × HubSpot</strong>
            <p>マーケティングオートメーションと組み合わせてリードを育成する。</p>
            <span class="related-price">20万円〜</span>
          </a>
          <a href="/case-studies/line-salesforce-demo/" class="related-card">
            <span>Salesforce</span>
            <strong>LINE × Salesforce</strong>
            <p>本格的な営業CRMでリード管理・商談転換まで一元化する。</p>
            <span class="related-price">40万円〜</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="case-cta">
      <div class="container">
        <div class="cta-inner">
          <span class="eyebrow">READY TO START?</span>
          <h2>LINE連携の相談は<br/>無料で受け付けています。</h2>
          <p>現在のLINE運用の課題、スプレッドシートの利用状況、必要な連携範囲をヒアリングした上で、実現方法と費用感をお伝えします。</p>
          <div class="cta-btns">
            <a href="/pricing/" class="btn-secondary">料金一覧を見る</a>
            <a href={`/contact/?source=${kase.contactSource}&category=${kase.contactCategory}`} class="btn-primary">LINE連携を相談する</a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  :root {
    --line-green: #06C755;
    --line-dark: #00B449;
    --trust: #0f4c5c;
    --trust-mid: #1f6f78;
    --trust-line: rgba(15, 76, 92, 0.18);
    --accent-red: #c7352f;
    --text-deep: #1a1a1a;
    --card-shadow: 0 16px 38px rgba(15, 76, 92, 0.075), 0 4px 14px rgba(70, 52, 32, 0.045);
  }

  .line-case { background: linear-gradient(180deg, #fff 0%, #f8fbf9 100%); padding-bottom: 100px; }
  .eyebrow { display: block; font-size: 0.78rem; font-weight: 900; color: var(--trust); letter-spacing: 0.3em; text-transform: uppercase; margin-bottom: 16px; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

  .case-section { padding: 72px 0; }
  .case-section + .case-section { border-top: 1px solid var(--trust-line); }
  .case-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .case-two-col h2 { font-size: clamp(1.55rem, 2.8vw, 2.1rem); font-weight: 900; line-height: 1.4; margin-bottom: 16px; color: var(--text-deep); }
  .case-two-col p { color: #555; line-height: 1.9; }
  .specs-list { display: grid; gap: 14px; }
  .specs-list > div { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 14px 16px; border: 1px solid var(--trust-line); border-radius: 14px; background: rgba(255, 255, 255, 0.82); }
  .specs-list dt { font-size: 0.78rem; font-weight: 900; color: var(--trust); }
  .specs-list dd { margin: 0; font-size: 0.9rem; font-weight: 700; color: var(--text-deep); }

  .flow-section { background: rgba(6, 199, 85, 0.03); }
  .flow-section h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 900; color: var(--text-deep); margin-bottom: 36px; }
  .flow-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; position: relative; }
  .flow-card { padding: 28px 24px; border: 1px solid var(--trust-line); border-radius: 20px; background: #fff; box-shadow: 0 8px 24px rgba(15, 76, 92, 0.05); position: relative; }
  .flow-step { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; border-radius: 50%; background: var(--trust); color: #fff; font-size: 0.82rem; font-weight: 900; margin-bottom: 16px; }
  .flow-card h3 { font-size: 1rem; font-weight: 900; color: var(--text-deep); margin-bottom: 10px; }
  .flow-card p { font-size: 0.85rem; color: #666; line-height: 1.8; margin: 0; }

  .design-points-section h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 900; color: var(--text-deep); margin-bottom: 36px; }
  .design-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .design-card { display: flex; flex-direction: column; gap: 12px; padding: 28px 24px; border: 1px solid var(--trust-line); border-radius: 20px; background: #fff; box-shadow: 0 8px 24px rgba(15, 76, 92, 0.05); }
  .design-icon { width: 46px; height: 46px; border-radius: 14px; background: rgba(15, 76, 92, 0.08); display: flex; align-items: center; justify-content: center; color: var(--trust); }
  .design-card h3 { font-size: 1.05rem; font-weight: 900; color: var(--text-deep); margin: 0; }
  .design-card p { font-size: 0.88rem; color: #666; line-height: 1.85; margin: 0; }

  .scope-section { background: linear-gradient(135deg, rgba(15, 76, 92, 0.04), rgba(255, 255, 255, 0.98)); }
  .scope-inner { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; align-items: start; }
  .scope-inner h2 { font-size: clamp(1.55rem, 2.8vw, 2.1rem); font-weight: 900; color: var(--text-deep); margin-bottom: 16px; }
  .scope-inner > div > p { color: #555; line-height: 1.9; }
  .scope-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .scope-card { padding: 24px; border: 1px solid var(--trust-line); border-radius: 20px; background: #fff; }
  .scope-card--highlight { border: 2px solid var(--trust); background: linear-gradient(135deg, rgba(15, 76, 92, 0.06), #fff); }
  .scope-card > span { display: inline-block; padding: 4px 10px; border-radius: 999px; background: rgba(15, 76, 92, 0.08); color: var(--trust); font-size: 0.7rem; font-weight: 900; letter-spacing: 0.08em; margin-bottom: 12px; }
  .scope-card strong { display: block; font-size: 1.6rem; font-weight: 900; color: var(--accent-red); margin-bottom: 16px; line-height: 1.2; }
  .scope-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .scope-card li { position: relative; padding-left: 18px; font-size: 0.85rem; font-weight: 700; color: #444; line-height: 1.6; }
  .scope-card li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 8px; height: 8px; border-radius: 50%; background: var(--trust); }

  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }
  .case-section h2 { font-size: clamp(1.55rem, 2.8vw, 2.1rem); font-weight: 900; color: var(--text-deep); margin-bottom: 12px; }
  .case-section > .container > p { color: #555; line-height: 1.9; margin-bottom: 32px; }
  .related-card { display: flex; flex-direction: column; gap: 10px; padding: 24px; border: 1px solid var(--trust-line); border-radius: 18px; background: #fff; text-decoration: none; transition: 0.3s; box-shadow: 0 4px 16px rgba(15, 76, 92, 0.04); }
  .related-card:hover { transform: translateY(-4px); border-color: var(--trust-mid); box-shadow: var(--card-shadow); }
  .related-card > span:first-child { font-size: 0.72rem; font-weight: 900; color: var(--trust); padding: 4px 10px; background: rgba(15, 76, 92, 0.08); border-radius: 999px; align-self: flex-start; letter-spacing: 0.04em; }
  .related-card strong { font-size: 1.05rem; font-weight: 900; color: var(--text-deep); }
  .related-card p { font-size: 0.88rem; color: #666; line-height: 1.75; margin: 0; flex: 1; }
  .related-price { font-size: 0.88rem !important; font-weight: 900 !important; color: var(--accent-red) !important; padding: 0 !important; background: none !important; border-radius: 0 !important; }

  .case-cta { padding: 80px 0; background: linear-gradient(135deg, #1a2e35, #0f4c5c); }
  .cta-inner { text-align: center; max-width: 720px; margin: 0 auto; }
  .cta-inner .eyebrow { color: rgba(255, 255, 255, 0.6); }
  .cta-inner h2 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 900; color: #fff; line-height: 1.35; margin-bottom: 20px; }
  .cta-inner p { color: rgba(255, 255, 255, 0.75); line-height: 1.9; font-size: 1rem; margin-bottom: 36px; }
  .cta-btns { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; }
  .btn-primary, .btn-secondary { display: inline-flex; align-items: center; justify-content: center; padding: 16px 36px; border-radius: 999px; font-weight: 900; font-size: 0.95rem; text-decoration: none; transition: 0.3s; }
  .btn-primary { background: var(--line-green); color: #fff; box-shadow: 0 8px 28px rgba(6, 199, 85, 0.3); }
  .btn-primary:hover { background: var(--line-dark); transform: translateY(-2px); }
  .btn-secondary { background: transparent; color: #fff; border: 2px solid rgba(255, 255, 255, 0.4); }
  .btn-secondary:hover { border-color: rgba(255, 255, 255, 0.8); transform: translateY(-2px); }

  @media (max-width: 768px) {
    .case-two-col { grid-template-columns: 1fr; }
    .flow-grid { grid-template-columns: 1fr 1fr; }
    .design-grid { grid-template-columns: 1fr; }
    .scope-inner { grid-template-columns: 1fr; }
    .scope-cards { grid-template-columns: 1fr; }
    .related-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .flow-grid { grid-template-columns: 1fr; }
  }
</style>
