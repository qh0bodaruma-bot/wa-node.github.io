---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MaterialIcon from '../../components/MaterialIcon.astro';
import { createBreadcrumbSchema, createWebPageSchema, organizationSchema } from '../../data/structuredData';

export const prerender = true;

const title = 'LINE × kintone 問い合わせ自動登録デモ｜LINE連携構築｜和-Node';
const description = 'LINEで受け取った問い合わせを自動でkintoneに登録し、担当者割り当てまでをLINE上で完結させる連携構築のケーススタディです。インタラクティブデモで一連の流れを体験できます。';
const structuredData = [
  organizationSchema,
  createWebPageSchema({ name: title, description, path: '/case-studies/line-kintone-demo/', type: 'CreativeWork' }),
  createBreadcrumbSchema([
    { name: 'ホーム', path: '/' },
    { name: '制作例・デモ', path: '/works/' },
    { name: 'LINE × kintone 問い合わせ管理', path: '/case-studies/line-kintone-demo/' },
  ]),
];

const specs = [
  ['連携先', 'LINE公式アカウント × kintone'],
  ['対象業種', 'BtoB向けサービス業・IT・コンサル等'],
  ['実現すること', '問い合わせ自動登録・担当者割り当て・対応ステータス管理'],
  ['デモ仕様', 'ブラウザ内完結（外部API未使用）'],
];

const flow = [
  { step: '01', title: 'LINEから問い合わせ', desc: '顧客がLINE公式アカウントに問い合わせを送信。内容・時刻・LINE IDを取得。' },
  { step: '02', title: 'kintoneに自動登録', desc: 'Webhookでkintoneへリアルタイム転送。フォーム入力なしで担当者がすぐ確認できる状態に。' },
  { step: '03', title: 'LINE上で担当者割り当て', desc: '担当者をリプライ、またはkintoneで設定。LINE通知で担当者に即座に連絡。' },
  { step: '04', title: '対応ステータスをkintoneで管理', desc: '対応中→完了の更新をkintone上で完結。履歴・担当者・対応内容が一元管理される。' },
];

const designPoints = [
  { icon: 'sync_alt', title: '転記ゼロで対応漏れを防ぐ', text: 'LINE上の問い合わせをコピー・貼り付けせずkintoneに自動登録。入力ミスや転記漏れが起きない。' },
  { icon: 'person_pin', title: '担当者割り当てをLINEで完結', text: '電話・メールを介さず、LINE上で担当者を設定してkintoneに反映。外出中でも対応できる。' },
  { icon: 'history', title: '対応履歴が自動で蓄積される', text: 'kintoneに全ての問い合わせ・対応内容・担当者が記録され、振り返りや引き継ぎに使える。' },
  { icon: 'notifications_active', title: '対応完了をLINEで顧客に通知', text: '対応完了時に自動でLINEメッセージを送信。顧客への連絡を忘れることがなくなる。' },
];
---

<BaseLayout noindex={true} title={title} description={description} structuredData={structuredData}>
  <main id="main" class="line-kintone-case" data-glossary-skip>

    <!-- Hero -->
    <section class="case-hero">
      <div class="hero-badge-row">
        <a href="/works/" class="back-link"><MaterialIcon name="arrow_back" /> 制作例・デモ一覧</a>
      </div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="kicker">CASE STUDY / LINE INTEGRATION</p>
          <h1>LINEの問い合わせが、<br />kintoneに自動で届く。</h1>
          <p class="hero-desc">担当者がLINEを手作業でチェックして転記する作業をなくし、問い合わせ受信から対応完了まで一本のフローでつなぎます。</p>
          <div class="hero-chips">
            <span>LINE公式アカウント</span>
            <MaterialIcon name="sync_alt" />
            <span>kintone</span>
          </div>
          <div class="hero-price">
            <span>参考価格</span>
            <strong>25万円〜</strong>
            <small>連携先・通知設計・管理画面カスタマイズで変動</small>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="visual-line">
            <div class="line-header">
              <span class="line-dot"></span>
              <span>LINE公式アカウント</span>
            </div>
            <div class="line-bubble">ご担当者様、製品Aの<br/>見積もりをお願いしたいのですが</div>
            <div class="line-bubble line-bubble--received">受け付けました。担当者より<br/>折り返しご連絡いたします</div>
          </div>
          <div class="visual-arrow">
            <MaterialIcon name="east" />
            <small>自動連携</small>
          </div>
          <div class="visual-kintone">
            <div class="kintone-header">
              <span class="kintone-dot"></span>
              <span>kintone 問い合わせ管理</span>
            </div>
            <div class="kintone-row new-row">
              <span class="status-badge new">新着</span>
              <span>製品Aの見積もり依頼</span>
              <span class="assigned">担当：田中</span>
            </div>
            <div class="kintone-row">
              <span class="status-badge done">完了</span>
              <span>導入時期の確認</span>
              <span class="assigned">担当：山田</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Disclaimer -->
    <section class="case-disclaimer">
      <div class="container">
        <div class="disclaimer-inner">
          <MaterialIcon name="info" />
          <p><strong>自主制作・架空データのケーススタディです。</strong>実在企業の実績・成果数値を示すものではありません。LINE × kintone連携の実装範囲・設計意図をご確認いただくためのサンプルです。</p>
        </div>
      </div>
    </section>

    <!-- Specs -->
    <section class="case-section">
      <div class="container case-two-col">
        <div>
          <span class="eyebrow">PROJECT SPECS</span>
          <h2>転記・手動管理をなくして、<br/>対応速度を上げる。</h2>
          <p>LINEは顧客にとって使いやすい反面、担当者側の管理に手間がかかります。kintoneと連携することで、受信から完了まで担当者の手間を最小化します。</p>
        </div>
        <dl class="specs-list">
          {specs.map(([label, val]) => (
            <div>
              <dt>{label}</dt>
              <dd>{val}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Interactive Demo -->
    <section class="demo-section">
      <div class="container">
        <div class="demo-header">
          <span class="eyebrow">INTERACTIVE DEMO</span>
          <h2>連携の流れを体験する</h2>
          <p>実際の操作と同じ流れを再現したデモです。「体験する」ボタンを押してください。</p>
        </div>
        <div class="demo-stage">
          <!-- LINE側 -->
          <div class="demo-panel demo-panel--line" id="demo-line">
            <div class="demo-panel-header demo-header-line">
              <span class="demo-dot"></span>
              <span>LINE 公式アカウント</span>
              <span class="demo-live"><span class="live-dot"></span>デモ</span>
            </div>
            <div class="demo-messages" id="demo-messages">
              <div class="demo-msg demo-msg--sent">
                <div class="msg-bubble sent">こんにちは。<br/>製品Aの導入について相談したいのですが。</div>
                <span class="msg-time">10:23</span>
              </div>
            </div>
            <div class="demo-input-area">
              <div class="demo-input-options">
                <button class="demo-preset" data-msg="見積もりをお願いできますか？" id="preset1">見積もり依頼</button>
                <button class="demo-preset" data-msg="サポートについて確認したいことがあります。" id="preset2">サポート確認</button>
                <button class="demo-preset" data-msg="契約内容の変更を相談したいです。" id="preset3">契約変更相談</button>
              </div>
              <div class="demo-send-row">
                <div class="demo-input-field" id="demo-input-display">メッセージを選択してください</div>
                <button class="demo-send-btn" id="demo-send-btn" disabled>
                  <MaterialIcon name="send" />
                </button>
              </div>
            </div>
          </div>

          <!-- 矢印 -->
          <div class="demo-connector">
            <div class="connector-line" id="connector-line">
              <div class="connector-arrow" id="connector-arrow">
                <MaterialIcon name="east" />
                <small>自動連携</small>
              </div>
            </div>
          </div>

          <!-- kintone側 -->
          <div class="demo-panel demo-panel--kintone" id="demo-kintone">
            <div class="demo-panel-header demo-header-kintone">
              <span class="demo-dot"></span>
              <span>kintone 問い合わせ管理</span>
              <span class="demo-live"><span class="live-dot kintone-dot-color"></span>デモ</span>
            </div>
            <div class="kintone-toolbar">
              <span class="kintone-count">全 <strong id="kintone-count">2</strong> 件</span>
              <span class="kintone-filter">状態：すべて</span>
            </div>
            <div class="kintone-table">
              <div class="kintone-thead">
                <span>状態</span>
                <span>内容</span>
                <span>受信時刻</span>
                <span>担当</span>
              </div>
              <div class="kintone-tbody" id="kintone-tbody">
                <div class="kintone-tr">
                  <span><span class="k-badge done">完了</span></span>
                  <span>製品カタログ請求</span>
                  <span>09:15</span>
                  <span>山田</span>
                </div>
                <div class="kintone-tr">
                  <span><span class="k-badge inprogress">対応中</span></span>
                  <span>価格改定の確認</span>
                  <span>09:52</span>
                  <span>田中</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- コントロール -->
        <div class="demo-controls">
          <div class="demo-steps">
            <div class="demo-step" id="step-1">
              <span class="step-num">1</span>
              <span>メッセージを選択</span>
            </div>
            <MaterialIcon name="chevron_right" />
            <div class="demo-step" id="step-2">
              <span class="step-num">2</span>
              <span>LINEから送信</span>
            </div>
            <MaterialIcon name="chevron_right" />
            <div class="demo-step" id="step-3">
              <span class="step-num">3</span>
              <span>kintoneに自動登録</span>
            </div>
            <MaterialIcon name="chevron_right" />
            <div class="demo-step" id="step-4">
              <span class="step-num">4</span>
              <span>担当者を設定</span>
            </div>
          </div>
          <button class="demo-reset-btn" id="demo-reset-btn">
            <MaterialIcon name="refresh" /> リセット
          </button>
        </div>
        <p class="demo-note">※ このデモはブラウザ内のみで動作します。外部への送信・個人情報の取得は行いません。</p>
      </div>
    </section>

    <!-- Flow -->
    <section class="case-section flow-section">
      <div class="container">
        <span class="eyebrow">INTEGRATION FLOW</span>
        <h2>4ステップで完結する<br/>問い合わせ対応フロー。</h2>
        <div class="flow-grid">
          {flow.map((item) => (
            <div class="flow-card">
              <span class="flow-step">{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Design Points -->
    <section class="case-section design-points-section">
      <div class="container">
        <span class="eyebrow">DESIGN DECISIONS</span>
        <h2>設計で意識した4つのこと。</h2>
        <div class="design-grid">
          {designPoints.map((item) => (
            <div class="design-card">
              <div class="design-icon">
                <MaterialIcon name={item.icon} />
              </div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Implementation Scope -->
    <section class="case-section scope-section">
      <div class="container">
        <div class="scope-inner">
          <div>
            <span class="eyebrow">SCOPE & PRICING</span>
            <h2>実装範囲と参考価格</h2>
            <p>連携先のAPIへのアクセス方法、通知のカスタマイズ範囲、kintone側のフィールド設計・権限管理によって変動します。</p>
          </div>
          <div class="scope-cards">
            <div class="scope-card">
              <span>スタンダード</span>
              <strong>25万円〜</strong>
              <ul>
                <li>LINE → kintone 自動登録</li>
                <li>担当者割り当て通知</li>
                <li>対応完了の自動返信</li>
                <li>kintoneフィールド設計</li>
              </ul>
            </div>
            <div class="scope-card scope-card--highlight">
              <span>カスタム連携</span>
              <strong>35万円〜</strong>
              <ul>
                <li>スタンダード全機能</li>
                <li>問い合わせ種別の自動振り分け</li>
                <li>Slack / メール同時通知</li>
                <li>kintone権限管理・運用設計</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related -->
    <section class="case-section">
      <div class="container">
        <span class="eyebrow">RELATED SERVICES</span>
        <h2>他のシステムとも連携できます</h2>
        <div class="related-grid">
          <a href="/pricing/" class="related-card">
            <span>Salesforce</span>
            <strong>LINE × Salesforce</strong>
            <p>商談・リード管理をLINEから操作。大規模な顧客管理基盤との連携。</p>
            <span class="related-price">40万円〜</span>
          </a>
          <a href="/pricing/" class="related-card">
            <span>HubSpot</span>
            <strong>LINE × HubSpot</strong>
            <p>マーケティングオートメーションとLINEのステップ配信を連動。</p>
            <span class="related-price">20万円〜</span>
          </a>
          <a href="/pricing/" class="related-card">
            <span>Googleスプレッドシート</span>
            <strong>LINE × スプレッドシート</strong>
            <p>既存の管理シートを活かしたシンプルな連携。スモールスタートに。</p>
            <span class="related-price">10万円〜</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="case-cta">
      <div class="container">
        <div class="cta-inner">
          <span class="eyebrow">READY TO START?</span>
          <h2>LINE連携の相談は<br/>無料で受け付けています。</h2>
          <p>現在のLINE運用の課題、kintoneの利用状況、必要な連携範囲をヒアリングした上で、実現方法と費用感をお伝えします。</p>
          <div class="cta-btns">
            <a href="/pricing/" class="btn-secondary">料金一覧を見る</a>
            <a href="/contact/?source=line-kintone-demo" class="btn-primary">LINE連携を相談する</a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  :root {
    --line-green: #06C755;
    --line-dark: #00B449;
    --kintone-blue: #0f4c81;
    --kintone-light: #e8f0f8;
    --trust: #0f4c5c;
    --trust-mid: #1f6f78;
    --trust-line: rgba(15, 76, 92, 0.18);
    --accent: #8c6b1f;
    --accent-red: #c7352f;
    --surface: #fffdf8;
    --text-deep: #1a1a1a;
    --card-shadow: 0 16px 38px rgba(15, 76, 92, 0.075), 0 4px 14px rgba(70, 52, 32, 0.045);
  }

  .line-kintone-case {
    background: linear-gradient(180deg, #fff 0%, #f8fbf9 100%);
    padding-bottom: 100px;
  }

  .eyebrow {
    display: block;
    font-size: 0.78rem;
    font-weight: 900;
    color: var(--trust);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  /* Hero */
  .case-hero {
    padding: 48px 0 60px;
    background: linear-gradient(135deg, #f8fbf9 0%, #fff 60%, #f0f7ff 100%);
    border-bottom: 1px solid var(--trust-line);
  }
  .hero-badge-row {
    max-width: 1200px;
    margin: 0 auto 24px;
    padding: 0 24px;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--trust);
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
    opacity: 0.8;
    transition: 0.2s;
  }
  .back-link:hover { opacity: 1; }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .kicker {
    font-size: 0.78rem;
    font-weight: 900;
    color: var(--trust);
    letter-spacing: 0.28em;
    margin-bottom: 16px;
  }
  .hero-copy h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 900;
    line-height: 1.3;
    color: var(--text-deep);
    margin-bottom: 20px;
  }
  .hero-desc {
    color: #555;
    line-height: 1.85;
    font-size: 1rem;
    margin-bottom: 24px;
  }
  .hero-chips {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .hero-chips span {
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 900;
    border: 2px solid var(--trust-line);
    background: #fff;
    color: var(--text-deep);
  }
  .hero-chips span:first-child { border-color: var(--line-green); color: var(--line-dark); }
  .hero-chips span:last-child { border-color: var(--kintone-blue); color: var(--kintone-blue); }
  .hero-price {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 14px 20px;
    border: 1px solid rgba(199, 53, 47, 0.18);
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(199, 53, 47, 0.06), rgba(255, 250, 242, 0.94));
    flex-wrap: wrap;
  }
  .hero-price span { color: var(--accent-red); font-size: 0.72rem; font-weight: 900; letter-spacing: 0.1em; }
  .hero-price strong { color: var(--text-deep); font-size: 1.5rem; font-weight: 900; }
  .hero-price small { color: #777; font-size: 0.8rem; font-weight: 700; }

  /* Hero Visual */
  .hero-visual {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .visual-line, .visual-kintone {
    flex: 1;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.07);
  }
  .visual-line { background: #fff; }
  .visual-kintone { background: #fff; }
  .line-header, .kintone-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    font-size: 0.75rem;
    font-weight: 900;
  }
  .line-header { background: var(--line-green); color: #fff; }
  .kintone-header { background: var(--kintone-blue); color: #fff; }
  .line-dot, .kintone-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.5); }
  .line-bubble {
    margin: 12px 14px;
    padding: 10px 14px;
    border-radius: 18px 18px 18px 4px;
    background: #f4f4f4;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #333;
    max-width: 85%;
  }
  .line-bubble--received {
    background: var(--line-green);
    color: #fff;
    border-radius: 18px 18px 4px 18px;
    margin-left: auto;
    margin-right: 14px;
  }
  .kintone-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid #f0f0f0;
    font-size: 0.78rem;
  }
  .kintone-row.new-row { background: rgba(6, 199, 85, 0.05); }
  .status-badge {
    padding: 3px 8px;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 900;
    white-space: nowrap;
  }
  .status-badge.new { background: rgba(6, 199, 85, 0.15); color: var(--line-dark); }
  .status-badge.done { background: rgba(15, 76, 92, 0.1); color: var(--trust); }
  .assigned { margin-left: auto; color: #777; font-size: 0.72rem; font-weight: 800; }
  .visual-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--trust);
    font-size: 0.72rem;
    font-weight: 900;
    padding: 0 4px;
  }

  /* Disclaimer */
  .case-disclaimer { background: rgba(15, 76, 92, 0.04); border-bottom: 1px solid var(--trust-line); }
  .disclaimer-inner {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 0;
    color: var(--trust);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  /* Section base */
  .case-section { padding: 72px 0; }
  .case-section + .case-section { border-top: 1px solid var(--trust-line); }
  .case-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .case-two-col h2 {
    font-size: clamp(1.55rem, 2.8vw, 2.1rem);
    font-weight: 900;
