<script is:inline>
(function () {
  let selectedMsg = '';
  let step = 0;

  const presets = document.querySelectorAll('.demo-preset');
  const inputDisplay = document.getElementById('demo-input-display');
  const sendBtn = document.getElementById('demo-send-btn');
  const messagesEl = document.getElementById('demo-messages');
  const kintoneBodyEl = document.getElementById('kintone-tbody');
  const kintoneCountEl = document.getElementById('kintone-count');
  const connectorArrow = document.getElementById('connector-arrow');
  const resetBtn = document.getElementById('demo-reset-btn');

  const steps = [
    document.getElementById('step-1'),
    document.getElementById('step-2'),
    document.getElementById('step-3'),
    document.getElementById('step-4'),
  ];

  function setStep(n) {
    steps.forEach((s, i) => {
      s.classList.remove('active', 'done');
      if (i < n) s.classList.add('done');
      if (i === n) s.classList.add('active');
    });
    step = n;
  }

  setStep(0);

  presets.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (step > 1) return;
      presets.forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      selectedMsg = btn.dataset.msg;
      inputDisplay.textContent = selectedMsg;
      inputDisplay.classList.add('has-text');
      sendBtn.classList.add('ready');
      sendBtn.disabled = false;
      setStep(1);
    });
  });

  sendBtn.addEventListener('click', () => {
    if (!selectedMsg || step > 1) return;
    sendBtn.disabled = true;
    sendBtn.classList.remove('ready');

    // LINEにメッセージ追加
    const msgDiv = document.createElement('div');
    msgDiv.className = 'demo-msg demo-msg--me';
    const now = new Date();
    const timeStr = now.getHours() + ':' + String(now.getMinutes()).padStart(2, '0');
    msgDiv.innerHTML = `<div class="msg-bubble me-bubble">${selectedMsg}</div><span class="msg-time">${timeStr}</span>`;
    messagesEl.appendChild(msgDiv);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    setStep(2);

    // コネクターアニメーション
    setTimeout(() => {
      connectorArrow.classList.add('active');
    }, 600);

    // kintoneにレコード追加
    setTimeout(() => {
      connectorArrow.classList.remove('active');
      const shortMsg = selectedMsg.length > 16 ? selectedMsg.slice(0, 16) + '…' : selectedMsg;
      const tr = document.createElement('div');
      tr.className = 'kintone-tr new-entry';
      tr.innerHTML = `<span><span class="k-badge new">新着</span></span><span>${shortMsg}</span><span>${timeStr}</span><span>—</span>`;
      kintoneBodyEl.insertBefore(tr, kintoneBodyEl.firstChild);
      const count = kintoneBodyEl.querySelectorAll('.kintone-tr').length;
      kintoneCountEl.textContent = count;
      setStep(3);
    }, 1800);

    // 担当者自動割り当て
    setTimeout(() => {
      const newTr = kintoneBodyEl.querySelector('.new-entry');
      if (newTr) {
        newTr.querySelector('.k-badge').classList.remove('new');
        newTr.querySelector('.k-badge').classList.add('assigned');
        newTr.querySelector('.k-badge').textContent = '対応中';
        const cells = newTr.querySelectorAll('span');
        if (cells[3]) cells[3].textContent = '自動割当';
      }
      // 自動返信をLINEに追加
      const replyDiv = document.createElement('div');
      replyDiv.className = 'demo-msg demo-msg--sent';
      const replyTime = new Date().getHours() + ':' + String(new Date().getMinutes()).padStart(2, '0');
      replyDiv.innerHTML = `<div class="msg-bubble received">受け付けました。担当者より折り返しご連絡いたします。</div><span class="msg-time">${replyTime}</span>`;
      messagesEl.appendChild(replyDiv);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      setStep(4);
    }, 3200);
  });

  resetBtn.addEventListener('click', () => {
    selectedMsg = '';
    step = 0;
    presets.forEach(b => b.classList.remove('selected'));
    inputDisplay.textContent = 'メッセージを選択してください';
    inputDisplay.classList.remove('has-text');
    sendBtn.disabled = true;
    sendBtn.classList.remove('ready');
    connectorArrow.classList.remove('active');

    // メッセージを初期状態に
    messagesEl.innerHTML = `
      <div class="demo-msg demo-msg--sent">
