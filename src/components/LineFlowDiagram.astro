---
// LineFlowDiagram.astro
// LINEと各システムの共通連携フロー図
---

<div class="lfd" aria-label="LINEと各システムの連携フロー図">

  <!-- Step 1: LINE -->
  <div class="lfd-node lfd-node--line">
    <div class="lfd-node-icon" aria-hidden="true">
      <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="40" height="40" rx="10" fill="#06C755"/>
        <path d="M33 18.6C33 13.3 27.6 9 21 9S9 13.3 9 18.6c0 4.7 4.2 8.7 9.9 9.4.4.1.9.3 1 .6.1.3.1.7 0 1l-.2 1c-.1.3-.3 1.3 1.1.7 1.4-.6 7.5-4.4 10.2-7.6C32.3 22 33 20.4 33 18.6z" fill="white"/>
      </svg>
    </div>
    <div class="lfd-node-body">
      <strong>LINE公式アカウント</strong>
      <span>友だち追加・フォーム送信</span>
    </div>
  </div>

  <!-- Arrow 1 -->
  <div class="lfd-connector" aria-hidden="true">
    <div class="lfd-connector-line"></div>
    <svg class="lfd-arrow-icon" viewBox="0 0 16 16" fill="none">
      <path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <!-- Step 2: LIFF -->
  <div class="lfd-node lfd-node--liff">
    <div class="lfd-node-icon" aria-hidden="true">
      <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="40" height="40" rx="10" fill="#0f4c5c"/>
        <rect x="11" y="8" width="18" height="24" rx="3" stroke="white" stroke-width="1.5"/>
        <rect x="14" y="12" width="12" height="7" rx="1.5" fill="white" opacity="0.8"/>
        <line x1="14" y1="22" x2="22" y2="22" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="14" y1="25" x2="19" y2="25" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
        <circle cx="20" cy="29" r="1" fill="white" opacity="0.6"/>
      </svg>
    </div>
    <div class="lfd-node-body">
      <strong>LIFFフォーム</strong>
      <span>LINEアプリ内で動く申込・問い合わせページ</span>
    </div>
  </div>

  <!-- Arrow 2 + API label -->
  <div class="lfd-connector lfd-connector--labeled" aria-hidden="true">
    <div class="lfd-connector-line"></div>
    <div class="lfd-connector-badge">
      <svg viewBox="0 0 16 16" fill="none" width="12" height="12">
        <path d="M2 8h12M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Webhook / REST API
      <span class="lfd-badge-sub">和-Nodeが設計・構築</span>
    </div>
    <div class="lfd-connector-line"></div>
    <svg class="lfd-arrow-icon" viewBox="0 0 16 16" fill="none">
      <path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <!-- Step 3: Systems -->
  <div class="lfd-systems" role="list" aria-label="対応システム一覧">
    <div class="lfd-system" role="listitem" style="--sys-color: #00A1E0;">
      <span class="lfd-system-dot" aria-hidden="true"></span>
      Salesforce
    </div>
    <div class="lfd-system" role="listitem" style="--sys-color: #E4002B;">
      <span class="lfd-system-dot" aria-hidden="true"></span>
      kintone
    </div>
    <div class="lfd-system" role="listitem" style="--sys-color: #FF7A59;">
      <span class="lfd-system-dot" aria-hidden="true"></span>
      HubSpot
    </div>
    <div class="lfd-system" role="listitem" style="--sys-color: #0F9D58;">
      <span class="lfd-system-dot" aria-hidden="true"></span>
      Google<br/>スプレッドシート
    </div>
  </div>

  <!-- Arrow 3 -->
  <div class="lfd-connector" aria-hidden="true">
    <div class="lfd-connector-line"></div>
    <svg class="lfd-arrow-icon" viewBox="0 0 16 16" fill="none">
      <path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <!-- Step 4: Result -->
  <div class="lfd-result">
    <div class="lfd-result-inner">
      <ul class="lfd-result-list" aria-label="連携後の効果">
        <li>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8.5l3.5 3.5 6.5-7" stroke="#06C755" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          手入力ゼロ
        </li>
        <li>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8.5l3.5 3.5 6.5-7" stroke="#06C755" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          二重入力なし
        </li>
        <li>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8.5l3.5 3.5 6.5-7" stroke="#06C755" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          対応漏れゼロ
        </li>
      </ul>
    </div>
  </div>

</div>

<style>
  .lfd {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    max-width: 420px;
    margin: 0 auto 48px;
    font-family: 'Shippori Mincho', serif;
  }

  /* ── Nodes ─────────────────────────── */
  .lfd-node {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    background: var(--white, #fff);
    border: 1.5px solid var(--card-border, rgba(15,76,92,0.14));
    border-radius: 14px;
    padding: 16px 20px;
    box-shadow: 0 4px 16px rgba(15,76,92,0.07);
  }

  .lfd-node-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
  }

  .lfd-node-icon svg {
    width: 40px;
    height: 40px;
  }

  .lfd-node-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lfd-node-body strong {
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-deep, #1a1a1a);
    line-height: 1.3;
  }

  .lfd-node-body span {
    font-size: 0.78rem;
    color: var(--muted, #666);
    line-height: 1.4;
  }

  /* ── Connectors ─────────────────────── */
  .lfd-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    color: var(--trust, #0f4c5c);
    opacity: 0.5;
  }

  .lfd-connector-line {
    width: 1.5px;
    height: 20px;
    background: var(--trust, #0f4c5c);
    opacity: 0.4;
  }

  .lfd-arrow-icon {
    width: 16px;
    height: 16px;
    color: var(--trust, #0f4c5c);
  }

  .lfd-connector--labeled {
    opacity: 1;
    gap: 4px;
  }

  .lfd-connector-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--soft, #f3f7f5);
    border: 1px solid var(--trust-line, rgba(15,76,92,0.18));
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--trust, #0f4c5c);
    white-space: nowrap;
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    line-height: 1.4;
  }

  .lfd-badge-sub {
    display: block;
    width: 100%;
    text-align: center;
    font-size: 0.65rem;
    font-weight: 400;
    color: var(--muted, #666);
    margin-top: 1px;
  }

  /* ── Systems grid ────────────────────── */
  .lfd-systems {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
  }

  .lfd-system {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--white, #fff);
    border: 1.5px solid var(--card-border, rgba(15,76,92,0.14));
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-deep, #1a1a1a);
    line-height: 1.3;
    box-shadow: 0 2px 8px rgba(15,76,92,0.05);
  }

  .lfd-system-dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sys-color, #999);
  }

  /* ── Result ─────────────────────────── */
  .lfd-result {
    width: 100%;
  }

  .lfd-result-inner {
    background: linear-gradient(135deg, var(--soft, #f3f7f5) 0%, #eef7f0 100%);
    border: 1.5px solid rgba(6, 199, 85, 0.25);
    border-radius: 14px;
    padding: 16px 20px;
  }

  .lfd-result-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
  }

  .lfd-result-list li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-deep, #1a1a1a);
  }

  .lfd-result-list li svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* ── Mobile ─────────────────────────── */
  @media (max-width: 480px) {
    .lfd {
      max-width: 100%;
    }

    .lfd-node {
      padding: 14px 16px;
    }

    .lfd-connector-badge {
      font-size: 0.68rem;
      padding: 5px 12px;
    }

    .lfd-system {
      font-size: 0.78rem;
      padding: 8px 10px;
    }
  }
</style>
