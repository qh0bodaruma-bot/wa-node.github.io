---
import ExplanationIllustration from './ExplanationIllustration.astro';
interface Props { step: number }
const { step } = Astro.props;
const scenes = ['home-receive', 'home-validate', 'home-register', 'home-notify'];
---
<div class="flow-scene"><ExplanationIllustration name={scenes[step]} /></div>
<style>
 .flow-scene { width: 100%; max-width: 240px; margin-inline: auto; }
</style>
