---
// 説明文の補助となるオリジナル線画。意味は隣接するHTMLで伝える。
import ScenePerson from './ScenePerson.astro';
interface Props { step: number }
const { step } = Astro.props;
---
<svg class="flow-scene" viewBox="0 0 240 150" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
 <g stroke="#74736c" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
  <path d="M19 137H221" stroke="#d4d1c7" />
  {step === 0 && <>
   <ScenePerson x={33} y={31} pose="phone" />
   <rect x="132" y="19" width="64" height="111" rx="8" fill="#fffefa" />
   <path d="M152 26H176M158 123H170" />
   <rect x="140" y="39" width="48" height="37" rx="4" fill="#f3e5a5" stroke="none" />
   <path d="M149 50H177M149 59H169M149 87H179M149 96H170M149 105H175" />
   <path d="M101 68C112 61 119 60 126 61M120 56L126 61L121 67" stroke-dasharray="3 4" />
   <path d="M202 39l7-4M205 48h9" stroke="#c5ad58" />
  </>}
  {step === 1 && <>
   <rect x="37" y="29" width="91" height="102" rx="4" fill="#fffefa" />
   <rect x="60" y="22" width="45" height="15" rx="3" fill="#f3e5a5" />
   {[57, 80, 103].map(y => <><rect x="48" y={y-6} width="12" height="12" rx="2" fill="#f6edcb" /><path d={`M50 ${y}l3 3 6-7M70 ${y}h43`} /></>)}
   <ScenePerson x={145} y={31} pose="point" />
   <circle cx="133" cy="84" r="17" fill="#fffefa" fill-opacity=".9" />
   <path d="M145 97l13 14" stroke-width="5" stroke="#d8c578" /><path d="M126 84l5 5 9-11" />
  </>}
  {step === 2 && <>
   <rect x="92" y="25" width="115" height="79" rx="4" fill="#fffefa" />
   <path d="M93 40H206M137 105v15M161 105v15M125 121H174" />
   <circle cx="100" cy="33" r="1.5" fill="#bcb8ac" stroke="none" />
   <rect x="102" y="48" width="95" height="13" rx="2" fill="#f3e5a5" stroke="none" />
   <path d="M104 71H193M104 82H193M121 49V92M157 49V92" stroke="#c5c0b3" />
   <path d="M79 122H220M89 122v15M211 122v15" /><ScenePerson x={25} y={32} pose="point" />
   <path d="M198 111l4 4 8-9" stroke="#9b8a46" />
  </>}
  {step === 3 && <>
   <ScenePerson x={56} y={30} pose="wave" />
   <path d="M134 30H200a6 6 0 0 1 6 6v36a6 6 0 0 1-6 6h-37l-13 12V78h-16a6 6 0 0 1-6-6V36a6 6 0 0 1 6-6Z" fill="#f6edcb" />
   <path d="M155 58v-7a11 11 0 0 1 22 0v7l5 5h-32l5-5ZM162 68q4 5 8 0" />
   <path d="M185 34l4-6M194 44l7-2" stroke="#c5ad58" />
   <rect x="132" y="110" width="74" height="26" rx="3" fill="#fffefa" /><path d="M144 120H194M144 127H178" stroke="#bcb8ac" />
  </>}
  {step === 4 && <>
   <ScenePerson x={30} y={30} pose="point" />
   <g transform="translate(240 0) scale(-1 1)"><ScenePerson x={30} y={30} pose="point" /></g>
   <path d="M94 24h52v29h-22l-9 8v-8H94Z" fill="#f3e5a5" /><path d="M104 35H136M104 43H127M77 114H164M85 114v23M156 114v23" />
   <path d="M104 106h35l-4-20h-27Z" fill="#fffefa" />
  </>}
  {step === 5 && <>
   <ScenePerson x={31} y={31} pose="point" />
   <path d="M129 24h49l23 23v84h-72Z" fill="#fffefa" /><path d="M178 24v23h23" fill="#f3e5a5" />
   <path d="M142 62H186M142 73H181M142 84H186M142 95H170" stroke="#bcb8ac" />
   <rect x="142" y="107" width="29" height="12" rx="2" fill="#f3e5a5" stroke="none" /><path d="M179 116l5 5 10-12" />
  </>}
  {step === 6 && <>
   <ScenePerson x={35} y={31} pose="phone" />
   <rect x="125" y="45" width="79" height="57" rx="4" fill="#fffefa" /><path d="M126 48l38 29 39-29" fill="#f6edcb" />
   <path d="M126 100l27-25M203 100l-27-25M134 114H190M146 122H181" stroke="#bcb8ac" /><path d="M111 47l-5-6M117 37v-7" stroke="#c5ad58" />
  </>}
  {step >= 7 && <>
   <ScenePerson x={32} y={31} pose="point" />
   <rect x="121" y="35" width="84" height="91" rx="4" fill="#fffefa" /><path d="M121 50H205M132 42h2M141 42h2" />
   <rect x="132" y="60" width="61" height="22" rx="2" fill="#f3e5a5" stroke="none" /><path d="M133 93h23v21h-23ZM166 94H193M166 103H189M166 112H182" />
   <path d="M203 26l4-7M212 33l7-2" stroke="#c5ad58" />
  </>}
 </g>
</svg>
<style>
 .flow-scene { display: block; width: 100%; height: auto; max-width: 240px; margin-inline: auto; }
</style>
