---
// トップ：LINEから担当者への通知までを、スクロールに合わせてたどる連携フロー。
// 段階の切り替えは IntersectionObserver、線とデータの移動はスクロール駆動アニメーション（animation-timeline）で行う。
// どちらも使えない環境・動きを減らす設定では、完成した図を静止表示する。
import MaterialIcon from './MaterialIcon.astro';
import type { SiteLanguage } from '../data/services';
interface Props { lang?: SiteLanguage; compact?: boolean }
const { lang = 'ja', compact = false } = Astro.props;
const c = {
  ja: {
    eyebrow: '連携の流れ',
    title: '問い合わせが届いてから、担当者に知らせるまで。',
    lead: 'LINEで受けた内容が、どこを通って業務システムに入るのか。4つの段階に分けて説明します。',
    steps: [
      ['LINEで受け付ける', '友だち追加やLINEの中で開くフォームから、申込・問い合わせを受け取ります。お客様はいつものLINEのまま送れます。'],
      ['入力内容を確かめる', '和-Nodeが作る中継の仕組みが、必要な項目を取り出します。足りない情報や、同じ内容の二重送信がないかもここで確かめます。'],
      ['業務システムへ登録する', 'Salesforce・kintone・HubSpot・Googleスプレッドシートへ、事前に決めた項目の形で自動登録します。'],
      ['担当者に知らせる', '登録が済んだら担当者へ通知します。転記の手間と、対応の漏れを減らします。'],
    ],
    nodes: [['LINE公式アカウント', '申込・問い合わせ'], ['内容を確認する仕組み', '項目の取り出し・確認'], ['業務システム', 'Salesforce / kintone など'], ['担当者への通知', '対応の開始']],
  },
  en: {
    eyebrow: 'How the integration works',
    title: 'From a LINE inquiry to a notified team.',
    lead: 'Where does a message received on LINE go before it reaches your business system? Here are the four stages.',
    steps: [
      ['Receive on LINE', 'Requests and inquiries arrive through a follow or a form opened inside LINE. Customers keep using the LINE app they already know.'],
      ['Check the details', 'The relay built by Wa-Node extracts the fields you need. It also checks for missing details and duplicate submissions.'],
      ['Register in your system', 'The details are registered automatically in Salesforce, kintone, HubSpot or Google Sheets, in the fields agreed in advance.'],
      ['Notify the right person', 'Once registered, the person in charge is notified. Less copying, fewer missed follow-ups.'],
    ],
    nodes: [['LINE Official Account', 'Requests & inquiries'], ['Relay (Webhook / API)', 'Extract & check fields'], ['Business system', 'Salesforce / kintone, etc.'], ['Team notification', 'Follow-up begins']],
  },
  fr: {
    eyebrow: 'Le parcours de l’intégration',
    title: 'De la demande LINE à l’équipe informée.',
    lead: 'Par où passe un message reçu sur LINE avant d’arriver dans votre outil métier ? Voici les quatre étapes.',
    steps: [
      ['Recevoir sur LINE', 'Les demandes arrivent via un ajout en ami ou un formulaire ouvert dans LINE. Vos clients restent dans l’application qu’ils connaissent.'],
      ['Vérifier les informations', 'Le relais conçu par Wa-Node extrait les champs utiles. Il vérifie aussi les informations manquantes et les envois en double.'],
      ['Enregistrer dans votre outil', 'Les informations sont enregistrées automatiquement dans Salesforce, kintone, HubSpot ou Google Sheets, selon les champs convenus.'],
      ['Informer la bonne personne', 'Une fois la fiche créée, la personne responsable est avertie. Moins de ressaisies, moins d’oublis.'],
    ],
    nodes: [['Compte officiel LINE', 'Demandes'], ['Relais (Webhook / API)', 'Extraction et contrôle'], ['Outil métier', 'Salesforce / kintone…'], ['Notification', 'Début du suivi']],
  },
}[lang];
const icons = ['forum', 'sync_alt', 'inventory_2', 'notifications_active'];
const brief = {
  ja: ['LINEの中で開く入力画面から、申込・問い合わせを受け付けます。', '必要な情報がそろっているか、同じ内容が二重に届いていないかを確かめます。', '今お使いのシステムへ、あらかじめ決めた項目を登録します。', '登録後に担当者へ通知し、次の対応につなげます。'],
  en: ['Receive requests through a form opened inside LINE.', 'Check for missing information and duplicate submissions.', 'Register the agreed fields in the system you already use.', 'Notify the person in charge so they can follow up.'],
  fr: ['Recevoir les demandes via un formulaire ouvert dans LINE.', 'Vérifier les informations manquantes et les doublons.', 'Enregistrer les champs convenus dans votre outil actuel.', 'Informer la personne responsable pour permettre le suivi.'],
}[lang];
---
<section class:list={["s-section", "flow-scroll", { "is-compact": compact }]} id="flow" aria-labelledby="flow-title" data-flow-scroll={compact ? undefined : ""} data-active-step="0">
  <div class="s-shell">
    <div class="flow-head" data-motion-enter="heading" data-motion-id="flow-heading">
      <p class="s-eyebrow">{c.eyebrow}</p>
      <h2 id="flow-title">{c.title}</h2>
      <p class="s-intro">{c.lead}</p>
    </div>
    <div class="flow-layout">
      <!-- 図は本文の段階を図示したもの。読み上げは本文の番号付きリストで足りるため隠す -->
      <div class="flow-visual" aria-hidden="true">
        <div class="flow-diagram">
          {c.nodes.map(([name, sub], i) => <>
            {i > 0 && <div class="flow-link" data-seg={i - 1}><span class="flow-link-fill"></span><span class="flow-packet"></span></div>}
            <div class="flow-node" data-node={i}>
              <span class="flow-node-icon"><MaterialIcon name={icons[i]} /></span>
              <span class="flow-node-text"><strong>{name}</strong><small>{sub}</small></span>
              <span class="flow-node-num">0{i + 1}</span>
            </div>
          </>)}
        </div>
      </div>
      <ol class="flow-steps">
        {c.steps.map(([title, desc], i) => <li class="flow-step" data-step={i}>
          <span class="flow-step-marker" aria-hidden="true"><MaterialIcon name={icons[i]} /></span>
          <div><span class="s-number">0{i + 1}</span><h3>{title}</h3><p>{compact ? brief[i] : desc}</p></div>
        </li>)}
      </ol>
    </div>
  </div>
</section>
<style>
.flow-head{max-width:46em;margin-bottom:12px}
.flow-head .s-eyebrow{text-transform:none}
.flow-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:72px;align-items:start}

/* 図：PCでは画面内に固定し、右の本文に合わせて段階を切り替える */
.flow-visual{position:sticky;top:max(104px,calc(50vh - 230px));padding:24px 0}
.flow-diagram{--link-h:36px;display:flex;flex-direction:column;padding:28px;border:1px solid var(--rule);border-radius:12px;background:#fffefa}
.flow-node{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:14px;align-items:center;padding:14px 16px;border:1px solid var(--rule);border-radius:8px;background:#fff;color:var(--quiet);transition:border-color var(--motion-panel,200ms) ease-out,box-shadow var(--motion-panel,200ms) ease-out,color var(--motion-panel,200ms) ease-out}
.flow-node-icon{display:grid;place-items:center;width:44px;height:44px;border-radius:8px;background:#eef1ea;color:var(--deep);transition:background var(--motion-panel,200ms) ease-out,color var(--motion-panel,200ms) ease-out}
.flow-node-text{display:grid;gap:2px;min-width:0}
.flow-node-text strong{font-size:.9375rem;color:var(--ink)}
.flow-node-text small{font-size:.75rem}
.flow-node-num{font-family:'Outfit',sans-serif;font-size:.75rem;letter-spacing:.1em}
.flow-link{position:relative;height:var(--link-h);width:2px;margin-left:37px;background:var(--rule)}
.flow-link-fill{position:absolute;inset:0;background:var(--deep);transform-origin:50% 0}
.flow-packet{position:absolute;left:50%;top:0;width:10px;height:10px;margin:-5px 0 0 -5px;border-radius:50%;background:var(--vermillion);opacity:0}

/* 画面の高さが低いPCでは、図を縮めて画面内に収める */
@media (min-width:821px) and (max-height:720px){.flow-diagram{padding:18px}.flow-node{padding:10px 14px}.flow-node-text small{display:none}.flow-diagram{--link-h:24px}}

/* 現在の段階と、通過済みの段階 */
[data-active-step="0"] .flow-node[data-node="0"],
[data-active-step="1"] .flow-node[data-node="1"],
[data-active-step="2"] .flow-node[data-node="2"],
[data-active-step="3"] .flow-node[data-node="3"]{border-color:var(--deep);box-shadow:0 0 0 3px rgba(22,79,77,.12);color:var(--ink)}
[data-active-step="0"] .flow-node[data-node="0"] .flow-node-icon,
[data-active-step="1"] .flow-node[data-node="1"] .flow-node-icon,
[data-active-step="2"] .flow-node[data-node="2"] .flow-node-icon,
[data-active-step="3"] .flow-node[data-node="3"] .flow-node-icon{background:var(--deep);color:#fff}

/* 本文 */
.flow-steps{list-style:none;margin:0;padding:0}
.flow-step{display:flex;gap:20px;min-height:min(62vh,520px);align-items:center;border-top:1px solid var(--rule)}
.flow-step:first-child{border-top:0}
.flow-step h3{font-size:1.23rem;margin:6px 0 10px;color:var(--ink)}
.flow-step p{margin:0;font-size:.9375rem;line-height:1.95;color:var(--quiet);max-width:30em}
.flow-step-marker{display:none}

/* スクロール駆動：次の段階の本文が画面中央へ来るまでの間に、その段階への線を引き、データを流す。
   線の進み具合を本文の位置に結び付けるため、各段階の view-timeline をセクション全体で参照する。
   対応ブラウザだけで動かし、非対応では線を引き終えた状態で止める。 */
@supports (animation-timeline: view()) and (timeline-scope: --a){
  @media (prefers-reduced-motion: no-preference) and (min-width: 821px){
    .flow-scroll{timeline-scope:--flow-step-1,--flow-step-2,--flow-step-3}
    .flow-step[data-step="1"]{view-timeline-name:--flow-step-1}
    .flow-step[data-step="2"]{view-timeline-name:--flow-step-2}
    .flow-step[data-step="3"]{view-timeline-name:--flow-step-3}
    .flow-link-fill{transform:scaleY(0);animation:flow-fill linear both}
    .flow-packet{animation:flow-packet linear both}
    .flow-link :is(.flow-link-fill,.flow-packet){animation-range:cover 15% cover 50%}
    .flow-link[data-seg="0"] :is(.flow-link-fill,.flow-packet){animation-timeline:--flow-step-1}
    .flow-link[data-seg="1"] :is(.flow-link-fill,.flow-packet){animation-timeline:--flow-step-2}
    .flow-link[data-seg="2"] :is(.flow-link-fill,.flow-packet){animation-timeline:--flow-step-3}
  }
}
@keyframes flow-fill{to{transform:scaleY(1)}}
@keyframes flow-packet{0%{opacity:0;transform:translateY(0)}10%{opacity:1}90%{opacity:1;transform:translateY(var(--link-h))}100%{opacity:0;transform:translateY(var(--link-h))}}

/* スマホ・タブレット：図は出さず、本文の左に縦の線と段階のしるしを置く */
@media (max-width:820px){
  .flow-layout{display:block}
  .flow-visual{display:none}
  .flow-steps{position:relative;margin-top:12px}
  .flow-steps::before{content:"";position:absolute;left:21px;top:28px;bottom:28px;width:2px;background:var(--rule)}
  .flow-step{min-height:0;align-items:flex-start;padding:22px 0;border-top:0}
  .flow-step-marker{position:relative;display:grid;place-items:center;flex:0 0 44px;height:44px;border-radius:50%;background:#eef1ea;color:var(--deep);border:2px solid var(--paper);transition:background var(--motion-panel,200ms) ease-out,color var(--motion-panel,200ms) ease-out}
  .flow-step.is-reached .flow-step-marker{background:var(--deep);color:#fff}
  .flow-step h3{font-size:1.06rem}
}

/* サイト上の「動きを控えめに」でも、端末の設定と同じく線を引き終えた状態にする */
:global(html[data-motion="reduce"]) .flow-link-fill{transform:none}
:global(html[data-motion="reduce"]) .flow-packet{opacity:0}

@media (prefers-reduced-motion: reduce){
  .flow-node,.flow-node-icon,.flow-step-marker{transition:none}
  .flow-link-fill{animation:none;transform:none}
  .flow-packet{animation:none;opacity:0}
}
/* 概要ではスクロールの演出を使わず、全段階をまとめて読む。 */
.flow-scroll.is-compact .flow-layout{display:block}
.flow-scroll.is-compact .flow-visual{display:none}
.flow-scroll.is-compact .flow-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:24px}
.flow-scroll.is-compact .flow-steps::before{display:none}
.flow-scroll.is-compact .flow-step{min-height:0;display:block;padding:20px 0 0;border-top:2px solid var(--rule);align-items:start;view-timeline-name:none}
.flow-scroll.is-compact .flow-step-marker{display:none}
.flow-scroll.is-compact .flow-step h3{font-size:1.05rem;line-height:1.6}
.flow-scroll.is-compact .flow-step p{line-height:1.85}
@media(max-width:1100px){.flow-scroll.is-compact .flow-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.flow-scroll.is-compact .flow-steps{grid-template-columns:1fr;gap:18px}.flow-scroll.is-compact .flow-step{padding-top:14px}}
</style>
<script>
function initFlowScroll() {
  const root = document.querySelector<HTMLElement>('[data-flow-scroll]');
  if (!root || root.dataset.initialized) return;
  root.dataset.initialized = 'true';
  const steps = [...root.querySelectorAll<HTMLElement>('.flow-step')];
  // IntersectionObserverが無い環境では全段階を到達済みとして表示する（フェイルオープン）
  if (!('IntersectionObserver' in window)) {
    steps.forEach((s) => s.classList.add('is-reached'));
    return;
  }
  // 画面中央の帯に入った段階を現在の段階にする。上方向に戻った場合も同じ判定で切り替わる。
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const index = Number((entry.target as HTMLElement).dataset.step);
      root.dataset.activeStep = String(index);
      steps.forEach((s, i) => s.classList.toggle('is-reached', i <= index));
    });
  }, { rootMargin: '-45% 0px -45% 0px' });
  steps.forEach((s) => io.observe(s));
  document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
}
initFlowScroll();
document.addEventListener('astro:page-load', initFlowScroll);
</script>
