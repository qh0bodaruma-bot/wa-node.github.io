---
import MaterialIcon from './MaterialIcon.astro';
import { localizedPath, serviceLabels, consultationMinutes, type SiteLanguage } from '../data/services';
import '../styles/service-pages.css';
interface Props { lang?: SiteLanguage }
const { lang = 'ja' } = Astro.props;
const href = (path: string) => localizedPath(path,lang);
const labels = serviceLabels[lang];
const c = {
 ja: {
  title:'今の状況から、聞かせてください。',lead:'LINE連携・アプリ開発・Web制作。「何が必要か」「いくらかかるか」を整理するところからご相談いただけます。',formTitle:'無料相談フォーム',required:'必須',optional:'任意',name:'お名前',nameExample:'和 太郎',email:'メールアドレス',category:'相談したい内容',undecided:'まだ決まっていない',message:'ご相談内容',messageHint:'現在の状況と、できるようにしたいことを、分かる範囲で。',
  categories:{line_sf:'LINE × Salesforce連携',line_kintone:'LINE × kintone連携',line_hubspot:'LINE × HubSpot連携',line_sheets:'LINE × Googleスプレッドシート連携',liff_only:'LIFF（LINE内フォーム）の開発',mobile_app:'iOS・Androidアプリ開発',web_lp:'Webサイト・LPの制作／改善',web_system:'小規模Webシステム',consultation:'費用・実現可否の確認',other:'その他'},
  examples:{general:'例：予約や顧客管理を整理したいです。今はExcelとLINEを使っています。どんな方法が合うか相談したいです。',line:'例：LINEで受けた問い合わせを、kintoneに自動登録したいです。現在の受付方法と連携できる範囲を相談したいです。',app:'例：現場の作業記録をアプリにしたいです。使う人数や必要な機能、iOS・Androidの対応範囲から相談したいです。',web:'例：今のサイトでサービスが伝わりにくいと感じています。ページの見せ方と、問い合わせまでの流れを見直したいです。',system:'例：ブラウザで予約の受付・確認ができる小さな管理画面を作りたいです。'},
  schedule:'希望の相談方法・日時を追加する',scheduleHint:'未定のまま送信できます。返信後に調整します。',method:'相談方法',methods:{google_meet:'Google Meet',zoom:'Zoom',line_video:'LINEビデオ通話',phone:'電話',face_to_face:'対面（岐阜県可児市・近郊）',other:'その他（相談内容に記載）'},phone:'電話番号',line:'LINE表示名 または LINE ID',dates:'希望日時（日本時間）',dateLabels:['第一希望','第二希望','第三希望'],datesNote:'平日10:00〜18:00を基本に調整します。夜間・土日のご希望は相談内容にご記入ください。',
  privacyNote:'ログイン情報や顧客データなどの機密情報は、ここには入力しないでください。',terms:'利用規約',privacy:'プライバシーポリシー',cancel:'キャンセルポリシー',consent:'規約・ポリシーを確認し、同意します',send:'この内容で相談を送る',sending:'送信中…',error:'送信できませんでした。内容はそのまま残っています。時間をおいて再度お試しいただくか、LINEでご連絡ください。',
  afterTitle:'送信したあとは',steps:[['通常2営業日以内に返信','ご相談内容を確認し、メールでご連絡します。'],[`${consultationMinutes}分の無料相談`,'現状と目的を伺い、必要な範囲を一緒に整理します。'],['必要に応じてご提案','調査が必要な点も確認して、構成・費用・期間をご案内します。']],reassurance:'ご相談後に契約する必要はありません。内容と費用に合意してから着手します。',lineTitle:'チャットで聞きたい方へ',lineDesc:'公式LINEからもご相談いただけます。',lineButton:'LINEで相談する',pricing:'料金と対応範囲を確認する',
 },
 en: {
  title:'Tell us where you are now.',lead:'LINE integration, apps or websites. Start by clarifying what you need and what it may cost.',formTitle:'Free consultation form',required:'Required',optional:'Optional',name:'Full name',nameExample:'Your name',email:'Email address',category:'What would you like to discuss?',undecided:'Not decided yet',message:'Your message',messageHint:'Share your current situation and what you would like to achieve.',
  categories:{line_sf:'LINE × Salesforce integration',line_kintone:'LINE × kintone integration',line_hubspot:'LINE × HubSpot integration',line_sheets:'LINE × Google Sheets integration',liff_only:'LIFF form development',mobile_app:'iOS & Android app development',web_lp:'Website or landing page design / improvement',web_system:'Small web system',consultation:'Cost and feasibility',other:'Other'},
  examples:{general:'Example: I want to organize bookings and customer records. We currently use Excel and LINE. I would like to discuss suitable options.',line:'Example: I want to add inquiries from LINE to kintone automatically. I would like to discuss our current workflow and the integration scope.',app:'Example: We need an app for work records. I would like to discuss users, essential features and support for iOS and Android.',web:'Example: Our website does not explain the service clearly. I want to improve the content and the path to contacting us.',system:'Example: I need a small browser-based tool to accept and review bookings.'},
  schedule:'Add preferred meeting method and dates',scheduleHint:'You can leave these undecided. We can arrange them by email.',method:'Meeting method',methods:{google_meet:'Google Meet',zoom:'Zoom',line_video:'LINE video call',phone:'Phone',face_to_face:'In person (Kani, Gifu, Japan)',other:'Other (describe in your message)'},phone:'Phone number',line:'LINE display name or ID',dates:'Preferred dates (Japan Standard Time)',dateLabels:['First choice','Second choice','Third choice'],datesNote:'Usually weekdays, 10:00–18:00 JST. Please mention evening or weekend preferences in your message.',privacyNote:'Please do not enter passwords, customer data or other confidential information.',terms:'Terms of use',privacy:'Privacy policy',cancel:'Cancellation policy',consent:'I have read and agree to the terms and policies',send:'Send my inquiry',sending:'Sending…',error:'Your message could not be sent. Your entries are still here. Please retry later or contact us on LINE.',afterTitle:'What happens next',steps:[['Reply within 2 business days','We review your inquiry and reply by email.'],[`${consultationMinutes}-minute free consultation`,'We clarify your situation, goals and necessary scope.'],['A proposal if needed','We review any open questions before proposing scope, cost and timing.']],reassurance:'There is no obligation to order. Work starts only after agreement on scope and cost.',lineTitle:'Prefer a chat?',lineDesc:'You can also reach us on our official LINE account.',lineButton:'Contact us on LINE',pricing:'Review scope and pricing',
 },
 fr: {
  title:'Parlons de votre situation.',lead:'Intégration LINE, applications ou sites web : commençons par préciser vos besoins et le coût possible.',formTitle:'Formulaire de consultation gratuite',required:'Obligatoire',optional:'Facultatif',name:'Nom',nameExample:'Votre nom',email:'Adresse e-mail',category:'Quel est votre projet ?',undecided:'Pas encore défini',message:'Votre message',messageHint:'Décrivez votre situation actuelle et ce que vous souhaitez réaliser.',
  categories:{line_sf:'Intégration LINE × Salesforce',line_kintone:'Intégration LINE × kintone',line_hubspot:'Intégration LINE × HubSpot',line_sheets:'Intégration LINE × Google Sheets',liff_only:'Développement de formulaire LIFF',mobile_app:'Application iOS et Android',web_lp:'Création / amélioration de site ou page de vente',web_system:'Petit système web',consultation:'Coût et faisabilité',other:'Autre'},
  examples:{general:'Exemple : je souhaite organiser les réservations et les dossiers clients. Nous utilisons Excel et LINE. Quelles solutions seraient adaptées ?',line:'Exemple : je souhaite enregistrer automatiquement dans kintone les demandes reçues sur LINE. J’aimerais préciser le périmètre possible.',app:'Exemple : nous souhaitons une application de suivi du travail. Parlons des utilisateurs, des fonctions essentielles et des systèmes iOS et Android.',web:'Exemple : notre site présente mal notre service. Je souhaite clarifier les contenus et le parcours de prise de contact.',system:'Exemple : je souhaite un petit outil dans le navigateur pour recevoir et consulter les réservations.'},
  schedule:'Ajouter vos préférences de rendez-vous',scheduleHint:'Vous pouvez laisser ces choix ouverts et les préciser par e-mail.',method:'Mode de consultation',methods:{google_meet:'Google Meet',zoom:'Zoom',line_video:'Appel vidéo LINE',phone:'Téléphone',face_to_face:'En personne (Kani, Gifu, Japon)',other:'Autre (à préciser dans le message)'},phone:'Numéro de téléphone',line:'Nom d’affichage ou identifiant LINE',dates:'Dates souhaitées (heure du Japon)',dateLabels:['Premier choix','Deuxième choix','Troisième choix'],datesNote:'En général en semaine, de 10 h à 18 h au Japon. Précisez vos préférences en soirée ou le week-end dans le message.',privacyNote:'Ne saisissez pas de mots de passe, de données clients ou d’informations confidentielles.',terms:'Conditions d’utilisation',privacy:'Politique de confidentialité',cancel:'Politique d’annulation',consent:'J’ai lu et j’accepte les conditions et politiques',send:'Envoyer ma demande',sending:'Envoi en cours…',error:'L’envoi a échoué. Vos informations sont conservées dans ce formulaire. Réessayez plus tard ou contactez-nous sur LINE.',afterTitle:'Après votre demande',steps:[['Réponse sous 2 jours ouvrés','Nous étudions votre demande et répondons par e-mail.'],[`Échange gratuit de ${consultationMinutes} minutes`,'Nous précisons votre situation, vos objectifs et le périmètre.'],['Une proposition si nécessaire','Nous vérifions les questions ouvertes avant de proposer un coût et un calendrier.']],reassurance:'Aucune obligation de commander. Le travail commence après accord sur le périmètre et le coût.',lineTitle:'Vous préférez discuter par message ?',lineDesc:'Notre compte LINE officiel est également disponible.',lineButton:'Nous contacter sur LINE',pricing:'Consulter les tarifs et le périmètre',
 }
}[lang];
---
<main id="main" class="service-page contact-refresh" data-glossary-skip data-reveal="off">
 <header class="contact-heading s-shell"><p class="s-eyebrow">Contact</p><h1>{c.title}</h1><p class="s-intro">{c.lead}</p></header>
 <div class="s-shell contact-layout">
  <section class="contact-form-panel" aria-labelledby="form-title"><div class="contact-form-heading"><h2 id="form-title">{c.formTitle}</h2><span>{labels.consultation}</span></div>
   <form action="https://formspree.io/f/xojrldrq" method="POST" class="contact-form" data-lang={lang} data-thanks={href('/thanks/')} data-error={c.error}>
    <input type="hidden" name="_next" value={new URL(href('/thanks/'),Astro.url).href}/><input type="hidden" id="landing_url" name="landing_url" value=""/><input type="hidden" id="referrer_url" name="referrer_url" value=""/><input type="hidden" id="seen_source" name="seen_source" value=""/>
    <div class="contact-fields-two">
     <div class="form-group"><label for="name">{c.name}<span class="field-required">{c.required}</span></label><input type="text" id="name" name="name" autocomplete="name" placeholder={c.nameExample} required maxlength="200"/></div>
     <div class="form-group"><label for="email">{c.email}<span class="field-required">{c.required}</span></label><input type="email" id="email" name="email" autocomplete="email" inputmode="email" placeholder="name@example.com" required maxlength="254"/></div>
    </div>
    <div class="form-group"><label for="consultation_category">{c.category}<span class="field-optional">{c.optional}</span></label><select name="consultation_category" id="consultation_category"><option value="">{c.undecided}</option>{Object.entries(c.categories).map(([value,label])=><option value={value}>{label}</option>)}</select></div>
    <div class="form-group"><label for="message">{c.message}<span class="field-required">{c.required}</span></label><p class="field-hint" id="message-hint">{c.messageHint}</p><textarea id="message" name="message" rows="6" required maxlength="10000" placeholder={c.examples.general} aria-describedby="message-hint message-example" data-example-general={c.examples.general} data-example-line={c.examples.line} data-example-app={c.examples.app} data-example-web={c.examples.web} data-example-system={c.examples.system}></textarea><p class="field-example" id="message-example">{c.examples.general}</p></div>
    <details class="optional-schedule"><summary>{c.schedule}<span class="field-optional">{c.optional}</span></summary><div class="schedule-content"><p class="field-hint">{c.scheduleHint}</p><div class="form-group"><label for="consultation_method">{c.method}</label><select id="consultation_method" name="consultation_method"><option value="">{c.undecided}</option>{Object.entries(c.methods).map(([value,label])=><option value={value}>{label}</option>)}</select></div>
     <div class="form-group" data-method-field="phone" hidden><label for="phone">{c.phone}<span class="field-required">{c.required}</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" disabled/></div>
     <div class="form-group" data-method-field="line_video" hidden><label for="line_contact">{c.line}<span class="field-required">{c.required}</span></label><input id="line_contact" name="line_contact" type="text" disabled/></div>
     <fieldset class="date-candidates"><legend>{c.dates}</legend>{c.dateLabels.map((label,i)=><div><label for={`date_${i+1}`}>{label}</label><input id={`date_${i+1}`} type="datetime-local" name={`date_${i+1}`}/></div>)}</fieldset><p class="field-hint">{c.datesNote}</p>
    </div></details>
    <p class="contact-private-note">{c.privacyNote}</p>
    <div class="form-consent"><div class="policy-links"><a href="/terms/" target="_blank" rel="noopener">{c.terms} ↗</a><a href="/privacy/" target="_blank" rel="noopener">{c.privacy} ↗</a><a href="/cancel-policy/" target="_blank" rel="noopener">{c.cancel} ↗</a></div><label class="consent-check"><input type="checkbox" name="consent" value="agreed" required/><span>{c.consent}</span></label></div>
    <p class="form-error" role="alert" tabindex="-1" hidden></p><button type="submit" class="s-button submit-btn" data-submitting={c.sending}><span>{c.send}</span><MaterialIcon name="arrow_forward"/></button>
   </form>
  </section>
  <aside class="contact-aside"><p class="s-eyebrow">Next steps</p><h2>{c.afterTitle}</h2><ol>{c.steps.map(([title,desc],i)=><li><span class="s-number">0{i+1}</span><div><h3>{title}</h3><p>{desc}</p></div></li>)}</ol><p class="contact-reassurance">{c.reassurance}</p><a class="s-link" href={href('/pricing/')}>{c.pricing}<span aria-hidden="true">→</span></a><div class="contact-line"><h3>{c.lineTitle}</h3><p>{c.lineDesc}</p><a href="https://lin.ee/o5QFPwc" target="_blank" rel="noopener" class="line-contact-button">{c.lineButton}<MaterialIcon name="north_east"/></a></div></aside>
 </div>
</main>
<style>
.contact-refresh{padding-bottom:76px}.contact-heading{padding-top:60px;padding-bottom:26px}.contact-heading h1{font-size:clamp(2.15rem,3.7vw,3.1rem);max-width:21em}.contact-heading .s-intro{max-width:50em;margin-bottom:12px}.contact-layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(250px,1fr);gap:50px;align-items:start}.contact-form-panel{padding:30px!important;background:#fffefa;border:1px solid var(--rule);border-radius:8px}.contact-form-heading{margin-bottom:28px;border-bottom:1px solid var(--rule);padding-bottom:20px}.contact-form-heading h2{font-family:inherit!important;font-size:1.2rem!important;margin-bottom:6px}.contact-form-heading>span{color:var(--deep);font-size:.76rem}.form-group{margin-bottom:24px}.form-group>label{display:flex;gap:10px;align-items:center;font-size:.88rem;font-weight:700;margin-bottom:8px}.field-required,.field-optional{font-size:.63rem;padding:1px 6px;border-radius:3px;flex-shrink:0;font-weight:500}.field-required{background:#f5e8e3;color:#923528}.field-optional{color:var(--quiet);background:#eeefe9}.contact-refresh input:not([type=checkbox]):not([type=hidden]),.contact-refresh select,.contact-refresh textarea{display:block;width:100%;min-width:0;min-height:48px;padding:12px;background:white;border:1px solid #bfc7bd;border-radius:5px;color:var(--ink);font:inherit;font-size:16px;line-height:1.7}.contact-refresh textarea{resize:vertical;min-height:140px}.contact-refresh input::placeholder,.contact-refresh textarea::placeholder{color:#747b71;font-size:.86rem}.contact-refresh input:focus-visible,.contact-refresh select:focus-visible,.contact-refresh textarea:focus-visible{outline:2px solid var(--deep);outline-offset:2px;border-color:var(--deep)}.contact-fields-two{display:grid;grid-template-columns:1fr;gap:0}.field-hint,.field-example{font-size:.75rem;color:var(--quiet);line-height:1.8;margin:0 0 10px}.field-example{padding:10px 12px;background:#f2f3ec;border-radius:4px;margin:10px 0 0}.optional-schedule{border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);padding:18px 0}.optional-schedule summary{font-size:.84rem;font-weight:700;cursor:pointer;line-height:1.8}.optional-schedule summary .field-optional{margin-left:10px}.schedule-content{padding-top:20px}.date-candidates{border:0;padding:0;margin:0 0 12px;min-width:0}.date-candidates legend{font-size:.86rem;font-weight:700;margin-bottom:10px}.date-candidates>div{display:grid;grid-template-columns:86px minmax(0,1fr);gap:10px;align-items:center;margin-bottom:10px}.date-candidates label{font-size:.76rem}.contact-private-note{font-size:.7rem;color:var(--quiet);margin:20px 0}.form-consent{margin-bottom:26px}.policy-links{display:flex;flex-wrap:wrap;gap:8px 16px;font-size:.68rem;margin-bottom:18px}.policy-links a{text-decoration:underline;text-underline-offset:3px}.consent-check{display:flex;align-items:start;gap:12px;cursor:pointer;font-size:.81rem;line-height:1.8}.consent-check input{width:20px;height:20px;flex-shrink:0;margin:2px 0;accent-color:var(--deep)}.submit-btn{width:100%}.submit-btn:disabled{opacity:.65;cursor:wait}.form-error{border-left:3px solid var(--vermillion);background:#fbebe6;color:#8b2925;font-size:.8rem;padding:14px;margin-bottom:20px}.contact-aside{padding-top:22px}.contact-aside h2{font-size:1.5rem}.contact-aside ol{padding:0;list-style:none;margin:24px 0}.contact-aside li{display:flex;gap:16px;border-top:1px solid var(--rule);padding:20px 0}.contact-aside h3{font-size:.95rem;margin-bottom:6px}.contact-aside li p{font-size:.8rem;color:var(--quiet);margin:0}.contact-reassurance{background:#eaf0e5;padding:18px;font-size:.8rem;border-radius:6px}.contact-aside>.s-link{font-size:.76rem}.contact-line{margin-top:30px;padding-top:26px;border-top:1px solid var(--rule)}.contact-line p{font-size:.8rem;color:var(--quiet)}.line-contact-button{background:#23754e;color:#fff!important;display:flex;justify-content:center;align-items:center;gap:12px;border-radius:5px;padding:12px;text-decoration:none;font-size:.84rem;font-weight:700}
@media(max-width:820px){.contact-layout{grid-template-columns:1fr;gap:24px}.contact-aside{padding-top:14px}.contact-heading{padding-top:40px}.contact-aside ol{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.contact-aside li{display:block}.contact-aside li h3{margin-top:8px}.contact-form-panel{padding:26px!important}}
@media(max-width:560px){.contact-form-panel{padding:22px 18px!important}.contact-aside ol{grid-template-columns:1fr;gap:0}.contact-aside li{display:flex}.date-candidates>div{grid-template-columns:1fr;gap:5px}.contact-heading h1{font-size:2.1rem}}
</style>
<script>
function initContactForm() {
 const form = document.querySelector<HTMLFormElement>('.contact-form');
 if (!form || form.dataset.initialized) return;
 form.dataset.initialized = 'true';
 const params = new URLSearchParams(window.location.search);
 const category = form.querySelector<HTMLSelectElement>('#consultation_category')!;
 const message = form.querySelector<HTMLTextAreaElement>('#message')!;
 const source = (params.get('source') || params.get('plan') || params.get('benefit') || '').slice(0,200);
 (form.querySelector('#landing_url') as HTMLInputElement).value = window.location.href;
 (form.querySelector('#referrer_url') as HTMLInputElement).value = document.referrer;
 (form.querySelector('#seen_source') as HTMLInputElement).value = source;
 const inferred = source.includes('mobile') || source === 'pricing_app' ? 'mobile_app' : source.includes('kintone') ? 'line_kintone' : source.includes('salesforce') ? 'line_sf' : source.includes('hubspot') ? 'line_hubspot' : source.includes('sheets') ? 'line_sheets' : source.includes('line') ? 'liff_only' : source === 'pricing_web' || source.includes('b2b') || source.includes('lp') ? 'web_lp' : '';
 const initial = params.get('category') || inferred;
 if ([...category.options].some(option => option.value === initial)) category.value = initial;
 function updateExample() { const value = category.value; const kind = value === 'mobile_app' ? 'App' : value === 'web_lp' ? 'Web' : value === 'web_system' ? 'System' : value.startsWith('line') || value === 'liff_only' ? 'Line' : 'General'; const example = message.dataset[`example${kind}`] || ''; message.placeholder = example; const hint = form!.querySelector('#message-example'); if (hint) hint.textContent = example; }
 category.addEventListener('change', updateExample); updateExample();
 const method = form.querySelector<HTMLSelectElement>('#consultation_method')!;
 function updateMethod() { form!.querySelectorAll<HTMLElement>('[data-method-field]').forEach(group => { const active = group.dataset.methodField === method.value; group.hidden = !active; const input = group.querySelector('input')!; input.disabled = !active; input.required = active; }); }
 method.addEventListener('change', updateMethod); updateMethod();
 form.addEventListener('invalid', event => { const field = event.target as HTMLElement; const details = field.closest('details'); if (details) details.open = true; },true);
 form.addEventListener('submit', async event => {
  event.preventDefault(); const button = form.querySelector<HTMLButtonElement>('.submit-btn')!; if (button.disabled) return;
  const label = button.querySelector('span')!; const original = label.textContent; const error = form.querySelector<HTMLElement>('.form-error')!;
  button.disabled = true; form.setAttribute('aria-busy','true'); label.textContent = button.dataset.submitting!; error.hidden = true;
  const controller = new AbortController(); const timeout = window.setTimeout(() => controller.abort(), 20000);
  try { const response = await fetch(form.action,{method:'POST',body:new FormData(form),headers:{Accept:'application/json'},signal:controller.signal}); if (!response.ok) throw new Error('Submission failed'); window.location.assign(form.dataset.thanks || '/thanks/'); }
  catch { error.textContent = form.dataset.error!; error.hidden = false; error.focus(); button.disabled = false; label.textContent = original; }
  finally { window.clearTimeout(timeout); form.removeAttribute('aria-busy'); }
 });
}
initContactForm();document.addEventListener('astro:page-load',initContactForm);
</script>
