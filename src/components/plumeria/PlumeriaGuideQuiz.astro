---
import { routes } from '../../data/plumeria';

// お悩み（どこで・何をしたいか）→ 具体的な希望 → サービス、の順にたどる図。
// 現行サイトのサービスフロー図（画像1枚）を参考に、読み上げ・文字の拡大・スマホでも使えるよう HTML で組む。
// 同じサービスが複数のお悩みから選ばれる（ショートステイ・居宅介護支援）ことを、行き先の重複で見せる。
type Dest = { want: string; name: string; sub: string; href: string; id: string; gtag?: string };
type Need = { tone: string; icon: string; title: string; paths: Dest[] };

const shortStay: Omit<Dest, 'want'> = { name: 'プルメリアⅢ', sub: 'ショートステイ', href: routes.shortStay, id: 'short-stay' };
const careManagement: Omit<Dest, 'want'> = { name: '居宅介護支援', sub: 'ケアマネジャーへの相談', href: routes.careManagement, id: 'care-management' };

const needs: Need[] = [
  {
    tone: 'stay', icon: 'home', title: '住まいや施設で、介護を受けたい',
    paths: [
      { want: '入居して、ゆっくり過ごしたい', name: 'プルメリアⅠ・Ⅱ', sub: 'サービス付き高齢者向け住宅', href: routes.housing, id: 'housing' },
      { want: '期間を決めて、泊まりたい', ...shortStay },
    ],
  },
  {
    tone: 'home', icon: 'staff', title: '自宅で、介護を続けたい',
    paths: [
      { want: '入浴・食事・家事を手伝ってほしい', name: '訪問介護', sub: 'ホームヘルパーが訪問', href: routes.homeCare, id: 'home-care' },
      { want: '家族が休む間、短期間泊まってほしい', ...shortStay },
      { want: '歩行器や介護ベッドを使いたい', name: '福祉用具', sub: '用具選びの相談', href: routes.welfareEquipment, id: 'welfare-equipment' },
      { want: 'サービスの組み合わせを決めたい', ...careManagement },
    ],
  },
  {
    tone: 'talk', icon: 'people', title: '介護について、相談したい',
    paths: [
      { want: '手続きや、何から始めるかを知りたい', ...careManagement },
    ],
  },
  {
    tone: 'med', icon: 'care', title: '自宅で、医療的なケアを受けたい',
    paths: [
      { want: '体調の確認や、医師の指示によるケアを受けたい', name: '訪問看護', sub: '看護師が訪問', href: routes.homeNursing, id: 'home-nursing' },
    ],
  },
  {
    // 孤立効果：最後の1行だけ地の色を変え、どれにも当てはまらない人の行き先をはっきりさせる
    tone: 'else', icon: 'phone', title: 'どれに当てはまるか、分からない',
    paths: [
      { want: '状況を話して、合うサービスを一緒に考えてほしい', name: 'お問い合わせ・ご相談', sub: 'サービスに合う窓口をご案内します', href: `${routes.contact}?service=undecided`, id: 'undecided', gtag: 'contact_click' },
    ],
  },
];
---
<section class="pl-sec pl-sec-tight" id="guide">
  <div class="pl-wrap">
    <h2 class="pl-h2">お悩みから、サービスを選ぶ</h2>
    <p class="pl-sec-lead">お悩みから、近い希望をたどってください。行き先のサービスの説明が開きます。</p>
    <ol class="pl-flow">
      {needs.map((n) => (
        <li class={`pl-flow-row pl-flow-${n.tone}`}>
          <p class="pl-flow-need">
            <svg aria-hidden="true" focusable="false"><use href={`#pl-i-${n.icon}`} /></svg>
            <span>{n.title}</span>
          </p>
          <ul class="pl-flow-paths">
            {n.paths.map((p) => (
              <li>
                <a class="pl-flow-path" href={p.href} data-pl-gtag={p.gtag ?? 'service_select'} data-pl-service={p.id} data-pl-cta="purpose_guide">
                  <span class="pl-flow-want">{p.want}</span>
                  <span class="pl-flow-arrow" aria-hidden="true"></span>
                  <span class="pl-flow-dest">
                    <strong>{p.name}</strong>
                    <small>{p.sub}</small>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <p class="pl-note">ショートステイと居宅介護支援は、複数のお悩みから選べます。サービスの利用条件は、各窓口でご確認ください。</p>
  </div>
</section>
