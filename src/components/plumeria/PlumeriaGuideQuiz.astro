---
import { routes } from '../../data/plumeria';
const choices = [
  { text: '暮らしを見守ってもらえる住まいを探したい', label: '住宅Ⅰ・Ⅱ', href: routes.housing, id: 'housing' },
  { text: '家族の休息や外出の間、短期間泊まりたい', label: 'ショートステイⅢ', href: routes.shortStay, id: 'short-stay' },
  { text: '自宅での入浴・食事や家事を手伝ってほしい', label: '訪問介護', href: routes.homeCare, id: 'home-care' },
  { text: '自宅で体調管理や医療的なケアを受けたい', label: '訪問看護', href: routes.homeNursing, id: 'home-nursing' },
  { text: '介護の手続きやサービスの組み合わせを相談したい', label: '居宅介護支援', href: routes.careManagement, id: 'care-management' },
  { text: '歩行器や介護ベッドなどを相談したい', label: '福祉用具', href: routes.welfareEquipment, id: 'welfare-equipment' },
];
---
<section class="pl-sec pl-sec-tight" id="guide">
  <div class="pl-wrap">
    <details class="pl-purpose-guide">
      <summary><span>どのサービスか迷ったら</span><span class="pl-guide-hint">目的から探す</span></summary>
      <p class="pl-note">今のお困りごとに近いものから、サービスの説明をご覧ください。</p>
      <ul class="pl-purpose-list">
        {choices.map((c) => (
          <li><a href={c.href} data-pl-gtag="service_select" data-pl-service={c.id} data-pl-cta="purpose_guide">
            <span>{c.text}</span><strong>{c.label} →</strong>
          </a></li>
        ))}
      </ul>
      <p class="pl-note">サービスの利用条件は、各窓口でご確認ください。</p>
    </details>
  </div>
</section>
