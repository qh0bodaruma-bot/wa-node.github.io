---
// プルメリア専用のアクセス解析の同意バナー（2026-09-28 に和-Node 共通の AnalyticsConsent から分離）。
// 同意の保存キーを和-Node 本体と分け、同じドメイン上でも同意状態を共有しないようにする。
// 解析IDは既定値を持たない。指定がなければ何も読み込まない（和-Node 本体のIDへの混入を防ぐ）。
interface Props {
  gaMeasurementId?: string;
  gaEnabled?: boolean;
  clarityProjectId?: string;
  clarityEnabled?: boolean;
  /** 同意の説明として示すポリシーのURL */
  policyHref: string;
}

const {
  gaMeasurementId = '',
  gaEnabled = false,
  clarityProjectId = '',
  clarityEnabled = false,
  policyHref,
} = Astro.props;
---

<section
  class="analytics-consent"
  id="analytics-consent"
  aria-labelledby="analytics-consent-title"
  data-ga-id={gaMeasurementId}
  data-ga-enabled={String(gaEnabled)}
  data-clarity-id={clarityProjectId}
  data-clarity-enabled={String(clarityEnabled)}
  hidden
>
  <div class="analytics-consent-inner">
    <div>
      <h2 id="analytics-consent-title">アクセス解析の設定</h2>
      <p>サイト改善のため、Google AnalyticsとMicrosoft Clarityを利用します。「許可する」を選ぶまで解析ツールは読み込みません。 <a href={policyHref}>詳しく見る</a></p>
    </div>
    <div class="analytics-consent-actions">
      <button type="button" class="consent-deny" data-consent="denied">許可しない</button>
      <button type="button" class="consent-allow" data-consent="granted">解析を許可する</button>
    </div>
  </div>
</section>

<style>
  /* ターコイズ・丸型ボタン・Zen Kaku Gothic New、文字は補足14px以上 */
  .analytics-consent { position: fixed; inset: auto 16px 16px; z-index: 10000; max-width: 920px; margin: 0 auto; padding: 20px; color: #083c4a; background: #ffffff; border: 1px solid rgba(8, 60, 74, 0.14); border-radius: 14px; box-shadow: 0 12px 40px rgba(0,0,0,.2); font-family: 'Zen Kaku Gothic New', 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Yu Gothic Medium', 'Yu Gothic', Meiryo, sans-serif; }
  .analytics-consent[hidden] { display: none; }
  .analytics-consent-inner { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 24px; align-items: center; }
  .analytics-consent h2 { margin: 0 0 6px; font-family: inherit; font-size: 17px; }
  .analytics-consent p { margin: 0; font-size: 14px; line-height: 1.7; }
  .analytics-consent a { color: #0d5a6f; text-decoration: underline; text-underline-offset: 3px; }
  .analytics-consent-actions { display: flex; gap: 10px; }
  .analytics-consent button { min-height: 46px; padding: 9px 22px; border: 1px solid #137792; border-radius: 999px; font: inherit; font-size: 15px; font-weight: 700; cursor: pointer; }
  .consent-deny { color: #0d5a6f; background: #fff; }
  .consent-allow { color: #fff; background: #137792; }
  @media (max-width: 680px) { .analytics-consent-inner { grid-template-columns: 1fr; gap: 16px; } .analytics-consent-actions { display: grid; grid-template-columns: 1fr 1fr; } }
</style>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'plumeria-analytics-consent-v1';

    // 注意：同じドメインに和-Node 本体がある間は、_ga 等のCookieも共有される。
    // 「許可しない」で消すと本体側の分も消える。サイトを分離すれば解消する。
    function eraseAnalyticsCookies() {
      document.cookie.split(';').forEach((entry) => {
        const name = entry.split('=')[0].trim();
        if (name === '_ga' || name.startsWith('_ga_') || name === '_clck' || name === '_clsk') {
          document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
        }
      });
    }

    function setGoogleConsent(value) {
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
      window.gtag('consent', 'update', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: value,
      });
    }

    function loadAnalytics(root) {
      const gaId = root.dataset.gaId;
      if (root.dataset.gaEnabled === 'true' && gaId && !document.getElementById('plumeria-ga')) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
        });
        window.gtag('consent', 'update', { analytics_storage: 'granted' });
        window.gtag('js', new Date());
        window.gtag('config', gaId);
        const script = document.createElement('script');
        script.id = 'plumeria-ga';
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`;
        document.head.appendChild(script);
      }

      const clarityId = root.dataset.clarityId;
      if (root.dataset.clarityEnabled === 'true' && clarityId && !document.getElementById('plumeria-clarity')) {
        window.clarity = window.clarity || function(){ (window.clarity.q = window.clarity.q || []).push(arguments); };
        window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'granted' });
        const script = document.createElement('script');
        script.id = 'plumeria-clarity';
        script.async = true;
        script.src = `https://www.clarity.ms/tag/${encodeURIComponent(clarityId)}`;
        document.head.appendChild(script);
      }
    }

    function applyChoice(root, choice) {
      if (choice === 'granted') {
        loadAnalytics(root);
      } else {
        setGoogleConsent('denied');
        if (typeof window.clarity === 'function') {
          window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'denied' });
          window.clarity('consent', false);
        }
        eraseAnalyticsCookies();
      }
      root.hidden = true;
    }

    function initAnalyticsConsent() {
      const root = document.getElementById('analytics-consent');
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      let choice = null;
      try { choice = localStorage.getItem(STORAGE_KEY); } catch {}
      if (choice === 'granted' || choice === 'denied') applyChoice(root, choice);
      else root.hidden = false;

      root.querySelectorAll('[data-consent]').forEach((button) => {
        button.addEventListener('click', () => {
          const next = button.dataset.consent;
          const analyticsWasLoaded = Boolean(document.getElementById('plumeria-ga') || document.getElementById('plumeria-clarity'));
          try { localStorage.setItem(STORAGE_KEY, next); } catch {}
          applyChoice(root, next);
          if (next === 'denied' && analyticsWasLoaded) window.location.reload();
        });
      });

      document.addEventListener('plumeria:open-consent', () => { root.hidden = false; });
    }

    initAnalyticsConsent();
    document.addEventListener('astro:page-load', initAnalyticsConsent);
  })();
</script>
