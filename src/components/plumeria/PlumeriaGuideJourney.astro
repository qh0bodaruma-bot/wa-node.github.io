---
// 試作（案3）：暮らしの段階に沿った道のり。PC版のみ。
// 4つの段階を横の道に並べ、各サービスを「使える段階の幅」の帯で置く。
// 1点に決めつけず幅で見せることで、段階どおりに進まない人にも当てはめやすくする。
import { routes } from '../../data/plumeria';

const stages = [
  { title: '元気なうち', note: '身の回りのことは自分でできる' },
  { title: '少し手助けが要る', note: '家事や外出に不安が出てきた' },
  { title: '介護が必要', note: '入浴や食事に介助が要る' },
  { title: '医療のケアも必要', note: '体調の管理や処置が要る' },
];

// from・to は段階の番号（1〜4）。同じ行に並べたいものは lane を同じにする
type Bar = { name: string; sub: string; href: string; id: string; from: number; to: number; lane: number; kind: 'live' | 'home' | 'stay' };
const bars: Bar[] = [
  { name: 'プルメリアⅠ', sub: '自立・介護予防向けの住まい', href: routes.housingUnit('1'), id: 'housing', from: 1, to: 2, lane: 1, kind: 'live' },
  { name: 'プルメリアⅡ', sub: '介護対応型の住まい（要介護1以上）', href: routes.housingUnit('2'), id: 'housing', from: 3, to: 4, lane: 1, kind: 'live' },
  { name: '訪問介護', sub: '入浴・食事・家事をご自宅で手伝います', href: routes.homeCare, id: 'home-care', from: 2, to: 3, lane: 2, kind: 'home' },
  { name: '訪問看護', sub: '看護師がご自宅へ', href: routes.homeNursing, id: 'home-nursing', from: 4, to: 4, lane: 2, kind: 'home' },
  { name: '福祉用具', sub: '歩行器や介護ベッドの相談', href: routes.welfareEquipment, id: 'welfare-equipment', from: 2, to: 3, lane: 3, kind: 'home' },
  { name: 'プルメリアⅢ（ショートステイ）', sub: 'ご家族が休む間などに、短期間泊まれます', href: routes.shortStay, id: 'short-stay', from: 2, to: 4, lane: 4, kind: 'stay' },
];
const kindLabel = { live: '住まい', home: '自宅で', stay: '泊まる' };
---
<section class="pl-sec pl-sec-tight" id="guide">
  <div class="pl-wrap">
    <h2 class="pl-h2">今の暮らしから選ぶ</h2>
    <p class="pl-sec-lead">今の状態に近い段階を探して、その下の帯をご覧ください。段階が変わっても、続けてご相談いただけます。</p>

    <div class="gj">
      <ol class="gj-road">
        {stages.map((s, i) => (
          <li class="gj-stage" style={`grid-column:${i + 2}`}>
            <span class="gj-dot pl-num-face" aria-hidden="true">{i + 1}</span>
            <strong>{s.title}</strong>
            <span>{s.note}</span>
          </li>
        ))}
      </ol>

      <ul class="gj-bars">
        {(['live', 'home', 'stay'] as const).map((k) => (
          <li class={`gj-kind gj-kind-${k}`} style={`grid-row:${k === 'live' ? '1' : k === 'home' ? '2 / span 2' : '4'}`}>{kindLabel[k]}</li>
        ))}
        {bars.map((b) => (
          <li class={`gj-bar-item gj-${b.kind}`} style={`grid-column:${b.from + 1} / ${b.to + 2}; grid-row:${b.lane}`}>
            <a class="gj-bar" href={b.href} data-pl-gtag="service_select" data-pl-service={b.id} data-pl-cta="guide_journey">
              <strong>{b.name}</strong>
              <span>{b.sub}</span>
            </a>
          </li>
        ))}
      </ul>

      <a class="gj-base" href={routes.careManagement} data-pl-gtag="service_select" data-pl-service="care-management" data-pl-cta="guide_journey">
        <svg aria-hidden="true" focusable="false"><use href="#pl-i-clipboard" /></svg>
        <span><strong>居宅介護支援</strong>　どの段階でも、ケアマネジャーが何から始めるかを一緒に考えます</span>
      </a>
    </div>
    <p class="pl-note">段階と帯の幅は目安です。要介護度などの利用条件は、各窓口でご確認ください。</p>
  </div>
</section>

<style>
  .gj { margin-block: 28px 14px; }
  .gj-road, .gj-bars {
    display: grid;
    grid-template-columns: 96px repeat(4, 1fr);
    column-gap: 12px;
  }
  /* 段階を結ぶ道。左の見出し列を除いた幅に引く */
  .gj-road { position: relative; padding-bottom: 20px; }
  .gj-road::before {
    content: ''; position: absolute; left: calc(96px + 12px + 12.5% - 30px); right: calc(12.5% - 30px); top: 21px;
    height: 4px; background: var(--green);
  }
  .gj-stage { position: relative; display: grid; justify-items: center; gap: 4px; text-align: center; line-height: 1.6; }
  .gj-dot {
    display: grid; place-items: center; width: 46px; height: 46px; margin-bottom: 6px;
    border-radius: 50%; background: var(--green); color: white; font-size: calc(20px * var(--pl-fs));
    box-shadow: 0 0 0 6px var(--bg);
  }
  .gj-stage strong { font-size: calc(18px * var(--pl-fs)); }
  .gj-stage span:last-child { font-size: calc(14px * var(--pl-fs)); color: var(--muted); }
  .gj-bars { row-gap: 10px; padding-block: 18px; border-top: 1px solid var(--line); }
  .gj-kind {
    grid-column: 1; display: flex; align-items: center; justify-content: flex-end; padding-right: 10px;
    font-weight: 700; font-size: calc(15px * var(--pl-fs)); color: var(--green-deep);
    border-right: 3px solid var(--green);
  }
  .gj-bar {
    display: flex; flex-direction: column; justify-content: center; gap: 2px; height: 100%;
    padding: 12px 18px; color: var(--ink); text-decoration: none; line-height: 1.6;
    background: var(--surface);
  }
  .gj-live .gj-bar { background: var(--mint); }
  .gj-home .gj-bar { background: var(--beige); }
  .gj-stay .gj-bar { background: #fbeaf0; }
  .gj-bar strong { font-size: calc(18px * var(--pl-fs)); }
  .gj-bar span { font-size: calc(14px * var(--pl-fs)); color: var(--muted); }
  .gj-bar:hover strong, .gj-base:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .gj-bar:focus-visible, .gj-base:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
  .gj-base {
    display: flex; align-items: center; gap: 14px; margin-left: 108px;
    padding: 16px 20px; background: var(--ink); color: white; text-decoration: none;
  }
  .gj-base svg { width: 28px; height: 28px; flex: none; }
  .gj-base strong { font-size: calc(18px * var(--pl-fs)); }
</style>
