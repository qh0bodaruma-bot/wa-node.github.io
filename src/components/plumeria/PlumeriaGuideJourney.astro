---
// サービス一覧の「選び方」（#guide）。質問に答えながらたどる分岐フロー（ボス判断 2026-11-27）。
// 動きは決定会議（AI-Company projects/プルメリア/作業中/20261127_決定会議_選び方の図の動き_評決_V01.md）の
// 案D（動きなしの図）を土台に、PCだけ「マウスを乗せた・キーボードで選んだ項目までの道筋」を目立たせる（ボス選択）。
// - 図は入れ子の箇条書き（ul/li）1つだけで作る。PCでは横に広がる分岐図、狭い幅では字下げの一覧として見せる。
//   読み上げ・文字サイズ「大」・JSなしでも同じ内容を読める。図と文章を二重に持たない（直す場所は下の tree だけ）。
// - 目立たせ方は CSS の :hover / :focus-visible だけ（JSなし）。ほかの道筋は薄くしない（組み合わせて使うサービスが
//   「使えない」と読まれるのを避けるため）。スマホは目立たせず、タップはサービスのページへの移動だけ。
// - 入口に「ここから」と、迷ったときの相談先（居宅介護支援）を置く。
// - 分かれ道の条件は「要介護1以上」（プルメリアⅡ）以外は制作者の推測で、先方に未確認（2026-11-27 時点）。
//   公開している文言は「目安」とし、確認が取れたらこのコメントを更新する。
import { routes } from '../../data/plumeria';

type Kind = 'stay' | 'home' | 'talk' | 'med';
// answer：線の上に乗せる「はい／いいえ」（色で区別）。choice：はい・いいえで言えない選び方の答えで、箱の1行目に札で出す
type YN = 'はい' | 'いいえ';
type Result = { answer?: YN; choice?: string; name: string; sub: string; href: string; id: string; kind: Kind };
type Question = { answer?: YN; choice?: string; q: string; note?: string; children: Node[] };
type Node = Result | Question;

const tree: Question = {
  q: '住まいを移って暮らしたいですか？',
  children: [
    {
      answer: 'はい',
      q: '介護が必要ですか？',
      note: '要介護1以上の認定',
      children: [
        { answer: 'いいえ', name: 'プルメリアⅠ', sub: '住まい｜自立・介護予防向け', href: routes.housingUnit('1'), id: 'housing', kind: 'stay' },
        { answer: 'はい', name: 'プルメリアⅡ', sub: '住まい｜介護対応型（要介護1以上）', href: routes.housingUnit('2'), id: 'housing', kind: 'stay' },
      ],
    },
    { choice: 'しばらくの間だけ泊まりたい', name: 'ショートステイ', sub: 'プルメリアⅢ｜ご家族が休む間などに', href: routes.shortStay, id: 'short-stay', kind: 'stay' },
    {
      answer: 'いいえ',
      choice: '自宅で暮らしたい',
      q: '看護師による体調の確認や処置が必要ですか？',
      children: [
        { answer: 'はい', name: '訪問看護', sub: '看護師がご自宅で体調を確認', href: routes.homeNursing, id: 'home-nursing', kind: 'med' },
        {
          answer: 'いいえ',
          q: 'どんな手助けがほしいですか？',
          children: [
            { choice: '入浴・食事・家事の手伝い', name: '訪問介護', sub: 'ヘルパーがご自宅で手伝います', href: routes.homeCare, id: 'home-care', kind: 'home' },
            { choice: '歩行器・介護ベッドなどの道具', name: '福祉用具', sub: '選び方と借り方のご相談', href: routes.welfareEquipment, id: 'welfare-equipment', kind: 'home' },
          ],
        },
      ],
    },
  ],
};

const isResult = (n: Node): n is Result => 'href' in n;
---
<section class="pl-sec pl-sec-tight gf-sec" id="guide">
  <div class="pl-wrap">
    <h2 class="pl-h2">生活スタイルから選ぶ</h2>

    <div class="gf">
      <a class="gf-consult gj-talk" href={routes.careManagement} data-pl-gtag="service_select" data-pl-service="care-management" data-pl-cta="guide_journey">
        <span class="gf-consult-lead">分からないとき・迷ったときは</span>
        <strong>居宅介護支援</strong>
        <span>ケアマネジャーが、何から始めるかを一緒に考えます</span>
      </a>

      <div class="gf-scroll">
        <p class="gf-here" aria-hidden="true">ここから</p>
        <ul class="gf-tree">
          {(() => {
            // 入れ子の箇条書きを再帰で組み立てる。結果はサービスへのリンク、質問はその下に答えごとの枝を持つ
            const render = (n: Node, depth: number): any => (
              <li class={`gf-node${n.answer === 'はい' ? ' gf-yes' : n.answer === 'いいえ' ? ' gf-no' : ''}`}>
                {n.answer && <span class="gf-yn">{n.answer}</span>}
                {isResult(n) ? (
                  <a class={`gf-box gf-res gj-${n.kind}`} href={n.href} data-pl-gtag="service_select" data-pl-service={n.id} data-pl-cta="guide_journey">
                    {n.choice && <span class="gf-ans">{n.choice}</span>}
                    <strong>{n.name}</strong>
                    <span class="gf-sub">{n.sub}</span>
                  </a>
                ) : (
                  <div class={`gf-box gf-q${depth === 0 ? ' gf-q-root' : ''}`}>
                    {n.choice && <span class="gf-ans">{n.choice}</span>}
                    <strong>{n.q}</strong>
                    {n.note && <span class="gf-sub">{n.note}</span>}
                  </div>
                )}
                {!isResult(n) && (
                  <ul class="gf-kids">
                    {n.children.map((c) => render(c, depth + 1))}
                  </ul>
                )}
              </li>
            );
            return render(tree, 0);
          })()}
        </ul>
      </div>
    </div>
    <p class="pl-note">分かれ道は目安です。サービスは組み合わせて使えます（例：訪問介護＋福祉用具＋訪問看護）。要介護度などの利用条件は、各窓口でご確認ください。</p>
  </div>
</section>

<style>
  .gf-sec { background: var(--surface); }
  .gf { margin-block: 28px 14px; display: grid; gap: 18px; }

  /* 分類の色（以前の図と同じ。プルメリアのブランドの黄・ピンク・ターコイズ・緑）。
     結果の箱は各色の淡い地＋下の色の帯。文字は --ink / --muted */
  .gj-stay { --kind: #f2b437; --kind-tint: #fdf3df; }
  .gj-home { --kind: #cc3f70; --kind-tint: #fbe9ef; }
  .gj-talk { --kind: #11809e; --kind-tint: #e2f2f6; }
  .gj-med  { --kind: #2b7a4b; --kind-tint: #e6f3ea; }

  /* 迷ったときの相談先。点線の枠で「どこからでも戻れる先」を表す */
  .gf-consult {
    position: relative; justify-self: start; display: grid; gap: 2px; max-width: 100%;
    padding: 12px 18px; border: 2px dashed var(--kind); box-shadow: var(--gf-glass);
    background: linear-gradient(170deg, color-mix(in srgb, var(--kind-tint) 40%, white) 0%, color-mix(in srgb, var(--kind-tint) 75%, white) 100%);
    color: var(--ink); text-decoration: none; line-height: 1.6;
  }
  .gf-consult-lead { font-size: calc(14px * var(--pl-fs)); font-weight: 700; color: var(--green-deep); }
  .gf-consult strong { font-size: calc(18px * var(--pl-fs)); }
  .gf-consult > span:last-child { font-size: calc(14px * var(--pl-fs)); color: var(--muted); }
  .gf-consult:hover strong { text-decoration: underline; text-underline-offset: 4px; }

  .gf-here {
    display: inline-block; margin-bottom: 8px; padding: 2px 12px;
    background: var(--green-deep); color: #fff; font-size: calc(14px * var(--pl-fs)); font-weight: 700; line-height: 1.7;
  }

  /* 箱：質問は白地＋線、結果は色の淡い地。はい・いいえで言えない答え（choice）は箱の1行目に小さな札で出す */
  .gf-box {
    position: relative; display: grid; gap: 2px; align-content: center;
    padding: 10px 14px; border: 1.5px solid var(--line); background: var(--surface);
    color: var(--ink); text-decoration: none; line-height: 1.55;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .gf-box strong { font-size: calc(16px * var(--pl-fs)); text-wrap: balance; }
  /* 入口の質問は「住まいを移って／暮らしたいですか？」の2行に収まる大きさにする（18pxだと「か？」だけが3行目に落ちた） */
  .gf-q-root strong { font-size: calc(17px * var(--pl-fs)); }
  .gf-q { border-color: color-mix(in srgb, var(--ink) 45%, transparent); }
  .gf-sub { font-size: calc(13px * var(--pl-fs)); color: var(--muted); }
  .gf-res {
    /* 地の色は分類の淡い色をさらに白に寄せ、上ほど明るいグラデーションにする（ボス指示 2026-11-27：透明感を高める） */
    background: linear-gradient(170deg,
      color-mix(in srgb, var(--kind-tint) 40%, white) 0%,
      color-mix(in srgb, var(--kind-tint) 75%, white) 100%);
    border-color: color-mix(in srgb, var(--kind) 28%, transparent);
    box-shadow: inset 0 -4px 0 var(--kind), var(--gf-glass);
  }

  /* ── カードのガラス感（ヘッダーのリキッドグラスと同じ作り：縁の光・内側の照り返し・表面の照り）──
     白地のセクションの上なので、背面を透かす backdrop-filter は使わない（透けて見えるものがないため）。
     光はすべて文字の下（z-index: -1）に置き、文字の読みやすさは地の色だけで決まるようにする */
  .gf-box, .gf-consult {
    isolation: isolate;
    --gf-glass:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 14px rgba(255, 255, 255, 0.6),
      0 6px 18px rgba(8, 60, 74, 0.08);
  }
  /* 質問の箱の影（結果の箱は .gf-res で色の帯と合わせて指定済み。.gf-box に書くと後勝ちで色の帯が消えるため分ける） */
  .gf-q { box-shadow: var(--gf-glass); }
  .gf-q { background: linear-gradient(170deg, #ffffff 0%, color-mix(in srgb, var(--mint) 35%, white) 100%); }
  /* 縁の光：左上と右下が明るい 1.5px の輪郭 */
  .gf-box::before, .gf-consult::before {
    content: ''; position: absolute; inset: 0; z-index: -1; padding: 1.5px; pointer-events: none;
    background: linear-gradient(135deg,
      rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.25) 30%,
      rgba(255, 255, 255, 0.10) 60%, rgba(255, 255, 255, 0.75) 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }
  /* 表面の照り：上の方に淡い光と、左寄りの斜めの細い光 */
  .gf-box::after, .gf-consult::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(115deg, transparent 14%, rgba(255, 255, 255, 0.45) 19%, transparent 25%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0, rgba(255, 255, 255, 0.12) 42%, rgba(255, 255, 255, 0) 55%);
  }
  .gf-res strong { font-size: calc(18px * var(--pl-fs)); }
  .gf-res:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .gf-ans {
    justify-self: start; margin-bottom: 2px; padding: 0 8px;
    background: var(--mint); color: var(--green-deep); font-size: calc(13px * var(--pl-fs)); font-weight: 700; line-height: 1.7;
  }
  .gf :is(a):focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

  /* ── 線と「はい／いいえ」（ボス指示 2026-11-27：区別しやすく、線を太く、線の上に色と文字を乗せる）──
     線の太さは --gf-w（18px。ボス指示で 6px の3倍）。線の色はすべて同じ灰色にそろえる（ボス指示）。
     はい・いいえの区別は札（.gf-yn）の色で示す：はいはターコイズ、いいえは焼けたオレンジ。
     札は子への横の線の真ん中に乗せる。色だけに頼らず、必ず「はい」「いいえ」の文字を出す。
     白い文字との比：はい #137792 は 5.2:1、いいえ #b3541b は約 5.0:1（計算値）。
     線の組み立て（各子 li に対して）：
       ::before ＝ 背骨から自分への横の線。
       ::after  ＝ 自分の高さから次の子の高さまでの縦線（最後の子以外）。
       縦線を「次の子の高さまで」1本で引くと、目立たせるときに途中の兄弟の中で線の色が切れない。
     --gf-s は背骨から箱までの横の線の長さ、--gf-y は箱の上から線の中心までの高さ、--gf-gap は兄弟の間 */
  .gf {
    --gf-w: 18px;
    --gf-yes: #137792;
    --gf-no: #b3541b;
    /* 線の色は不透明にする（半透明だと、線の重なる角だけ色が濃くなるため） */
    --gf-line: color-mix(in srgb, var(--ink) 32%, white);
    --gf-on: var(--green-deep);
    --gf-s: 66px; --gf-y: 26px; --gf-gap: 10px;
    /* 線の終点の矢印：長さ --gf-a、高さ --gf-ah（線の太さより上下に 8px ずつ大きい） */
    --gf-a: 14px; --gf-ah: calc(var(--gf-w) + 16px);
  }
  .gf-node { --gf-c: var(--gf-line); }
  .gf-yes { --gf-c: var(--gf-yes); }
  .gf-no { --gf-c: var(--gf-no); }
  .gf-yn {
    /* 狭い幅：札の左端を背骨の左端にそろえ、背骨から横の線への曲がり角に乗せる（字下げを浅く保つため）。
       矢印にかからないよう、--gf-s を 66px にし、札の左右の余白を 6px に詰めている（広い幅では 8px） */
    position: absolute; z-index: 1; left: calc(-1 * var(--gf-s) - var(--gf-w) / 2); top: var(--gf-y); transform: translateY(-50%);
    padding: 0 6px; border-radius: 4px; background: var(--gf-c); color: #fff;
    font-size: calc(13px * var(--pl-fs)); font-weight: 700; line-height: 1.6; white-space: nowrap;
    box-shadow: 0 0 0 2px var(--surface);  /* 線との境目を白で縁取り、札を線から浮かせる */
  }

  /* 線はすべて「色を塗った帯」（background）で描く。枠線（border）で描くと、画面の拡大率によって太さが端数で丸められ
     （例：6px が 125% 表示で 5.6px）、上端そろえの線と下端そろえの線で 1px の段差が出たため（ボス指摘 2026-11-27）。
     帯は上端・高さ・幅をそのまま指定するので、どの線も --gf-y を中心に同じ位置に描かれる。 */

  /* ── 狭い幅（1199px以下）：字下げの一覧。左の背骨から各箱へ横の線を出し、その上に札を乗せる ── */
  .gf-tree, .gf-kids { display: grid; gap: var(--gf-gap); }
  /* 左の余白は背骨の太さの半分（背骨が枠の外にはみ出さず、字下げをなるべく浅くするため） */
  .gf-kids { position: relative; margin: 10px 0 0 calc(var(--gf-w) / 2); padding-left: var(--gf-s); }
  .gf-kids > .gf-node { position: relative; }
  .gf-kids > .gf-node::before, .gf-kids > .gf-node::after, .gf-kids::before { content: ''; position: absolute; pointer-events: none; }
  /* 背骨から自分への横の線。終点（箱の手前）は矢印にする（ボス指示 2026-11-27：線の流れが分かるように）。
     帯の高さを矢印の高さにし、clip-path で「太さ --gf-w の線＋先端の三角」の形に切り抜く */
  .gf-kids > .gf-node::before {
    left: calc(-1 * var(--gf-s) - var(--gf-w) / 2); width: calc(var(--gf-s) + var(--gf-w) / 2);
    top: calc(var(--gf-y) - var(--gf-ah) / 2); height: var(--gf-ah);
    background: var(--gf-line);
    clip-path: polygon(
      0 calc(50% - var(--gf-w) / 2), calc(100% - var(--gf-a)) calc(50% - var(--gf-w) / 2),
      calc(100% - var(--gf-a)) 0, 100% 50%, calc(100% - var(--gf-a)) 100%,
      calc(100% - var(--gf-a)) calc(50% + var(--gf-w) / 2), 0 calc(50% + var(--gf-w) / 2));
  }
  /* 自分の高さから次の子の高さまでの縦線 */
  .gf-kids > .gf-node:not(:last-child)::after {
    left: calc(-1 * var(--gf-s) - var(--gf-w) / 2); width: var(--gf-w);
    top: calc(var(--gf-y) - var(--gf-w) / 2); bottom: calc(-1 * (var(--gf-gap) + var(--gf-y)) - var(--gf-w) / 2);
    background: var(--gf-line);
  }
  /* 親の箱の下から最初の子の高さまでの縦線（狭い幅だけ） */
  @media (max-width: 1199px) {
    .gf-kids::before {
      left: calc(var(--gf-w) / -2); width: var(--gf-w);
      top: -10px; height: calc(10px + var(--gf-y) + var(--gf-w) / 2);
      background: var(--gf-line);
    }
  }

  /* ── 広い幅：左から右へ広がる分岐図 ──
     4段の箱（最大200px）と線（親から背骨まで18px＋背骨から箱まで90px）で、全体は約1125px になる。
     これが横に収まる 1200px 以上だけ図にする */
  @media (min-width: 1200px) {
    .gf-consult { justify-self: end; margin-bottom: -6px; }
    /* 箱は上そろえにする（中央そろえだと入口の質問が図の縦の中ほどに沈み、「ここから」から離れるため）。
       線は箱の上から --gf-y の高さでつなぐ */
    .gf { --gf-s: 90px; --gf-y: 30px; --gf-gap: 14px; }
    /* 広い幅：札は横の線のうち、背骨の右端から矢印の手前までの真ん中に置く */
    .gf-yn { left: calc((var(--gf-s) - var(--gf-w) / 2 + var(--gf-a)) / -2); transform: translate(-50%, -50%); padding: 0 8px; }
    .gf-node { display: flex; align-items: flex-start; }
    /* 箱の幅は文字の倍率に合わせて広げるが、200px で止める（図に切り替わる幅 1200px・文字サイズ「大」でも横に収めるため） */
    .gf-box { flex: none; width: min(calc(196px * var(--pl-fs)), 200px); }
    .gf-tree, .gf-kids { display: flex; flex-direction: column; gap: var(--gf-gap); }
    .gf-kids { margin: 0; padding-left: calc(18px + var(--gf-s)); }
    /* 親の箱から背骨までの横の線。背骨の中心（左から18px）を越えて、背骨の右端まで塗る */
    .gf-kids::before {
      left: 0; width: calc(18px + var(--gf-w) / 2);
      top: calc(var(--gf-y) - var(--gf-w) / 2); height: var(--gf-w);
      background: var(--gf-line);
    }

    /* 道筋を目立たせる（PCのみ）。:hover は、乗せた項目を含む枝（入口からそこまで）のすべての li に掛かる。
       その枝の箱を濃い枠で囲み、入口からそこまでの線を濃い色にする（太さは変えない）。
       縦の線は、乗せた子より上の兄弟の「次の子までの縦線」だけ。ほかの道筋は薄くしない */
    @media (hover: hover) and (pointer: fine) {
      .gf-node:hover > .gf-box { border-color: var(--gf-on); box-shadow: var(--gf-glass), 0 0 0 2px var(--gf-on); }
      .gf-node:hover > .gf-res { box-shadow: inset 0 -4px 0 var(--kind), var(--gf-glass), 0 0 0 2px var(--gf-on); }
      .gf-node:hover > .gf-kids:has(> .gf-node:hover)::before,
      .gf-kids > .gf-node:hover::before,
      .gf-kids > .gf-node:has(~ .gf-node:hover)::after { background: var(--gf-on); }
    }
    /* キーボードで選んだときも同じ道筋を目立たせる（マウスのない環境でも同じ情報を得られるように） */
    .gf-node:has(:focus-visible) > .gf-box { border-color: var(--gf-on); box-shadow: var(--gf-glass), 0 0 0 2px var(--gf-on); }
    .gf-node:has(:focus-visible) > .gf-res { box-shadow: inset 0 -4px 0 var(--kind), var(--gf-glass), 0 0 0 2px var(--gf-on); }
    .gf-node:has(:focus-visible) > .gf-kids::before,
    .gf-kids > .gf-node:has(:focus-visible)::before,
    .gf-kids > .gf-node:has(~ .gf-node :focus-visible)::after { background: var(--gf-on); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gf-box { transition: none; }
  }
</style>
