---
import PlumeriaLayout from '../../layouts/PlumeriaLayout.astro';
import { routes, genericFaqs, type PlumeriaFaq } from '../../data/plumeria';

interface Props {
  title: string;
  description: string;
  currentPath: string;
  breadcrumbLabel: string;
  heroTitle: string;
  heroLead: string;
  heroImg: string;
  heroAlt: string;
  fitFor: string[];
  content: { label: string; body: string }[];
  targetInfo: { label: string; body: string }[];
  costInfo: string;
  costDetails?: { label: string; value: string }[];
  flowSteps: { title: string; body: string }[];
  faqs?: PlumeriaFaq[];
  contactCategory: string;
}

const {
  title, description, currentPath, breadcrumbLabel,
  heroTitle, heroLead, heroImg, heroAlt, fitFor, content, targetInfo, costInfo, flowSteps,
  faqs = genericFaqs, contactCategory, costDetails = [],
} = Astro.props;

const contactHref = `${routes.contact}?service=${encodeURIComponent(contactCategory)}`;
// カードの列数は件数から決める。auto-fit は最大幅が固定値だと列数を少なく見積もるため使わない。
const cols = (n: number) => `pl-auto-grid pl-auto-grid-${Math.min(Math.max(n, 1), 4)}`;
---
<PlumeriaLayout title={title} description={description} currentPath={currentPath}>
  <div class="pl-wrap" style="padding-top:28px">
    <p class="pl-breadcrumb">
      <a href={routes.top}>トップ</a>
      <span aria-hidden="true">/</span>
      <span>{breadcrumbLabel}</span>
    </p>
  </div>

  <section class="pl-sec pl-sec-tight">
    <div class="pl-wrap">
      <h1 class="pl-h1" style="font-size:clamp(1.7rem,4vw,2.4rem)">{heroTitle}</h1>
      <p class="pl-sec-lead">{heroLead}</p>
      <nav class="pl-page-nav" aria-label="このページの内容">
        <a href="#support">できること</a><a href="#conditions">対象・費用</a><a href="#flow">利用の流れ</a><a href="#questions">よくある質問</a>
      </nav>
      <img class="pl-page-photo" src={heroImg} alt={heroAlt} width="1200" height="675" loading="eager" decoding="async" />
      <p class="pl-photo-note">※ 掲載写真はイメージ写真です。実際の施設・スタッフではありません。</p>
    </div>
  </section>

  <section class="pl-sec" id="support">
    <div class="pl-wrap">
      <h2 class="pl-h2">こんなときにご相談ください</h2>
      <ul class={cols(fitFor.length)}>
        {fitFor.map((f) => <li class="pl-fit-item">{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige">
    <div class="pl-wrap">
      <h2 class="pl-h2">提供内容</h2>
      <div class="pl-grid-3">
        {content.map((c) => (
          <div class="pl-card">
            <h3 class="pl-h3">{c.label}</h3>
            <p class="pl-body">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pl-sec" id="conditions">
    <div class="pl-wrap">
      <h2 class="pl-h2">対象・利用条件</h2>
      <dl class={cols(targetInfo.length)}>
        {targetInfo.map((t) => (
          <div class="pl-target-card"><dt>{t.label}</dt><dd>{t.body}</dd></div>
        ))}
      </dl>
      <div class="pl-cost-summary">
        <h3 class="pl-h3">費用の目安</h3>
        <p class="pl-body">{costInfo}</p>
        {costDetails.length > 0 && (
          <dl class="pl-cost-list">
            {costDetails.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
          </dl>
        )}
      </div>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" id="flow">
    <div class="pl-wrap">
      <h2 class="pl-h2">利用までの流れ</h2>
      <ol class={cols(flowSteps.length)}>
        {flowSteps.map((step, i) => (
          <li class="pl-flow-card">
            <span class="pl-num-face pl-flow-num" aria-hidden="true">{i + 1}</span>
            <h3 class="pl-flow-title">{step.title}</h3>
            <p class="pl-flow-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="pl-sec" id="questions">
    <div class="pl-wrap">
      <h2 class="pl-h2">よくあるご質問</h2>
      <div class="pl-faq-list">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="pl-sec" style="text-align:center">
    <div class="pl-wrap">
      <h2 class="pl-h2" style="justify-content:center">ご利用を検討されている方へ</h2>
      <div class="pl-btn-row" style="justify-content:center">
        <a class="pl-btn pl-btn-main" href={contactHref}>{breadcrumbLabel}について相談する</a>
      </div>
    </div>
  </section>
</PlumeriaLayout>
