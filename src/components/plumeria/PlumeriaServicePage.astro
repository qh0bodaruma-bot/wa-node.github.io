---
import PlumeriaLayout from '../../layouts/PlumeriaLayout.astro';
import PlumeriaVacancyStatus from './PlumeriaVacancyStatus.astro';
import { routes, genericFaqs, type PlumeriaFaq } from '../../data/plumeria';

interface Props {
  title: string;
  description: string;
  currentPath: string;
  breadcrumbLabel: string;
  heroTitle: string;
  heroLead: string;
  heroImg: string;
  heroAlt: string;
  fitFor: string[];
  content: { label: string; body: string }[];
  targetInfo: { label: string; body: string }[];
  /** 空室状況を表示する施設（管理画面の施設ID）。指定したときだけ対象・利用条件に空室状況を加える */
  vacancyFacilityId?: string;
  costInfo: string;
  costDetails?: { label: string; value: string }[];
  flowSteps: { title: string; body: string }[];
  /** 利用の流れの下に置く補足（申し込み時期・持ち物など） */
  flowNotes?: string[];
  faqs?: PlumeriaFaq[];
  contactCategory: string;
  /** 各セクションの見出し。ページごとに、そのページの内容から言い切りの文で指定する。省略時は汎用の見出し */
  supportHeading?: string;
  conditionsHeading?: string;
  flowHeading?: string;
}

const {
  title, description, currentPath, breadcrumbLabel,
  heroTitle, heroLead, heroImg, heroAlt, fitFor, content, targetInfo, vacancyFacilityId, costInfo, flowSteps,
  faqs = genericFaqs, contactCategory, costDetails = [], flowNotes = [],
  supportHeading = '提供内容', conditionsHeading = '対象・利用条件', flowHeading = '利用までの流れ',
} = Astro.props;

const contactAnchor = contactCategory === 'housing' ? 'housing-desk' : contactCategory === 'short-stay' ? 'short-stay-desk' : contactCategory === 'welfare-equipment' ? 'welfare-equipment-desk' : 'home-service-desk';
const contactHref = `${routes.contact}?service=${encodeURIComponent(contactCategory)}#${contactAnchor}`;
// カードの列数は件数から決める。auto-fit は最大幅が固定値だと列数を少なく見積もるため使わない。
const cols = (n: number) => `pl-auto-grid pl-auto-grid-${Math.min(Math.max(n, 1), 4)}`;
// 手順は4つまでは横一列、5つ以上は縦に積む（5列にすると各手順の文が窮屈になるため）
const flowClass = flowSteps.length <= 4 ? `pl-hs-flow pl-hs-flow-${flowSteps.length}` : 'pl-hs-flow pl-hs-flow-stack';
---
<PlumeriaLayout title={title} description={description} currentPath={currentPath}>
  <div class="pl-wrap" style="padding-top:28px">
    <p class="pl-breadcrumb">
      <a href={routes.top}>トップ</a>
      <span aria-hidden="true">/</span>
      <span>{breadcrumbLabel}</span>
    </p>
  </div>

  <section class="pl-sec pl-sec-tight">
    <div class="pl-wrap">
      <h1 class="pl-h1" style="font-size:calc(clamp(1.7rem,4vw,2.4rem) * var(--pl-fs))">{heroTitle}</h1>
      <p class="pl-sec-lead">{heroLead}</p>
      <nav class="pl-hs-jump" aria-label="このページの内容">
        <a href="#fit">こんなときに</a><a href="#support">できること</a><a href="#conditions">対象・費用</a><a href="#flow">利用の流れ</a><a href="#questions">よくある質問</a>
      </nav>
      <img class="pl-page-photo" src={heroImg} alt={heroAlt} width="1200" height="675" loading="eager" decoding="async" />
      <p class="pl-photo-note">※ 掲載写真はイメージ写真です。実際の施設・スタッフではありません。</p>
    </div>
  </section>

  <section class="pl-sec" id="fit">
    <div class="pl-wrap">
      <h2 class="pl-h2">こんなときにご相談ください</h2>
      <ul class={cols(fitFor.length)}>
        {fitFor.map((f) => <li class="pl-fit-item">{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" id="support">
    <div class="pl-wrap">
      <h2 class="pl-h2">{supportHeading}</h2>
      <div class={content.length === 3 ? 'pl-hs-lines pl-hs-lines-3' : 'pl-hs-lines pl-hs-lines-2'}>
        {content.map((c) => (
          <div class="pl-hs-line">
            <h3 class="pl-hs-line-name">{c.label}</h3>
            <p class="pl-hs-line-body">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pl-sec" id="conditions">
    <div class="pl-wrap">
      <h2 class="pl-h2">{conditionsHeading}</h2>
      <div class="pl-hs-spec">
        <dl class="pl-hs-facts">
          {vacancyFacilityId && <div><dt>空室状況</dt><dd><PlumeriaVacancyStatus facilityId={vacancyFacilityId} /></dd></div>}
          {targetInfo.map((t) => (
            <div><dt>{t.label}</dt><dd>{t.body}</dd></div>
          ))}
        </dl>
      </div>
      <div class="pl-hs-cost">
        <h3 class="pl-hs-line-name">費用の目安</h3>
        <p class="pl-hs-cost-body">{costInfo}</p>
        {costDetails.length > 0 && (
          <div class="pl-hs-lines pl-hs-lines-2 pl-hs-lines-value">
            {costDetails.map((item) => (
              <div class="pl-hs-line">
                <h4 class="pl-hs-line-name">{item.label}</h4>
                <p class="pl-hs-line-body">{item.value}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  {/* サービス固有の追加セクション（施設紹介・受け入れ条件など）。指定がなければ何も出ない */}
  <slot name="extra" />

  <section class="pl-sec pl-sec-beige" id="flow">
    <div class="pl-wrap">
      <h2 class="pl-h2">{flowHeading}</h2>
      <ol class={flowClass}>
        {flowSteps.map((step, i) => (
          <li class="pl-hs-stage">
            <ol class="pl-hs-steps" style={`--from:${i}`}><li>{step.title}</li></ol>
            <p class="pl-hs-stage-body">{step.body}</p>
          </li>
        ))}
      </ol>
      {flowNotes.length > 0 && (
        <ul class="pl-note pl-check-list" style="margin-top:14px">
          {flowNotes.map((note) => <li>{note}</li>)}
        </ul>
      )}
    </div>
  </section>

  <section class="pl-sec" id="questions">
    <div class="pl-wrap">
      <h2 class="pl-h2">よくあるご質問</h2>
      <div class="pl-faq-list">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="pl-sec pl-sec-beige" style="text-align:center">
    <div class="pl-wrap">
      <h2 class="pl-h2" style="justify-content:center">ご利用を検討されている方へ</h2>
      <div class="pl-btn-row" style="justify-content:center">
        <a class="pl-btn pl-btn-main" href={contactHref} data-pl-gtag="contact_click" data-pl-service={contactCategory} data-pl-cta="page_cta">{breadcrumbLabel}の相談窓口を確認する</a>
      </div>
    </div>
  </section>
</PlumeriaLayout>
