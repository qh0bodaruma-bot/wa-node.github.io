---
import MaterialIcon from './MaterialIcon.astro';
import { workCatalog, mainWorkCategories } from '../data/workCatalog';
import { localizedPath, servicePrices, startingPrice, serviceLabels, type SiteLanguage } from '../data/services';
import '../styles/service-pages.css';
interface Props { lang?: SiteLanguage; scope?: 'main' | 'other' }
const {lang='ja', scope='main'} = Astro.props;
const href = (path: string) => path.endsWith('.html') ? path : localizedPath(path,lang);
const labels = serviceLabels[lang];
const c = {
 ja:{title:'制作例・デモ',lead:'LINEの問い合わせを業務システムへ自動登録する流れを、連携先ごとに操作して確かめられます。',note:'自主制作のデモです。お客様の導入成果を示すものではありません。',otherTitle:'その他の制作',otherLead:'LINE連携のほかに制作したWeb・LP、診断ツール、出版物などをまとめています。',otherNote:'自主制作デモ・架空企業のサンプルと、公開済みの出版物です。お客様の導入成果を示すものではありません。',otherLink:'Web・LP、診断ツール、出版などの制作例は「その他の制作」にまとめています。',otherOpen:'その他の制作を見る',backMain:'LINE連携の制作例に戻る',all:'すべて',line:'LINE連携',app:'アプリ',web:'Web・LP',system:'AI・業務システム',tool:'診断・ツール',kdp:'KDP出版',featured:'連携先ごとのデモ',others:'ほかの制作例',open:'開いて試す',view:'詳しく見る',sample:'自主制作デモ・サンプル',published:'出版実績',price:'関連する制作の開始価格',count:'件',filter:'制作例を絞り込む',finalTitle:'近いサンプルをもとにご相談いただけます',finalDesc:'「この画面のようなものを」とお伝えいただくと、必要な範囲から相談できます。'},
 en:{title:'See it. Try it. Picture your project.',lead:'Try how LINE inquiries are registered automatically in your business system, one demo per integration target.',note:'These are independently built demos, not client deployments or measured outcomes. Some demo screens are in Japanese.',otherTitle:'Other projects',otherLead:'Websites, landing pages, self-check tools and publications created besides LINE integration.',otherNote:'This collection includes independent demos, fictional business samples and published books. It does not represent measured client outcomes. Some demo screens are in Japanese.',otherLink:'Websites, self-check tools and publications are collected on a separate page.',otherOpen:'View other projects',backMain:'Back to LINE integration demos',all:'All',line:'LINE',app:'Apps',web:'Web & LP',system:'AI & business tools',tool:'Self-check tools',kdp:'KDP books',featured:'Demos by integration target',others:'More projects',open:'Open the demo',view:'View details',sample:'Independent demo / sample',published:'Published work',price:'Related service starts at',count:'projects',filter:'Filter projects',finalTitle:'Found a useful reference?',finalDesc:'Tell us which sample is close to your idea, and we can discuss the scope you need.'},
 fr:{title:'Voir, essayer et imaginer votre projet.',lead:'Essayez l’enregistrement automatique des demandes LINE dans votre outil métier, avec une démo par système connecté.',note:'Ce sont des démonstrations indépendantes, sans résultats clients revendiqués. Certains écrans sont en japonais.',otherTitle:'Autres créations',otherLead:'Sites, pages de vente, outils d’auto-évaluation et publications réalisés en dehors de l’intégration LINE.',otherNote:'Cette collection présente des démos indépendantes, des entreprises fictives et des livres publiés. Elle ne revendique pas de résultats clients mesurés. Certains écrans de démonstration sont en japonais.',otherLink:'Sites, outils d’auto-évaluation et publications sont regroupés sur une page séparée.',otherOpen:'Voir les autres créations',backMain:'Retour aux démos d’intégration LINE',all:'Tout',line:'LINE',app:'Applications',web:'Web & pages de vente',system:'IA & outils métier',tool:'Auto-évaluations',kdp:'Livres KDP',featured:'Une démo par système connecté',others:'Autres créations',open:'Ouvrir la démo',view:'Voir les détails',sample:'Démo / exemple indépendant',published:'Publication',price:'Prestation associée à partir de',count:'créations',filter:'Filtrer les créations',finalTitle:'Un exemple proche de votre idée ?',finalDesc:'Indiquez le modèle qui vous intéresse pour préciser le périmètre nécessaire.'},
}[lang];
const isMain = scope==='main';
const items = workCatalog.filter(work=>mainWorkCategories.includes(work.category)===isMain);
const categories = isMain ? ['all','line','app'] as const : ['all','web','system','tool','kdp'] as const;
const icons = {line:'forum',app:'smartphone',web:'web',system:'account_tree',tool:'tune',kdp:'menu_book'};
// 代表の3件。並び順が変わっても崩れないようIDで指定する。その他の制作ページには代表枠を置かない
const featuredIds = isMain ? ['work-01','work-02','work-03'] : [];
const featured = featuredIds.map(id=>workCatalog.find(work=>work.id===id)!);
const usecaseIds = isMain ? ['work-22', 'work-23', 'work-24'] : [];
// 連携先別デモのサムネイルは画面キャプチャを使わず、同じ図（公式アイコン → 連携先名）にそろえる
const lineVendors: Record<string, { name: string; color: string }> = {
  'work-01': { name: 'kintone', color: '#0f4c81' },
  'work-02': { name: 'Salesforce', color: '#0176a3' },
  'work-03': { name: 'HubSpot', color: '#c4502f' },
  'work-04': { name: 'Googleスプレッドシート', color: '#0b8043' },
};
const usecases = usecaseIds.map(id => workCatalog.find(work => work.id === id)!);
const usecaseTitle = { ja: '業務ごとのデモ', en: 'Demos by business workflow', fr: 'Démos par usage métier' }[lang];
---
<main id="main" class="service-page works-refresh" data-glossary-skip data-reveal="off" data-works-page>
 <section class="works-heading"><div class="s-shell"><h1>{isMain?c.title:c.otherTitle}</h1><p class="s-intro">{isMain?c.lead:c.otherLead}</p><p class="s-note">{isMain?c.note:c.otherNote}</p>
  <div class="works-filters" role="group" aria-label={c.filter}>{categories.map(category=><button type="button" class:list={{active:category==='all'}} data-filter={category} aria-pressed={category==='all'}>{c[category]}<span>{category==='all'?items.length:items.filter(work=>work.category===category).length}</span></button>)}</div>
  <p class="works-count" aria-live="polite" data-result-count data-unit={c.count}>{items.length} {c.count}</p>
 </div></section>
 {isMain&&<section class="featured-section" data-featured-section><div class="s-shell"><div class="s-section-head" data-motion-enter="heading" data-motion-id="works-featured-heading"><h2>{c.featured}</h2></div><div class="s-grid featured-grid">{featured.map((work,i)=><a class="featured-work" href={href(work.href)}>
  <div class:list={['featured-visual',`feature-${work.category}`]}>{lineVendors[work.id]?<div class="sample-integration" aria-hidden="true"><span class="si-line"><img src="/images/brand/line/LINE_Brand_icon.png" alt="" width="40" height="40"/></span><MaterialIcon name="east"/><span class="si-vendor" style={`--vendor:${lineVendors[work.id].color}`}>{lineVendors[work.id].name}</span><small>01 → 02 → 03</small></div>:work.image?<img src={work.image} alt="" width="720" height="480" loading="lazy" decoding="async"/>:<div class="sample-apps" aria-hidden="true"><div><MaterialIcon name="pets"/><span>Pet Health Note</span></div><div><b>Flow</b><MaterialIcon name="bar_chart"/></div></div>}</div>
  <div class="featured-caption"><span class="s-number">{c[work.category]}</span><h3>{work.title[lang]}</h3><p>{work.description[lang]}</p><span class="work-open">{c.open}<MaterialIcon name="north_east"/></span></div>
 </a>)}</div></div></section>}
 {isMain&&<section class="s-section works-usecases" data-usecase-section><div class="s-shell"><h2>{usecaseTitle}</h2><div class="usecase-list">{usecases.map((work, i)=><article class="work-entry" data-category={work.category} data-featured="false">
  <a class="usecase-entry" href={href(work.href)}><span class="usecase-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><span class="entry-kind">{c.sample}</span><h3>{work.title[lang]}</h3><p>{work.description[lang]}</p><span class="work-open">{c.open}<MaterialIcon name="north_east"/></span></div></a>
 </article>)}</div></div></section>}
 <section class="s-section works-collection"><div class="s-shell"><h2 data-collection-title data-default-title={isMain?c.others:c.otherTitle}>{isMain?c.others:c.otherTitle}</h2><div class="s-grid works-grid">{items.filter(work=>!usecaseIds.includes(work.id)).map(work=><article class="work-entry" data-category={work.category} data-featured={String(featuredIds.includes(work.id))} hidden={featuredIds.includes(work.id)}>
  <a class="entry-main" href={href(work.href)}><div class="entry-image">{lineVendors[work.id]?<div class="sample-integration is-small" aria-hidden="true"><span class="si-line"><img src="/images/brand/line/LINE_Brand_icon.png" alt="" width="40" height="40"/></span><MaterialIcon name="east"/><span class="si-vendor" style={`--vendor:${lineVendors[work.id].color}`}>{lineVendors[work.id].name}</span></div>:work.image?<img src={work.image} alt="" width="640" height="400" loading="lazy" decoding="async"/>:<div class="entry-type" aria-hidden="true"><MaterialIcon name={icons[work.category]}/><span>{c[work.category]}</span></div>}</div><div class="entry-copy"><span class="entry-kind">{work.category==='kdp'?c.published:c.sample}</span><h3>{work.title[lang]}</h3><p>{work.description[lang]}</p><span class="work-open">{work.category==='kdp'?c.view:c.open}<MaterialIcon name="north_east"/></span></div></a>
  {work.priceKey&&(isMain?<a class="entry-price" href={href(`/pricing/#${work.category}`)}><span>{c.price}</span><strong>{startingPrice(servicePrices[work.priceKey],lang)}</strong></a>:<div class="entry-price"><span>{c.price}</span><strong>{startingPrice(servicePrices[work.priceKey],lang)}</strong></div>)}
 </article>)}</div><p class="s-note">{labels.tax}</p>
  <p class="works-other-link">{isMain&&<span>{c.otherLink}</span>}<a class="s-link" href={href(isMain?'/works/other/':'/works/')}>{isMain?c.otherOpen:c.backMain}<span aria-hidden="true">→</span></a></p></div></section>
 <section class="s-contact-band"><div class="s-shell"><div><h2>{c.finalTitle}</h2><p>{c.finalDesc}</p></div><a class="s-button" href={href('/contact/?source=works')}>{labels.consultation}<MaterialIcon name="arrow_forward"/></a></div></section>
</main>
<style>
.usecase-list{display:grid;gap:14px}.usecase-entry{display:grid;grid-template-columns:3em minmax(0,1fr);gap:18px;padding:24px;text-decoration:none}.usecase-number{color:var(--deep);font-size:1.25rem}.usecase-entry h3{font-size:1.1rem;margin:8px 0}.usecase-entry p{color:var(--quiet);font-size:.9375rem;max-width:65em;margin-bottom:16px}.works-usecases h2{font-size:1.5rem}.works-usecases[hidden]{display:none}.usecase-entry:hover h3{color:var(--vermillion)}@media(max-width:560px){.usecase-entry{grid-template-columns:1.5em minmax(0,1fr);gap:10px;padding:18px}}
.works-grid{opacity:1;transition:opacity var(--motion-feedback,180ms) ease-out}.works-grid.grid-enter{opacity:.92}.works-refresh .works-heading{padding:60px 0 20px}.works-heading h1{max-width:22em}.works-heading .s-intro{max-width:50em;margin-bottom:14px}.works-filters{display:flex;flex-wrap:wrap;gap:8px;margin-top:32px;padding-bottom:18px;border-bottom:1px solid var(--rule)}.works-filters button{display:flex;align-items:center;gap:10px;min-height:44px;padding:9px 15px;border:1px solid #c9d0c3;border-radius:6px;font:inherit;font-size:.8125rem;font-weight:600;color:var(--ink);background:transparent;cursor:pointer}.works-filters button span{font-size:.75rem;opacity:.75}.works-filters button.active{background:var(--deep);border-color:var(--deep);color:white}.works-filters button:hover:not(.active){background:#e8ede1}.works-count{margin:12px 0 0;font-size:.75rem;color:var(--quiet)}.works-refresh .featured-section{padding:16px 0 54px}.featured-section h2{font-size:1.55rem}.featured-work{border:1px solid var(--rule);border-radius:7px;background:#fffefa;overflow:hidden;text-decoration:none;display:flex;flex-direction:column}.featured-visual{aspect-ratio:1.7;background:#e5ebe0;overflow:hidden;display:flex;align-items:center;justify-content:center}.featured-visual img{width:100%;height:100%;object-fit:cover}.featured-caption{padding:24px;flex:1;display:flex;flex-direction:column}.featured-caption>.s-number{font-size:.75rem}.featured-caption h3{font-size:1.06rem;margin:12px 0}.featured-caption p{font-size:.9375rem;color:var(--quiet);margin-bottom:20px}.work-open{display:flex;justify-content:space-between;align-items:center;gap:14px;color:var(--deep);font-size:.8125rem;font-weight:700;margin-top:auto}.featured-work:hover h3,.entry-main:hover h3{color:var(--vermillion)}.sample-integration{display:flex;align-items:center;justify-content:center;gap:14px;position:relative;padding-bottom:18px}.sample-integration>span{display:grid;place-items:center;min-width:76px;height:60px;padding:10px;border-radius:10px;background:#26784f;color:#fff;font-weight:600}.sample-integration>span.si-vendor{background:#fff;border:2px solid var(--vendor);color:var(--vendor);font-size:.875rem;font-weight:700;padding:10px 14px;min-width:0;white-space:nowrap}.entry-image .sample-integration{height:100%;padding-bottom:0}.sample-integration .si-line img{width:40px;height:auto;object-fit:initial}.sample-integration>span.si-line{flex-shrink:0}.sample-integration.is-small{padding:0 12px}.sample-integration.is-small>span.si-vendor{white-space:normal;text-align:center;line-height:1.4}.sample-integration>span.si-line{min-width:0;height:auto;padding:10px;background:#fff;border-radius:10px}.si-line img{display:block;width:40px;height:auto}.sample-integration small{position:absolute;bottom:-20px;letter-spacing:.2em;color:#62765e;font-size:.75rem}.feature-app{background:#e7e4ed}.sample-apps{display:flex;gap:16px;transform:translateY(28px)}.sample-apps>div{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;width:100px;height:150px;border:5px solid #42433d;border-bottom:0;border-radius:16px 16px 0 0;background:#fff6e6;color:#715938}.sample-apps>div+div{background:#25223d;color:#fff;transform:translateY(-15px)}.sample-apps span{font-size:.75rem}.sample-apps b{font-size:1.35rem}.works-collection h2{font-size:1.5rem}.work-entry{display:flex;flex-direction:column;background:#fffefa;border:1px solid var(--rule);border-radius:7px;overflow:hidden}.entry-main{display:flex;flex-direction:column;flex:1;text-decoration:none}.entry-image{aspect-ratio:2.1;background:#eef0e7;overflow:hidden}.entry-image img{width:100%;height:100%;object-fit:cover}.entry-type{height:100%;display:flex;gap:16px;align-items:center;justify-content:center;color:var(--deep);font-size:.8125rem}.entry-type :global(.material-symbols-rounded){font-size:38px}.entry-copy{padding:22px;display:flex;flex:1;flex-direction:column}.entry-kind{font-size:.75rem;color:var(--quiet)}.entry-copy h3{font-size:1.02rem;line-height:1.65;margin:10px 0}.entry-copy p{font-size:.9375rem;color:var(--quiet);margin-bottom:20px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.entry-price{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:13px 22px;border-top:1px solid var(--rule);text-decoration:none}.entry-price span{font-size:.75rem;color:var(--quiet)}.entry-price strong{font-size:.8125rem;white-space:nowrap}.entry-price:hover{background:#edf1e6}.works-refresh [hidden]{display:none!important}.works-other-link{margin-top:28px;padding-top:20px;border-top:1px solid var(--rule);font-size:.9375rem;color:var(--quiet);display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px}
@media(max-width:820px){.works-refresh .works-heading{padding-top:40px}.featured-grid{grid-template-columns:1fr}.featured-work{display:grid;grid-template-columns:1fr 1.4fr}.featured-visual{height:100%;min-height:210px;aspect-ratio:auto}.featured-caption{padding:22px}.sample-apps{gap:8px}.sample-apps>div{width:85px}.works-filters button{padding:8px 12px}.works-grid{gap:18px}}
@media(max-width:560px){.featured-work{display:flex}.featured-visual{aspect-ratio:1.8;min-height:0}.works-grid{grid-template-columns:1fr}.entry-image{aspect-ratio:2}.works-filters{gap:7px}.works-filters button{font-size:.8125rem}.works-refresh .featured-section{padding-bottom:36px}}
</style>
<script>
import { isReducedMotion } from '../scripts/motion';
function initWorksFilter() {
 const root=document.querySelector<HTMLElement>('[data-works-page]'); if(!root||root.dataset.initialized)return;root.dataset.initialized='true';
 const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];const cards=[...root.querySelectorAll<HTMLElement>('.work-entry')];const featured=root.querySelector<HTMLElement>('[data-featured-section]');const count=root.querySelector<HTMLElement>('[data-result-count]')!;const heading=root.querySelector<HTMLElement>('[data-collection-title]')!;const grid=root.querySelector<HTMLElement>('.works-grid')!;
 let currentValue:string|null=null;
 function filter(value:string,writeUrl=false,animate=false){if(!buttons.some(button=>button.dataset.filter===value))value='all';let total=0;buttons.forEach(button=>{const active=button.dataset.filter===value;button.classList.toggle('active',active);button.setAttribute('aria-pressed',String(active));});if(featured)featured.hidden=value!=='all';cards.forEach(card=>{const matches=value==='all'||card.dataset.category===value;if(matches)total++;card.hidden=!matches||(value==='all'&&card.dataset.featured==='true');});count.textContent=`${total} ${count.dataset.unit}`;const active=buttons.find(button=>button.dataset.filter===value)!;heading.textContent=value==='all'?heading.dataset.defaultTitle!:active.firstChild!.textContent;if(writeUrl){const url=new URL(window.location.href);if(value==='all')url.searchParams.delete('type');else url.searchParams.set('type',value);history.replaceState(null,'',url);}if(animate&&value!==currentValue&&!isReducedMotion()){grid.classList.add('grid-enter');void grid.offsetWidth;grid.classList.remove('grid-enter');}currentValue=value;}
 const usecaseSection=root.querySelector<HTMLElement>('[data-usecase-section]');
 function syncUsecases(){if(usecaseSection)usecaseSection.hidden=![...usecaseSection.querySelectorAll<HTMLElement>('.work-entry')].some(card=>!card.hidden);}
 buttons.forEach(button=>button.addEventListener('click',()=>{filter(button.dataset.filter!,true,true);syncUsecases();}));filter(new URLSearchParams(window.location.search).get('type')||'all');syncUsecases();
}
initWorksFilter();document.addEventListener('astro:page-load',initWorksFilter);
</script>
