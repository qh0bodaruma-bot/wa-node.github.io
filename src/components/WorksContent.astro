---
import MaterialIcon from './MaterialIcon.astro';
import { workCatalog } from '../data/workCatalog';
import { localizedPath, servicePrices, startingPrice, serviceLabels, type SiteLanguage } from '../data/services';
import '../styles/service-pages.css';
interface Props { lang?: SiteLanguage }
const {lang='ja'} = Astro.props;
const href = (path: string) => path.endsWith('.html') ? path : localizedPath(path,lang);
const labels = serviceLabels[lang];
const c = {
 ja:{title:'見て、触れて、イメージする。',lead:'LINE連携、アプリ、Web制作。近い目的のサンプルを操作して、必要な機能や見せ方を確かめられます。',note:'自主制作デモ・架空企業のサンプルと、公開済みの出版物を掲載しています。お客様の導入成果を示すものではありません。',all:'すべて',line:'LINE連携',app:'アプリ',web:'Web・LP',system:'AI・業務システム',tool:'診断・ツール',kdp:'KDP出版',featured:'まずは、この3つから。',others:'ほかの制作例',open:'開いて試す',view:'詳しく見る',sample:'自主制作デモ・サンプル',published:'出版実績',price:'関連する制作の開始価格',count:'件',filter:'制作例を絞り込む',finalTitle:'近いサンプルは、ありましたか。',finalDesc:'「この画面のようなものを」とお伝えいただくと、必要な範囲から相談できます。'},
 en:{title:'See it. Try it. Picture your project.',lead:'Explore LINE integration, apps and websites to understand the features and interactions your project may need.',note:'This collection includes independent demos, fictional business samples and published books. It does not represent measured client outcomes. Some demo screens are in Japanese.',all:'All',line:'LINE',app:'Apps',web:'Web & LP',system:'AI & business tools',tool:'Self-check tools',kdp:'KDP books',featured:'Start with these three.',others:'More projects',open:'Open the demo',view:'View details',sample:'Independent demo / sample',published:'Published work',price:'Related service starts at',count:'projects',filter:'Filter projects',finalTitle:'Found a useful reference?',finalDesc:'Tell us which sample is close to your idea, and we can discuss the scope you need.'},
 fr:{title:'Voir, essayer et imaginer votre projet.',lead:'Explorez les intégrations LINE, les applications et les sites pour préciser les fonctions et les interactions utiles.',note:'Cette collection présente des démos indépendantes, des entreprises fictives et des livres publiés. Elle ne revendique pas de résultats clients mesurés. Certains écrans de démonstration sont en japonais.',all:'Tout',line:'LINE',app:'Applications',web:'Web & pages de vente',system:'IA & outils métier',tool:'Auto-évaluations',kdp:'Livres KDP',featured:'Commencez par ces trois exemples.',others:'Autres créations',open:'Ouvrir la démo',view:'Voir les détails',sample:'Démo / exemple indépendant',published:'Publication',price:'Prestation associée à partir de',count:'créations',filter:'Filtrer les créations',finalTitle:'Un exemple proche de votre idée ?',finalDesc:'Indiquez le modèle qui vous intéresse pour préciser le périmètre nécessaire.'},
}[lang];
const categories = ['all','line','app','web','system','tool','kdp'] as const;
const icons = {line:'forum',app:'smartphone',web:'web',system:'account_tree',tool:'tune',kdp:'menu_book'};
const featured = [workCatalog[0],workCatalog[10],workCatalog[7]];
---
<main id="main" class="service-page works-refresh" data-glossary-skip data-reveal="off" data-works-page>
 <section class="works-heading"><div class="s-shell"><p class="s-eyebrow">Works & Demos</p><h1>{c.title}</h1><p class="s-intro">{c.lead}</p><p class="s-note">{c.note}</p>
  <div class="works-filters" role="group" aria-label={c.filter}>{categories.map(category=><button type="button" class:list={{active:category==='all'}} data-filter={category} aria-pressed={category==='all'}>{c[category]}<span>{category==='all'?workCatalog.length:workCatalog.filter(work=>work.category===category).length}</span></button>)}</div>
  <p class="works-count" aria-live="polite" data-result-count data-unit={c.count}>{workCatalog.length} {c.count}</p>
 </div></section>
 <section class="featured-section" data-featured-section><div class="s-shell"><div class="s-section-head"><h2>{c.featured}</h2></div><div class="s-grid featured-grid">{featured.map((work,i)=><a class="featured-work" href={href(work.href)}>
  <div class:list={['featured-visual',`feature-${work.category}`]}>{work.category==='web'?<img src={work.image} alt="" width="720" height="480" loading="lazy" decoding="async"/>:work.category==='line'?<div class="sample-integration" aria-hidden="true"><span>LINE</span><MaterialIcon name="east"/><span>kintone</span><small>01 → 02 → 03</small></div>:<div class="sample-apps" aria-hidden="true"><div><MaterialIcon name="pets"/><span>Pet Health Note</span></div><div><b>Flow</b><MaterialIcon name="bar_chart"/></div></div>}</div>
  <div class="featured-caption"><span class="s-number">0{i+1} / {c[work.category]}</span><h3>{work.title[lang]}</h3><p>{work.description[lang]}</p><span class="work-open">{c.open}<MaterialIcon name="north_east"/></span></div>
 </a>)}</div></div></section>
 <section class="s-section works-collection"><div class="s-shell"><h2 data-collection-title data-default-title={c.others}>{c.others}</h2><div class="s-grid works-grid">{workCatalog.map(work=><article class="work-entry" data-category={work.category} data-featured={String(work.featured)} hidden={work.featured}>
  <a class="entry-main" href={href(work.href)}><div class="entry-image">{work.image?<img src={work.image} alt="" width="640" height="400" loading="lazy" decoding="async"/>:<div class="entry-type" aria-hidden="true"><MaterialIcon name={icons[work.category]}/><span>{c[work.category]}</span></div>}</div><div class="entry-copy"><span class="entry-kind">{work.category==='kdp'?c.published:c.sample}</span><h3>{work.title[lang]}</h3><p>{work.description[lang]}</p><span class="work-open">{work.category==='kdp'?c.view:c.open}<MaterialIcon name="north_east"/></span></div></a>
  {work.priceKey&&<a class="entry-price" href={href(`/pricing/#${work.category==='line'?'line':work.category==='app'?'app':'web'}`)}><span>{c.price}</span><strong>{startingPrice(servicePrices[work.priceKey],lang)}</strong></a>}
 </article>)}</div><p class="s-note">{labels.tax}</p></div></section>
 <section class="s-contact-band"><div class="s-shell"><div><h2>{c.finalTitle}</h2><p>{c.finalDesc}</p></div><a class="s-button" href={href('/contact/?source=works')}>{labels.consultation}<MaterialIcon name="arrow_forward"/></a></div></section>
</main>
<style>
.works-refresh .works-heading{padding:60px 0 20px}.works-heading h1{max-width:22em}.works-heading .s-intro{max-width:50em;margin-bottom:14px}.works-filters{display:flex;flex-wrap:wrap;gap:8px;margin-top:32px;padding-bottom:18px;border-bottom:1px solid var(--rule)}.works-filters button{display:flex;align-items:center;gap:10px;min-height:44px;padding:9px 15px;border:1px solid #c9d0c3;border-radius:5px;font:inherit;font-size:.78rem;font-weight:600;color:var(--ink);background:transparent;cursor:pointer}.works-filters button span{font-size:.66rem;opacity:.75}.works-filters button.active{background:var(--deep);border-color:var(--deep);color:white}.works-filters button:hover:not(.active){background:#e8ede1}.works-count{margin:12px 0 0;font-size:.71rem;color:var(--quiet)}.works-refresh .featured-section{padding:16px 0 54px}.featured-section h2{font-size:1.55rem}.featured-work{border:1px solid var(--rule);border-radius:7px;background:#fffefa;overflow:hidden;text-decoration:none;display:flex;flex-direction:column}.featured-visual{aspect-ratio:1.7;background:#e5ebe0;overflow:hidden;display:flex;align-items:center;justify-content:center}.featured-visual img{width:100%;height:100%;object-fit:cover}.featured-caption{padding:24px;flex:1;display:flex;flex-direction:column}.featured-caption>.s-number{font-size:.64rem}.featured-caption h3{font-size:1.06rem;margin:12px 0}.featured-caption p{font-size:.79rem;color:var(--quiet);margin-bottom:20px}.work-open{display:flex;justify-content:space-between;align-items:center;gap:14px;color:var(--deep);font-size:.78rem;font-weight:700;margin-top:auto}.featured-work:hover h3,.entry-main:hover h3{color:var(--vermillion)}.sample-integration{display:flex;align-items:center;justify-content:center;gap:14px;position:relative;padding-bottom:18px}.sample-integration>span{display:grid;place-items:center;min-width:76px;height:60px;padding:10px;border-radius:10px;background:#26784f;color:#fff;font-weight:600}.sample-integration>span:last-of-type{background:#eedb90;color:#554726;font-size:.8rem}.sample-integration small{position:absolute;bottom:-20px;letter-spacing:.2em;color:#62765e;font-size:.64rem}.feature-app{background:#e7e4ed}.sample-apps{display:flex;gap:16px;transform:translateY(28px)}.sample-apps>div{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;width:100px;height:150px;border:5px solid #42433d;border-bottom:0;border-radius:16px 16px 0 0;background:#fff6e6;color:#715938}.sample-apps>div+div{background:#25223d;color:#fff;transform:translateY(-15px)}.sample-apps span{font-size:.61rem}.sample-apps b{font-size:1.35rem}.works-collection h2{font-size:1.5rem}.work-entry{display:flex;flex-direction:column;background:#fffefa;border:1px solid var(--rule);border-radius:7px;overflow:hidden}.entry-main{display:flex;flex-direction:column;flex:1;text-decoration:none}.entry-image{aspect-ratio:2.1;background:#eef0e7;overflow:hidden}.entry-image img{width:100%;height:100%;object-fit:cover}.entry-type{height:100%;display:flex;gap:16px;align-items:center;justify-content:center;color:var(--deep);font-size:.8rem}.entry-type :global(.material-symbols-rounded){font-size:38px}.entry-copy{padding:22px;display:flex;flex:1;flex-direction:column}.entry-kind{font-size:.64rem;color:var(--quiet)}.entry-copy h3{font-size:1.02rem;line-height:1.65;margin:10px 0}.entry-copy p{font-size:.79rem;color:var(--quiet);margin-bottom:20px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.entry-price{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:13px 22px;border-top:1px solid var(--rule);text-decoration:none}.entry-price span{font-size:.61rem;color:var(--quiet)}.entry-price strong{font-size:.76rem;white-space:nowrap}.entry-price:hover{background:#edf1e6}.works-refresh [hidden]{display:none!important}
@media(max-width:820px){.works-refresh .works-heading{padding-top:40px}.featured-grid{grid-template-columns:1fr}.featured-work{display:grid;grid-template-columns:1fr 1.4fr}.featured-visual{height:100%;min-height:210px;aspect-ratio:auto}.featured-caption{padding:22px}.sample-apps{gap:8px}.sample-apps>div{width:85px}.works-filters button{padding:8px 12px}.works-grid{gap:18px}}
@media(max-width:560px){.featured-work{display:flex}.featured-visual{aspect-ratio:1.8;min-height:0}.works-grid{grid-template-columns:1fr}.entry-image{aspect-ratio:2}.works-filters{gap:7px}.works-filters button{font-size:.75rem}.works-refresh .featured-section{padding-bottom:36px}}
</style>
<script>
function initWorksFilter() {
 const root=document.querySelector<HTMLElement>('[data-works-page]'); if(!root||root.dataset.initialized)return;root.dataset.initialized='true';
 const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];const cards=[...root.querySelectorAll<HTMLElement>('.work-entry')];const featured=root.querySelector<HTMLElement>('[data-featured-section]')!;const count=root.querySelector<HTMLElement>('[data-result-count]')!;const heading=root.querySelector<HTMLElement>('[data-collection-title]')!;
 function filter(value:string,writeUrl=false){if(!buttons.some(button=>button.dataset.filter===value))value='all';let total=0;buttons.forEach(button=>{const active=button.dataset.filter===value;button.classList.toggle('active',active);button.setAttribute('aria-pressed',String(active));});featured.hidden=value!=='all';cards.forEach(card=>{const matches=value==='all'||card.dataset.category===value;if(matches)total++;card.hidden=!matches||(value==='all'&&card.dataset.featured==='true');});count.textContent=`${total} ${count.dataset.unit}`;const active=buttons.find(button=>button.dataset.filter===value)!;heading.textContent=value==='all'?heading.dataset.defaultTitle!:active.firstChild!.textContent;if(writeUrl){const url=new URL(window.location.href);if(value==='all')url.searchParams.delete('type');else url.searchParams.set('type',value);history.replaceState(null,'',url);}}
 buttons.forEach(button=>button.addEventListener('click',()=>filter(button.dataset.filter!,true)));filter(new URLSearchParams(window.location.search).get('type')||'all');
}
initWorksFilter();document.addEventListener('astro:page-load',initWorksFilter);
</script>
