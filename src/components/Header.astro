---
import LanguageSwitcher from './LanguageSwitcher.astro';
import MaterialIcon from './MaterialIcon.astro';
import t from '../i18n/translations.json';
import { MULTILANG_PAGES } from '../i18n/navigation';

interface Props {
  lang?: 'ja' | 'en' | 'fr';
}

const { lang = 'ja' } = Astro.props;

function getLocalizedLink(path: string) {
  const cleanPath = path.replace(/\/+/g, '/');
  if (lang === 'ja') {
    return cleanPath.endsWith('/') ? cleanPath : `${cleanPath}/`;
  }
  
  // en or fr: For existing multi-language pages
  const validPages = [...MULTILANG_PAGES, ''];
  const basePage = cleanPath.split(/[?#]/)[0];
  
  if (validPages.includes(basePage)) {
    const langPath = basePage === '/' || basePage === '' ? `/${lang}/` : `/${lang}${cleanPath}/`;
    return langPath.replace(/\/+/g, '/');
  }
  
  // For other pages that do not have multi-language files, fallback to their Japanese counterpart with lang param
  const fallbackPath = cleanPath.endsWith('/') ? cleanPath : `${cleanPath}/`;
  return `${fallbackPath}?lang=${lang}`;
}

function isCurrentPage(path: string) {
  const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
  const targetPath = new URL(getLocalizedLink(path), Astro.url.origin).pathname.replace(/\/+$/, '') || '/';
  return currentPath === targetPath;
}
---
<header class="site-header" id="site-header">
  <div class="header-inner">
    <a class="logo" href={getLocalizedLink('/')}>
      和-Node<span class="logo-sub">{lang === 'ja' ? 'LINE × 業務システム連携' : lang === 'en' ? 'LINE × Business Systems' : 'LINE × Outils métier'}</span>
    </a>

    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-label={lang === 'ja' ? 'メニューを開く' : lang === 'en' ? 'Open Menu' : 'Ouvrir le menu'}
      aria-expanded="false"
      aria-controls="site-nav"
      data-open-label={lang === 'ja' ? 'メニューを開く' : lang === 'en' ? 'Open Menu' : 'Ouvrir le menu'}
      data-close-label={lang === 'ja' ? 'メニューを閉じる' : lang === 'en' ? 'Close Menu' : 'Fermer le menu'}
    >
      <MaterialIcon name="menu" class="menu-icon-open" />
      <MaterialIcon name="close" class="menu-icon-close" />
    </button>

    <nav class="nav" id="site-nav">
      <div class="nav-links">
        <a href={getLocalizedLink('/pricing')} class:list={{ 'nav-active': isCurrentPage('/pricing') }} aria-current={isCurrentPage('/pricing') ? 'page' : undefined}>{t.nav.pricing[lang]}</a>
        <a href={getLocalizedLink('/works')} class:list={{ 'nav-active': isCurrentPage('/works') }} aria-current={isCurrentPage('/works') ? 'page' : undefined}>{t.nav.works[lang]}</a>
        {lang === 'ja' && <a href="/blog/" class:list={{ 'nav-active': isCurrentPage('/blog') }} aria-current={isCurrentPage('/blog') ? 'page' : undefined}>コラム</a>}
        <a href={getLocalizedLink('/about')} class:list={{ 'nav-active': isCurrentPage('/about') }} aria-current={isCurrentPage('/about') ? 'page' : undefined}>{t.nav.about[lang]}</a>
        <a href={getLocalizedLink('/contact')} class="nav-cta">{t.nav.cta[lang]}</a>
        <LanguageSwitcher lang={lang} />
        <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false">
          <span class="motion-switch" aria-hidden="true"></span>
          <span class="motion-label">{lang === 'ja' ? '動きを控えめに' : lang === 'en' ? 'Less motion' : 'Moins d’animations'}</span>
        </button>
        <span class="motion-toggle-note" id="motion-toggle-note" hidden>{lang === 'ja' ? '端末の設定で、動きは控えめになっています。' : lang === 'en' ? 'Motion is already reduced by your device settings.' : 'Les animations sont déjà réduites par les réglages de votre appareil.'}</span>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100vw;
    max-width: 100%;
    z-index: 1000;
    background: rgba(255, 253, 249, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(234, 223, 212, 0.5);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-header.scrolled {
    background: rgba(255, 253, 249, 0.98);
    box-shadow: 0 10px 30px rgba(70, 52, 32, 0.08);
  }

  .header-inner {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .logo {
    min-width: 0;
    flex-wrap: wrap;
    font-weight: 800;
    color: #2b241f;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: 10px;
    text-decoration: none;
    white-space: normal;
  }

  .logo-sub {
    font-size: .75rem;
    color: #6d6259;
    background: #f1e6da;
    padding: 2px 10px;
    border-radius: 999px;
    max-width: 100%;
    white-space: normal;
  }

  /* 幅320px前後でロゴ「和-Node」と帯が折れないよう詰める */
  @media (max-width: 360px) {
    .header-inner { padding: 12px 14px; }
    .logo { gap: 8px; }
    .logo-sub { font-size: .6875rem; padding: 2px 8px; }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  @media (min-width: 821px) {
    .header-inner { flex-wrap: wrap; }
    .nav { max-width: 100%; margin-left: auto; }
    .nav-links { flex-wrap: wrap; justify-content: flex-end; }
    .nav-links > a { white-space: nowrap; }
  }

  .nav-links a {
    color: #2b241f;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.3s ease;
    position: relative;
  }

  .nav-links a:not(.nav-cta)::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: #8a5a32;
    transition: width 0.3s ease;
  }

  .nav-links a:not(.nav-cta):hover::after {
    width: 100%;
  }

  .nav-links a.nav-active { color: #8a5a32; }
  .nav-links a.nav-active::after { width: 100%; }

  .nav-links a:hover {
    color: #8a5a32;
  }

  .nav-cta {
    background: var(--action, #c7352f);
    color: #fff !important;
    padding: 8px 22px;
    border-radius: 6px; /* ボタンの角丸は6pxに統一（2026-09-15） */
    box-shadow: 0 4px 15px rgba(199, 53, 47, 0.2);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .nav-cta:hover {
    background: var(--action-strong, #b62f29);
    opacity: 1;
  }

  /* 動きの量の切替。端末の設定で控えめになっている場合は押せない状態で「オン」を示す */
  .motion-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 4px;
    border: 0;
    background: none;
    color: #2b241f;
    font: inherit;
    font-size: .8125rem;
    font-weight: 700;
    white-space: normal;
    max-width: 100%;
    text-align: left;
    cursor: pointer;
  }
  .motion-switch {
    position: relative;
    flex-shrink: 0;
    width: 34px;
    height: 20px;
    border: 1px solid #8a7d72;
    border-radius: 999px;
    background: #fff;
    transition: background .2s ease, border-color .2s ease;
  }
  .motion-switch::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #6d6259;
    transition: transform .2s ease, background .2s ease;
  }
  .motion-toggle[aria-pressed="true"] .motion-switch { background: #164f4d; border-color: #164f4d; }
  .motion-toggle[aria-pressed="true"] .motion-switch::after { transform: translateX(14px); background: #fff; }
  .motion-toggle[aria-disabled="true"] { cursor: default; color: #6d6259; }
  .motion-toggle:focus-visible { outline: 3px solid #9b4c12; outline-offset: 2px; border-radius: 6px; }
  /* PCでナビが折り返す幅（821〜1200px）では、ヘッダーから外してフッターの切替だけにする */
  @media (820px < width <= 1200px) {
    .motion-toggle { display: none; }
  }

  /* Hamburger Menu */
  .menu-toggle {
    flex-shrink: 0;
    position: relative;
    display: none;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    z-index: 1100;
    transition: 0.3s ease;
  }

  .menu-toggle:hover {
    transform: scale(1.1);
  }

  .menu-toggle :global(.material-symbols-rounded) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin: auto;
    color: #2b241f;
    font-size: 30px;
    transition: opacity 0.24s ease, transform 0.24s ease;
  }

  .menu-toggle :global(.menu-icon-close) {
    opacity: 0;
    transform: scale(0.7) rotate(-45deg);
  }

  .menu-toggle.active :global(.menu-icon-open) {
    opacity: 0;
    transform: scale(0.7) rotate(45deg);
  }

  .menu-toggle.active :global(.menu-icon-close) {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  @media (max-width: 820px) {
    .menu-toggle { display: block; }
    
    .nav {
      position: fixed;
      top: 0;
      right: 0;
      width: 80%;
      max-width: 300px;
      height: 100vh;
      height: 100dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: #fff;
      padding: max(80px, 5rem) 30px 30px;
      box-shadow: -10px 0 30px rgba(0,0,0,0.05);
      clip-path: inset(0 0 0 100%);
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transition: clip-path 0.38s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease, visibility 0.25s ease;
      z-index: 1050;
    }

    .nav.active {
      clip-path: inset(0);
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }
    .menu-toggle:focus-visible + .nav, .nav:focus-within { transition: none; }

    .nav-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
  }
  .menu-toggle:focus-visible { outline: 3px solid #9b4c12; outline-offset: 2px; border-radius: 6px; }
  @media (prefers-reduced-motion: reduce) {
    .nav, .menu-toggle, .menu-toggle :global(.material-symbols-rounded) { transition: none; }
  }
  :global(html[data-motion="reduce"]) :is(.nav, .menu-toggle),
  :global(html[data-motion="reduce"]) .menu-toggle :global(.material-symbols-rounded) { transition: none; }
</style>

<script is:inline>
  (function() {
    let disposeHeader;
    function initHeader() {
      const toggle = document.getElementById('menu-toggle');
      const nav = document.getElementById('site-nav');
      const header = document.getElementById('site-header');
      if (!toggle || !nav || !header) return;
      if (header.dataset.initialized === 'true') return;
      disposeHeader?.();
      header.dataset.initialized = 'true';
      const controller = new AbortController();
      const signal = controller.signal;
      const mobile = window.matchMedia('(max-width: 820px)');
      let previousOverflow = document.body.style.overflow;
      function setOpen(open, restoreFocus = false) {
        const isOpen = open && mobile.matches;
        if (isOpen && !nav.classList.contains('active')) previousOverflow = document.body.style.overflow;
        toggle.classList.toggle('active', isOpen);
        nav.classList.toggle('active', isOpen);
        nav.inert = mobile.matches && !isOpen;
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.setAttribute('aria-label', isOpen ? toggle.dataset.closeLabel : toggle.dataset.openLabel);
        document.body.style.overflow = isOpen ? 'hidden' : previousOverflow;
        if (restoreFocus && mobile.matches) toggle.focus();
      }
      const updateScroll = () => header.classList.toggle('scrolled', window.scrollY > 50);
      setOpen(false);
      updateScroll();
      toggle.addEventListener('click', () => setOpen(!nav.classList.contains('active')), { signal });
      nav.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false), { signal }));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && nav.classList.contains('active')) {
          event.preventDefault();
          setOpen(false, true);
        }
      }, { signal });
      document.addEventListener('focusin', event => {
        if (nav.classList.contains('active') && event.target !== toggle && !nav.contains(event.target)) setOpen(false);
      }, { signal });
      document.addEventListener('pointerdown', event => {
        if (nav.classList.contains('active') && !toggle.contains(event.target) && !nav.contains(event.target)) setOpen(false);
      }, { signal });
      mobile.addEventListener('change', () => setOpen(false), { signal });
      window.addEventListener('scroll', updateScroll, { passive: true, signal });
      disposeHeader = () => { setOpen(false); controller.abort(); };
    }

    // 動きの量の切替。選択は html[data-motion] と localStorage（wa-motion）に保持し、wa:motion-change で各部品へ知らせる
    var reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    // ヘッダーとフッターの両方に置くため、[data-motion-toggle] をすべて同じ状態にそろえる
    function syncMotionToggle() {
      var note = document.getElementById('motion-toggle-note');
      var system = reduceQuery.matches;
      var user = document.documentElement.dataset.motion === 'reduce';
      document.querySelectorAll('[data-motion-toggle]').forEach(function (button) {
        button.setAttribute('aria-pressed', String(system || user));
        if (system) {
          button.setAttribute('aria-disabled', 'true');
          button.setAttribute('aria-describedby', 'motion-toggle-note');
          if (note) button.title = note.textContent;
        } else {
          button.removeAttribute('aria-disabled');
          button.removeAttribute('aria-describedby');
          button.removeAttribute('title');
        }
      });
    }
    function initMotionToggle() {
      document.querySelectorAll('[data-motion-toggle]').forEach(function (button) {
      if (button.dataset.initialized) return;
      button.dataset.initialized = 'true';
      button.addEventListener('click', function () {
        if (reduceQuery.matches) return;
        var next = document.documentElement.dataset.motion !== 'reduce';
        if (next) document.documentElement.dataset.motion = 'reduce';
        else delete document.documentElement.dataset.motion;
        try {
          if (next) localStorage.setItem('wa-motion', 'reduce');
          else localStorage.removeItem('wa-motion');
        } catch (e) { /* 保存できない環境では、このページを開いている間だけ有効 */ }
        syncMotionToggle();
        document.dispatchEvent(new CustomEvent('wa:motion-change'));
      });
      });
      syncMotionToggle();
    }
    reduceQuery.addEventListener('change', syncMotionToggle);

    initHeader();
    initMotionToggle();
    // Initial load and Astro page transitions
    document.addEventListener('astro:page-load', initHeader);
    document.addEventListener('astro:before-swap', () => disposeHeader?.());
    document.addEventListener('astro:page-load', initMotionToggle);
  })();
</script>
