---
// 説明用の人物線画。親SVGの線色と線幅を継承する。
interface Props { x?: number; y?: number; pose?: 'phone' | 'point' | 'wave' }
const { x = 0, y = 0, pose = 'point' } = Astro.props;
---
<g transform={`translate(${x} ${y})`}>
  <path d="M19 66l-2 34h10l6-30 5 30h10l-3-34" fill="#e8e6df" />
  <path d="M16 100l-5 5h17v-5M38 100v5h17l-8-5" fill="#fffefa" />
  <path d="M13 40q2-12 16-13h10q13 2 15 13l-7 28H17Z" fill="#f3e5a5" />
  <path d="M28 27l6 9 6-9M34 36v29" stroke="#c5ad58" />
  <path d="M27 21v8q7 6 13 0v-8" fill="#fffefa" />
  <path d="M22 10q0-12 13-10 14-1 13 14l-3 8q-5 8-13 4-9-3-10-16Z" fill="#fffefa" />
  <path d="M22 12q-4-15 11-14 17-3 17 14l-7-2-4-7q-4 8-17 9Z" fill="#d0cdc2" />
  <path d="M35 14v4h3M33 22q4 2 7-1" />
  <circle cx="29" cy="14" r=".8" fill="#74736c" stroke="none" /><circle cx="41" cy="14" r=".8" fill="#74736c" stroke="none" />
  {pose === 'phone' ? <>
    <path d="M16 39L9 60q-1 5 5 6l25-10-3-6-18 6 6-14" fill="#f3e5a5" />
    <rect x="41" y="33" width="14" height="23" rx="2" transform="rotate(12 41 33)" fill="#fffefa" />
    <path d="M48 40l9 14q3 5-2 8l-14-6-1-6 11 4-9-10" fill="#fffefa" />
  </> : pose === 'wave' ? <>
    <path d="M16 39l-8 23 9 5 10-22M48 38l15 8 7-22 6 2-4 29q-2 5-7 3L45 48" fill="#f3e5a5" />
    <path d="M70 24l-2-8 3-1 3 5 2-9 3 1-1 13-3 3M17 67l-2 7 5 2 4-8" fill="#fffefa" />
  </> : <>
    <path d="M16 39L8 63l10 6 8-23M47 38l10 16 16-9 3 6-19 15q-4 1-7-3l-9-14" fill="#f3e5a5" />
    <path d="M73 45l6-7 3 1-2 5 7-2 1 3-12 6M18 69l-2 7 5 2 4-8" fill="#fffefa" />
  </>}
</g>
