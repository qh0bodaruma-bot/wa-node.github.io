argin:0;font-size:.875rem;font-weight:600;color:var(--ink)}.record-status{display:grid;margin:4px 0 0!important;padding-top:10px;border-top:1px solid #d9dfd1;font-size:.875rem}.record-status>span{grid-area:1/1;display:flex;align-items:center;gap:8px;min-height:24px}.status-wait{visibility:hidden;color:var(--quiet)}.status-done{color:var(--action,#c7352f);font-weight:700}.status-done :global(.material-symbols-rounded){font-size:20px}.hero-lead-short{display:none}@keyframes hd-source{0%{opacity:0;transform:translateY(10px)}7%,88%{opacity:1;transform:none}96%,100%{opacity:0;transform:none}}@keyframes hd-track{0%,9%{opacity:.2}15%,88%{opacity:1}96%,100%{opacity:.2}}@keyframes hd-field-1{0%,18%{opacity:0;clip-path:inset(0 100% 0 0)}26%,88%{opacity:1;clip-path:inset(0 0 0 0)}96%,100%{opacity:0;clip-path:inset(0 0 0 0)}}@keyframes hd-field-2{0%,30%{opacity:0;clip-path:inset(0 100% 0 0)}38%,88%{opacity:1;clip-path:inset(0 0 0 0)}96%,100%{opacity:0;clip-path:inset(0 0 0 0)}}@keyframes hd-field-3{0%,42%{opacity:0;clip-path:inset(0 100% 0 0)}50%,88%{opacity:1;clip-path:inset(0 0 0 0)}96%,100%{opacity:0;clip-path:inset(0 0 0 0)}}@keyframes hd-wait{0%,14%{opacity:0}20%,54%{opacity:1}58%,100%{opacity:0}}@keyframes hd-done{0%,56%{opacity:0;transform:translateY(4px)}62%,88%{opacity:1;transform:none}96%,100%{opacity:0;transform:none}}@keyframes hd-target{0%,56%{border-color:#d9dfd1;box-shadow:0 0 0 0 rgba(199,53,47,0)}62%{border-color:#d9a19c;box-shadow:0 0 0 4px rgba(199,53,47,.16)}74%,88%{border-color:#d9a19c;box-shadow:0 0 0 0 rgba(199,53,47,0)}96%,100%{border-color:#d9dfd1}}.is-playing .connection-source .line-bubble{animation:hd-source 9s ease-out infinite}.is-playing .connection-track{animation:hd-track 9s ease-out infinite}.is-playing .record-field-1 dd{animation:hd-field-1 9s linear infinite}.is-playing .record-field-2 dd{animation:hd-field-2 9s linear infinite}.is-playing .record-field-3 dd{animation:hd-field-3 9s linear infinite}.is-playing .status-wait{visibility:visible;animation:hd-wait 9s ease-out infinite}.is-playing .status-done{animation:hd-done 9s ease-out infinite}.is-playing .connection-target{animation:hd-target 9s ease-out infinite}.is-paused .preview-panel *,.is-playing .preview-panel:hover *,.is-paused .preview-panel,.is-playing .preview-panel:hover{animation-play-state:paused!important}@media(prefers-reduced-motion:reduce){.is-playing .preview-panel *{animation:none!important}.is-playing .status-wait{visibility:hidden}}
