---
import MaterialIcon from './MaterialIcon.astro';
import LineFlowDiagram from './LineFlowDiagram.astro';

interface Props {
  lang?: 'ja' | 'en' | 'fr';
}

const { lang = 'ja' } = Astro.props;

function getLocalizedLink(path: string) {
  const cleanPath = path.replace(/\/+/g, '/');
  if (lang === 'ja') {
    return cleanPath.endsWith('/') ? cleanPath : `${cleanPath}/`;
  }
  const validPages = ['/', '', '/contact', '/works', '/pricing', '/about', '/kdp_books', '/psychology-demo', '/ai-chat-demo', '/simulator', '/demos', '/barrier_free', '/mental_care', '/corporate-mental', '/lp-portfolio'];
  const basePage = cleanPath.split(/[?#]/)[0];
  if (validPages.includes(basePage)) {
    const langPath = basePage === '/' || basePage === '' ? `/${lang}/` : `/${lang}${cleanPath}/`;
    return langPath.replace(/\/+/g, '/');
  }
  const fallbackPath = cleanPath.endsWith('/') ? cleanPath : `${cleanPath}/`;
  return `${fallbackPath}?lang=${lang}`;
}

const trustSignals = [
  { value: 'LINE連携', label: 'Salesforce・kintone・HubSpot等に対応' },
  { value: 'LIFF開発', label: 'LINEアプリ内フォーム・ツール開発' },
  { value: '20年以上', label: 'IT・Web・開発の現場経験' },
  { value: 'SECURITY ACTION', label: '情報管理への取り組みを宣言' },
];

const issues = [
  'LINEで受けた問い合わせ情報を、毎回管理システムに手入力している（二重入力）',
  'LINE側の開発会社とシステム側の担当が別々で、要件がかみ合わない（ベンダー分断）',
  '自社でAPI（システム同士をつなぐ仕組み）の連携を試みたが、技術的に行き詰まった（技術の壁）',
];

const capabilities = [
  {
    icon: 'link',
    title: 'LIFF（LINE内フォーム）の開発',
    desc: 'LINEアプリ内で動くWebページ（LIFF）を使った申込・問い合わせフォームを開発します。ノーコードでは難しいブランドに合ったデザインにも対応。',
  },
  {
    icon: 'sync_alt',
    title: '各種システムへの自動連携設定',
    desc: 'フォーム送信データをSalesforce・kintone・HubSpot等のシステムへ即時反映。手入力・CSV出力の手間をゼロにします。',
  },
  {
    icon: 'chat',
    title: 'Messaging APIによる自動応答',
    desc: '申込・問い合わせ後にLINEで自動確認メッセージを送信。各システムのステータス変更に連動したLINE通知にも対応します。',
  },
  {
    icon: 'verified',
    title: '設計から実装・テストまで一社で',
    desc: '要件整理・API設計・開発・実機テスト・本番移行まで和-Nodeが一括対応。ベンダー間の調整コストが発生しません。',
  },
];

const devSteps = [
  {
    num: 'STEP 1',
    title: '無料ヒアリング（30〜45分）',
    desc: '実現したいこと・現在のLINE環境・連携先システムを確認します。この段階でスコープ外の要件も明確にします。',
  },
  {
    num: 'STEP 2',
    title: '要件整理・お見積り',
    desc: 'ヒアリング内容をもとに、開発範囲・費用・期間をまとめた見積書をご提出します。不明点があれば再調整します。',
  },
  {
    num: 'STEP 3',
    title: '契約・着手',
    desc: 'テスト用LINEアカウントで開発を開始します。Figmaデータ・システムのAPI権限など必要な素材をご提供いただきます。',
  },
  {
    num: 'STEP 4',
    title: 'テスト・確認',
    desc: '実機（iOS・AndroidのLINEアプリ）での動作確認を行い、修正対応します。軽微な修正は2回まで含みます。',
  },
  {
    num: 'STEP 5',
    title: '本番移行・納品',
    desc: 'テスト環境で確認が取れたら、本番アカウントへ移行します。操作・運用の引継ぎメモをセットでお渡しします。',
  },
];

const faqs = [
  {
    q: '費用の目安を教えてください。',
    a: '連携先システムにより異なります。Salesforce連携は40万円〜、kintone連携は25万円〜、HubSpot連携は20万円〜、Googleスプレッドシート連携は10万円〜（いずれも税別）が目安です。要件定義・設計・実装・テストを含みます。連携するデータの種類や画面数により変動するため、まずヒアリングで範囲を確認したうえでお見積りします。',
  },
  {
    q: '開発期間はどのくらいかかりますか？',
    a: '必要な情報・権限がそろった時点から4〜6週間が目安です。連携先システムのAPI権限や仕様が固まっているほど短くなります。',
  },
  {
    q: '連携先システムの設定変更も対応してもらえますか？',
    a: '連携に必要な範囲のシステム設定（カスタム項目・APIユーザー設定等）は対応します。Salesforce Apexカスタム開発・各システムの大規模な改修は対応外です。',
  },
  {
    q: 'Salesforce以外のシステムでも対応してもらえますか？',
    a: 'Salesforce・kintone・HubSpot・Googleスプレッドシートなど、各種システムに対応しています。LINE公式アカウントをお持ちであれば、連携先システムについてはご相談ください。',
  },
  {
    q: '適格請求書（インボイス）は発行できますか？',
    a: 'インボイス登録済みです。番号確定後、正式な適格請求書を発行します。',
  },
  {
    q: '公開後の保守・修正はお願いできますか？',
    a: '別途お見積りで対応します。月額での継続サポートもご相談いただけます。',
  },
];
---

<main id="main" class="home-content">

  <!-- 1. Hero Section -->
  <section class="section hero">
    <div class="hero-inner">
      <div class="hero-content">
        <div class="hero-editorial-rule" aria-hidden="true"></div>
        <div class="hero-copy">
          <h1>
            <span class="hero-title-main">LINEと業務を、<br />つなごう。</span>
          </h1>
          <div class="hero-divider" aria-hidden="true"></div>
          <p class="lead">LINE公式アカウントの顧客データを、お使いのシステムへ自動連携。<br /><strong>Salesforce・kintone・HubSpot等に対応。二重入力をなくし、対応漏れを防ぐ仕組みを構築します。</strong></p>
          <div class="btns">
            <a class="btn primary" href={getLocalizedLink('/contact')}>
              <span>無料で相談する</span><span aria-hidden="true">→</span>
            </a>
            <a class="btn secondary" href={getLocalizedLink('/pricing')}>
              <span>料金・期間の目安</span><span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
      <div class="hero-visual">
        <svg class="hero-visual-defs" width="0" height="0" aria-hidden="true" focusable="false">
          <defs>
            <clipPath id="hero-photo-clip" clipPathUnits="objectBoundingBox">
              <path d="M0.035,0.058 C0.30,0.018 0.70,0.048 0.966,0.030 C0.986,0.35 0.980,0.66 0.970,0.956 C0.70,0.986 0.30,0.958 0.040,0.974 C0.020,0.66 0.026,0.35 0.035,0.058 Z" />
            </clipPath>
          </defs>
        </svg>
        <svg class="hero-visual-frame" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true">
          <path
            class="hero-frame-line hero-frame-line-1"
            d="M16,24 C58,13 98,25 142,17 C188,9 230,23 276,14 C314,7 352,19 384,12 C391,50 384,88 388,126 C392,166 384,202 387,240 C389,264 384,278 386,289 C346,296 304,285 260,293 C212,300 166,287 120,295 C84,300 52,287 17,294 C11,255 18,219 14,181 C10,141 17,105 12,67 C11,49 13,34 16,24 Z"
          />
          <path
            class="hero-frame-line hero-frame-line-2"
            d="M16,24 C58,13 98,25 142,17 C188,9 230,23 276,14 C314,7 352,19 384,12 C391,50 384,88 388,126 C392,166 384,202 387,240 C389,264 384,278 386,289 C346,296 304,285 260,293 C212,300 166,287 120,295 C84,300 52,287 17,294 C11,255 18,219 14,181 C10,141 17,105 12,67 C11,49 13,34 16,24 Z"
          />
        </svg>
        <img
          class="hero-visual-photo"
          src="/images/hero-meeting.webp"
          alt="打ち合わせの席で、資料と画面を見ながら和やかに方向性を話し合っている様子"
          width="1448"
          height="1086"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <section class="trust-strip" aria-label="和-Nodeの対応領域">
    <div class="trust-strip-inner">
      {trustSignals.map((signal) => (
        <div class="trust-signal">
          <strong>{signal.value}</strong>
          <span>{signal.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- 2. 課題共感セクション -->
  <section class="section issues-section" aria-labelledby="issues-title">
    <div class="section-inner">
      <div class="issues-head">
        <span class="eyebrow">Issues</span>
        <h2 id="issues-title">こんな状況、続いていませんか。</h2>
      </div>
      <ul class="issues-list">
        {issues.map((issue) => (
          <li class="issue-item">
            <span class="issue-check" aria-hidden="true">✓</span>
            <p>{issue}</p>
          </li>
        ))}
      </ul>
      <p class="issues-footer">どれか一つでも当てはまるなら、和-Nodeが力になれます。LINE連携の相談を受けるなかで、同じ問題を繰り返し耳にしてきました。だからこそ、根本から解決できます。</p>
    </div>
  </section>

  <!-- 3. 開発できること -->
  <section class="section capabilities-section" aria-labelledby="capabilities-title">
    <div class="section-inner">
      <div class="section-title">
        <span class="eyebrow">Services</span>
        <h2 id="capabilities-title">設計から実装まで、一社で。</h2>
      </div>
      <LineFlowDiagram />
      <div class="capabilities-grid">
        {capabilities.map((cap) => (
          <article class="capability-card">
            <div class="capability-icon">
              <MaterialIcon name={cap.icon} />
            </div>
            <h3>{cap.title}</h3>
            <p>{cap.desc}</p>
          </article>
        ))}
      </div>
      <p class="capabilities-note">※ 対応できない要件（Salesforceカスタム開発・大規模Apex等）は初回ヒアリングで明確にお伝えします。</p>
    </div>
  </section>

  <!-- 強み -->
  <section class="section strengths-section" aria-labelledby="strengths-title">
    <div class="section-inner">
      <div class="section-title">
        <span class="eyebrow">Why Us</span>
        <h2 id="strengths-title">なぜ和-Nodeに頼むのか。</h2>
        <p class="section-subtitle">大手SIerでもなく、LINE単体の開発会社でもない。<br />LINE連携構築に特化した専門パートナーです。</p>
      </div>
      <div class="strengths-list">
        <div class="strength-item">
          <div class="strength-num" aria-hidden="true">01</div>
          <div class="strength-body">
            <h3>ベンダー間の調整が不要。窓口は1つだけ。</h3>
            <p>LINE側の開発も連携先システムの設定も、和-Nodeが一括対応します。「LINE会社とシステム会社の言っていることが食い違う」問題が起きません。</p>
          </div>
        </div>
        <div class="strength-item">
          <div class="strength-num" aria-hidden="true">02</div>
          <div class="strength-body">
            <h3>設計・実装・テストまで一気通貫。</h3>
            <p>「要件定義だけして開発は別会社」にはなりません。動く仕組みとして納品するまで、同じ担当者が責任を持ちます。</p>
          </div>
        </div>
        <div class="strength-item">
          <div class="strength-num" aria-hidden="true">03</div>
          <div class="strength-body">
            <h3>必要な範囲を適正価格で。</h3>
            <p>大手SIerのような大規模体制は持っていません。その分、中間コストを省いた適正価格で、LINE連携構築に特化した対応が可能です。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. 開発の流れ -->
  <section class="section dev-flow-section" aria-labelledby="dev-flow-title">
    <div class="section-inner">
      <div class="section-title">
        <span class="eyebrow">Process</span>
        <h2 id="dev-flow-title">ご依頼から納品までの流れ</h2>
      </div>
      <ol class="dev-flow-list">
        {devSteps.map((step, i) => (
          <li class="dev-flow-item">
            <div class="dev-flow-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <div class="dev-flow-body">
              <span class="dev-flow-step-label">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="dev-flow-note">必要な情報・権限がそろい次第、目安4〜6週間で納品します。</p>
    </div>
  </section>

  <!-- 実績・事例 -->
  <section class="section cases-section" aria-labelledby="cases-title">
    <div class="section-inner">
      <div class="section-title">
        <span class="eyebrow">Cases</span>
        <h2 id="cases-title">連携事例のご紹介。</h2>
        <p class="section-subtitle">LINE連携の構築事例は、現在個別にご紹介しています。<br />自社の課題に当てはまるか、ぜひご相談ください。</p>
      </div>
      <div class="cases-placeholder">
        <p class="cases-placeholder-text">現在、掲載許可をいただいた実績から順次公開を進めています。<br />具体的な導入事例をお知りになりたい場合は、個別にご説明いたします。</p>
        <a class="btn secondary" href={getLocalizedLink('/contact')}>
          <span>事例について相談する</span><span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -->
  <section class="section faq-section" aria-labelledby="faq-title">
    <div class="section-inner faq-inner">
      <div class="section-title">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-title">よくあるご質問</h2>
      </div>
      <dl class="faq-list">
        {faqs.map((faq) => (
          <div class="faq-item">
            <dt class="faq-q">
              <span class="faq-mark faq-q-mark" aria-hidden="true">Q</span>
              {faq.q}
            </dt>
            <dd class="faq-a">
              <span class="faq-mark faq-a-mark" aria-hidden="true">A</span>
              {faq.a}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 6. 料金 -->
  <section class="section pricing-section" aria-labelledby="pricing-title">
    <div class="section-inner pricing-inner">
      <div class="section-title">
        <span class="eyebrow">Pricing</span>
        <h2 id="pricing-title">まず費用感を知りたい方へ。</h2>
        <p class="section-subtitle">「いくらかかるかわからない」が相談のハードルになっていませんか。<br />目安価格と料金の決まり方をお伝えします。</p>
      </div>
      <div class="pricing-card">
        <p class="pricing-includes">要件定義・設計・実装・テストを含みます。</p>
        <div class="pricing-main">
          <span class="pricing-label">Salesforce連携</span>
          <span class="pricing-price">40万円〜<small>（税別）</small></span>
        </div>
        <div class="pricing-main" style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed rgba(15, 76, 92, 0.15);">
          <span class="pricing-label">kintone連携</span>
          <span class="pricing-price">25万円〜<small>（税別）</small></span>
        </div>
        <div class="pricing-main" style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed rgba(15, 76, 92, 0.15);">
          <span class="pricing-label">HubSpot連携</span>
          <span class="pricing-price">20万円〜<small>（税別）</small></span>
        </div>
        <div class="pricing-main" style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed rgba(15, 76, 92, 0.15);">
          <span class="pricing-label">Googleスプレッドシート連携</span>
          <span class="pricing-price">10万円〜<small>（税別）</small></span>
        </div>
        <ul class="pricing-vars" style="margin-top: 16px;">
          <li>連携するデータ項目の種類・数</li>
          <li>LIFF画面（LINEアプリ内ページ）の有無・画面数</li>
          <li>連携先システムの設定状況・API権限</li>
        </ul>
        <p class="pricing-note">上記により最終費用は変動します。「自社の場合いくらになるか」を知るための初回相談は無料です。</p>
        <a class="btn primary" href={getLocalizedLink('/contact')}>
          <span>無料で費用感を聞く</span><span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 7. CTA -->
  <section class="section cta-section" aria-labelledby="cta-title">
    <div class="section-inner cta-inner">
      <h2 id="cta-title">まずは、30分の無料相談。</h2>
      <p class="cta-lead">「こんな連携はできるのか？」「自社の場合、費用はどれくらいか？」<br />そんな段階からで構いません。ご相談後に必ず契約する必要はありません。</p>
      <a class="btn primary cta-btn" href={getLocalizedLink('/contact')}>
        <span>無料相談を予約する</span><span aria-hidden="true">→</span>
      </a>
      <p class="cta-note">月の新規受付には限りがあります。気になる方はお早めに。<br />返信は営業日2日以内 ／ オンラインまたはお電話で対応</p>
    </div>
  </section>

</main>

<script is:inline>
  function initHomeInteractions() {
    const root = document.querySelector('.home-content');
    if (!root || root.dataset.homeInteractionsReady === 'true') return;
    root.dataset.homeInteractionsReady = 'true';
  }
  document.addEventListener('DOMContentLoaded', initHomeInteractions);
  document.addEventListener('astro:page-load', initHomeInteractions);
  initHomeInteractions();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;700;800&display=swap');

  :root {
    --accent: #8c6b1f;
    --accent-dark: #725719;
    --accent2: #c7352f;
    --accent2-dark: #b62f29;
    --trust: #0f4c5c;
    --trust-mid: #1f6f78;
    --trust-line: rgba(15, 76, 92, 0.18);
    --text: #333;
    --text-deep: #1a1a1a;
    --muted: #666;
    --line: rgba(140, 107, 31, 0.2);
    --soft: #f3f7f5;
    --white: #ffffff;
    --paper: #ffffff;
    --surface: #ffffff;
    --surface-strong: #fbfcfb;
    --surface-cool: #eef5f2;
    --card-border: rgba(15, 76, 92, 0.14);
    --card-border-warm: rgba(140, 107, 31, 0.24);
    --card-shadow: 0 16px 38px rgba(15, 76, 92, 0.075), 0 4px 14px rgba(70, 52, 32, 0.045);
    --card-shadow-hover: 0 24px 52px rgba(15, 76, 92, 0.12), 0 8px 20px rgba(70, 52, 32, 0.07);
    --radius: 16px;
  }

  body {
    font-family: 'Shippori Mincho', serif;
    color: var(--text);
    line-height: 1.8;
    background: linear-gradient(180deg, #ffffff 0%, #ffffff 54%, #f7faf8 100%);
  }

  .home-content {
    --home-action: #c7352f;
    --home-action-dark: #b62f29;
    --home-gold: #8c6b1f;
    --home-gold-dark: #725719;
    --home-cool: #eef5f2;
  }

  .section { padding: 80px 0; }
  .section-inner { max-width: 1000px; margin: 0 auto; padding: 0 20px; }

  h1, h2, h3, h4 { font-family: 'Shippori Mincho', serif; font-weight: 800; color: var(--text-deep); }
  h1 { font-size: clamp(2.2rem, 5vw, 4rem); line-height: 1.2; margin: 0 0 24px; }
  h2 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin-bottom: 32px; }

  .lead { font-size: 1.2rem; color: var(--muted); margin-bottom: 40px; max-width: 700px; }
  .lead strong { color: var(--accent); }

  .btns { display: flex; gap: 16px; margin-top: 40px; }
  .btn { padding: 18px 36px; border-radius: 6px; font-weight: 800; text-decoration: none; transition: all 0.3s ease; text-align: center; }
  .btn.primary { background: var(--home-action); color: white; border: 1px solid var(--home-action); box-shadow: 0 10px 25px rgba(199, 53, 47, 0.24); }
  .btn.primary:hover { background: var(--home-action-dark); border-color: var(--home-action-dark); transform: translateY(-2px); box-shadow: 0 12px 30px rgba(199, 53, 47, 0.32); }
  .btn.secondary { border: 1px solid rgba(140, 107, 31, 0.5); color: var(--home-gold); background: transparent; }
  .btn.secondary:hover { border-color: var(--home-gold); background: rgba(140, 107, 31, 0.06); transform: translateY(-1px); }

