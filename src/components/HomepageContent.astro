---
import MaterialIcon from './MaterialIcon.astro';
import { localizedPath, servicePrices, startingPrice, priceRange, serviceLabels, type SiteLanguage } from '../data/services';
import { flowPaidTotal, flowProjectedTotal, demoYen } from '../data/flowDemo';
import '../styles/service-pages.css';
interface Props { lang?: SiteLanguage }
const { lang = 'ja' } = Astro.props;
const href = (path: string) => localizedPath(path, lang);
const labels = serviceLabels[lang];
const c = {
  ja: {
    eyebrow: 'LINE連携構築', title: ['LINEの問い合わせを', '業務システムへ', '自動で登録。'],
    lead: 'LINE公式アカウントで受けた申込・問い合わせを、Salesforce・kintone・HubSpot・Googleスプレッドシートへ自動で登録します。転記や二重入力を減らす仕組みを、要件整理から公開まで一緒につくります。連携の先に専用アプリが必要な場合もご相談いただけます。',
    leadShort: 'LINE公式アカウントの申込・問い合わせを、Salesforce・kintone・HubSpot・Googleスプレッドシートへ自動で登録します。',
    view: '動く制作例を見る', assurance: '構想段階でも大丈夫です。まずは目的と必要な範囲から。',
    preview: '自動登録の流れ', sample: 'サンプル画面・外部送信なし', received: 'LINEで問い合わせ', message: '見積りについて相談したいです。', record: '顧客管理に登録', waiting: 'フォームの内容を連携中…', done: '登録・担当通知が完了', fullLine: 'LINE × kintoneのデモへ',
    fields: [['会社名', 'サンプル商事'], ['ご用件', '見積りの相談'], ['返信方法', 'LINEで返信']], pause: '動きを止める', play: '動きを再開',
    trust: [['20年以上', 'IT・開発の現場経験'], ['LINE連携の専門', '業務システム4種に対応'], ['相談から公開まで', '同じ窓口で対応']],
    servicesTitle: '対応サービスと料金の目安', servicesLead: '手段がまだ決まっていなくても、今の業務や使う人に合わせて整理します。',
    lineTitle: 'LINEの情報を、日々の業務へ。', lineDesc: '申込・問い合わせを受け付け、必要な情報を管理システムへ自動登録。転記や確認の往復を減らします。', lineFit: 'Salesforce / kintone / HubSpot / Google Sheets',
    appTitle: '毎日の操作を、使いやすいアプリに。', appDesc: '業務の記録、会員サービス、予定や費用の管理。iOS・Androidで繰り返し使う画面と機能を設計します。', appFit: '業務アプリ / 顧客向けアプリ / ストア公開支援',
    scope: '費用と対応範囲を見る', webTitle: 'Webサイト・LPの制作や改善も。', webDesc: '事業の説明から料金の比較、問い合わせまで。読み手が判断しやすい順番に整えます。', webLink: 'Web制作の料金を見る',
    worksTitle: '操作できる自主制作デモ', worksLead: '以下は自主制作のデモ・サンプルです。実在のお客様の導入実績や成果数値ではありません。', allWorks: 'すべての制作例', demo: '自主制作デモ', sampleSite: '自主制作サンプル',
    works: [['LINE × kintone', '受付・自動登録・担当通知の流れを体験。'], ['ペット健康手帳・Flow', '記録、予定、サブスクの支出管理を操作。'], ['BtoB企業サイト', '製品・技術の説明から、相談までの導線。']],
    whyEyebrow: 'AIの時代に、和-Nodeに頼む意味',
    whyTitle: ['AIで作ったシステム、', '本当に正しく動いていると確かめられますか？'],
    whyLead: 'いまは、LINEと業務システムをつなぐ仕組みもAIで形にできます。和-Nodeも、作業を速めるためにAIを使います。ただ、画面が動くことと、業務で安心して使い続けられることは別の話です。',
    whyListTitle: '連携が動いたあとに、確かめること',
    whyChecks: [['登録漏れ・二重登録', '通信が途切れたときや、同じ問い合わせが2回届いたときに、記録が消えたり重なったりしないか。'], ['個人情報の扱い', 'LINEから受け取った氏名や連絡先を、必要な範囲だけ、決めた場所に保存しているか。'], ['接続キーと権限', '接続用のキーが画面やコードに露出していないか。必要以上の権限を持たせていないか。'], ['仕様の変更', 'LINEや業務システムの仕様が変わったとき、どこを直せばよいか分かる作りになっているか。'], ['引き継ぎ', '担当者が替わっても、仕組みと運用の手順を追える形で残っているか。']],
    whyClose: 'IT・開発の現場で20年以上積み重ねた知識をもとに、AIが作った部分も含めて、人が一つずつ確認してからお渡しします。',
    approachTitle: '和-Nodeの進め方', approachLead: '技術を選ぶ前に、誰が、いつ、何のために使うのか。心理学と開発の両面から、情報の順番と操作の流れを組み立てます。', about: '和-Nodeについて',
    steps: [['整理する', '現状と目的を伺い、必要な機能と優先順位を確認。'], ['見える形にする', '画面・連携範囲・費用・期間を具体化してから着手。'], ['確かめて、届ける', '操作と連携を確認し、公開・運用の引継ぎまで対応。']],
    scopeTitle: 'ご相談をお受けする範囲', scopeLead: '最初に線引きをお伝えします。合わないご相談に、お互いの時間を使わないためです。',
    scopeYes: '向いているご相談', scopeNo: 'お受けしていないこと',
    scopeFor: ['LINEと業務システムを別々に運用していて、転記や二重入力が発生している', 'Salesforce・kintone・HubSpot・Googleスプレッドシートのいずれかを既に使っている', '社内に相談できるIT担当がいない、または手が足りていない'],
    scopeNot: ['連携先となる業務システムを、まだ導入していない', 'LINE公式アカウントの構築だけを希望している'],
    finalTitle: '構想段階からご相談いただけます', finalDesc: '必要なことも、まだ決まっていないことも。そのまま聞かせてください。',
  },
  en: {
    eyebrow: 'LINE integration', title: ['LINE inquiries,', 'registered in your', 'business system.'],
    leadShort: 'Inquiries from your LINE Official Account, registered automatically in Salesforce, kintone, HubSpot or Google Sheets.',
    lead: 'Requests and inquiries received on your LINE Official Account are registered automatically in Salesforce, kintone, HubSpot or Google Sheets. We build the integration with you, from requirements to launch, to reduce copying and double entry. If you also need a dedicated app, we can discuss that too.',
    view: 'Explore working demos', assurance: 'An early idea is enough. Start with your goals and the scope you need.',
    preview: 'How automatic registration works', sample: 'Sample interface · no data sent', received: 'A LINE inquiry arrives', message: 'I would like to discuss a quote.', record: 'Add to customer management', waiting: 'Transferring the form details…', done: 'Record added · team notified', fullLine: 'Explore the LINE × kintone demo',
    fields: [['Company', 'Sample Co.'], ['Request', 'Quote inquiry'], ['Reply via', 'LINE']], pause: 'Pause animation', play: 'Play animation',
    trust: [['20+ years', 'Experience in IT & development'], ['LINE specialist', '4 business systems supported'], ['From idea to launch', 'One point of contact']],
    servicesTitle: 'Start with what you want to do.', servicesLead: 'No need to choose a technology first. We clarify what fits your workflow and users.',
    lineTitle: 'Connect LINE to everyday work.', lineDesc: 'Capture requests and inquiries, then register the relevant details in your business system. Reduce repeated entry and back-and-forth checks.', lineFit: 'Salesforce / kintone / HubSpot / Google Sheets',
    appTitle: 'Make everyday tasks easier in an app.', appDesc: 'Work records, member services, schedules and expense tracking. We design iOS and Android interfaces for regular use.', appFit: 'Business apps / Customer apps / Store submission support',
    scope: 'View scope and pricing', webTitle: 'Websites and landing pages, too.', webDesc: 'Clear information from understanding your business to comparing prices and making an inquiry.', webLink: 'View web design pricing',
    worksTitle: 'See how it works. Try it yourself.', worksLead: 'These are independently built demos and samples, not client deployments or measured business results.', allWorks: 'All projects & demos', demo: 'Independent demo', sampleSite: 'Independent sample',
    works: [['LINE × kintone', 'Try inquiry capture, record creation and team notifications.'], ['Pet Health Note & Flow', 'Explore records, schedules and subscription expenses.'], ['B2B company website', 'Follow the path from products and technology to an inquiry.']],
    whyEyebrow: 'Why work with Wa-Node when AI can build it?',
    whyTitle: ['AI can build a system.', 'Can you confirm it really works correctly?'],
    whyLead: 'Today, AI can put together an integration between LINE and your business system. Wa-Node uses AI too, to work faster. But a screen that runs is not the same as a system your team can rely on every day.',
    whyListTitle: 'What we check once the integration runs',
    whyChecks: [['Missing or duplicate records', 'Records are not lost or duplicated when a connection drops or the same inquiry arrives twice.'], ['Personal data', 'Names and contact details from LINE are stored only as needed, and only where agreed.'], ['Keys and permissions', 'Connection keys are not exposed in screens or code, and no account has more access than it needs.'], ['Specification changes', 'When LINE or your business system changes, it is clear what needs to be updated.'], ['Handover', 'If the person in charge changes, the setup and operating steps can still be followed.']],
    whyClose: 'Drawing on more than 20 years in IT and development, we review every part by hand, including anything AI produced, before handing it over.',
    approachTitle: 'Begin with how people will use it.', approachLead: 'Who uses it, when, and why? We bring psychology and development together to shape clear information and intuitive interactions.', about: 'About Wa-Node',
    steps: [['Understand', 'Clarify the current situation, goals and priorities.'], ['Make it concrete', 'Agree on screens, scope, cost and timing before work begins.'], ['Check and deliver', 'Verify interactions and integrations, then support launch and handover.']],
    scopeTitle: 'What fits, and what we do not take on.', scopeLead: 'We state the boundary up front, so neither of us spends time on a poor match.',
    scopeYes: 'A good fit', scopeNo: 'Not a fit',
    scopeFor: ['LINE and your business system run separately, causing re-entry and duplicate work', 'You already use Salesforce, kintone, HubSpot or Google Sheets', 'You have no in-house IT contact, or not enough hands'],
    scopeNot: ['The business system to connect to is not in place yet', 'You only want a LINE official account set up'],
    finalTitle: 'Start with “could this work?”', finalDesc: 'Tell us what you know and what you are still figuring out.',
  },
  fr: {
    eyebrow: 'Intégration LINE', title: ['Les demandes LINE,', 'enregistrées dans', 'votre outil métier.'],
    leadShort: 'Les demandes reçues sur LINE, enregistrées automatiquement dans Salesforce, kintone, HubSpot ou Google Sheets.',
    lead: 'Les demandes reçues sur votre compte officiel LINE sont enregistrées automatiquement dans Salesforce, kintone, HubSpot ou Google Sheets. Nous construisons l’intégration avec vous, des besoins au lancement, pour limiter les ressaisies. Une application dédiée peut aussi être envisagée si nécessaire.',
    view: 'Essayer les démonstrations', assurance: 'Une première idée suffit. Partons de vos objectifs et du périmètre nécessaire.',
    preview: 'Le parcours d’enregistrement', sample: 'Interface fictive · aucun envoi', received: 'Une demande arrive sur LINE', message: 'Je souhaite discuter d’un devis.', record: 'Ajout à la gestion clients', waiting: 'Transfert des informations…', done: 'Fiche créée · équipe informée', fullLine: 'Voir la démo LINE × kintone',
    fields: [['Entreprise', 'Exemple SA'], ['Objet', 'Devis'], ['Réponse', 'Par LINE']], pause: 'Mettre en pause', play: 'Relancer l’animation',
    trust: [['Plus de 20 ans', 'D’expérience en informatique'], ['Spécialiste LINE', '4 outils métier pris en charge'], ['De l’idée au lancement', 'Un interlocuteur unique']],
    servicesTitle: 'Partons de ce que vous voulez faire.', servicesLead: 'Inutile de choisir la technologie au départ. Nous clarifions les besoins de votre activité et de vos utilisateurs.',
    lineTitle: 'Relier LINE à votre activité.', lineDesc: 'Recevez les demandes et inscrivez les informations utiles dans votre système de gestion pour limiter les doubles saisies et les vérifications répétées.', lineFit: 'Salesforce / kintone / HubSpot / Google Sheets',
    appTitle: 'Simplifier les gestes du quotidien.', appDesc: 'Suivi d’activité, services aux membres, agendas et dépenses : des applications iOS et Android conçues pour un usage régulier.', appFit: 'Applications métier / Services clients / Publication',
    scope: 'Voir le périmètre et les tarifs', webTitle: 'Sites web et pages de vente aussi.', webDesc: 'Des informations claires pour comprendre votre activité, comparer les offres et vous contacter.', webLink: 'Voir les tarifs web',
    worksTitle: 'Découvrez le fonctionnement en l’essayant.', worksLead: 'Ces créations sont des démonstrations et exemples indépendants, sans résultats clients ni déploiements réels revendiqués.', allWorks: 'Toutes les créations', demo: 'Démo indépendante', sampleSite: 'Exemple indépendant',
    works: [['LINE × kintone', 'Tester la réception, la création de fiche et les notifications.'], ['Pet Health Note & Flow', 'Découvrir les dossiers, les agendas et le suivi des abonnements.'], ['Site d’entreprise BtoB', 'Parcourir les produits et les technologies jusqu’à la prise de contact.']],
    whyEyebrow: 'Pourquoi Wa-Node, quand l’IA peut le faire ?',
    whyTitle: ['Un système créé avec l’IA :', 'pouvez-vous vérifier qu’il fonctionne vraiment correctement ?'],
    whyLead: 'Aujourd’hui, l’IA peut assembler une intégration entre LINE et votre outil métier. Wa-Node utilise aussi l’IA pour travailler plus vite. Mais un écran qui fonctionne n’est pas encore un système fiable au quotidien.',
    whyListTitle: 'Ce que nous vérifions une fois l’intégration en marche',
    whyChecks: [['Fiches perdues ou en double', 'Aucune fiche perdue ou dupliquée si la connexion coupe ou si la même demande arrive deux fois.'], ['Données personnelles', 'Les noms et coordonnées reçus via LINE sont conservés au strict nécessaire, à l’endroit convenu.'], ['Clés et droits d’accès', 'Les clés de connexion ne sont pas exposées dans les écrans ou le code, et aucun compte n’a plus de droits que nécessaire.'], ['Évolutions des services', 'Si LINE ou votre outil métier évolue, on sait clairement quoi mettre à jour.'], ['Transmission', 'Si l’interlocuteur change, le fonctionnement et les procédures restent faciles à suivre.']],
    whyClose: 'Forts de plus de 20 ans d’expérience en informatique et en développement, nous vérifions chaque élément à la main, y compris ce que l’IA a produit, avant de vous le livrer.',
    approachTitle: 'Penser aux usages avant de développer.', approachLead: 'Qui l’utilise, quand et pourquoi ? Nous associons psychologie et développement pour organiser des informations claires et des interactions simples.', about: 'À propos de Wa-Node',
    steps: [['Comprendre', 'Clarifier la situation, les objectifs et les priorités.'], ['Concrétiser', 'Définir les écrans, le périmètre, le coût et les délais avant de commencer.'], ['Vérifier et livrer', 'Vérifier les interactions, puis accompagner le lancement et la prise en main.']],
    scopeTitle: 'Ce qui correspond, et ce que nous ne prenons pas.', scopeLead: 'Nous posons la limite dès le départ, pour ne pas perdre votre temps ni le nôtre.',
    scopeYes: 'Demandes adaptées', scopeNo: 'Hors périmètre',
    scopeFor: ['LINE et votre système de gestion fonctionnent séparément, avec des ressaisies', 'Vous utilisez déjà Salesforce, kintone, HubSpot ou Google Sheets', 'Vous n’avez pas d’interlocuteur informatique en interne, ou pas assez de moyens'],
    scopeNot: ['Le système de gestion à relier n’est pas encore en place', 'Vous souhaitez uniquement la création d’un compte officiel LINE'],
    finalTitle: 'Commençons par votre idée.', finalDesc: 'Dites-nous ce qui est défini et ce qui reste à préciser.',
  },
}[lang];
const workLinks = ['/case-studies/line-kintone-demo/', '/mobile-app-demo/', '/case-studies/b2b-corporate-renewal/'];
---
<main id="main" class="service-page home-refresh" data-glossary-skip data-reveal="off">
  <section class="home-hero">
    <div class="s-shell hero-layout">
      <div class="hero-copy">
        <p class="s-eyebrow">{c.eyebrow}</p>
        <h1>{c.title.map(line => <span>{line}</span>)}</h1>
        <p class="s-intro hero-lead">{c.lead}</p>
        <p class="s-intro hero-lead-short">{c.leadShort}</p>
        <div class="s-actions"><a class="s-button" href={href('/contact/?source=top')}>{labels.consultation}<MaterialIcon name="arrow_forward" /></a><a class="s-button secondary" href="#selected-works">{c.view}</a></div>
        <p class="s-note">{c.assurance}</p>
      </div>
      <div class="hero-demo" data-home-demo>
        <div class="demo-title"><span>{c.preview}</span><button type="button" class="demo-toggle" data-demo-toggle aria-pressed="false" data-pause={c.pause} data-play={c.play} hidden><MaterialIcon name="pause" /><span data-demo-toggle-label>{c.pause}</span></button></div>
        <div class="preview-panel">
          <div class="connection-source"><span class="source-icon">LINE</span><div class="line-bubble"><strong>{c.received}</strong><p>{c.message}</p></div></div>
          <div class="connection-track" aria-hidden="true"><MaterialIcon name="south" /><span>LINE → kintone</span></div>
          <div class="connection-target">
            <div class="target-head"><span class="target-icon"><MaterialIcon name="inventory_2" /></span><strong>{c.record}</strong></div>
            <dl class="record-fields">{c.fields.map(([term, value], i) => <div class:list={['record-field', `record-field-${i + 1}`]}><dt>{term}</dt><dd>{value}</dd></div>)}</dl>
            <p class="record-status"><span class="status-wait" aria-hidden="true">{c.waiting}</span><span class="status-done"><MaterialIcon name="check_circle" />{c.done}</span></p>
          </div>
          <a class="preview-detail" href={href(workLinks[0])}>{c.fullLine} <span aria-hidden="true">↗</span></a>
        </div>
        <p class="demo-disclosure">{c.sample}</p>
      </div>
    </div>
  </section>
  <div class="trust-strip s-shell">{c.trust.map(([value, label]) => <div><strong>{value}</strong><span>{label}</span></div>)}</div>
  <section class="s-section" id="services"><div class="s-shell">
    <div class="s-section-head" data-motion-enter="heading" data-motion-id="services-heading"><div><h2>{c.servicesTitle}</h2><p class="s-intro">{c.servicesLead}</p></div></div>
    <div class="s-grid-two service-choices">
      {[{id:'line',icon:'forum',label:labels.line,title:c.lineTitle,desc:c.lineDesc,fit:c.lineFit,priceText:priceRange(servicePrices.lineSheets,servicePrices.lineSalesforce,lang)},{id:'app',icon:'smartphone',label:labels.app,title:c.appTitle,desc:c.appDesc,fit:c.appFit,priceText:startingPrice(servicePrices.businessApp,lang)}].map((item,i) => <article class="service-choice" data-motion-enter="block" data-motion-group="services"><div class="choice-label"><MaterialIcon name={item.icon}/><span>{item.label}</span></div><h3>{item.title}</h3><p>{item.desc}</p><p class="service-fit">{item.fit}</p><div class="service-choice-foot"><strong>{item.priceText}</strong><a class="s-link" href={href(`/pricing/#${item.id}`)}>{c.scope}<span aria-hidden="true">→</span></a></div></article>)}
    </div>
    <p class="s-note">{labels.tax}</p>
  </div></section>
  <section class="s-section scope-section" id="scope"><div class="s-shell">
    <div class="s-section-head" data-motion-enter="heading" data-motion-id="scope-heading"><div><h2>{c.scopeTitle}</h2><p class="s-intro">{c.scopeLead}</p></div></div>
    <div class="s-grid-two scope-split">
      <div class="scope-col scope-col-yes"><h3><MaterialIcon name="check_circle"/>{c.scopeYes}</h3><ul>{c.scopeFor.map(t => <li>{t}</li>)}</ul></div>
      <div class="scope-col scope-col-no"><h3><MaterialIcon name="do_not_disturb_on"/>{c.scopeNo}</h3><ul>{c.scopeNot.map(t => <li>{t}</li>)}</ul></div>
    </div>
  </div></section>
  <section class="s-section works-section" id="selected-works"><div class="s-shell">
    <div class="s-section-head" data-motion-enter="heading" data-motion-id="works-heading"><div><h2>{c.worksTitle}</h2></div><a class="s-link" href={href('/works/')}>{c.allWorks}<span aria-hidden="true">→</span></a></div>
    <div class="s-grid selected-grid">{c.works.map(([title,desc],i) => <a class="selected-work" href={href(workLinks[i])}>
      <div class:list={['work-preview',`work-preview-${i}`]} aria-hidden="true">{i===0 ? <><span class="mini-line">LINE</span><MaterialIcon name="east"/><span class="mini-crm">kintone</span><small>FORM → RECORD → NOTIFY</small></> : i===1 ? <><div class="mini-app"><MaterialIcon name="pets"/><span>Pet Health Note</span></div><div class="mini-app flow"><span>Flow</span><strong>{demoYen(flowPaidTotal)}</strong></div></> : <img src="/images/works/captures/work-08.webp" alt="" width="720" height="450" loading="lazy" decoding="async"/>}</div>
      <div class="work-caption"><span>{i===2?c.sampleSite:c.demo}</span><h3>{title}<MaterialIcon name="north_east"/></h3><p>{desc}</p></div>
    </a>)}</div><p class="s-note">{c.worksLead}</p>
  </div></section>
  <section class="s-section why-section" id="why-wa-node" aria-labelledby="why-title"><div class="s-shell">
    <div class="why-head">
      <p class="s-eyebrow">{c.whyEyebrow}</p>
      <h2 id="why-title">{c.whyTitle.map(line => <span>{line}</span>)}</h2>
      <p class="s-intro">{c.whyLead}</p>
    </div>
    <h3 class="why-list-title">{c.whyListTitle}</h3>
    <ol class="why-checks">{c.whyChecks.map(([title, desc], i) => <li><span class="s-number">0{i + 1}</span><div><h4>{title}</h4><p>{desc}</p></div></li>)}</ol>
    <p class="why-close">{c.whyClose}</p>
  </div></section>
  <section class="s-section"><div class="s-shell approach-layout"><div><h2>{c.approachTitle}</h2><p class="s-intro">{c.approachLead}</p><a class="s-link" href={href('/about/')}>{c.about}<span aria-hidden="true">→</span></a></div><ol class="approach-steps">{c.steps.map(([title,desc],i) => <li data-motion-enter="block" data-motion-group="approach"><span class="s-number">0{i+1}</span><div><h3>{title}</h3><p>{desc}</p></div></li>)}</ol></div></section>
  <section class="s-contact-band"><div class="s-shell"><div><h2>{c.finalTitle}</h2><p>{c.finalDesc}</p></div><a class="s-button" href={href('/contact/?source=top')}>{labels.consultation}<MaterialIcon name="arrow_forward"/></a></div></section>
</main>
