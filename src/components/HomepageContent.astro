</style>
<script>
import { isReducedMotion, onReducedMotionChange } from '../scripts/motion-pref';

function initHomeDemo() {
  const demo = document.querySelector<HTMLElement>('[data-home-demo]');
  if (!demo || demo.dataset.initialized) return;
  demo.dataset.initialized = 'true';
  const toggle = demo.querySelector<HTMLButtonElement>('[data-demo-toggle]');
  const label = demo.querySelector<HTMLElement>('[data-demo-toggle-label]');
  const icon = toggle?.querySelector<HTMLElement>('.material-symbols-rounded');
  // JSが動かない・動きを減らす設定・タブが非表示の場合は、完成した状態のまま表示する
  // （非表示のタブではCSSアニメーションが開始位置で止まり、項目が空に見えるため。TRB-202609-045）
  function apply() {
    // 触れるデモを操作した後は、自動再生に戻さない
    const live = demo!.classList.contains('is-live');
    const play = !live && !isReducedMotion() && document.visibilityState === 'visible';
    demo!.classList.toggle('is-playing', play);
    if (toggle) toggle.hidden = live || isReducedMotion();
  }
  apply();
  onReducedMotionChange(apply);
  document.addEventListener('visibilitychange', apply);
  toggle?.addEventListener('click', () => {
    const paused = demo.classList.toggle('is-paused');
    toggle.setAttribute('aria-pressed', String(paused));
    if (label) label.textContent = paused ? toggle.dataset.play! : toggle.dataset.pause!;
    if (icon) icon.textContent = paused ? 'play_arrow' : 'pause';
  });
  const rerun = initTry(demo);
  initTargets(demo, rerun);
}

// 登録先の切替：見出し・項目名・完了表示・詳しいデモへのリンクを、選んだシステムのものに差し替える。
// JSが動かない環境では切替ボタンを出さず、最初の登録先（kintone）のまま表示する。
interface DemoTarget { name: string; track: string; record: string; fields: string[]; done: string; link: string; href: string }
function initTargets(demo: HTMLElement, rerun: (() => boolean) | undefined) {
  const group = demo.querySelector<HTMLElement>('[data-demo-targets]');
  if (!group || !demo.dataset.targets) return;
  const targets = JSON.parse(demo.dataset.targets) as DemoTarget[];
  const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-target]')];
  const set = (selector: string, text: string) => { const el = demo.querySelector<HTMLElement>(selector); if (el) el.textContent = text; };
  const terms = [...demo.querySelectorAll<HTMLElement>('.record-field dt')];
  const detail = demo.querySelector<HTMLAnchorElement>('[data-demo-detail]');
  const live = demo.querySelector<HTMLElement>('[data-demo-live]');
  group.hidden = false;

  function select(index: number) {
    const target = targets[index];
    if (!target) return;
    buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
    set('[data-demo-track]', target.track);
    set('[data-demo-record]', target.record);
    terms.forEach((dt, i) => { dt.textContent = target.fields[i] ?? dt.textContent; });
    demo.dataset.doneText = target.done;
    // 会社名が読み取れなかった場合の完了表示は、触れるデモ側で差し替えるため、ここでは通常の完了表示だけを入れる
    if (!demo.classList.contains('is-live')) set('[data-demo-done]', target.done);
    if (detail) {
      detail.href = target.href;
      set('[data-demo-detail-label]', target.link);
    }
    // 触れるデモの操作後は、同じ文章で登録をやり直す。自動再生中は最初から再生し直す
    if (rerun?.()) return;
    if (demo.classList.contains('is-playing')) {
      demo.classList.remove('is-playing');
      void demo.offsetWidth;
      demo.classList.add('is-playing');
    }
    if (live) live.textContent = `${demo.dataset.targetSwitched ?? ''}${target.name}`;
  }
  buttons.forEach((button) => button.addEventListener('click', () => select(Number(button.dataset.target))));
}

// 触れるデモ：選んだ文・入力した文から項目を取り出し、登録までの流れをこの画面の中だけで再生する。
// 文章はどこにも送信・保存しない。JSが動かない環境では操作部を出さず、自動再生のデモだけを表示する。
interface DemoRules {
  company: string; companyTrim: string;
  purposes: [string, string][]; defaultPurpose: string;
  replies: [string, string][]; defaultReply: string;
  missing: string; doneMissing: string; live: string;
}
function initTry(demo: HTMLElement): (() => boolean) | undefined {
  const panel = demo.querySelector<HTMLElement>('[data-demo-try]');
  if (!panel || !demo.dataset.rules) return;
  const rules = JSON.parse(demo.dataset.rules) as DemoRules;
  const form = panel.querySelector<HTMLFormElement>('[data-demo-form]');
  const input = form?.querySelector<HTMLInputElement>('input');
  const own = panel.querySelector<HTMLButtonElement>('[data-demo-own]');
  const message = demo.querySelector<HTMLElement>('.line-bubble p');
  const fields = [...demo.querySelectorAll<HTMLElement>('.record-field')];
  const status = demo.querySelector<HTMLElement>('.record-status');
  const done = demo.querySelector<HTMLElement>('[data-demo-done]');
  const live = demo.querySelector<HTMLElement>('[data-demo-live]');
  const toggle = demo.querySelector<HTMLButtonElement>('[data-demo-toggle]');
  const initialDone = done?.textContent ?? '';
  let lastText = '';
  let timers: number[] = [];
  panel.hidden = false;
  // 試す部分は、ボタンを押したときだけ開く（FVの縦の長さを抑えるため）
  const opener = panel.querySelector<HTMLButtonElement>('[data-demo-try-open]');
  const body = panel.querySelector<HTMLElement>('[data-demo-try-body]');
  opener?.addEventListener('click', () => {
    if (!body) return;
    const open = body.hidden;
    body.hidden = !open;
    opener.setAttribute('aria-expanded', String(open));
  });

  const pick = (text: string, list: [string, string][], fallback: string) =>
    list.find(([pattern]) => new RegExp(pattern, 'i').test(text))?.[1] ?? fallback;

  function extract(text: string) {
    let company = text.match(new RegExp(rules.company))?.[0]?.trim() ?? '';
    if (company && rules.companyTrim) company = company.replace(new RegExp(rules.companyTrim), '');
    return {
      company,
      purpose: pick(text, rules.purposes, rules.defaultPurpose),
      reply: pick(text, rules.replies, rules.defaultReply),
    };
  }

  function run(text: string) {
    const value = text.trim().slice(0, 120);
    if (!value || !message || !status) return;
    lastText = value;
    timers.forEach((t) => clearTimeout(t));
    timers = [];
    // 自動再生を止め、操作した結果だけを表示する
    demo.classList.remove('is-playing', 'is-paused');
    demo.classList.add('is-live');
    if (toggle) toggle.hidden = true;
    const result = extract(value);
    const values = [result.company || rules.missing, result.purpose, result.reply];
    message.textContent = value;
    fields.forEach((field, i) => {
      field.classList.remove('is-filled');
      field.classList.toggle('is-missing', i === 0 && !result.company);
      const dd = field.querySelector('dd');
      if (dd) dd.textContent = values[i];
    });
    if (done) done.textContent = result.company ? (demo.dataset.doneText ?? initialDone) : rules.doneMissing;
    const finish = () => {
      status.dataset.state = 'done';
      if (live) live.textContent = `${rules.live}${fields.map((f, i) => `${f.querySelector('dt')?.textContent}: ${values[i]}`).join(' / ')}`;
    };
    if (isReducedMotion()) {
      fields.forEach((f) => f.classList.add('is-filled'));
      finish();
      return;
    }
    status.dataset.state = 'wait';
    fields.forEach((f, i) => timers.push(window.setTimeout(() => f.classList.add('is-filled'), 500 + i * 300)));
    timers.push(window.setTimeout(finish, 500 + fields.length * 300 + 200));
  }

  panel.querySelectorAll<HTMLButtonElement>('[data-sample]').forEach((button) => {
    button.addEventListener('click', () => run(button.dataset.sample!));
  });
  own?.addEventListener('click', () => {
    if (!form) return;
    const open = form.hidden;
    form.hidden = !open;
    own.setAttribute('aria-expanded', String(open));
    if (open) input?.focus();
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (input) run(input.value);
  });
  // 登録先を切り替えたときに、操作済みなら同じ文章で再実行する（実行したら true）
  return () => {
    if (!lastText) return false;
    run(lastText);
    return true;
  };
}
initHomeDemo();
document.addEventListener('astro:page-load', initHomeDemo);
</script>
