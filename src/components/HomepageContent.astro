    { name: 'Salesforce', track: 'LINE → Salesforce', record: 'Créer une piste', fields: ['Entreprise', 'Description', 'Contact'], done: 'Piste créée · équipe informée', link: 'Voir la démo LINE × Salesforce', path: '/case-studies/line-salesforce-demo/' },
    { name: 'HubSpot', track: 'LINE → HubSpot', record: 'Créer un contact', fields: ['Entreprise', 'Demande', 'Contact'], done: 'Contact créé · équipe informée', link: 'Voir la démo LINE × HubSpot', path: '/case-studies/line-hubspot-demo/' },
    { name: 'Google Sheets', track: 'LINE → Google Sheets', record: 'Ajouter une ligne', fields: ['Entreprise', 'Objet', 'Réponse'], done: 'Ligne ajoutée · équipe informée', link: 'Voir la démo LINE × Google Sheets', path: '/case-studies/line-spreadsheet-demo/' },
  ] as DemoTarget[] },
}[lang];
const firstTarget = demoTargets.items[0];
// 文章だけの項目に添えるアイコン（登録漏れ・個人情報・接続キー・仕様変更・引き継ぎ／整理・具体化・確認）
const whyIcons = ['done_all', 'verified_user', 'lock', 'update', 'menu_book'];
const approachIcons = ['checklist', 'preview', 'task_alt'];
const targetData = demoTargets.items.map((t) => ({ ...t, href: href(t.path) }));
---
<main id="main" class="service-page home-refresh" data-glossary-skip data-reveal="off">
  <section class="home-hero">
    <div class="s-shell hero-layout">
      <div class="hero-copy">
        <p class="s-eyebrow">{c.eyebrow}</p>
        <h1 class:list={{ 'is-ja': lang === 'ja' }}>{c.title.map((line, i) => <>{i > 0 && lang !== 'ja' && ' '}<span>{line.split('|').map((phrase) => <span class="phrase">{phrase}</span>)}</span></>)}</h1>
        <div class="hero-reading">
        <p class="s-intro hero-lead">{c.lead}</p>
        <p class="s-intro hero-lead-short">{c.leadShort}</p>
        <p class="hero-audience">{audience}</p>
        <div class="s-actions"><a class="s-button" href={href('/contact/?source=top')}>{labels.consultation}<MaterialIcon name="arrow_forward" /></a><a class="s-link hero-secondary" href="#selected-works">{c.view}<MaterialIcon name="arrow_forward" /></a></div>
        <p class="s-note">{c.assurance}</p>
        </div>
        <nav class="hero-prices" aria-label={c.connectorsTitle}>
          <p class="hero-prices-title">{c.connectorsTitle}</p>
          <ul>{connectors.map(([name, amount]) => <li><a href={href(connectorDemo[name])}><span class="hp-name">{name}</span><span class="hp-price">{startingPrice(amount, lang)}</span><MaterialIcon name="arrow_forward" /></a></li>)}</ul>
          <p class="hero-prices-note">{labels.tax}</p>
        </nav>
      </div>
      <div class="hero-demo" data-home-demo data-rules={JSON.stringify(c.rules)} data-targets={JSON.stringify(targetData)} data-target-switched={demoTargets.switched}>
        <div class="demo-title"><span>{c.preview}</span><button type="button" class="demo-toggle" data-demo-toggle aria-pressed="false" data-pause={c.pause} data-play={c.play} hidden><MaterialIcon name="pause" /><span data-demo-toggle-label>{c.pause}</span></button></div>
        <p class="demo-scope">{c.demoScope}</p>
        <div class="demo-targets" role="group" aria-label={demoTargets.label} data-demo-targets hidden>{demoTargets.items.map((t, i) => <button type="button" class="demo-target" data-target={i} aria-pressed={i === 0 ? 'true' : 'false'}>{t.name}</button>)}</div>
        <div class="preview-panel">
          <div class="connection-source"><span class="source-icon"><img src="/images/brand/line/LINE_Brand_icon.png" alt="LINE" width="40" height="40" /></span><div class="line-bubble"><strong>{c.received}</strong><p>{c.message}</p></div></div>
          <div class="connection-track" aria-hidden="true"><MaterialIcon name="south" /><span data-demo-track>{firstTarget.track}</span></div>
          <div class="connection-target">
            <div class="target-head"><span class="target-icon"><MaterialIcon name="inventory_2" /></span><strong data-demo-record>{firstTarget.record}</strong></div>
            <dl class="record-fields">{c.fields.map(([, value], i) => <div class:list={['record-field', `record-field-${i + 1}`]}><dt>{firstTarget.fields[i]}</dt><dd>{value}</dd></div>)}</dl>
            <p class="record-status"><span class="status-wait" aria-hidden="true">{c.waiting}</span><span class="status-done"><MaterialIcon name="check_circle" /><span data-demo-done>{firstTarget.done}</span></span></p>
          </div>
          <a class="preview-detail" href={href(firstTarget.path)} data-demo-detail><span data-demo-detail-label>{firstTarget.link}</span> <span aria-hidden="true">↗</span></a>
        </div>
        <div class="demo-try" data-demo-try hidden>
          <button type="button" class="demo-try-open" data-demo-try-open aria-expanded="false" aria-controls={`demo-try-body-${lang}`}><MaterialIcon name="touch_app" /><span>{c.tryOpen}</span><MaterialIcon name="keyboard_arrow_down" class="demo-try-caret" /></button>
          <div class="demo-try-body" id={`demo-try-body-${lang}`} data-demo-try-body hidden>
          <p class="demo-try-label" id={`demo-try-label-${lang}`}>{c.tryLabel}</p>
          <div class="demo-try-samples" role="group" aria-labelledby={`demo-try-label-${lang}`}>
            {c.samples.map(([label, text]) => <button type="button" class="demo-chip" data-sample={text}>{label}</button>)}
            <button type="button" class="demo-chip demo-chip-own" data-demo-own aria-expanded="false" aria-controls={`demo-try-form-${lang}`}><MaterialIcon name="edit_note" />{c.tryOwn}</button>
          </div>
          <form class="demo-try-form" id={`demo-try-form-${lang}`} data-demo-form hidden>
            <label for={`demo-try-input-${lang}`}>{c.inputLabel}</label>
            <div class="demo-try-row"><input id={`demo-try-input-${lang}`} type="text" maxlength="120" autocomplete="off" placeholder={c.placeholder} required /><button type="submit" class="demo-send">{c.send}</button></div>
          </form>
          <p class="demo-try-note">{c.tryNote}</p>
          </div>
        </div>
        <p class="demo-live" aria-live="polite" data-demo-live></p>
        <p class="demo-disclosure">{c.sample}</p>
      </div>
    </div>
  </section>
  <section class="s-section" id="services"><div class="s-shell">
    <div class="s-section-head" data-motion-enter="heading" data-motion-id="services-heading"><div><h2>{c.servicesTitle}</h2><p class="s-intro">{c.servicesLead}</p></div></div>
    <div class="s-grid-two service-choices">
      {[{id:'line',icon:'forum',label:labels.line,title:c.lineTitle,desc:c.lineDesc,fit:c.lineFit,priceText:startingPrice(servicePrices.lineSheets,lang)}].map((item,i) => <article class="service-choice" data-motion-enter="block" data-motion-group="services"><div class="choice-label"><MaterialIcon name={item.icon}/><span>{item.label}</span></div><h3>{item.title}</h3><p>{item.desc}</p><p class="service-fit">{item.fit}</p><div class="service-choice-foot"><strong>{item.priceText}</strong><a class="s-link" href={href(`/pricing/#${item.id}`)}>{c.scope}<span aria-hidden="true">→</span></a></div></article>)}
      <article class="service-choice connector-prices" data-motion-enter="block" data-motion-group="services"><h3>{c.connectorsTitle}</h3><dl>{connectors.map(([name, amount]) => <div><dt>{name}</dt><dd>{startingPrice(amount, lang)}</dd></div>)}</dl></article>
    </div>
    <p class="s-note">{labels.tax}</p>
    <p class="app-note">{c.appNote} {startingPrice(servicePrices.businessApp, lang)}{lang==='ja'?'）':')'}<a class="s-link" href={href('/pricing/#app')}>{c.scope}<span aria-hidden="true">→</span></a></p>
  </div></section>
  <section class="s-section scope-section" id="scope"><div class="s-shell">
    <div class="s-section-head" data-motion-enter="heading" data-motion-id="scope-heading"><div><h2>{c.scopeTitle}</h2><p class="s-intro">{c.scopeLead}</p></div></div>
    <div class="s-grid-two scope-split">
      <div class="scope-col scope-col-yes"><h3><MaterialIcon name="check_circle"/>{c.scopeYes}</h3><ul>{c.scopeFor.map(t => <li>{t}</li>)}</ul></div>
      <div class="scope-col scope-col-no"><h3><MaterialIcon name="do_not_disturb_on"/>{c.scopeNo}</h3><ul>{c.scopeNot.map(t => <li>{t}</li>)}</ul></div>
    </div>
  </div></section>
  <HomeFlowScroll lang={lang} compact />
  <section class="s-section works-section" id="selected-works"><div class="s-shell">
    <div class="s-section-head" data-motion-enter="heading" data-motion-id="works-heading"><div><h2>{c.worksTitle}</h2></div><a class="s-link" href={href('/works/')}>{c.allWorks}<span aria-hidden="true">→</span></a></div>
    <p class="s-note usecase-disclosure">{c.worksLead}</p>
    <div class="usecase-showcase">{c.works.map(([title,desc],i) => <a class="selected-work" href={href(workLinks[i])}>
      <div class="work-preview" transition:name={`case-${workSlugs[i]}-visual`}><img src={`/images/works/captures/${workImages[i]}`} alt="" width="736" height={workImageHeights[i]} loading="lazy" decoding="async" /></div>
      <div class="work-caption"><span>{c.demo}</span><h3 transition:name={`case-${workSlugs[i]}-title`}>{title}</h3><p class="work-system">LINE × {workTargets[i]}</p><p>{desc}</p><span class="work-action">{c.tryDemo}<span aria-hidden="true">→</span></span>{c.demoLanguage && <small class="work-language">{c.demoLanguage}</small>}</div>
    </a>)}</div>
  </div></section>
  <section class="s-section why-section" id="why-wa-node" aria-labelledby="why-title"><div class="s-shell">
    <div class="why-head">
      <p class="s-eyebrow">{c.whyEyebrow}</p>
      <h2 id="why-title">{c.whyTitle.map((line, i) => <>{i > 0 && lang !== 'ja' && ' '}<span>{line}</span></>)}</h2>
      <p class="s-intro">{c.whyLead}</p>
    </div>
    <h3 class="why-list-title">{c.whyListTitle}</h3>
    <ol class="why-checks">{c.whyChecks.map(([title, desc], i) => <li><MaterialIcon name={whyIcons[i]} class="ic-chip" /><div><h4>{title}</h4><p>{desc}</p></div></li>)}</ol>
    <p class="why-close">{c.whyClose}</p>
  </div></section>
  <section class="s-section"><div class="s-shell approach-layout"><div><h2>{c.approachTitle}</h2><p class="s-intro">{c.approachLead}</p><a class="s-link" href={href('/about/')}>{c.about}<span aria-hidden="true">→</span></a></div><ol class="approach-steps">{c.steps.map(([title,desc],i) => <li data-motion-enter="block" data-motion-group="approach"><span class="s-number">0{i+1}</span><div><h3><MaterialIcon name={approachIcons[i]} class="ic-inline" />{title}</h3><p>{desc}</p></div></li>)}</ol></div></section>
  <section class="s-contact-band"><div class="s-shell"><div><h2>{c.finalTitle}</h2><p>{c.finalDesc}</p></div><a class="s-button" href={href('/contact/?source=top')}>{labels.consultation}<MaterialIcon name="arrow_forward"/></a></div></section>
</main>
<style>
.hero-audience{font-size:.9375rem;line-height:1.8;color:var(--ink);margin:0 0 20px;padding-left:12px;border-left:2px solid var(--deep)}
