---
import MaterialIcon from './MaterialIcon.astro';
import type { LineCaseConfig } from '../data/lineCaseCatalog';

interface Props { config: LineCaseConfig }
const { config } = Astro.props;
const c = config;
---
<section class="case-hero lc-hero">
  <div class="hero-badge-row">
    <a href="/works/" class="back-link"><MaterialIcon name="arrow_back" /> 制作例・デモ一覧</a>
  </div>
  <div class="container">
    <p class="kicker">CASE STUDY / LINE INTEGRATION</p>
    <h1>{c.heroTitle}</h1>
    <p class="hero-desc">{c.heroDesc}</p>
    <div class="hero-chips">
      <span class="chip-line">LINE公式アカウント</span>
      <MaterialIcon name="sync_alt" />
      <span class="chip-vendor" style={`border-color:${c.vendorColor};color:${c.vendorColorDark}`}>{c.vendorName}</span>
    </div>
  </div>
</section>

<section class="case-disclaimer">
  <div class="container">
    <div class="disclaimer-inner">
      <MaterialIcon name="info" />
      <p><strong>自主制作・架空データのケーススタディです。</strong>実在企業の実績・成果数値を示すものではありません。デモ操作でLINE・{c.vendorName}への実際の送信は行われません。</p>
    </div>
  </div>
</section>

<section class="demo-section" id="demo" data-lc-root>
  <div class="container">
    <div class="demo-header">
      <span class="eyebrow">INTERACTIVE DEMO</span>
      <h2>連携の流れを体験する</h2>
      <p>シナリオを選んで、例文を送信してください。架空データの操作デモです。</p>
    </div>

    <div class="scenario-selector" role="group" aria-label="体験するシナリオを選ぶ">
      <button type="button" class="scenario-btn is-active" data-scenario="normal">通常の流れ</button>
      <button type="button" class="scenario-btn" data-scenario="fail_register">登録に失敗した場合</button>
      <button type="button" class="scenario-btn" data-scenario="fail_notify">通知だけ失敗した場合</button>
    </div>

    <div class="demo-stage">
      <div class="demo-panel demo-panel--line">
        <div class="demo-panel-header demo-header-line">
          <span class="demo-dot"></span>
          <span>LINE 公式アカウント</span>
          <span class="demo-live"><span class="live-dot"></span>デモ</span>
        </div>
        <div class="demo-messages" data-lc-messages>
          <div class="demo-msg demo-msg--sent">
            <div class="msg-bubble sent">こんにちは。<br />{c.vendorName}連携について相談したいのですが。</div>
            <span class="msg-time">10:23</span>
          </div>
        </div>
        <div class="demo-input-area">
          <div class="demo-input-options" data-lc-presets>
            {c.presets.map((preset, i) => <button type="button" class="demo-preset" data-msg={preset.message} data-preset-index={i}>{preset.label}</button>)}
          </div>
          <div class="demo-send-row">
            <div class="demo-input-field" data-lc-input>メッセージを選択してください</div>
            <button type="button" class="demo-send-btn" data-lc-send disabled aria-label="デモで送信する">
              <MaterialIcon name="send" />
            </button>
          </div>
        </div>
      </div>

      <div class="demo-connector">
        <div class="connector-line">
          <div class="connector-arrow" data-lc-arrow>
            <MaterialIcon name="east" />
            <small>自動連携</small>
          </div>
        </div>
      </div>

      <div class="demo-panel demo-panel--vendor" style={`--vendor-color:${c.vendorColor}`}>
        <div class="demo-panel-header demo-header-vendor">
          <span class="demo-dot"></span>
          <span>{c.vendorName} {c.recordLabel}管理</span>
          <span class="demo-live"><span class="live-dot"></span>デモ</span>
        </div>
        <div class="vendor-toolbar">
          <span class="vendor-count">全 <strong data-lc-count>{c.seedRecords.length}</strong> 件</span>
          <span class="vendor-filter">状態：すべて</span>
        </div>
        <div class="vendor-table">
          <div class="vendor-thead">
            <span>{c.columns.status}</span>
            <span>{c.columns.content}</span>
            <span>{c.columns.time}</span>
            <span>{c.columns.assignee}</span>
          </div>
          <div class="vendor-tbody" data-lc-tbody>
            {c.seedRecords.map((rec) => (
              <div class="vendor-tr">
                <span><span class={`v-badge ${rec.badge}`}>{rec.badge === 'done' ? '完了' : '対応中'}</span></span>
                <span>{rec.content}</span>
                <span>{rec.time}</span>
                <span>{rec.assignee}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <p class="demo-status-bar" role="status" aria-live="polite" data-lc-status>例文を選んで、登録までの流れを試せます。</p>

    <div class="demo-actions" data-lc-actions>
      <button type="button" class="demo-action-btn" data-lc-action="retry_register" hidden>{c.recordLabel}の登録を再試行</button>
      <button type="button" class="demo-action-btn" data-lc-action="retry_notify" hidden>担当者への通知を再試行</button>
      <button type="button" class="demo-action-btn demo-action-btn--primary" data-lc-action="confirm" hidden>担当者が内容を確認する</button>
    </div>

    <div class="demo-controls">
      <button type="button" class="demo-reset-btn" data-lc-reset>
        <MaterialIcon name="refresh" /> デモを初期化する
      </button>
    </div>
    <p class="demo-note">※ このデモはブラウザ内のみで動作します。外部への送信・個人情報の取得は行いません。</p>
  </div>
</section>

<section class="case-section responsibility-section">
  <div class="container case-two-col">
    <div>
      <span class="eyebrow">AUTOMATION &amp; HUMAN JUDGEMENT</span>
      <h2>自動化する範囲と、<br />人が判断する範囲。</h2>
      <p>自動処理と人の確認を分けることで、対応漏れと誤登録の両方を防ぎやすくします。</p>
    </div>
    <div class="responsibility-grid">
      <div class="responsibility-col">
        <h3><MaterialIcon name="smart_toy" /> 自動化の候補</h3>
        <ul>{c.automatedTasks.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="responsibility-col">
        <h3><MaterialIcon name="person" /> 担当者が判断すること</h3>
        <ul>{c.humanTasks.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<section class="case-section ops-section">
  <div class="container">
    <span class="eyebrow">OPERATIONS AFTER LAUNCH</span>
    <h2>公開後の運用について</h2>
    <dl class="ops-list">
      <div><dt><MaterialIcon name="error_outline" />失敗の検知</dt><dd>登録できなかった処理と、通知だけ失敗した処理を分けて未処理一覧へ残します。通知経路が不調でも、一覧から確認できる設計です。</dd></div>
      <div><dt><MaterialIcon name="replay" />再実行</dt><dd>登録失敗は重複の有無を確認してから再登録します。通知失敗は登録済みデータを保持したまま、通知だけを再実行します。</dd></div>
      <div><dt><MaterialIcon name="groups" />運用担当</dt><dd>通知を見る人、再実行できる人、外部サービスの権限を管理する人を、導入時に決めます。担当不在時の連絡先もあわせて決めます。</dd></div>
      <div><dt><MaterialIcon name="build" />保守範囲</dt><dd>障害調査・連携先の仕様変更・項目追加・運用相談は個別に確認します。対応時間・保守費用は契約範囲として別途確認し、無償・常時対応は前提としません。</dd></div>
    </dl>
  </div>
</section>

<script define:vars={{
  presets: c.presets,
  newBadge: c.newBadge,
  assignedBadge: c.assignedBadge,
  autoReply: c.autoReply,
  recordLabel: c.recordLabel,
  seedCount: c.seedRecords.length,
  seedHtml: c.seedRecords.map((rec) => `<div class="vendor-tr"><span><span class="v-badge ${rec.badge}">${rec.badge === 'done' ? '完了' : '対応中'}</span></span><span>${rec.content}</span><span>${rec.time}</span><span>${rec.assignee}</span></div>`).join(''),
  initialMessageHtml: `<div class="demo-msg demo-msg--sent"><div class="msg-bubble sent">こんにちは。<br/>${c.vendorName}連携について相談したいのですが。</div><span class="msg-time">10:23</span></div>`,
}}>
(function () {
  const root = document.querySelector('[data-lc-root]');
  if (!root || root.dataset.lcInitialized) return;
  root.dataset.lcInitialized = 'true';

  const scenarioBtns = [...root.querySelectorAll('[data-scenario]')];
  const presetBtns = [...root.querySelectorAll('[data-preset-index]')];
  const inputEl = root.querySelector('[data-lc-input]');
  const sendBtn = root.querySelector('[data-lc-send]');
  const messagesEl = root.querySelector('[data-lc-messages]');
  const tbodyEl = root.querySelector('[data-lc-tbody]');
  const countEl = root.querySelector('[data-lc-count]');
  const arrowEl = root.querySelector('[data-lc-arrow]');
  const statusEl = root.querySelector('[data-lc-status]');
  const resetBtn = root.querySelector('[data-lc-reset]');
  const actionRegisterBtn = root.querySelector('[data-lc-action="retry_register"]');
  const actionNotifyBtn = root.querySelector('[data-lc-action="retry_notify"]');
  const actionConfirmBtn = root.querySelector('[data-lc-action="confirm"]');

  let scenario = 'normal';
  let phase = 'idle';
  let selectedMessage = '';
  let eventId = 0;
  let registerAttempted = false;
  let notifyAttempted = false;
  let runId = 0;
  const timers = new Set();

  function cancelPending() {
    runId += 1;
    timers.forEach((id) => clearTimeout(id));
    timers.clear();
  }
  function schedule(delay, action) {
    const current = runId;
    const id = setTimeout(() => {
      timers.delete(id);
      if (current !== runId) return;
      action();
    }, delay);
    timers.add(id);
  }

  function timeNow() {
    const now = new Date();
    return now.getHours() + ':' + String(now.getMinutes()).padStart(2, '0');
  }

  function setStatus(text) { statusEl.textContent = text; }

  function setControlsEnabled(enabled) {
    scenarioBtns.forEach((b) => { b.disabled = !enabled; });
    presetBtns.forEach((b) => { b.disabled = !enabled; });
  }

  function updateActions() {
    actionRegisterBtn.hidden = phase !== 'failed_register';
    actionNotifyBtn.hidden = phase !== 'failed_notify';
    actionConfirmBtn.hidden = phase !== 'awaiting_review';
  }

  function setPhase(next) {
    phase = next;
    updateActions();
  }

  scenarioBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (phase === 'processing') return;
      scenarioBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
      scenario = btn.dataset.scenario;
    });
  });

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (phase === 'processing') return;
      presetBtns.forEach((b) => b.classList.remove('selected'));
      btn.classList.add('selected');
      selectedMessage = btn.dataset.msg;
      inputEl.textContent = selectedMessage;
      inputEl.classList.add('has-text');
      sendBtn.disabled = false;
      sendBtn.classList.add('ready');
      if (phase === 'idle') setPhase('selected');
    });
  });

  sendBtn.addEventListener('click', () => {
    if (!selectedMessage || phase === 'processing') return;
    eventId += 1;
    registerAttempted = false;
    notifyAttempted = false;
    runSend();
  });

  function runSend() {
    const currentEventId = eventId;
    sendBtn.disabled = true;
    sendBtn.classList.remove('ready');
    setControlsEnabled(false);
    setPhase('processing');
    setStatus('問い合わせを受け付け、登録しています。');

    const msgDiv = document.createElement('div');
    msgDiv.className = 'demo-msg demo-msg--me';
    msgDiv.innerHTML = `<div class="msg-bubble me-bubble">${selectedMessage}</div><span class="msg-time">${timeNow()}</span>`;
    messagesEl.appendChild(msgDiv);
    messagesEl.scrollTop = messagesEl.scrollHeight;

    schedule(600, () => { arrowEl.classList.add('active'); });

    schedule(1400, () => {
      arrowEl.classList.remove('active');
      const shouldFailRegister = scenario === 'fail_register' && !registerAttempted;
      registerAttempted = true;
      if (shouldFailRegister) {
        setPhase('failed_register');
        setControlsEnabled(true);
        setStatus(`登録できませんでした。内容を保持しています。再試行できます。`);
        return;
      }
      addRecord(currentEventId);
      setPhase('registered');
      runNotify(currentEventId);
    });
  }

  function addRecord(currentEventId) {
    const shortMsg = selectedMessage.length > 16 ? selectedMessage.slice(0, 16) + '…' : selectedMessage;
    const tr = document.createElement('div');
    tr.className = 'vendor-tr new-entry';
    tr.dataset.eventId = String(currentEventId);
    tr.innerHTML = `<span><span class="v-badge new">${newBadge}</span></span><span data-cell="content">${shortMsg}</span><span data-cell="time">${timeNow()}</span><span data-cell="assignee">—</span>`;
    tbodyEl.insertBefore(tr, tbodyEl.firstChild);
    countEl.textContent = String(tbodyEl.querySelectorAll('.vendor-tr').length);
  }

  function markRowAssigned(currentEventId) {
    const row = tbodyEl.querySelector(`[data-event-id="${currentEventId}"]`);
    if (!row) return;
    const badge = row.querySelector('.v-badge');
    badge.classList.remove('new');
    badge.classList.add('assigned');
    badge.textContent = assignedBadge;
    const assigneeCell = row.querySelector('[data-cell="assignee"]');
    if (assigneeCell) assigneeCell.textContent = '自動割当';
  }

  function runNotify(currentEventId) {
    schedule(1400, () => {
      const shouldFailNotify = scenario === 'fail_notify' && !notifyAttempted;
      notifyAttempted = true;
      if (shouldFailNotify) {
        setPhase('failed_notify');
        setControlsEnabled(true);
        setStatus(`登録は完了しています。担当者への通知を再試行できます。`);
        return;
      }
      markRowAssigned(currentEventId);
      const replyDiv = document.createElement('div');
      replyDiv.className = 'demo-msg demo-msg--sent';
      replyDiv.innerHTML = `<div class="msg-bubble received">${autoReply}</div><span class="msg-time">${timeNow()}</span>`;
      messagesEl.appendChild(replyDiv);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      setPhase('awaiting_review');
      setControlsEnabled(true);
      setStatus(`登録しました。担当者が内容を確認します。`);
    });
  }

  actionRegisterBtn.addEventListener('click', () => {
    if (phase !== 'failed_register') return;
    setControlsEnabled(false);
    setPhase('processing');
    setStatus('再登録しています。');
    schedule(1000, () => {
      addRecord(eventId);
      setPhase('registered');
      runNotify(eventId);
      setStatus('再試行が完了しました。同じ問い合わせは追加登録していません。');
    });
  });

  actionNotifyBtn.addEventListener('click', () => {
    if (phase !== 'failed_notify') return;
    setControlsEnabled(false);
    setPhase('processing');
    setStatus('通知を再試行しています。');
    const currentEventId = eventId;
    schedule(1000, () => {
      markRowAssigned(currentEventId);
      const replyDiv = document.createElement('div');
      replyDiv.className = 'demo-msg demo-msg--sent';
      replyDiv.innerHTML = `<div class="msg-bubble received">${autoReply}</div><span class="msg-time">${timeNow()}</span>`;
      messagesEl.appendChild(replyDiv);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      setPhase('awaiting_review');
      setControlsEnabled(true);
      setStatus('再試行が完了しました。同じ問い合わせは追加登録していません。');
    });
  });

  actionConfirmBtn.addEventListener('click', () => {
    if (phase !== 'awaiting_review') return;
    const row = tbodyEl.querySelector(`[data-event-id="${eventId}"]`);
    if (row) {
      const badge = row.querySelector('.v-badge');
      badge.classList.remove('assigned');
      badge.classList.add('done');
      badge.textContent = '確認済み';
    }
    setPhase('completed');
    setStatus(`確認しました。${recordLabel}を確認済みにしました。`);
  });

  function resetDemo() {
    cancelPending();
    scenario = 'normal';
    selectedMessage = '';
    registerAttempted = false;
    notifyAttempted = false;
    phase = 'idle';
    updateActions();
    scenarioBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.scenario === 'normal'));
    presetBtns.forEach((b) => b.classList.remove('selected'));
    inputEl.textContent = 'メッセージを選択してください';
    inputEl.classList.remove('has-text');
    sendBtn.disabled = true;
    sendBtn.classList.remove('ready');
    arrowEl.classList.remove('active');
    setControlsEnabled(true);
    messagesEl.innerHTML = initialMessageHtml;
    tbodyEl.innerHTML = seedHtml;
    countEl.textContent = String(seedCount);
    setStatus('例文を選んで、登録までの流れを試せます。');
  }

  resetBtn.addEventListener('click', resetDemo);
  document.addEventListener('astro:before-swap', cancelPending);
})();
</script>

<style is:global>
  :root {
    --line-green: #06C755;
    --line-dark: #00B449;
    --trust: #0f4c5c;
    --trust-line: rgba(15, 76, 92, 0.18);
    --accent-red: #c7352f;
    --text-deep: #1a1a1a;
    --card-shadow: 0 16px 38px rgba(15, 76, 92, 0.075), 0 4px 14px rgba(70, 52, 32, 0.045);
  }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .eyebrow { display: block; font-size: 0.78rem; font-weight: 900; color: var(--trust); letter-spacing: 0.3em; text-transform: uppercase; margin-bottom: 16px; }
  .case-section { padding: 72px 0; }
  .case-section + .case-section { border-top: 1px solid var(--trust-line); }
  .case-section h2 { font-size: clamp(1.55rem, 2.8vw, 2.1rem); font-weight: 900; color: var(--text-deep); margin-bottom: 12px; }
  .case-section > .container > p { color: #555; line-height: 1.9; margin-bottom: 32px; }

  .case-hero { padding: 48px 0 0; background: linear-gradient(135deg, #f8fbf9 0%, #fff 60%, #f0f7ff 100%); border-bottom: 1px solid var(--trust-line); }
  .hero-badge-row { max-width: 1200px; margin: 0 auto 24px; padding: 0 24px; }
  .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--trust); font-size: 0.88rem; font-weight: 800; text-decoration: none; opacity: 0.8; transition: 0.2s; }
  .back-link:hover { opacity: 1; }
  .kicker { font-size: 0.78rem; font-weight: 900; color: var(--trust); letter-spacing: 0.28em; margin-bottom: 16px; }
  .case-disclaimer { background: rgba(15, 76, 92, 0.04); border-bottom: 1px solid var(--trust-line); }
  .disclaimer-inner { display: flex; align-items: flex-start; gap: 12px; padding: 16px 0; color: var(--trust); font-size: 0.88rem; line-height: 1.8; }

  .demo-section { padding: 60px 0 80px; background: linear-gradient(135deg, rgba(15, 76, 92, 0.04), rgba(6, 199, 85, 0.03)); border-top: 1px solid var(--trust-line); border-bottom: 1px solid var(--trust-line); }
  .demo-header { text-align: center; margin-bottom: 32px; }
  .demo-header h2 { font-size: clamp(1.55rem, 3vw, 2.2rem); font-weight: 900; color: var(--text-deep); margin-bottom: 12px; }
  .demo-header p { color: #666; line-height: 1.8; }
  .demo-stage { display: grid; grid-template-columns: 1fr 64px 1fr; gap: 0; align-items: stretch; margin-bottom: 20px; border: 1px solid var(--trust-line); border-radius: 24px; overflow: hidden; box-shadow: var(--card-shadow); background: #fff; }
  .demo-panel { display: flex; flex-direction: column; min-height: 420px; }
  .demo-panel-header { display: flex; align-items: center; gap: 8px; padding: 12px 16px; font-size: 0.8rem; font-weight: 900; color: #fff; }
  .demo-header-line { background: var(--line-green); }
  .demo-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.5); }
  .demo-live { margin-left: auto; display: flex; align-items: center; gap: 5px; font-size: 0.7rem; opacity: 0.9; }
  .live-dot { width: 6px; height: 6px; border-radius: 50%; background: #fff; animation: lc-pulse 1.5s infinite; }
  @keyframes lc-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  .demo-messages { flex: 1; padding: 16px; display: flex; flex-direction: column; gap: 10px; overflow-y: auto; background: #f5f5f5; }
  .demo-msg { display: flex; flex-direction: column; }
  .demo-msg--sent { align-items: flex-start; }
  .demo-msg--me { align-items: flex-end; }
  .msg-bubble { max-width: 85%; padding: 10px 14px; border-radius: 18px; font-size: 0.88rem; line-height: 1.65; }
  .msg-bubble.sent, .msg-bubble.received { background: #fff; border-radius: 4px 18px 18px 18px; color: #333; }
  .msg-bubble.me-bubble { background: var(--line-green); color: #fff; border-radius: 18px 4px 18px 18px; }
  .msg-time { font-size: 0.65rem; color: #999; margin-top: 4px; padding: 0 4px; }
  .demo-input-area { padding: 12px; background: #fff; border-top: 1px solid #e5e5e5; }
  .demo-input-options { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
  .demo-preset { padding: 6px 12px; border: 1px solid var(--line-green); border-radius: 999px; background: rgba(6, 199, 85, 0.08); color: var(--line-dark); font-size: 0.75rem; font-weight: 800; cursor: pointer; transition: 0.2s; }
  .demo-preset:hover, .demo-preset.selected { background: var(--line-green); color: #fff; }
  .demo-preset:disabled { opacity: 0.5; cursor: not-allowed; }
  .demo-send-row { display: flex; gap: 8px; align-items: center; }
  .demo-input-field { flex: 1; padding: 10px 14px; border: 1px solid #ddd; border-radius: 999px; font-size: 0.85rem; color: #aaa; background: #f9f9f9; min-height: 40px; display: flex; align-items: center; }
  .demo-input-field.has-text { color: #333; background: #fff; }
  .demo-send-btn { width: 42px; height: 42px; border-radius: 50%; border: none; background: #ccc; color: #fff; cursor: not-allowed; display: flex; align-items: center; justify-content: center; transition: 0.2s; flex-shrink: 0; }
  .demo-send-btn.ready { background: var(--line-green); cursor: pointer; }
