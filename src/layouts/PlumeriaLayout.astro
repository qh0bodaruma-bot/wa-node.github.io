---
import BaseLayout from './BaseLayout.astro';
import PlumeriaTelCta from '../components/plumeria/PlumeriaTelCta.astro';
import { corp, services, recruitEntry, routes, shortStayTel } from '../data/plumeria';
import '../styles/plumeria.css';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
}
const { title, description, currentPath = '' } = Astro.props;

const navEntries = [...services, recruitEntry];
const activeService = services.find((s) => currentPath.startsWith(s.href));
const isRecruit = currentPath === routes.recruit;
const phone = activeService?.id === 'short-stay' ? shortStayTel : activeService?.id === 'housing' || isRecruit ? corp.tel : null;
const phoneLabel = isRecruit ? '採用' : activeService?.id === 'short-stay' ? 'Ⅲ' : 'Ⅰ・Ⅱ';
const contactHref = isRecruit ? `${routes.recruit}#application` : activeService ? `${routes.contact}?service=${activeService.id}` : routes.contact;
---
<BaseLayout
  title={title}
  description={description}
  image="/images/plumeria/hero-01.webp"
  noindex={true}
  showSiteChrome={false}
  siteName="プルメリア（修正版ラフ）"
  gaMeasurementId="G-G8XKQBVK7D"
  gaEnabled={false}
>
  <div class="pl" data-reveal="off" data-pl-demo="true">
    <a class="pl-skip" href="#top">本文へ進む</a>
    <svg class="pl-defs" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="pl-hero-clip" clipPathUnits="objectBoundingBox">
          <path d="M0,0 H1 V0.90 C0.70,1 0.35,0.92 0,1 Z" />
        </clipPath>
        <symbol id="pl-i-home" viewBox="0 0 24 24">
          <path d="M4 10.8 12 4.5l8 6.3V19a1.6 1.6 0 0 1-1.6 1.6h-3.2v-5.4H8.8v5.4H5.6A1.6 1.6 0 0 1 4 19z" />
          <path opacity="0.5" d="M7.4 9.3h9.2" />
        </symbol>
        <symbol id="pl-i-bed" viewBox="0 0 24 24">
          <path d="M3 18.5v-9M3 13.2h18v5.3M21 18.5v-4.1a3 3 0 0 0-3-3h-5.6v1.8" />
          <circle cx="7.4" cy="11.4" r="1.9" />
          <path opacity="0.5" d="M11 15.6h7.4" />
        </symbol>
        <symbol id="pl-i-care" viewBox="0 0 24 24">
          <path d="M12 19.6s-6.3-4.1-6.3-8.4A3.5 3.5 0 0 1 12 8.8a3.5 3.5 0 0 1 6.3 2.4c0 4.3-6.3 8.4-6.3 8.4Z" />
          <path d="M9.4 12.8h1.5l.9-1.7.9 3.1.9-1.4h1.6" />
        </symbol>
        <symbol id="pl-i-chair" viewBox="0 0 24 24">
          <circle cx="10" cy="16.8" r="3.9" />
          <path d="M10 4.4v8.9h5.9l2.9 4.9M8.1 7.2h3.9" />
          <path opacity="0.5" d="M10 13v7.6M6.3 16.8h7.4" />
        </symbol>
        <symbol id="pl-i-staff" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="3.1" />
          <path d="M5.2 19.8a6.8 6.8 0 0 1 13.6 0" />
          <path opacity="0.5" d="M12 15.4v2.6" />
        </symbol>
        <symbol id="pl-i-leaf" viewBox="0 0 24 24">
          <path d="M5 19.2C5 11.4 9.8 5.4 19 5.4c0 9.2-6.1 13.8-14 13.8Z" />
          <path d="M5 19.2c2.9-4.9 6-7.9 10.9-9.8" />
          <path opacity="0.55" d="M9.4 14.4c1.7-1 3.1-1 4.6-.3M12 11c1.4-.7 2.6-.7 3.9-.2" />
        </symbol>
        <symbol id="pl-i-sprout" viewBox="0 0 24 24">
          <path d="M12 20.5v-7.2" />
          <path d="M12 13.3C12 9.6 9.4 7 5.7 7c0 3.7 2.6 6.3 6.3 6.3Z" />
          <path d="M12 12.4c0-3.2 2.2-5.4 5.4-5.4 0 3.2-2.2 5.4-5.4 5.4Z" />
          <path opacity="0.55" d="M8.6 10.4c1 .4 1.8 1 2.3 1.7M14.4 9.7c-.9.4-1.6 1-2.1 1.7" />
        </symbol>
        <symbol id="pl-i-tree" viewBox="0 0 24 24">
          <path d="M12 20.6v-6.4" />
          <path d="M12 14.2 8.2 10.7M12 12.4l3.5-3.2" />
          <path d="M12 3.6c3.6 0 6.2 2.6 6.2 5.7 0 3-2.6 5.2-6.2 5.2S5.8 12.3 5.8 9.3c0-3.1 2.6-5.7 6.2-5.7Z" />
        </symbol>
        <symbol id="pl-i-bird" viewBox="0 0 24 24">
          <path d="M4.2 14.6c0-3.1 2.5-5.6 5.6-5.6h3.4l3.1-2.6v2.6h2.1c.9 0 1.6.7 1.6 1.6 0 2.1-1.7 3.8-3.8 3.8h-1.1l-2.6 5.1H9.8l1-3.6a5.6 5.6 0 0 1-6.6-1.3Z" />
          <path d="M16.2 10.4h.02" />
        </symbol>
        <symbol id="pl-i-sun" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 3.4v2.1M12 18.5v2.1M3.4 12h2.1M18.5 12h2.1M6 6l1.5 1.5M16.5 16.5 18 18M18 6l-1.5 1.5M7.5 16.5 6 18" />
        </symbol>
        <symbol id="pl-i-phone" viewBox="0 0 24 24">
          <path d="M6.6 4.5c.9-.3 1.9.1 2.3 1l1 2.2c.3.7.1 1.5-.4 2l-1.1 1c-.2.2-.3.5-.1.8a12 12 0 0 0 4.2 4.2c.3.2.6.1.8-.1l1-1.1c.5-.5 1.3-.7 2-.4l2.2 1c.9.4 1.3 1.4 1 2.3l-.6 1.7c-.3.8-1 1.3-1.9 1.3C10.6 20.4 3.6 13.4 3.6 5.1c0-.9.5-1.6 1.3-1.9Z" />
        </symbol>
        <symbol id="pl-i-calendar" viewBox="0 0 24 24">
          <rect x="4" y="5.5" width="16" height="14" rx="2.3" />
          <path d="M4 9.6h16M8 3.5v3M16 3.5v3" />
          <path opacity="0.85" d="M9 14.2l2 2 4-4.2" />
        </symbol>
        <symbol id="pl-i-document" viewBox="0 0 24 24">
          <path d="M6.5 3.6h8.2l4.8 4.8v11.2a1 1 0 0 1-1 1h-12a1 1 0 0 1-1-1V4.6a1 1 0 0 1 1-1Z" />
          <path opacity="0.5" d="M14.5 3.6v4.6a1 1 0 0 0 1 1h4.5" />
          <path d="M8.5 13.4h7M8.5 17h5" />
        </symbol>
        <symbol id="pl-i-clipboard" viewBox="0 0 24 24">
          <rect x="4.8" y="4.8" width="14.4" height="15.4" rx="2.2" />
          <path d="M9.4 4.8V3.6a1.1 1.1 0 0 1 1.1-1.1h3a1.1 1.1 0 0 1 1.1 1.1v1.2Z" />
          <path d="M8.8 11.4h6.4M8.8 15.2h4.4" />
        </symbol>
        <symbol id="pl-i-people" viewBox="0 0 24 24">
          <circle cx="9.2" cy="8.4" r="2.9" />
          <path d="M3.4 19.6a5.8 5.8 0 0 1 11.6 0" />
          <path opacity="0.55" d="M16.2 6.2a2.7 2.7 0 0 1 0 5.2M17.6 13.6a5.3 5.3 0 0 1 3.2 4.9" />
        </symbol>
      </defs>
    </svg>

    <p class="pl-notice">
      ご提案用デモ｜写真はイメージです。料金・募集条件は本番公開前に確認します。
    </p>

    <header class="pl-head">
      <div class="pl-head-inner">
        <a class="pl-brand" href={routes.top}>
          <span class="pl-brand-mark" aria-hidden="true"><svg><use href="#pl-i-sprout" /></svg></span>
          <span class="pl-brand-text">
            <span class="pl-brand-name">{corp.name}</span>
            <span class="pl-brand-en">{corp.nameEn}</span>
          </span>
        </a>

        <nav class="pl-nav" aria-label="サービス">
          {navEntries.map((s) => (
            <a href={s.href} aria-current={currentPath === s.href ? 'page' : undefined}
               data-pl-gtag={s.id === 'recruit' ? 'recruit_click' : 'service_select'}
               data-pl-service={s.id} data-pl-cta="header_nav">
              <span class="pl-nav-icon" aria-hidden="true"><svg><use href={`#pl-i-${s.icon}`} /></svg></span>
              <span class="pl-nav-label">{s.short}</span>
            </a>
          ))}
        </nav>

        <a class="pl-head-recruit" href={routes.recruit} data-pl-gtag="recruit_click" data-pl-cta="header_recruit">採用情報</a>
        <details class="pl-menu">
          <summary aria-label="メニューを開く"><span class="pl-menu-bars" aria-hidden="true"></span></summary>
          <nav class="pl-menu-list" aria-label="メニュー（モバイル）">
            <a href={routes.recruit} data-pl-gtag="recruit_click" data-pl-cta="mobile_menu"><span class="pl-nav-icon" aria-hidden="true"><svg><use href="#pl-i-bird" /></svg></span>採用情報</a>
            {services.map((s) => (
              <a href={s.href} aria-current={currentPath === s.href ? 'page' : undefined} data-pl-gtag="service_select" data-pl-service={s.id} data-pl-cta="mobile_menu">
                <span class="pl-nav-icon" aria-hidden="true"><svg><use href={`#pl-i-${s.icon}`} /></svg></span>
                {s.name}
              </a>
            ))}
            <a href={routes.services}><span class="pl-nav-icon" aria-hidden="true"><svg><use href="#pl-i-tree" /></svg></span>サービス一覧</a>
            <a href={routes.contact}><span class="pl-nav-icon" aria-hidden="true"><svg><use href="#pl-i-home" /></svg></span>お問い合わせ・ご相談</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="top" tabindex="-1">
      <slot />
      {currentPath !== routes.top && currentPath !== routes.contact && currentPath !== routes.recruit &&
        <div class="pl-wrap pl-print-tools"><button type="button" class="pl-print-button" data-pl-print hidden>このページを印刷・PDF保存</button></div>}
    </main>

    <footer class="pl-foot">
      <div class="pl-hill pl-hill-foot" aria-hidden="true">
        <svg viewBox="0 0 1440 70" preserveAspectRatio="none"><path d="M0 70V30c240-30 470 16 730 8s470-40 710-18v50Z" /></svg>
      </div>
      <img class="pl-deco-flower pl-deco-flower-tr" src="/images/plumeria/decoration-tr.webp" alt=""
           width="520" height="541" loading="lazy" decoding="async" aria-hidden="true" />
      <div class="pl-wrap pl-foot-inner">
        <div class="pl-foot-brand">
          <span class="pl-brand-mark" aria-hidden="true"><svg><use href="#pl-i-sprout" /></svg></span>
          <p class="pl-brand-name pl-foot-name">{corp.name}</p>
          <p class="pl-brand-en">{corp.nameEn}</p>
          <p class="pl-note">{corp.address ?? '住所：確認中'}</p>
          <p class="pl-note">
            運営法人：<span class="pl-pending-note">{corp.groupName ?? '確認中'}</span>
          </p>
          <p class="pl-note">
            現在の公式サイト：
            {corp.currentSiteUrl
              ? <a href={corp.currentSiteUrl}>{corp.currentSiteUrl}</a>
              : <span class="pl-pending-note">確認中</span>}
          </p>
        </div>
        <nav class="pl-foot-links" aria-label="サイト情報">
          <a href={routes.services}>サービス一覧</a>
          <a href={routes.recruit}>採用情報</a>
          <a href={routes.contact}>お問い合わせ・ご相談</a>
          <a href={routes.privacy}>個人情報の取扱いについて</a>
          <a href={routes.importantMatters}>重要事項説明について</a>
        </nav>
      </div>
    </footer>

    <div class="pl-float-cta">
      {phone ? <PlumeriaTelCta class="pl-float-seg pl-float-seg-tel" tel={phone} label={phoneLabel} service={isRecruit ? 'recruit' : activeService?.id} /> :
        <a class="pl-float-seg pl-float-seg-tel" href={`${routes.contact}#contact-desks`}>
          <span class="pl-float-seg-icon" aria-hidden="true"><svg><use href="#pl-i-phone" /></svg></span>
          電話窓口を確認
        </a>}
      <a class="pl-float-seg pl-float-seg-main" href={contactHref}>
        <span class="pl-float-seg-icon" aria-hidden="true"><svg><use href="#pl-i-calendar" /></svg></span>
        {isRecruit ? '応募方法を見る' : '見学・ご相談'}
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  import { initPlumeriaClickTracking } from '../scripts/plumeriaAnalytics';
  function run() {
    initPlumeriaClickTracking(document);
    document.querySelectorAll<HTMLButtonElement>('[data-pl-print]').forEach((button) => {
      if (button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.hidden = false;
      button.addEventListener('click', () => window.print());
    });
    const menu = document.querySelector<HTMLDetailsElement>('.pl-menu');
    if (menu && !menu.dataset.ready) {
      menu.dataset.ready = 'true';
      menu.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      menu.addEventListener('toggle', () => menu.querySelector('summary')?.setAttribute('aria-label', menu.open ? 'メニューを閉じる' : 'メニューを開く'));
    }
    document.querySelectorAll<HTMLElement>('.pl-compare-table-wrap').forEach((wrap) => {
      wrap.tabIndex = 0;
      wrap.setAttribute('role', 'region');
      wrap.setAttribute('aria-label', '比較表。横にスクロールして確認できます');
    });
  }
  run();
  document.addEventListener('DOMContentLoaded', run);
  document.addEventListener('astro:page-load', run);
</script>
