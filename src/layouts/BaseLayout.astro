---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GlossaryEnhancer from '../components/GlossaryEnhancer.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { ViewTransitions } from 'astro:transitions';
import { MULTILANG_PAGES } from '../i18n/navigation';
import { materialIconsHref } from '../data/materialIconNames';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/link-flow.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  lang?: 'ja' | 'en' | 'fr';
  noindex?: boolean;
  showSiteChrome?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  gaMeasurementId?: string;
  gaEnabled?: boolean;
  clarityProjectId?: string;
  clarityEnabled?: boolean;
  analyticsPolicyHref?: string;
  /** サイトごとのアイコン（既定は和-Node） */
  faviconHref?: string;
  appleTouchIconHref?: string;
  /** 和-Node本体用のWebフォント（Material Symbols・Outfit）を読み込むか */
  loadSiteFonts?: boolean;
  /** 同意バナーの見た目（サイトのデザインに合わせる） */
  consentTheme?: "wa-node" | "plumeria";
  siteName?: string;
}

const {
  title = "和-Node｜LINE×業務システム連携の専門パートナー",
  description = "和-Nodeは、LINE公式アカウントとSalesforce・kintone・HubSpot・Googleスプレッドシートをつなぐ連携構築の専門パートナーです。LINEで受け付けた申込・問い合わせを業務システムへ自動登録し、転記や確認の往復を減らします。",
  image = "/images/ogp-service.jpg",
  url = Astro.url.href,
  lang = 'ja',
  noindex = false,
  showSiteChrome = true,
  structuredData,
  gaMeasurementId,
  gaEnabled = true,
  clarityProjectId,
  clarityEnabled = true,
  analyticsPolicyHref = "/privacy/",
  faviconHref = "/favicon.ico",
  appleTouchIconHref = "/apple-touch-icon.png",
  loadSiteFonts = true,
  consentTheme = "wa-node",
  siteName = '和-Node'
} = Astro.props;

const structuredDataItems = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const urlLang = Astro.url.searchParams.get('lang');
const currentLang = urlLang === 'en' || urlLang === 'fr' ? urlLang : lang;

const urlObj = new URL(url);
const pathWithoutLocale = urlObj.pathname.replace(/^\/(en|fr)\//, '/').replace(/\/$/, '');
const normalizedPath = pathWithoutLocale === '' ? '/' : pathWithoutLocale;
const hasTranslation = MULTILANG_PAGES.includes(normalizedPath);

const SKIP_LINK_LABEL = {
  ja: '本文へスキップ',
  en: 'Skip to main content',
  fr: 'Aller au contenu principal',
} as const;
const skipLinkLabel = SKIP_LINK_LABEL[currentLang] ?? SKIP_LINK_LABEL.ja;

const getLocalizedHref = (l: string) => {
  const cleanPath = pathWithoutLocale === '' ? '/' : pathWithoutLocale + '/';
  if (l === 'ja') return new URL(cleanPath, urlObj.origin).href;
  return new URL(`/${l}${cleanPath}`, urlObj.origin).href;
};
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="0rBuRrl1I5-_XMfRp59rq2vD-BPOFfAWnCJEf2KOzbI" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={faviconHref} />
    <link rel="apple-touch-icon" href={appleTouchIconHref} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />

    <link rel="canonical" href={url} />
    {hasTranslation && (
      <>
        <link rel="alternate" hreflang="ja" href={getLocalizedHref('ja')} />
        <link rel="alternate" hreflang="en" href={getLocalizedHref('en')} />
        <link rel="alternate" hreflang="fr" href={getLocalizedHref('fr')} />
        <link rel="alternate" hreflang="x-default" href={getLocalizedHref('ja')} />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {loadSiteFonts && <link href={materialIconsHref} rel="stylesheet" />}
    {loadSiteFonts && <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;800&display=swap" rel="stylesheet" />}
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <ViewTransitions />
    <script is:inline>
      // IntersectionObserverが使える環境でだけ .reveal を隠す。
      // このクラスが付かない限り global.css 側で reveal は表示状態のままになる。
      function markRevealReady() {
        if ('IntersectionObserver' in window) {
          document.documentElement.classList.add('reveal-ready');
        }
      }
      markRevealReady();
      // View Transitionsのswapでhtmlの属性が入れ替わるため、都度付け直す
      document.addEventListener('astro:after-swap', markRevealReady);

      let revealObserver = null;
      function markHeadingRevealTargets() {
        document.querySelectorAll('.section-title, .issues-head').forEach((element) => {
          if (!element.closest('[data-reveal="off"]')) {
            element.classList.add('reveal', 'reveal-heading');
          }
        });
      }

      function markCardRevealTargets() {
        document.querySelectorAll('[class]').forEach((element) => {
          const isCard = Array.from(element.classList).some((className) => (
            className === 'card' || className.endsWith('-card') || className.startsWith('p-card-')
          ));

          if (isCard && !element.closest('[data-reveal="off"]')) {
            element.classList.add('reveal');
          }
        });
      }

      function initReveal() {
        if (!('IntersectionObserver' in window)) return;
        // 前ページ分のobserverを破棄してから作り直す
        if (revealObserver) revealObserver.disconnect();

        // カードはページごとの記述漏れが起きないよう、共通でスクロール表示の対象にする。
        markHeadingRevealTargets();
        markCardRevealTargets();

        revealObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('active');
              revealObserver.unobserve(entry.target);
            }
          });
        }, {
          root: null,
          rootMargin: '0px',
          threshold: 0.1
        });

        document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
      }

      // Initial load
      document.addEventListener('DOMContentLoaded', initReveal);
      // View Transitions navigation
      document.addEventListener('astro:page-load', initReveal);

      // Global Progress Bar for View Transitions
      (function() {
        document.addEventListener('astro:before-preparation', () => {
          const bar = document.getElementById('global-progress-bar');
          if (bar) {
            bar.style.width = '0%';
            bar.classList.remove('finish');
            bar.classList.add('active');
            // 擬似的にプログレスを進行させる
            setTimeout(() => {
              bar.style.width = '70%';
            }, 10);
          }
        });

        document.addEventListener('astro:after-preparation', () => {
          const bar = document.getElementById('global-progress-bar');
          if (bar) {
            bar.classList.add('finish');
            bar.style.width = '100%';
            setTimeout(() => {
              bar.classList.remove('active', 'finish');
              bar.style.width = '0%';
            }, 400);
          }
        });
      })();
    </script>
    <script>
      import { initMotion, watchReducedMotion } from '../scripts/motion';
      watchReducedMotion();
      let disposeMotion: (() => void) | null = null;
      function runMotion() {
        disposeMotion?.();
        disposeMotion = initMotion(document);
      }
      document.addEventListener('DOMContentLoaded', runMotion);
      document.addEventListener('astro:page-load', runMotion);
      document.addEventListener('astro:before-swap', () => { disposeMotion?.(); disposeMotion = null; });
    </script>
  </head>
  <body>
    {showSiteChrome && <div id="global-progress-bar" class="global-progress-bar" aria-hidden="true"></div>}
    {showSiteChrome && <a class="skip-link" href="#main">{skipLinkLabel}</a>}
    {showSiteChrome && <Header lang={currentLang} />}
    <slot />
    {showSiteChrome && <Footer lang={currentLang} />}
    <AnalyticsConsent lang={currentLang} gaMeasurementId={gaMeasurementId} gaEnabled={gaEnabled} clarityProjectId={clarityProjectId} clarityEnabled={clarityEnabled} policyHref={analyticsPolicyHref} theme={consentTheme} />
    <GlossaryEnhancer />
  </body>
</html>
