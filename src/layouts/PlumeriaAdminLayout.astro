---
// プルメリア 管理画面のモック用レイアウト。
// 公開サイト（PlumeriaLayout）とは別物。サイト共通のヘッダー・フッターも使わない。
// これは画面イメージであり、実際には動作しない。計測も入れない。
import PlumeriaBaseLayout from './PlumeriaBaseLayout.astro';
import '../styles/plumeria-admin.css';
import { routes } from '../data/plumeria';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  hello?: string;
  showTop?: boolean;
}
const {
  title, description, currentPath = '',
  hello = 'こんにちは、プルメリアの皆さま',
  showTop = true,
} = Astro.props;

const base = routes.admin;
// サイドバーに常設する空室情報のクイック切替（モックのため固定値）
const quickVac = [
  { name: 'プルメリアⅠ', state: '空きあり' },
  { name: 'プルメリアⅡ', state: '満室' },
  { name: 'プルメリアⅢ', state: '残りわずか' },
];
const vacStates = ['空きあり', '残りわずか', '満室'];

const nav = [
  { href: base, ico: 'home', t: 'ホーム', s: 'DASHBOARD' },
  { href: `${base}vacancy/`, ico: '空', t: '空室情報', s: 'VACANCY' },
  { href: `${base}post/`, ico: '知', t: 'お知らせ・通知', s: 'POSTS' },
  { href: base, ico: '析', t: 'アクセス分析', s: 'ANALYTICS' },
];
---
<PlumeriaBaseLayout
  title={title}
  description={description}
  siteName="プルメリア 管理画面（画面イメージ）"
>
  <div class="pa" data-reveal="off">
    <p class="pa-notice">これは画面イメージです。ボタンや入力欄は動作しません。数値もすべて仮のものです。</p>

    <div class="pa-shell">
      <aside class="pa-side">
        <!-- お試し版と同じく、先頭にログインしている人の名前とログアウトを置く（画面イメージのため固定の名前・動かないボタン） -->
        <div class="pt-user-slot">
          <div class="pt-user">
            <span class="pt-user-name">プルメリア 管理者 さん</span>
            <span class="pt-user-role">公開まで操作できます</span>
            <button type="button" class="pt-logout">ログアウト</button>
          </div>
        </div>

        <span class="pa-demo-badge">DEMO DATA</span>

        <nav class="pa-nav" aria-label="管理メニュー">
          {nav.map((n, i) => (
            <>
              <a href={n.href} aria-current={currentPath === n.href && n.s !== 'VACANCY' && n.s !== 'ANALYTICS' ? 'page' : undefined}>
                <span class="pa-ico" aria-hidden="true">{n.ico === 'home' ? '⌂' : n.ico}</span>
                <span>
                  <span class="pa-nav-t">{n.t}</span>
                  <span class="pa-nav-s">{n.s}</span>
                </span>
              </a>
              {i === 0 && (
                <a class="pa-status-link is-alert" href={`${base}approve/`} aria-current={currentPath === `${base}approve/` ? 'page' : undefined}>
                  <span class="pa-side-h">いまの状況<span class="pa-status-go" aria-hidden="true">開く →</span></span>
                  <span class="pa-stat"><span class="pa-dot pa-dot-warn"></span>最終確認まち<span class="pa-stat-v">2件</span></span>
                  <span class="pa-stat"><span class="pa-dot pa-dot-ok"></span>公開中<span class="pa-stat-v">3件</span></span>
                  <span class="pa-stat"><span class="pa-dot pa-dot-ok"></span>空室情報の更新<span class="pa-stat-v">本日済</span></span>
                </a>
              )}
            </>
          ))}
        </nav>

        <div class="pa-quick">
          <div class="pa-quick-h">
            <div class="pa-side-h">空室情報をすぐ変える</div>
            <a href={`${base}vacancy/`}>詳細</a>
          </div>
          {quickVac.map((v) => (
            <div class="pa-quick-item">
              <p class="pa-quick-name">{v.name}</p>
              <div class="pa-quick-seg" role="group" aria-label={`${v.name}の空室状況`}>
                {vacStates.map((s) => (
                  <button type="button" aria-pressed={v.state === s ? 'true' : 'false'}>{s}</button>
                ))}
              </div>
            </div>
          ))}
          <p class="pa-quick-note">どの画面からでも変更できます。押した瞬間に反映されます。</p>
        </div>

        <div class="pa-side-card">
          <b>更新でお困りのときは</b>
          <p>操作の手順書をご用意しています。ご不明な点は和-Nodeまでご連絡ください。</p>
        </div>
      </aside>

      <main class="pa-main">
        {showTop && (
          <div class="pa-top">
            <div>
              <h1 class="pa-hello">{hello}</h1>
              <p class="pa-date">2026年9月10日（木曜日）</p>
            </div>
            <div class="pa-filters">
              <div class="pa-filter"><span>事業所</span><b>すべて</b></div>
              <div class="pa-filter"><span>期間</span><b>今月</b></div>
              <button type="button" class="pa-btn">レポートを出す</button>
            </div>
          </div>
        )}

        <slot />
      </main>
    </div>

    <div class="pa-assist" aria-hidden="true">
      <span>更新のヘルプ<small>使い方を調べる</small></span>
    </div>
  </div>
</PlumeriaBaseLayout>

<style is:global>
  /* 「いまの状況」をホームの下に置き、最終確認の画面へのリンクにする（お試し版と同じ並び） */
  .pa-nav a.pa-status-link { display: block; margin: 4px 0 6px; padding: 12px 14px; border-radius: 12px; background: #fff; border: 1px solid #dbe7ea; box-shadow: 0 1px 3px rgba(8, 60, 74, .06); color: inherit; text-decoration: none; transition: border-color .15s, box-shadow .15s, background .15s; }
  .pa-nav a.pa-status-link[aria-current="page"] { border-color: #137792; background: #eef7f9; }
  .pa-nav a.pa-status-link:hover { border-color: #137792; box-shadow: 0 2px 8px rgba(8, 60, 74, .12); }
  .pa-nav a.pa-status-link:focus-visible { outline: 3px solid #137792; outline-offset: 2px; }
  .pa-status-link .pa-side-h { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 6px; }
  .pa-status-link .pa-stat { display: flex; }
  .pa-status-link .pa-stat:last-child { margin-bottom: 0; }
  .pa-status-go { font-size: 11px; font-weight: 700; color: #137792; white-space: nowrap; }
</style>
