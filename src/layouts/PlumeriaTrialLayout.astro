---
// プルメリア管理画面 お試し版のレイアウト（Supabase につながる・期間限定）。
// 見た目は管理画面モック（PlumeriaAdminLayout）を引き継ぐ。モック自体は提案用として残す。
// ログインしていない場合は、ブラウザ側でログイン画面へ移す（データの保護はデータベース側の権限で行う）。
import PlumeriaBaseLayout from './PlumeriaBaseLayout.astro';
import '../styles/plumeria-admin.css';
import { trialRoutes } from '../data/plumeriaTrial';

interface Props {
  title: string;
  currentPath?: string;
  hello: string;
}
const { title, currentPath = '', hello } = Astro.props;

const nav = [
  { href: trialRoutes.home, ico: '⌂', t: 'ホーム', s: 'DASHBOARD' },
  { href: trialRoutes.vacancy, ico: '空', t: '空室情報', s: 'VACANCY' },
  { href: trialRoutes.post, ico: '知', t: 'お知らせ・通知', s: 'POSTS' },
  { href: `${trialRoutes.home}#analytics`, ico: '析', t: 'アクセス分析', s: 'ANALYTICS' },
  { href: trialRoutes.trash, ico: '箱', t: 'ゴミ箱', s: 'TRASH' },
];
---
<PlumeriaBaseLayout
  title={`${title}｜プルメリア 管理画面 お試し版`}
  description="プルメリア様の責任者の方に操作をお試しいただくための管理画面です（期間限定）。"
  siteName="プルメリア 管理画面（お試し版）"
>
  <div class="pa pt" data-reveal="off" data-trial-shell>
    <p class="pa-notice pt-notice">
      <strong>お試し版です。</strong>仮の内容だけで試してください（入居者さまのお名前など本物の情報は入れないでください）。
      公開した内容は、お試し表示としてホームページに出ます。
    </p>

    <div class="pa-shell">
      <aside class="pa-side">
        <div class="pa-brand">
          <div class="pa-brand-eyebrow">PLUMERIA</div>
          <div class="pa-brand-name">ホームページ管理</div>
        </div>

        <span class="pa-demo-badge">お試し版</span>

        <div class="pt-user" data-trial-user hidden>
          <span class="pt-user-name" data-trial-user-name></span>
          <span class="pt-user-role" data-trial-user-role></span>
          <button type="button" class="pt-logout" data-trial-logout>ログアウト</button>
        </div>

        <nav class="pa-nav" aria-label="管理メニュー">
          {nav.map((n, i) => (
            <>
              <a href={n.href} data-astro-reload aria-current={currentPath === n.href ? 'page' : undefined}>
                <span class="pa-ico" aria-hidden="true">{n.ico}</span>
                <span>
                  <span class="pa-nav-t">{n.t}</span>
                  <span class="pa-nav-s">{n.s}</span>
                </span>
              </a>
              {i === 0 && (
                <a class="pt-status" href={trialRoutes.approve} data-astro-reload aria-current={currentPath === trialRoutes.approve ? 'page' : undefined}>
                  <span class="pa-side-h">いまの状況<span class="pt-status-go" aria-hidden="true">開く →</span></span>
                  <span class="pa-stat"><span class="pa-dot pa-dot-warn"></span>確認まち<span class="pa-stat-v" data-trial-count="pending">—</span></span>
                  <span class="pa-stat"><span class="pa-dot pa-dot-ok"></span>公開中<span class="pa-stat-v" data-trial-count="published">—</span></span>
                </a>
              )}
            </>
          ))}
        </nav>

        <div class="pa-quick">
          <div class="pa-quick-h">
            <div class="pa-side-h">空室情報をすぐ変える</div>
            <a href={trialRoutes.vacancy} data-astro-reload>詳細</a>
          </div>
          <div data-trial-quick><p class="pa-quick-note">読み込み中…</p></div>
          <p class="pa-quick-note">押すとすぐ保存され、ホームページのお試し表示に反映されます。</p>
        </div>

        <div class="pa-side-card">
          <b>うまく動かないときは</b>
          <p>画面を開き直してください。それでも直らない場合は、和-Nodeまでご連絡ください。</p>
        </div>
      </aside>

      <main class="pa-main">
        <div class="pa-top">
          <div>
            <h1 class="pa-hello">{hello}</h1>
            <p class="pa-date" data-trial-today></p>
          </div>
        </div>
        <p class="pt-msg" data-trial-msg role="status" aria-live="polite" hidden></p>
        <slot />
      </main>
    </div>
  </div>
</PlumeriaBaseLayout>

<style is:global>
  .pt-notice { background: #fff4e5; color: #6b4200; }
  .pt-user { display: grid; gap: 2px; margin: 10px 0 14px; padding: 10px 12px; border-radius: 10px; background: rgba(255,255,255,.6); font-size: 13px; }
  /* display を指定した部品でも hidden 属性で確実に隠す */
  .pt [hidden] { display: none !important; }
  .pt-user-name { font-weight: 700; }
  .pt-user-role { color: #587680; font-size: 12px; }
  .pt-logout { justify-self: start; margin-top: 4px; background: none; border: 1px solid #b9cdd3; border-radius: 999px; padding: 3px 12px; font: inherit; font-size: 12px; cursor: pointer; }
  .pt-status { padding: 12px 14px; border-radius: 12px; background: #fff; border: 1px solid #dbe7ea; box-shadow: 0 1px 3px rgba(8, 60, 74, .06); }
  .pa-nav a.pt-status { display: block; margin: 4px 0 6px; color: inherit; text-decoration: none; transition: border-color .15s, box-shadow .15s, background .15s; }
  .pa-nav a.pt-status[aria-current="page"] { border-color: #137792; background: #eef7f9; }
  .pt-status .pa-side-h, .pt-status .pa-stat { display: flex; }
  a.pt-status:hover { border-color: #137792; box-shadow: 0 2px 8px rgba(8, 60, 74, .12); }
  a.pt-status:focus-visible { outline: 3px solid #137792; outline-offset: 2px; }
  .pt-status .pa-side-h { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 6px; }
  .pt-status-go { font-size: 11px; font-weight: 700; color: #137792; white-space: nowrap; }
  .pt-status .pa-stat:last-child { margin-bottom: 0; }
  /* 確認まちがあるときの強調（ホームの「最終確認まち」とサイドメニューの「いまの状況」で共通）。
     透明感のある赤い色ガラス：薄い赤の重ね塗り＋上半分の照り返し（::before）＋光の筋（::after）。
     最初の約5秒だけ、赤くチカチカ点滅し、光の筋がガラスの上を横切る。止まったあとも色ガラスの見た目は残す。
     5秒で止めるのは、5秒を超えて自動で動き続ける表示には止める手段が要るため。動きを減らす設定の端末では動かさない。 */
  .pa-kpi.is-alert, .pa-nav a.pt-status.is-alert {
    position: relative; isolation: isolate; overflow: hidden;
    border-color: rgba(196, 30, 52, .55);
    background:
      linear-gradient(160deg, rgba(255, 130, 140, .30) 0%, rgba(230, 50, 70, .16) 48%, rgba(175, 15, 40, .26) 100%),
      #fff4f5;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, .95),
      inset 0 -12px 22px -6px rgba(190, 20, 45, .20),
      0 0 0 1px rgba(196, 30, 52, .35),
      0 10px 24px -10px rgba(196, 30, 52, .55);
  }
  .pa-kpi.is-alert::before, .pa-nav a.pt-status.is-alert::before {
    content: ""; position: absolute; inset: 0 0 52% 0; z-index: -1; pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(180deg, rgba(255, 255, 255, .75) 0%, rgba(255, 255, 255, .18) 70%, rgba(255, 255, 255, 0) 100%);
  }
  .pa-kpi.is-alert::after, .pa-nav a.pt-status.is-alert::after {
    content: ""; position: absolute; top: -20%; bottom: -20%; left: 0; width: 38%; z-index: -1; pointer-events: none;
    background: linear-gradient(100deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, .75) 50%, rgba(255, 255, 255, 0) 100%);
    transform: translateX(-160%) skewX(-18deg);
    opacity: 0;
  }
  .pa-nav a.pt-status.is-alert .pa-stat:nth-child(2) { color: #a3172b; font-weight: 700; }
  .pa-nav a.pt-status.is-alert .pa-dot-warn { background: #d42a45; }
  @media (prefers-reduced-motion: no-preference) {
    /* チカチカ点滅：1秒に2回、明るい赤と通常の色を段差で切り替える（9回＝約4.5秒）。
       光の点滅は1秒に3回を超えると発作を起こすおそれがあるため、2回にとどめる。 */
    .pa-kpi.is-alert, .pa-nav a.pt-status.is-alert { animation: pt-glass-flash .5s steps(1, end) 9; }
    .pa-kpi.is-alert::after, .pa-nav a.pt-status.is-alert::after { animation: pt-glass-sheen 1.5s ease-in-out 3; }
  }
  @keyframes pt-glass-flash {
    0% {
      background-color: #ffc2cb;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 1), inset 0 -14px 26px -6px rgba(190, 20, 45, .38),
        0 0 0 3px rgba(220, 40, 60, .45), 0 0 28px 4px rgba(225, 35, 60, .55);
    }
    50%, 100% {
      background-color: #fff4f5;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .95), inset 0 -12px 22px -6px rgba(190, 20, 45, .20),
        0 0 0 1px rgba(196, 30, 52, .35), 0 10px 24px -10px rgba(196, 30, 52, .55);
    }
  }
  @keyframes pt-glass-sheen {
    0% { transform: translateX(-160%) skewX(-18deg); opacity: 0; }
    15% { opacity: 1; }
    70% { opacity: 1; }
    100% { transform: translateX(330%) skewX(-18deg); opacity: 0; }
  }
  .pt-msg { margin: 0 0 16px; padding: 10px 14px; border-radius: 10px; background: #e7f4ec; color: #1f5a37; font-weight: 600; }
  .pt-msg.is-error { background: #fdecea; color: #8a1f12; }
  .pt .pa-seg button[disabled], .pt .pa-quick-seg button[disabled] { opacity: .55; cursor: wait; }
  .pt .pa-seg button, .pt .pa-quick-seg button { cursor: pointer; }
  /* お知らせの保存ボタン：下書き（灰）・最終確認へ送る（橙）・このまま公開する（青緑）で見分ける */
  .pt .pt-btn-draft { background: #fff; color: #4a5a60; border-color: #b8c4c8; cursor: pointer; }
  .pt .pt-btn-draft:hover { background: #f2f5f6; }
  .pt .pt-btn-send { background: #a35f00; border-color: #a35f00; color: #fff; cursor: pointer; }
  .pt .pt-btn-send:hover { background: #8a5000; border-color: #8a5000; }
  .pt .pt-btn-publish { background: var(--green); border-color: var(--green); color: #fff; cursor: pointer; }
  .pt .pt-btn-publish:hover { filter: brightness(.92); }
  .pt-att { margin-top: 10px; }
  .pt-att-imgs { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 8px; }
  .pt-att-imgs a { display: block; border-radius: 8px; overflow: hidden; background: #eef3f5; aspect-ratio: 4 / 3; }
  .pt-att-imgs img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pt-att-pdfs { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 4px; }
  .pt-att-pdfs a { font-weight: 700; overflow-wrap: anywhere; }
  .pt-file-input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .pt-drop { display: block; cursor: pointer; }
  .pt-file-input:focus-visible + .pt-drop, .pt-drop:focus-within { outline: 3px solid #137792; outline-offset: 2px; }
  .pt-att-edit { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 8px; }
  .pt-att-edit li { display: flex; align-items: center; gap: 10px; padding: 6px; border: 1px solid #dbe7ea; border-radius: 10px; background: #fff; }
  .pt-att-edit img { width: 72px; height: 72px; object-fit: cover; border-radius: 6px; flex: 0 0 72px; }
  .pt-att-pdficon { width: 72px; height: 72px; flex: 0 0 72px; display: grid; place-items: center; border-radius: 6px; background: #fdecea; color: #8a1f12; font-weight: 800; }
  .pt-att-name { flex: 1; min-width: 0; overflow-wrap: anywhere; font-size: 13px; }
  .pt-dialog { width: min(420px, calc(100vw - 32px)); border: none; border-radius: 16px; padding: 28px 24px 22px; text-align: center; box-shadow: 0 18px 48px rgba(8, 60, 74, .25); color: #083c4a; }
  .pt-dialog::backdrop { background: rgba(8, 40, 50, .45); }
  .pt-dialog-icon { width: 52px; height: 52px; margin: 0 auto 12px; border-radius: 50%; display: grid; place-items: center; background: #e7f4ec; color: #1f5a37; font-size: 26px; font-weight: 800; }
  .pt-dialog-title { margin: 0 0 8px; font-size: 19px; }
  .pt-dialog-text { margin: 0 0 20px; font-size: 14px; line-height: 1.7; color: #3d5a63; }
  .pt .pt-dialog-ok { width: 100%; padding: 12px; font-size: 14px; cursor: pointer; }
  .pt-empty { color: #587680; font-size: 14px; padding: 8px 0; }
  .pa-badge-warn { background: #fdecea; color: #8a1f12; }
  .pt-reason { margin-top: 6px; padding: 8px 10px; border-radius: 8px; background: #fdecea; color: #8a1f12; font-size: 13px; }
  .pt-body { white-space: pre-wrap; margin: 8px 0 0; padding: 10px 12px; border-radius: 8px; background: #f4f8f9; font-size: 14px; }
  .pt .pa-input, .pt .pa-select, .pt .pa-textarea { font: inherit; }
  .pt-inline-form { display: grid; gap: 8px; margin-top: 8px; }
</style>

<script>
  import { loadSession, currentProfile, signOut, goLogin, handleError, loadVacancies, setVacancy, api, h, showMsg } from '../lib/plumeriaTrial';
  import { vacancyStates, trialRoutes } from '../data/plumeriaTrial';

  async function refreshCounts() {
    try {
      for (const st of ['pending', 'published']) {
        const rows = await api<{ id: number }[]>(`posts?select=id&status=eq.${st}`);
        const el = document.querySelector<HTMLElement>(`[data-trial-count="${st}"]`);
        if (el) el.textContent = `${rows.length}件`;
        // 確認まちがあるときは、サイドメニューの「いまの状況」カードを橙で強調する（点滅は付けたときに一度だけ）
        if (st === 'pending') document.querySelector('.pt-status')?.classList.toggle('is-alert', rows.length > 0);
      }
    } catch (e) { handleError(e, (m) => showMsg(m, true)); }
  }

  async function renderQuick() {
    const box = document.querySelector<HTMLElement>('[data-trial-quick]');
    if (!box) return;
    try {
      const list = await loadVacancies();
      box.replaceChildren(...list.map((v) => {
        const seg = h('div', { class: 'pa-quick-seg', role: 'group', 'aria-label': `${v.name}の空室状況` },
          ...vacancyStates.map((s) => h('button', {
            type: 'button', 'aria-pressed': v.state === s ? 'true' : 'false',
            onclick: async (ev: Event) => {
              const btns = seg.querySelectorAll('button');
              btns.forEach((b) => (b.disabled = true));
              try {
                await setVacancy(v.facility, s);
                showMsg(`${v.name}を「${s}」にしました。`);
                document.dispatchEvent(new CustomEvent('pt:vacancy-changed'));
              } catch (e) { handleError(e, (m) => showMsg(m, true)); }
              finally { btns.forEach((b) => (b.disabled = false)); }
            },
          }, s)));
        return h('div', { class: 'pa-quick-item' }, h('p', { class: 'pa-quick-name' }, v.name), seg);
      }));
    } catch (e) { handleError(e, (m) => showMsg(m, true)); }
  }

  async function init() {
    if (!document.querySelector('[data-trial-shell]')) return;
    if (!loadSession()) { goLogin(); return; }
    const today = document.querySelector('[data-trial-today]');
    if (today) today.textContent = new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', dateStyle: 'full' }).format(new Date());
    try {
      const p = await currentProfile();
      if (!p) {
        showMsg('このアカウントには、まだ表示名と権限が登録されていません。和-Nodeまでご連絡ください。', true);
        return;
      }
      const box = document.querySelector<HTMLElement>('[data-trial-user]');
      if (box) {
        box.querySelector('[data-trial-user-name]')!.textContent = `${p.display_name} さん`;
        box.querySelector('[data-trial-user-role]')!.textContent = p.role === 'approver' ? '公開まで操作できます' : '最終確認へ送るまで操作できます';
        box.hidden = false;
      }
    } catch (e) { handleError(e, (m) => showMsg(m, true)); return; }
    document.querySelector('[data-trial-logout]')?.addEventListener('click', async () => {
      await signOut();
      location.href = trialRoutes.login;
    });
    renderQuick();
    refreshCounts();
    document.addEventListener('pt:vacancy-changed', renderQuick);
    document.addEventListener('pt:posts-changed', refreshCounts);
  }

  // 画面内のリンクは data-astro-reload で読み直すため、ページごとに1回だけ動く
  document.addEventListener('astro:page-load', init, { once: true });
</script>
